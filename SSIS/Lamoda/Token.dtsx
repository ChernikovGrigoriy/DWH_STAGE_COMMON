      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[Token] TGT &#xA; USING [BUFFER].[Lamoda_Token] SRC ON TGT.[id] = SRC.[id]&#xA; WHEN MATCHED THEN&#xA; UPDATE SET&#xA;&#x9;[access_token]  = SRC.[access_token]    &#xA;&#x9;,[expires_in] = SRC.[expires_in]&#xA;&#x9;,[token_type] = SRC.[token_type]&#xA;&#x9;,[scope] = SRC.[scope]&#xA;    ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA; INSERT&#xA; (&#xA;&#x9;ID&#xA;   ,[access_token]&#xA;   ,[expires_in]&#xA;   ,[token_type]&#xA;   ,[scope]&#xA;   ,SYSMOMENT&#xA; )&#xA; VALUES&#xA; (&#xA;&#x9;SRC.ID&#xA;   ,SRC.[access_token]&#xA;   ,SRC.[expires_in]&#xA;   ,SRC.[token_type]&#xA;   ,SRC.[scope]&#xA;   ,GETDATE()&#xA; );&#xA;&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
