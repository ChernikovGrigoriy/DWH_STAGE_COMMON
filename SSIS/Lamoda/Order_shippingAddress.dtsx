            <DTS:Executable
              DTS:refId="Package\Order id shippingAddress\цыкл\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{0cee2c30-a79a-476b-8208-84520476c309}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка в стейджинг"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[shippingAddress] WITH(TABLOCKX, HOLDLOCK) TGT &#xA; USING (&#xA;&#xA; SELECT&#xA;  [id]&#xA;  ,[zipcode]&#xA;  ,[region]&#xA;  ,[city]&#xA;  ,[street]&#xA;  ,[houseNum]&#xA;  ,[apartment]&#xA;  ,[coordinate_latitude]&#xA;  ,[coordinate_longitude]&#xA;  ,[cityId]&#xA;  ,[streetId]&#xA;  ,[buildingId]&#xA;  ,[isValid]&#xA;  ,[isEditable]&#xA;  ,[pickupPointId]&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;     NULLIF([id],'') [id]&#xA;     ,NULLIF([zipcode],'') [zipcode]&#xA;     ,NULLIF([region],'') [region]&#xA;     ,NULLIF([city],'') [city]&#xA;     ,NULLIF([street],'') [street]&#xA;     ,NULLIF([houseNum],'') [houseNum]&#xA;     ,NULLIF([apartment],'') [apartment]&#xA;     ,NULLIF([coordinate_latitude],0) [coordinate_latitude]&#xA;     ,NULLIF([coordinate_longitude],0) [coordinate_longitude]&#xA;     ,NULLIF([cityId],'') [cityId]&#xA;     ,NULLIF([streetId],'') [streetId]&#xA;     ,NULLIF([buildingId],'') [buildingId]&#xA;     ,[isValid]&#xA;     ,[isEditable]&#xA;     ,NULLIF([pickupPointId],0) [pickupPointId]&#xA;     ,ROW_NUMBER() OVER (PARTITION BY ID ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;     [BUFFER].[Lamoda_Order_shippingAddress]&#xA;   ) TMP&#xA; WHERE&#xA;  RN =1&#xA;&#xA; ) SRC ON TGT.[id] = SRC.[ID]&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;      SRC.[id]&#xA;      ,SRC.[zipcode]&#xA;      ,SRC.[region]&#xA;      ,SRC.[city]&#xA;      ,SRC.[street]&#xA;      ,SRC.[houseNum]&#xA;      ,SRC.[apartment]&#xA;      ,SRC.[coordinate_latitude]&#xA;      ,SRC.[coordinate_longitude]&#xA;      ,SRC.[cityId]&#xA;      ,SRC.[streetId]&#xA;      ,SRC.[buildingId]&#xA;      ,SRC.[isValid]&#xA;      ,SRC.[isEditable]&#xA;      ,SRC.[pickupPointId]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;      TGT.[id]&#xA;      ,TGT.[zipcode]&#xA;      ,TGT.[region]&#xA;      ,TGT.[city]&#xA;      ,TGT.[street]&#xA;      ,TGT.[houseNum]&#xA;      ,TGT.[apartment]&#xA;      ,TGT.[coordinate_latitude]&#xA;      ,TGT.[coordinate_longitude]&#xA;      ,TGT.[cityId]&#xA;      ,TGT.[streetId]&#xA;      ,TGT.[buildingId]&#xA;      ,TGT.[isValid]&#xA;      ,TGT.[isEditable]&#xA;      ,TGT.[pickupPointId]&#xA; ) THEN&#xA; UPDATE SET&#xA;       [id] = SRC.[id]&#xA;      ,[zipcode] = SRC.[zipcode]&#xA;      ,[region] = SRC.[region]&#xA;      ,[city] = SRC.[city]&#xA;      ,[street] = SRC.[street]&#xA;      ,[houseNum] = SRC.[houseNum]&#xA;      ,[apartment] = SRC.[apartment]&#xA;      ,[coordinate_latitude] = SRC.[coordinate_latitude]&#xA;      ,[coordinate_longitude] = SRC.[coordinate_longitude]&#xA;      ,[cityId] = SRC.[cityId]&#xA;      ,[streetId] = SRC.[streetId]&#xA;      ,[buildingId] = SRC.[buildingId]&#xA;      ,[isValid] = SRC.[isValid]&#xA;      ,[isEditable] = SRC.[isEditable]&#xA;      ,[pickupPointId] = SRC.[pickupPointId]&#xA;   ,SYSMOMENT = GETDATE()&#xA;  WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;      [id]&#xA;      ,[zipcode]&#xA;      ,[region]&#xA;      ,[city]&#xA;      ,[street]&#xA;      ,[houseNum]&#xA;      ,[apartment]&#xA;      ,[coordinate_latitude]&#xA;      ,[coordinate_longitude]&#xA;      ,[cityId]&#xA;      ,[streetId]&#xA;      ,[buildingId]&#xA;      ,[isValid]&#xA;      ,[isEditable]&#xA;      ,[pickupPointId]&#xA;   ,SYSMOMENT&#xA; )&#xA; VALUES&#xA; (&#xA;   SRC.[id]&#xA;      ,SRC.[zipcode]&#xA;      ,SRC.[region]&#xA;      ,SRC.[city]&#xA;      ,SRC.[street]&#xA;      ,SRC.[houseNum]&#xA;      ,SRC.[apartment]&#xA;      ,SRC.[coordinate_latitude]&#xA;      ,SRC.[coordinate_longitude]&#xA;      ,SRC.[cityId]&#xA;      ,SRC.[streetId]&#xA;      ,SRC.[buildingId]&#xA;      ,SRC.[isValid]&#xA;      ,SRC.[isEditable]&#xA;      ,SRC.[pickupPointId]&#xA;   ,GETDATE()&#xA; );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
