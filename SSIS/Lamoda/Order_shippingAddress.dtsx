     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    public class Error
    {
        public int? code { get; set; }
        public string description { get; set; }
        public string[] errors { get; set; }
        public string message { get; set; }
    }
    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(300000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    public JavaScriptSerializer oJSS { get; set; }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        System.Net.ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

        oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public string ApiKey()
    {
        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        oSqlConnection.Open();

        OleDbCommand oSqlCommand = new OleDbCommand("UPDATE [Lamoda].[Token] SET [LastRead] = GETDATE();", oSqlConnection);
        oSqlCommand.ExecuteNonQuery();

        oSqlCommand = new OleDbCommand("SELECT [access_token] FROM [Lamoda].[Token] WHERE ID = 1", oSqlConnection);

        string vApiKey = (string)oSqlCommand.ExecuteScalar();

        oSqlConnection.Close();

        return vApiKey;
    }
    public override void CreateNewOutputRows()
    {

        if (Variables.vOrder4 != "-1")
        {
            try
            {
                byte[] oDATA = null;

                int j = 1;
                while (j <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                        string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/orders/{0}/shipping_address",  Variables.vOrder4);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (WebException e)
                    {
                        if (e.Message.Contains("Too Many Requests")
                            || e.Message.Contains("Невозможно соединиться с удаленным сервером")
                            || e.Message.Contains("Время ожидания операции истекло")
                            || e.Message.Contains("(500) Внутренняя ошибка сервера"))
                        {
                            Thread.Sleep(20000 * j);
                            j++;
                        }
                        else if (e.Message.Contains("(404) Не найден"))
                        {
                            Error oError = oJSS.Deserialize<Error>(new StreamReader(e.Response.GetResponseStream()).ReadToEnd());
                            if (oError.errors.Length == 0 && oError.message == "Not Found")
                                throw new ApplicationException("Заказ не найден, пропускаем");
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (j > 6)
                    throw new ApplicationException("Lamoda сервер не отвечает");

                OutputBuffer.AddRow();
                OutputBuffer.JSON.AddBlobData(oDATA);

            }
            catch (Exception e)
            {
                bool cancel;
                if (!e.Message.Contains("Заказ не найден, пропускаем"))
                    ComponentMetaData.FireError(10, "Order id shippingAddress", e.Message, "", 0, out cancel);
            }
        }
    }

}
]]></arrayElement>
