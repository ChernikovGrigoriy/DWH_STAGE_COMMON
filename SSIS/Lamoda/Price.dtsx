    <DTS:Executable
      DTS:refId="Package\Загрузка в стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{a97f8f8c-7e9c-44f5-bf21-b0057b766bcc}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="DECLARE @step int&#xA;&#xA;SET @step = 1&#xA;&#xA;WHILE @step &lt;= 2&#xA;BEGIN&#xA;&#xA; MERGE [Lamoda].[Price] TGT&#xA; USING&#xA; (&#xA;  SELECT&#xA;   [sku]&#xA;   ,[country]&#xA;   ,[lamodaSku]&#xA;   ,[price]&#xA;   ,[salePrice]&#xA;   ,[saleStartDate]&#xA;   ,[saleEndDate]&#xA;   ,[isRestricted]&#xA;   ,[priceUpdateStatus]&#xA;   ,[restrictionUpdateStatus]&#xA;  FROM&#xA;   (&#xA;    SELECT&#xA;      [sku]&#xA;      ,[country]&#xA;      ,[lamodaSku]&#xA;      ,[price]&#xA;      ,[salePrice]&#xA;      ,[saleStartDate]&#xA;      ,[saleEndDate]&#xA;      ,[isRestricted]&#xA;      ,[priceUpdateStatus]&#xA;      ,[restrictionUpdateStatus]&#xA;      ,ROW_NUMBER() OVER (PARTITION BY [sku], [country] ORDER BY CURRENT_TIMESTAMP) RN&#xA;    FROM&#xA;     [BUFFER].[Lamoda_Price]&#xA;   ) TMP&#xA;  WHERE&#xA;   RN = 1&#xA;&#xA; ) SRC ON TGT.[sku] = SRC.[sku] AND TGT.[country] = SRC.[country] AND TGT.[date_finish] = '22000101'&#xA; WHEN MATCHED AND&#xA;   TGT.[date_start] &lt; CAST(GETDATE() as date) AND&#xA;  CHECKSUM&#xA;  (&#xA;   SRC.[sku]&#xA;   ,SRC.[country]&#xA;   ,SRC.[lamodaSku]&#xA;   ,SRC.[price]&#xA;   ,SRC.[salePrice]&#xA;   ,SRC.[saleStartDate]&#xA;   ,SRC.[saleEndDate]&#xA;   ,SRC.[isRestricted]&#xA;   ,SRC.[priceUpdateStatus]&#xA;   ,SRC.[restrictionUpdateStatus]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;   TGT.[sku]&#xA;   ,TGT.[country]&#xA;   ,TGT.[lamodaSku]&#xA;   ,TGT.[price]&#xA;   ,TGT.[salePrice]&#xA;   ,TGT.[saleStartDate]&#xA;   ,TGT.[saleEndDate]&#xA;   ,TGT.[isRestricted]&#xA;   ,TGT.[priceUpdateStatus]&#xA;   ,TGT.[restrictionUpdateStatus]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;  [date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;  ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;    [sku]&#xA;    ,[country]&#xA;    ,[DATE_START]&#xA;    ,[DATE_FINISH]&#xA;    ,[lamodaSku]&#xA;    ,[price]&#xA;    ,[salePrice]&#xA;    ,[saleStartDate]&#xA;    ,[saleEndDate]&#xA;    ,[isRestricted]&#xA;    ,[priceUpdateStatus]&#xA;    ,[restrictionUpdateStatus]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES&#xA;  (&#xA;    SRC.[sku]&#xA;    ,SRC.[country]&#xA;    ,CAST(GETDATE() as date)&#xA;    ,'22000101'&#xA;    ,[lamodaSku]&#xA;    ,[price]&#xA;    ,[salePrice]&#xA;    ,[saleStartDate]&#xA;    ,[saleEndDate]&#xA;    ,[isRestricted]&#xA;    ,[priceUpdateStatus]&#xA;    ,[restrictionUpdateStatus]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;  SET @step = @step + 1&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Создание буферной таблиц"
