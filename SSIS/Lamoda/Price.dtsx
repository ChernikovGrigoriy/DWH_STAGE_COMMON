    public string ApiKey()
    {
        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        oSqlConnection.Open();

        OleDbCommand oSqlCommand = new OleDbCommand("UPDATE [Lamoda].[Token] SET [LastRead] = GETDATE();", oSqlConnection);
        oSqlCommand.ExecuteNonQuery();

        oSqlCommand = new OleDbCommand("SELECT [access_token] FROM [Lamoda].[Token] WHERE ID = 1", oSqlConnection);

        string vApiKey = (string)oSqlCommand.ExecuteScalar();

        oSqlConnection.Close();

        return vApiKey;
    }

    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        try
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(60000);
                    string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/nomenclature/sell-values?page=1&limit=1000");
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (
                        e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("(500) Внутренняя ошибка сервера")
                        )
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Слишком большое количество обращений к серверу LaModa");

            Response oResponseFirst = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));
            Array.Clear(oDATA, 0, oDATA.Length);

            for (int vPage = 1; vPage <= oResponseFirst.pages; vPage++)
            {
                int j = 1;
                while (j <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(60000);
                        string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/nomenclature/sell-values?page={0}&limit=1000", vPage);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (Exception e)
                    {
                        if (
                            e.Message.Contains("Too Many Requests")
                            || e.Message.Contains("(500) Внутренняя ошибка сервера")
                            )
                        {
                            Thread.Sleep(20000 * j);
                            j++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (j > 6)
                    throw new ApplicationException("Слишком большое количество обращений к серверу LaModa");

                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));
                Array.Clear(oDATA, 0, oDATA.Length);

                if (oResponse._embedded != null && oResponse._embedded != null)
                {
                    foreach (Response_Embedded_Nomenclature item in oResponse._embedded.nomenclatures)
                    {
                        if (item._embedded != null && item._embedded.sellValues != null)
                        {
                            foreach (Response_Embedded_Nomenclature_Embedded_sellValues item2 in item._embedded.sellValues)
                            {
                                OutputBuffer.AddRow();

                                if (item.sku != null && item.sku.Length > 0) OutputBuffer.sku = item.sku.Length > 50 ? item.sku.Substring(1, 50) : item.sku;
                                if (item.lamodaSku != null && item.lamodaSku.Length > 0) OutputBuffer.lamodaSku = item.lamodaSku.Length > 50 ? item.lamodaSku.Substring(1, 50) : item.lamodaSku;
                                if (item2.country != null && item2.country.Length > 0) OutputBuffer.country = item2.country.Length > 20 ? item2.country.Substring(1, 20) : item2.country;
                                if (item2.price != null) OutputBuffer.price = (decimal)item2.price;
                                if (item2.salePrice != null) OutputBuffer.salePrice = (decimal)item2.salePrice;
                                if (item2.saleStartDate != null) OutputBuffer.saleStartDate = (DateTime)item2.saleStartDate;
                                if (item2.saleEndDate != null) OutputBuffer.saleEndDate = (DateTime)item2.saleEndDate;
                                if (item2.isRestricted != null) OutputBuffer.isRestricted = (bool)item2.isRestricted;
                                if (item2.priceUpdateStatus != null && item2.priceUpdateStatus.Length > 0) OutputBuffer.priceUpdateStatus = item2.priceUpdateStatus.Length > 10 ? item2.priceUpdateStatus.Substring(1, 10) : item2.priceUpdateStatus;
                                if (item2.restrictionUpdateStatus != null && item2.restrictionUpdateStatus.Length > 0) OutputBuffer.restrictionUpdateStatus = item2.restrictionUpdateStatus.Length > 10 ? item2.restrictionUpdateStatus.Substring(1, 10) : item2.restrictionUpdateStatus;
                            }
                        }
                    }
                }

                oResponse = null;
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "Price", e.Message, "", 0, out cancel);
        }
    }


}
]]></arrayElement>
