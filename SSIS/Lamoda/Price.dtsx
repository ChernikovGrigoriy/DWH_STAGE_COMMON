        public string parentSku { get; set; }
        public string name { get; set; }
        public int? quantity { get; set; }
        public Response_Embedded_Nomenclature_Embedded _embedded { get; set; }
    }

    public class Response_Embedded_Nomenclature_Embedded
    {
        public Response_Embedded_Nomenclature_Embedded_sellValues[] sellValues { get; set; }
    }

    public class Response_Embedded_Nomenclature_Embedded_sellValues
    {
        public string country { get; set; }
        public decimal? price { get; set; }
        public decimal? salePrice { get; set; }
        public DateTime? saleStartDate { get; set; }
        public DateTime? saleEndDate { get; set; }
        public bool? isRestricted { get; set; }
        public string priceUpdateStatus { get; set; }
        public string restrictionUpdateStatus { get; set; }
    }

