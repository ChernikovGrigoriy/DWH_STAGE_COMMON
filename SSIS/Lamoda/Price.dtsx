      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Lamoda_Price]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Lamoda_Price]&#xA;&#xA;create table [BUFFER].[Lamoda_Price] (&#xA;   sku                  nvarchar(50)         not null,&#xA;   country              nvarchar(10)         not null,&#xA;   lamodaSku            nvarchar(50)         not null,&#xA;   price                decimal(20,10)       null,&#xA;   salePrice            decimal(20,10)       null,&#xA;   saleStartDate        date                 null,&#xA;   saleEndDate          date                 null,&#xA;   isRestricted         bit                  null,&#xA;   priceUpdateStatus    nvarchar(10)         null,&#xA;   restrictionUpdateStatus nvarchar(10)         null&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
