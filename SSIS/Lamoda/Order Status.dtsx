    public Variables(ScriptComponent Component)
    {
        ParentComponent = Component;
    }

    public String vOrder11
    {
        get
        {
            return (String)(ParentComponent.ReadOnlyVariables["vOrder11"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

}
