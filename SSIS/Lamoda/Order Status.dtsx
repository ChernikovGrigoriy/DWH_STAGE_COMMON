            <DTS:Executable
              DTS:refId="Package\Order Id\цикл\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{3C08A9BF-7CBA-4FFA-9FA0-AFC4C6BB5687}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка в стейджинг"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[Order_Status] WITH(TABLOCKX, HOLDLOCK) TGT &#xA; USING ( &#xA;&#x9;SELECT&#xA;&#x9;&#x9;*&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;  [id]&#xA;&#x9;&#x9;&#x9;  ,[id_Order]&#xA;&#x9;&#x9;&#x9;  ,[createdAt]&#xA;&#x9;&#x9;&#x9;  ,[statusName]&#xA;&#x9;&#x9;&#x9;  ,[reasonId]&#xA;&#x9;&#x9;&#x9;  ,[reasonName]&#xA;&#x9;&#x9;&#x9;  ,[location]&#xA;&#x9;&#x9;&#x9;  ,ROW_NUMBER() OVER (PARTITION BY id ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[Lamoda_Order_Status]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA; ) SRC ON TGT.[id] = SRC.[id]&#xA; WHEN MATCHED AND&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[createdAt]&#xA;&#x9;&#x9;,SRC.[statusName]&#xA;&#x9;&#x9;,SRC.[reasonId]&#xA;&#x9;&#x9;,SRC.[reasonName]&#xA;&#x9;&#x9;,SRC.[location]&#xA;&#x9;) &lt;&gt;&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;&#x9;TGT.[createdAt]&#xA;&#x9;&#x9;,TGT.[statusName]&#xA;&#x9;&#x9;,TGT.[reasonId]&#xA;&#x9;&#x9;,TGT.[reasonName]&#xA;&#x9;&#x9;,TGT.[location]&#xA;&#x9;) THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[createdAt]= SRC.[createdAt]&#xA;&#x9;&#x9;,[statusName] = SRC.[statusName]&#xA;&#x9;&#x9;,[reasonId] = SRC.[reasonId]&#xA;&#x9;&#x9;,[reasonName] = SRC.[reasonName]&#xA;&#x9;&#x9;,[location] = SRC.[location]&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT&#xA;&#x9;(&#xA;&#x9;&#x9;[id]&#xA;      ,[id_Order]&#xA;      ,[createdAt]&#xA;      ,[statusName]&#xA;      ,[reasonId]&#xA;      ,[reasonName]&#xA;      ,[location]&#xA;      ,[SYSMOMENT]&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[id]&#xA;      ,SRC.[id_Order]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[statusName]&#xA;      ,SRC.[reasonId]&#xA;      ,SRC.[reasonName]&#xA;      ,SRC.[location]&#xA;      ,GETDATE()&#xA;&#x9;);&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
