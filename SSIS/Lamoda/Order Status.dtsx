    public Variables(ScriptComponent Component)
    {
        ParentComponent = Component;
    }

    public String vOrder17
    {
        get
        {
            return (String)(ParentComponent.ReadOnlyVariables["vOrder17"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

}
