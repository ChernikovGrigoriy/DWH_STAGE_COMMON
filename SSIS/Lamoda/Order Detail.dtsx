    #region шаблон
    public class Response
    {
        public string id { get; set; }
        public string orderNr { get; set; }
        public string status { get; set; }
        public string paymentMethod { get; set; }
        public decimal? rejectPrice { get; set; }
        public decimal? deliveryPrice { get; set; }
        public DateTime? paymentDate { get; set; }
        public bool? isConfirmed { get; set; }
        public string comment { get; set; }
        public int? itemQuantity { get; set; }
        public bool? isEditable { get; set; }
        public DateTime? createdAt { get; set; }
        public DateTime? updatedAt { get; set; }
        public Response_Options options { get; set; }
        public Response_Dates dates { get; set; }
        public decimal? fullSum { get; set; }
        public string currency { get; set; }
        public long? deprecatedId { get; set; }
        public bool? hasDiscrepancyActs { get; set; }
        public Response_Embedded _embedded { get; set; }
