    {
        ParentComponent = Component;
    }

    public String vOrder0
    {
        get
        {
            return (String)(ParentComponent.ReadOnlyVariables["vOrder0"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

}
