    public override void Input_ProcessInputRow(InputBuffer Row)
    {
        try
        {
            Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(Row.JSON.GetBlobData(0, (int)Row.JSON.Length)));
          
            if (oResponse._embedded.items != null)
            {
                foreach (Response_Embedded_Item item in oResponse._embedded.items)
                {
                    OutputBuffer.AddRow();
                    OutputBuffer.OrderID = oResponse.id;
                    if (item.id != null && item.id.Length > 0) OutputBuffer.id = item.id.Length > 50 ? item.id.Substring(1, 50) : item.id;
                    if (item.datamatrix != null && item.datamatrix.Length > 0) OutputBuffer.datamatrix = item.datamatrix.Length > 200 ? item.datamatrix.Substring(1, 200) : item.datamatrix;
                    if (item.sku != null && item.sku.Length > 0) OutputBuffer.sku = item.sku.Length > 50 ? item.sku.Substring(1, 200) : item.sku;
                    if (item.description != null && item.description.Length > 0) OutputBuffer.description = item.description.Length > 1000 ? item.description.Substring(1, 1000) : item.description;
                    if (item.basePrice != null) OutputBuffer.basePrice = (decimal)item.basePrice;
                    if (item.salePrice != null) OutputBuffer.salePrice = (decimal)item.salePrice;
                    if (item.paidPrice != null) OutputBuffer.paidPrice = (decimal)item.paidPrice;
                    if (item.partnerAgreedPrice != null) OutputBuffer.partnerAgreedPrice = (decimal)item.partnerAgreedPrice;
                    if (item.couponDiscount != null) OutputBuffer.couponDiscount = (decimal)item.couponDiscount;
                    if (item.loyaltyDiscount != null) OutputBuffer.loyaltyDiscount = (decimal)item.loyaltyDiscount;
                    if (item.partnerAgreedDiscount != null) OutputBuffer.partnerAgreedDiscount = (decimal)item.partnerAgreedDiscount;
                    if (item.otherDiscounts != null) OutputBuffer.otherDiscounts = (decimal)item.otherDiscounts;
                    if (item.totalDiscount != null) OutputBuffer.totalDiscount = (decimal)item.totalDiscount;
                    if (item.statusChangeReason != null && item.statusChangeReason.Length > 0) OutputBuffer.statusChangeReason = item.statusChangeReason.Length > 200 ? item.statusChangeReason.Substring(1, 200) : item.statusChangeReason;
                    if (item.size != null && item.size.Length > 0) OutputBuffer.size = item.size.Length > 50 ? item.size.Substring(1, 50) : item.size;
                    if (item.status != null && item.status.Length > 0) OutputBuffer.status = item.status.Length > 50 ? item.status.Substring(1, 50) : item.status;
                    if (item.finalERPStatus != null && item.finalERPStatus.Length > 0) OutputBuffer.finalERPStatus = item.finalERPStatus.Length > 50 ? item.finalERPStatus.Substring(1, 50) : item.finalERPStatus;
                    if (item.discrepancyAct != null && item.discrepancyAct.Length > 0) OutputBuffer.discrepancyAct = item.discrepancyAct.Length > 50 ? item.discrepancyAct.Substring(1, 50) : item.discrepancyAct;
