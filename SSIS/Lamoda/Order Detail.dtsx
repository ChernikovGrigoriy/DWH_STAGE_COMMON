          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Lamoda_Order_ID]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Lamoda_Order_ID]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Lamoda_Order_ID] FROM [Lamoda].[Order]&#xA;&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Lamoda_Order_Detail_ID]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Lamoda_Order_Detail_ID]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Lamoda_Order_Detail_ID] FROM [Lamoda].[Order_Detail]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Order Id\Список заказов"
