              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[Order] WITH(TABLOCKX, HOLDLOCK) TGT &#xA; USING ( &#xA;&#x9;SELECT&#xA;&#x9;&#x9;*&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;[id]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([orderNr],'') [orderNr]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([status],'') [status]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([paymentMethod],'') [paymentMethod]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([fullSum],0) [fullSum]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([deliveryPrice],0) [deliveryPrice]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([createdAt],'18991230') [createdAt]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([updatedAt],'18991230') [updatedAt]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([dates_delivered],'18991230') [dates_delivered]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([dates_shipped],'18991230') [dates_shipped]&#xA;&#x9;&#x9;&#x9;&#x9;,[isConfirmed]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([rejectPrice],0) [rejectPrice]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([paymentDate],'18991230') [paymentDate]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([comment],'') [comment]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([itemQuantity],0) [itemQuantity]&#xA;&#x9;&#x9;&#x9;&#x9;,[isEditable]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([currency],'') [currency]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([shippingAddress_id],0) [shippingAddress_id]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([platform],'') [platform]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([basePrice],0) [basePrice]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([salePrice],0) [salePrice]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([paidPrice],0) [paidPrice]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([partnerAgreedPrice],0) [partnerAgreedPrice]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([couponDiscount],0) [couponDiscount]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([loyaltyDiscount],0) [loyaltyDiscount]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([partnerAgreedDiscount],0) [partnerAgreedDiscount]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([otherDiscounts],0) [otherDiscounts]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([totalDiscount],0) [totalDiscount]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([lastDayOfStorage],'18991230') [lastDayOfStorage]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([deprecatedId],0) [deprecatedId]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([shippingType],'') [shippingType]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([options_has_liquid],0) [options_has_liquid]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([source],'') [source]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([confirmationFailedCode],'') [confirmationFailedCode]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([confirmationFailedReason],'') [confirmationFailedReason]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([externalOrderNumber],'') [externalOrderNumber]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([externalTrackingNumber],'') [externalTrackingNumber]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([partner_code],'') [partner_code]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([partner_shopName],'') [partner_shopName]&#xA;&#x9;&#x9;&#x9;&#x9;,NULLIF([partner_partnerId],0) [partner_partnerId]&#xA;&#x9;&#x9;&#x9;&#x9;,ROW_NUMBER() OVER (PARTITION BY id ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[Lamoda_Order_ID]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA; ) SRC ON TGT.[id] = SRC.[id]&#xA; WHEN MATCHED AND&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;      SRC.[orderNr]&#xA;      ,SRC.[status]&#xA;      ,SRC.[paymentMethod]&#xA;      ,SRC.[fullSum]&#xA;      ,SRC.[deliveryPrice]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[updatedAt]&#xA;      ,SRC.[dates_delivered]&#xA;      ,SRC.[dates_shipped]&#xA;      ,SRC.[isConfirmed]&#xA;      ,SRC.[rejectPrice]&#xA;      ,SRC.[paymentDate]&#xA;      ,SRC.[comment]&#xA;      ,SRC.[itemQuantity]&#xA;      ,SRC.[isEditable]&#xA;      ,SRC.[currency]&#xA;      ,SRC.[platform]&#xA;      ,SRC.[basePrice]&#xA;      ,SRC.[salePrice]&#xA;      ,SRC.[paidPrice]&#xA;      ,SRC.[partnerAgreedPrice]&#xA;      ,SRC.[couponDiscount]&#xA;      ,SRC.[loyaltyDiscount]&#xA;      ,SRC.[partnerAgreedDiscount]&#xA;      ,SRC.[otherDiscounts]&#xA;      ,SRC.[totalDiscount]&#xA;      ,SRC.[lastDayOfStorage]&#xA;      ,SRC.[deprecatedId]&#xA;      ,SRC.[shippingType]&#xA;      ,SRC.[options_has_liquid]&#xA;      ,SRC.[source]&#xA;      ,SRC.[confirmationFailedCode]&#xA;      ,SRC.[confirmationFailedReason]&#xA;      ,SRC.[externalOrderNumber]&#xA;      ,SRC.[externalTrackingNumber]&#xA;      ,SRC.[partner_code]&#xA;      ,SRC.[partner_shopName]&#xA;      ,SRC.[partner_partnerId]&#xA;&#x9;) &lt;&gt;&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;      TGT.[orderNr]&#xA;      ,TGT.[status]&#xA;      ,TGT.[paymentMethod]&#xA;      ,TGT.[fullSum]&#xA;      ,TGT.[deliveryPrice]&#xA;      ,TGT.[createdAt]&#xA;      ,TGT.[updatedAt]&#xA;      ,TGT.[dates_delivered]&#xA;      ,TGT.[dates_shipped]&#xA;      ,TGT.[isConfirmed]&#xA;      ,TGT.[rejectPrice]&#xA;      ,TGT.[paymentDate]&#xA;      ,TGT.[comment]&#xA;      ,TGT.[itemQuantity]&#xA;      ,TGT.[isEditable]&#xA;      ,TGT.[currency]&#xA;      ,TGT.[platform]&#xA;      ,TGT.[basePrice]&#xA;      ,TGT.[salePrice]&#xA;      ,TGT.[paidPrice]&#xA;      ,TGT.[partnerAgreedPrice]&#xA;      ,TGT.[couponDiscount]&#xA;      ,TGT.[loyaltyDiscount]&#xA;      ,TGT.[partnerAgreedDiscount]&#xA;      ,TGT.[otherDiscounts]&#xA;      ,TGT.[totalDiscount]&#xA;      ,TGT.[lastDayOfStorage]&#xA;      ,TGT.[deprecatedId]&#xA;      ,TGT.[shippingType]&#xA;      ,TGT.[options_has_liquid]&#xA;      ,TGT.[source]&#xA;      ,TGT.[confirmationFailedCode]&#xA;      ,TGT.[confirmationFailedReason]&#xA;      ,TGT.[externalOrderNumber]&#xA;      ,TGT.[externalTrackingNumber]&#xA;      ,TGT.[partner_code]&#xA;      ,TGT.[partner_shopName]&#xA;      ,TGT.[partner_partnerId]&#xA;&#x9;) THEN&#xA;&#x9;UPDATE SET&#xA;      [orderNr] = SRC.[orderNr]&#xA;      ,[status] = SRC.[status]&#xA;      ,[paymentMethod] = SRC.[paymentMethod]&#xA;      ,[fullSum] = SRC.[fullSum]&#xA;      ,[deliveryPrice] = SRC.[deliveryPrice]&#xA;      ,[createdAt] = SRC.[createdAt]&#xA;      ,[updatedAt] = SRC.[updatedAt]&#xA;      ,[dates_delivered] = SRC.[dates_delivered]&#xA;      ,[dates_shipped] = SRC.[dates_shipped]&#xA;      ,[isConfirmed] = SRC.[isConfirmed]&#xA;      ,[rejectPrice] = SRC.[rejectPrice]&#xA;      ,[paymentDate] = SRC.[paymentDate]&#xA;      ,[comment] = SRC.[comment]&#xA;      ,[itemQuantity] = SRC.[itemQuantity]&#xA;      ,[isEditable] = SRC.[isEditable]&#xA;      ,[currency] = SRC.[currency]&#xA;      ,[platform] = SRC.[platform]&#xA;      ,[basePrice] = SRC.[basePrice]&#xA;      ,[salePrice] = SRC.[salePrice]&#xA;      ,[paidPrice] = SRC.[paidPrice]&#xA;      ,[partnerAgreedPrice] = SRC.[partnerAgreedPrice]&#xA;      ,[couponDiscount] = SRC.[couponDiscount]&#xA;      ,[loyaltyDiscount] = SRC.[loyaltyDiscount]&#xA;      ,[partnerAgreedDiscount] = SRC.[partnerAgreedDiscount]&#xA;      ,[otherDiscounts] = SRC.[otherDiscounts]&#xA;      ,[totalDiscount] = SRC.[totalDiscount]&#xA;      ,[lastDayOfStorage] = SRC.[lastDayOfStorage]&#xA;      ,[deprecatedId] = SRC.[deprecatedId]&#xA;      ,[shippingType] = SRC.[shippingType]&#xA;      ,[options_has_liquid] = SRC.[options_has_liquid]&#xA;      ,[source] = SRC.[source]&#xA;      ,[confirmationFailedCode] = SRC.[confirmationFailedCode]&#xA;      ,[confirmationFailedReason] = SRC.[confirmationFailedReason]&#xA;      ,[externalOrderNumber] = SRC.[externalOrderNumber]&#xA;      ,[externalTrackingNumber] = SRC.[externalTrackingNumber]&#xA;      ,[partner_code] = SRC.[partner_code]&#xA;      ,[partner_shopName] = SRC.[partner_shopName]&#xA;      ,[partner_partnerId] = SRC.[partner_partnerId]&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT&#xA;&#x9;(&#xA;&#x9;  [id]&#xA;      ,[orderNr]&#xA;      ,[status]&#xA;      ,[paymentMethod]&#xA;      ,[fullSum]&#xA;      ,[deliveryPrice]&#xA;      ,[createdAt]&#xA;      ,[updatedAt]&#xA;      ,[dates_delivered]&#xA;      ,[dates_shipped]&#xA;      ,[isConfirmed]&#xA;      ,[rejectPrice]&#xA;      ,[paymentDate]&#xA;      ,[comment]&#xA;      ,[itemQuantity]&#xA;      ,[isEditable]&#xA;      ,[currency]&#xA;      ,[platform]&#xA;      ,[basePrice]&#xA;      ,[salePrice]&#xA;      ,[paidPrice]&#xA;      ,[partnerAgreedPrice]&#xA;      ,[couponDiscount]&#xA;      ,[loyaltyDiscount]&#xA;      ,[partnerAgreedDiscount]&#xA;      ,[otherDiscounts]&#xA;      ,[totalDiscount]&#xA;      ,[lastDayOfStorage]&#xA;      ,[deprecatedId]&#xA;      ,[shippingType]&#xA;      ,[options_has_liquid]&#xA;      ,[source]&#xA;      ,[confirmationFailedCode]&#xA;      ,[confirmationFailedReason]&#xA;      ,[externalOrderNumber]&#xA;      ,[externalTrackingNumber]&#xA;      ,[partner_code]&#xA;      ,[partner_shopName]&#xA;      ,[partner_partnerId]&#xA;&#x9;  ,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;  SRC.[id]&#xA;      ,SRC.[orderNr]&#xA;      ,SRC.[status]&#xA;      ,SRC.[paymentMethod]&#xA;      ,SRC.[fullSum]&#xA;      ,SRC.[deliveryPrice]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[updatedAt]&#xA;      ,SRC.[dates_delivered]&#xA;      ,SRC.[dates_shipped]&#xA;      ,SRC.[isConfirmed]&#xA;      ,SRC.[rejectPrice]&#xA;      ,SRC.[paymentDate]&#xA;      ,SRC.[comment]&#xA;      ,SRC.[itemQuantity]&#xA;      ,SRC.[isEditable]&#xA;      ,SRC.[currency]&#xA;      ,SRC.[platform]&#xA;      ,SRC.[basePrice]&#xA;      ,SRC.[salePrice]&#xA;      ,SRC.[paidPrice]&#xA;      ,SRC.[partnerAgreedPrice]&#xA;      ,SRC.[couponDiscount]&#xA;      ,SRC.[loyaltyDiscount]&#xA;      ,SRC.[partnerAgreedDiscount]&#xA;      ,SRC.[otherDiscounts]&#xA;      ,SRC.[totalDiscount]&#xA;      ,SRC.[lastDayOfStorage]&#xA;      ,SRC.[deprecatedId]&#xA;      ,SRC.[shippingType]&#xA;      ,SRC.[options_has_liquid]&#xA;      ,SRC.[source]&#xA;      ,SRC.[confirmationFailedCode]&#xA;      ,SRC.[confirmationFailedReason]&#xA;      ,SRC.[externalOrderNumber]&#xA;      ,SRC.[externalTrackingNumber]&#xA;      ,SRC.[partner_code]&#xA;      ,SRC.[partner_shopName]&#xA;      ,SRC.[partner_partnerId]&#xA;&#x9;  ,GETDATE()&#xA;&#x9;);&#xA;&#xA;&#x9;DELETE FROM [Lamoda].[Order_Detail] WHERE [id_Order] in (SELECT DISTINCT id_order FROM [BUFFER].[Lamoda_Order_Detail_ID])&#xA;&#xA;&#x9;INSERT INTO [Lamoda].[Order_Detail]&#xA;&#x9;(&#xA;&#x9;&#x9;[id_Order]&#xA;&#x9;&#x9;,[id]&#xA;&#x9;&#x9;,[datamatrix]&#xA;&#x9;&#x9;,[sku]&#xA;&#x9;&#x9;,[description]&#xA;&#x9;&#x9;,[basePrice]&#xA;&#x9;&#x9;,[salePrice]&#xA;&#x9;&#x9;,[paidPrice]&#xA;&#x9;&#x9;,[partnerAgreedPrice]&#xA;&#x9;&#x9;,[couponDiscount]&#xA;&#x9;&#x9;,[loyaltyDiscount]&#xA;&#x9;&#x9;,[partnerAgreedDiscount]&#xA;&#x9;&#x9;,[otherDiscounts]&#xA;&#x9;&#x9;,[totalDiscount]&#xA;&#x9;&#x9;,[statusChangeReason]&#xA;&#x9;&#x9;,[size]&#xA;&#x9;&#x9;,[status]&#xA;&#x9;&#x9;,[finalERPStatus]&#xA;&#x9;&#x9;,[discrepancyAct]&#xA;&#x9;&#x9;,[SYSMOMENT]&#xA;&#x9;&#x9;,[sku_nomenclature]&#xA;&#x9;)&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[id_Order]&#xA;&#x9;&#x9;,OD.[id]&#xA;&#x9;&#x9;,[datamatrix]&#xA;&#x9;&#x9;,[sku]&#xA;&#x9;&#x9;,[description]&#xA;&#x9;&#x9;,[basePrice]&#xA;&#x9;&#x9;,[salePrice]&#xA;&#x9;&#x9;,[paidPrice]&#xA;&#x9;&#x9;,[partnerAgreedPrice]&#xA;&#x9;&#x9;,[couponDiscount]&#xA;&#x9;&#x9;,[loyaltyDiscount]&#xA;&#x9;&#x9;,[partnerAgreedDiscount]&#xA;&#x9;&#x9;,[otherDiscounts]&#xA;&#x9;&#x9;,[totalDiscount]&#xA;&#x9;&#x9;,[statusChangeReason]&#xA;&#x9;&#x9;,[size]&#xA;&#x9;&#x9;,[status]&#xA;&#x9;&#x9;,[finalERPStatus]&#xA;&#x9;&#x9;,[discrepancyAct]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;&#x9;,NM.ID&#xA;&#x9;FROM&#x9;&#xA;&#x9;&#x9;[BUFFER].[Lamoda_Order_Detail_ID] OD&#xA;&#x9;&#x9;OUTER APPLY (&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;TOP 1&#xA;&#x9;&#x9;&#x9;&#x9;NM.id&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[Lamoda].[Nomenclatures] NM&#xA;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;&#x9;OD.sku = NM.supplier_sku&#xA;&#x9;&#x9;) NM&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
