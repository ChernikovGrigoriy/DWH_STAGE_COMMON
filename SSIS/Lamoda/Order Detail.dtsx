    {
        public DateTime? delivered { get; set; }
        public DateTime? shipped { get; set; }
    }

    public class Response_Embedded
    {
        public Response_Embedded_Item[] items { get; set; }
        public Response_Embedded_ShippingAddress shippingAddress { get; set; }
        public Response_Embedded_Partner partner { get; set; }
    }

