              SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Lamoda_Order_delivery]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Lamoda_Order_delivery]&#xA;&#xA;CREATE TABLE [BUFFER].[Lamoda_Order_delivery]&#xA;(&#xA; Order_ID nvarchar(50),&#xA; [delivery_deliveryPrice] [decimal](20, 10) NULL,&#xA; [delivery_deliveryDate] [date] NULL,&#xA; [delivery_deliveryIntervalFrom] [nvarchar](20) NULL,&#xA; [delivery_deliveryIntervalTo] [nvarchar](20) NULL,&#xA; [delivery_deliveryDateMin] [date] NULL,&#xA; [delivery_deliveryDateMax] [date] NULL,&#xA; [delivery_hasIntervals] [bit] NULL,&#xA; [delivery_isDeliveryPriceCustom] [bit] NULL,&#xA; [delivery_isEditable] [bit] NULL,&#xA; [delivery_shippingMethodName] [nvarchar](200) NULL,&#xA; [delivery_shippingMethodCode] [nvarchar](200) NULL,&#xA; [delivery_serviceLevelTypeCode] [nvarchar](50) NULL,&#xA; [delivery_serviceLevelTypeName] [nvarchar](50) NULL,&#xA; [delivery_storageDays] [nvarchar](50) NULL,&#xA; [delivery_cutOff] [date] NULL,&#xA; [delivery_shippingMethodTypeCode] [nvarchar](100) NULL,&#xA; [delivery_DeliveryIntervalId] [bigint] NULL,&#xA; PRIMARY KEY CLUSTERED(Order_ID)&#xA;)&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
