            if (oResponse.isDeliveryPriceCustom != null) Row.isDeliveryPriceCustom = (bool)oResponse.isDeliveryPriceCustom;
            if (oResponse.standardDeliveryPrice != null) Row.deliveryPrice = (decimal)oResponse.deliveryPrice;
            if (oResponse.deliveryDateMax != null) Row.deliveryDateMax = (DateTime)oResponse.deliveryDateMax;
            if (oResponse.deliveryDateMin != null) Row.deliveryDateMin = (DateTime)oResponse.deliveryDateMin;
