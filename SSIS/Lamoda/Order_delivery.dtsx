              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[Order] WITH(TABLOCKX, HOLDLOCK) TGT &#xA; USING &#xA; (&#xA;&#xA; SELECT&#xA;  [Order_ID]&#xA;  ,[delivery_deliveryPrice]&#xA;  ,[delivery_deliveryDate]&#xA;  ,[delivery_deliveryIntervalFrom]&#xA;  ,[delivery_deliveryIntervalTo]&#xA;  ,[delivery_deliveryDateMin]&#xA;  ,[delivery_deliveryDateMax]&#xA;  ,[delivery_hasIntervals]&#xA;  ,[delivery_isDeliveryPriceCustom]&#xA;  ,[delivery_isEditable]&#xA;  ,[delivery_shippingMethodName]&#xA;  ,[delivery_shippingMethodCode]&#xA;  ,[delivery_serviceLevelTypeCode]&#xA;  ,[delivery_serviceLevelTypeName]&#xA;  ,[delivery_storageDays]&#xA;  ,[delivery_cutOff]&#xA;  ,[delivery_shippingMethodTypeCode]&#xA;  ,[delivery_DeliveryIntervalId]&#xA; FROM&#xA;  (&#xA;  SELECT&#xA;    [Order_ID]&#xA;    ,NULLIF([delivery_deliveryPrice],0) [delivery_deliveryPrice]&#xA;    ,NULLIF([delivery_deliveryDate],'18991230') [delivery_deliveryDate]&#xA;    ,NULLIF([delivery_deliveryIntervalFrom],'') [delivery_deliveryIntervalFrom]&#xA;    ,NULLIF([delivery_deliveryIntervalTo],'') [delivery_deliveryIntervalTo]&#xA;    ,NULLIF([delivery_deliveryDateMin],'18991230') [delivery_deliveryDateMin]&#xA;    ,NULLIF([delivery_deliveryDateMax],'18991230') [delivery_deliveryDateMax]&#xA;    ,NULLIF([delivery_hasIntervals],0) [delivery_hasIntervals]&#xA;    ,NULLIF([delivery_isDeliveryPriceCustom],0) [delivery_isDeliveryPriceCustom]&#xA;    ,NULLIF([delivery_isEditable],0) [delivery_isEditable]&#xA;    ,NULLIF([delivery_shippingMethodName],'') [delivery_shippingMethodName]&#xA;    ,NULLIF([delivery_shippingMethodCode],'') [delivery_shippingMethodCode]&#xA;    ,NULLIF([delivery_serviceLevelTypeCode],'') [delivery_serviceLevelTypeCode]&#xA;    ,NULLIF([delivery_serviceLevelTypeName],'') [delivery_serviceLevelTypeName]&#xA;    ,NULLIF([delivery_storageDays],'') [delivery_storageDays]&#xA;    ,NULLIF([delivery_cutOff],'18991230') [delivery_cutOff]&#xA;    ,NULLIF([delivery_shippingMethodTypeCode],'') [delivery_shippingMethodTypeCode]&#xA;    ,NULLIF([delivery_DeliveryIntervalId],0) [delivery_DeliveryIntervalId]&#xA;    ,ROW_NUMBER() OVER (PARTITION BY Order_ID ORDER BY CURRENT_TIMESTAMP) RN&#xA;  FROM&#xA;     [BUFFER].[Lamoda_Order_delivery]&#xA;  ) TMP&#xA; WHERE&#xA;  RN =1 &#xA;&#xA; ) SRC ON TGT.[id] = SRC.[Order_ID]&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;      TGT.[delivery_deliveryPrice]&#xA;      ,TGT.[delivery_deliveryDate]&#xA;      ,TGT.[delivery_deliveryIntervalFrom]&#xA;      ,TGT.[delivery_deliveryIntervalTo]&#xA;      ,TGT.[delivery_deliveryDateMin]&#xA;      ,TGT.[delivery_deliveryDateMax]&#xA;      ,TGT.[delivery_hasIntervals]&#xA;      ,TGT.[delivery_isDeliveryPriceCustom]&#xA;      ,TGT.[delivery_isEditable]&#xA;      ,TGT.[delivery_shippingMethodName]&#xA;      ,TGT.[delivery_shippingMethodCode]&#xA;      ,TGT.[delivery_serviceLevelTypeCode]&#xA;      ,TGT.[delivery_serviceLevelTypeName]&#xA;      ,TGT.[delivery_storageDays]&#xA;      ,TGT.[delivery_cutOff]&#xA;      ,TGT.[delivery_shippingMethodTypeCode]&#xA;      ,TGT.[delivery_DeliveryIntervalId]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;      SRC.[delivery_deliveryPrice]&#xA;      ,SRC.[delivery_deliveryDate]&#xA;      ,SRC.[delivery_deliveryIntervalFrom]&#xA;      ,SRC.[delivery_deliveryIntervalTo]&#xA;      ,SRC.[delivery_deliveryDateMin]&#xA;      ,SRC.[delivery_deliveryDateMax]&#xA;      ,SRC.[delivery_hasIntervals]&#xA;      ,SRC.[delivery_isDeliveryPriceCustom]&#xA;      ,SRC.[delivery_isEditable]&#xA;      ,SRC.[delivery_shippingMethodName]&#xA;      ,SRC.[delivery_shippingMethodCode]&#xA;      ,SRC.[delivery_serviceLevelTypeCode]&#xA;      ,SRC.[delivery_serviceLevelTypeName]&#xA;      ,SRC.[delivery_storageDays]&#xA;      ,SRC.[delivery_cutOff]&#xA;      ,SRC.[delivery_shippingMethodTypeCode]&#xA;      ,SRC.[delivery_DeliveryIntervalId]&#xA; ) THEN&#xA; UPDATE SET&#xA;      [delivery_deliveryPrice] = SRC.[delivery_deliveryPrice]&#xA;      ,[delivery_deliveryDate] = SRC.[delivery_deliveryDate]&#xA;      ,[delivery_deliveryIntervalFrom] = SRC.[delivery_deliveryIntervalFrom]&#xA;      ,[delivery_deliveryIntervalTo]= SRC.[delivery_deliveryIntervalTo]&#xA;      ,[delivery_deliveryDateMin]= SRC.[delivery_deliveryDateMin]&#xA;      ,[delivery_deliveryDateMax] = SRC.[delivery_deliveryDateMax]&#xA;      ,[delivery_hasIntervals] = SRC.[delivery_hasIntervals]&#xA;      ,[delivery_isDeliveryPriceCustom] = SRC.[delivery_isDeliveryPriceCustom]&#xA;      ,[delivery_isEditable] = SRC.[delivery_isEditable]&#xA;      ,[delivery_shippingMethodName] = SRC.[delivery_shippingMethodName]&#xA;      ,[delivery_shippingMethodCode] = SRC.[delivery_shippingMethodCode]&#xA;      ,[delivery_serviceLevelTypeCode] = SRC.[delivery_serviceLevelTypeCode]&#xA;      ,[delivery_serviceLevelTypeName] = SRC.[delivery_serviceLevelTypeName]&#xA;      ,[delivery_storageDays] = SRC.[delivery_storageDays]&#xA;      ,[delivery_cutOff] = SRC.[delivery_cutOff]&#xA;      ,[delivery_shippingMethodTypeCode] = SRC.[delivery_shippingMethodTypeCode]&#xA;      ,[delivery_DeliveryIntervalId] = SRC.[delivery_DeliveryIntervalId];&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
