            if (oResponse.storageDays != null && oResponse.storageDays.Length > 0) Row.storageDays = oResponse.storageDays.Length > 50 ? oResponse.storageDays.Substring(1, 50) : oResponse.storageDays;
            if (oResponse.cutOff != null) Row.cutOff = (DateTime)oResponse.cutOff;
