    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        try
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                    string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/nomenclatures?limit=1500");
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("Время ожидания операции истекло")
                        || e.Message.Contains("(500) Внутренняя ошибка сервера")
                        )
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Слишком большое количество обращений к серверу WB");

            ResponseFirst oResponseFirst = oJSS.Deserialize<ResponseFirst>(Encoding.UTF8.GetString(oDATA));
            Array.Clear(oDATA, 0, oDATA.Length);

            for (int vPage = 1; vPage <= oResponseFirst.pages; vPage++)
            {
                int j = 1;
                while (j <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                        string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/nomenclatures?limit=500&page={0}", vPage);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests")
                            || e.Message.Contains("Время ожидания операции истекло")
                            || e.Message.Contains("(500) Внутренняя ошибка сервера")
                            )
                        {
                            Thread.Sleep(20000 * j);
                            j++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (j > 6)
                    throw new ApplicationException("Слишком большое количество обращений к серверу WB");

                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));
                Array.Clear(oDATA, 0, oDATA.Length);

                if (oResponse._embedded != null && oResponse._embedded.nomenclatures != null)
                {
                    foreach(Response_Embedded_Nomenclatures item in oResponse._embedded.nomenclatures)
                    {
                        NomenclaturesBuffer.AddRow();
                        if (item.id != null) NomenclaturesBuffer.id = item.id;
                        if (item.sku != null && item.sku.Length > 0) NomenclaturesBuffer.sku = item.sku.Length > 20 ? item.sku.Substring(0,20) : item.sku;
                        if (item.supplier_sku != null && item.supplier_sku.Length > 0) NomenclaturesBuffer.suppliersku = item.supplier_sku.Length > 50 ? item.supplier_sku.Substring(0, 50) : item.supplier_sku;
                        if (item.supplier_size != null && item.supplier_size.Length > 0) NomenclaturesBuffer.suppliersize = item.supplier_size.Length > 50 ? item.supplier_size.Substring(0, 50) : item.supplier_size;
                        if (item.quantity != null) NomenclaturesBuffer.quantity = (int)item.quantity;
                        if (item.color != null && item.color.Length > 0) NomenclaturesBuffer.color = item.color.Length > 50 ? item.color.Substring(0, 50) : item.color;
                        if (item.barcode != null && item.barcode.Length > 0) NomenclaturesBuffer.barcode = item.barcode.Length > 20 ? item.barcode.Substring(0, 20) : item.barcode;
                        if (item.name != null && item.name.Length > 0) NomenclaturesBuffer.name = item.name.Length > 200 ? item.name.Substring(0, 200) : item.name;
                        if (item.category != null && item.category.Length > 0) NomenclaturesBuffer.category = item.category.Length > 200 ? item.category.Substring(0, 200) : item.category;
                        if (item.lamodaSubCategory != null && item.lamodaSubCategory.Length > 0) NomenclaturesBuffer.lamodaSubCategory = item.lamodaSubCategory.Length > 200 ? item.lamodaSubCategory.Substring(0, 200) : item.lamodaSubCategory;
                        if (item.isDMRequired != null) NomenclaturesBuffer.isDMRequired = (bool)item.isDMRequired;
                        if (item.dmNecessity != null && item.dmNecessity.Length > 0) NomenclaturesBuffer.dmNecessity = item.dmNecessity.Length > 200 ? item.dmNecessity.Substring(0, 200) : item.dmNecessity;
                        if (item.vat != null) NomenclaturesBuffer.vat = (decimal)item.vat;
                        if (item.tnVed != null && item.tnVed.Length > 0) NomenclaturesBuffer.tnVed = item.tnVed.Length > 50 ? item.tnVed.Substring(0, 50) : item.tnVed;
                        if (item._embedded != null)
                        {
                            if (item._embedded.partner.code != null && item._embedded.partner.code.Length > 0) NomenclaturesBuffer.partnercode = item._embedded.partner.code.Length > 50 ? item._embedded.partner.code.Substring(0, 50) : item._embedded.partner.code;
                            if (item._embedded.partner.shopName != null && item._embedded.partner.shopName.Length > 0) NomenclaturesBuffer.partnershopName = item._embedded.partner.shopName.Length > 100 ? item._embedded.partner.shopName.Substring(0, 100) : item._embedded.partner.shopName;
                            if (item._embedded.partner.partnerId != null) NomenclaturesBuffer.partnerpartnerId = (int)item._embedded.partner.partnerId;
                           
                            if (item._embedded.images.GetType().Name != "Object[]")
                            {
                                var oDefault = ((Dictionary<string, object>)item._embedded.images)["default"];
                                foreach (Dictionary<string, object> oImage in (Object[]) oDefault)
                                {
                                    NomenclaturesImageBuffer.AddRow();
                                    NomenclaturesImageBuffer.id = item.id;
                                    NomenclaturesImageBuffer.url = (string)oImage["url"];
                                    NomenclaturesImageBuffer.type = (string)oImage["type"];
                                    NomenclaturesImageBuffer.order = (int)oImage["order"];
                                }
                            }
                        }
                        
                    }
