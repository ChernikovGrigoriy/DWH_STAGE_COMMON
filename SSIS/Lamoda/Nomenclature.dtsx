    public string ApiKey()
    {
        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        oSqlConnection.Open();

        OleDbCommand oSqlCommand = new OleDbCommand("UPDATE [Lamoda].[Token] SET [LastRead] = GETDATE();", oSqlConnection);
        oSqlCommand.ExecuteNonQuery();

        oSqlCommand = new OleDbCommand("SELECT [access_token] FROM [Lamoda].[Token] WHERE ID = 1", oSqlConnection);

        string vApiKey =  (string) oSqlCommand.ExecuteScalar();

        oSqlConnection.Close();

        return vApiKey;
