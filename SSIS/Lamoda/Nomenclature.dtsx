    <DTS:Executable
      DTS:refId="Package\Загрузка в стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3d1d558f-4436-4605-bbad-f5199381e52d}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[Nomenclatures] WITH(TABLOCK) TGT&#xA; USING [BUFFER].[Lamoda_Nomenclatures] SRC ON (TGT.[id]  = SRC.[id])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA; SRC.[id]&#xA;    ,SRC.[sku]&#xA;    ,SRC.[supplier_sku]&#xA;    ,SRC.[supplier_size]&#xA;    ,SRC.[quantity]&#xA;    ,SRC.[color]&#xA;    ,SRC.[barcode]&#xA;    ,SRC.[name]&#xA;    ,SRC.[category]&#xA;    ,SRC.[lamodaSubCategory]&#xA;    ,SRC.[isDMRequired]&#xA;    ,SRC.[dmNecessity]&#xA;    ,SRC.[vat]&#xA;    ,SRC.[tnVed]&#xA;    ,SRC.[partner_code]&#xA;    ,SRC.[partner_shopName]&#xA;    ,SRC.[partner_partnerId]&#xA; ) &lt;&gt; CHECKSUM(&#xA; TGT.[id]&#xA;    ,TGT.[sku]&#xA;    ,TGT.[supplier_sku]&#xA;    ,TGT.[supplier_size]&#xA;    ,TGT.[quantity]&#xA;    ,TGT.[color]&#xA;    ,TGT.[barcode]&#xA;    ,TGT.[name]&#xA;    ,TGT.[category]&#xA;    ,TGT.[lamodaSubCategory]&#xA;    ,TGT.[isDMRequired]&#xA;    ,TGT.[dmNecessity]&#xA;    ,TGT.[vat]&#xA;    ,TGT.[tnVed]&#xA;    ,TGT.[partner_code]&#xA;    ,TGT.[partner_shopName]&#xA;    ,TGT.[partner_partnerId]&#xA; ) THEN&#xA;  UPDATE SET &#xA;    [sku] = SRC.[sku]&#xA;    ,[supplier_sku] = SRC.[supplier_sku]&#xA;    ,[supplier_size] = SRC.[supplier_size]&#xA;    ,[quantity] = SRC.[quantity]&#xA;    ,[color] = SRC.[color]&#xA;    ,[barcode] = SRC.[barcode]&#xA;    ,[name] = SRC.[name]&#xA;    ,[category] = SRC.[category]&#xA;    ,[lamodaSubCategory] = SRC.[lamodaSubCategory]&#xA;    ,[isDMRequired] = SRC.[isDMRequired]&#xA;    ,[dmNecessity] = SRC.[dmNecessity]&#xA;    ,[vat] = SRC.[vat]&#xA;    ,[tnVed] = SRC.[tnVed]&#xA;    ,[partner_code] = SRC.[partner_code]&#xA;    ,[partner_shopName] = SRC.[partner_shopName]&#xA;    ,[partner_partnerId] = SRC.[partner_partnerId]&#xA;    ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA; [id]&#xA;    ,[sku]&#xA;    ,[supplier_sku]&#xA;    ,[supplier_size]&#xA;    ,[quantity]&#xA;    ,[color]&#xA;    ,[barcode]&#xA;    ,[name]&#xA;    ,[category]&#xA;    ,[lamodaSubCategory]&#xA;    ,[isDMRequired]&#xA;    ,[dmNecessity]&#xA;    ,[vat]&#xA;    ,[tnVed]&#xA;    ,[partner_code]&#xA;    ,[partner_shopName]&#xA;    ,[partner_partnerId]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA; SRC.[id]&#xA;    ,SRC.[sku]&#xA;    ,SRC.[supplier_sku]&#xA;    ,SRC.[supplier_size]&#xA;    ,SRC.[quantity]&#xA;    ,SRC.[color]&#xA;    ,SRC.[barcode]&#xA;    ,SRC.[name]&#xA;    ,SRC.[category]&#xA;    ,SRC.[lamodaSubCategory]&#xA;    ,SRC.[isDMRequired]&#xA;    ,SRC.[dmNecessity]&#xA;    ,SRC.[vat]&#xA;    ,SRC.[tnVed]&#xA;    ,SRC.[partner_code]&#xA;    ,SRC.[partner_shopName]&#xA;    ,SRC.[partner_partnerId]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;  MERGE [Lamoda].[Nomenclatures_Image] TGT &#xA;  USING (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;*&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;*,&#xA;&#x9;&#x9;&#x9;&#x9;ROW_NUMBER() OVER (PARTITION BY [id], [order] ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[Lamoda_Nomenclatures_Image]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA;&#x9;) SRC ON TGT.id = SRC.id&#xA;  AND TGT.[order] = SRC.[order] &#xA;  WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;   SRC.[url]&#xA;      ,SRC.[type]&#xA; ) &lt;&gt;&#xA;  CHECKSUM&#xA; (&#xA;   TGT.[url]&#xA;      ,TGT.[type]&#xA; ) THEN&#xA; UPDATE SET &#xA;   [url] = SRC.[url]&#xA;      ,[type] = SRC.[type]&#xA;   ,SYSMOMENT = GETDATE()&#xA;   WHEN NOT MATCHED THEN&#xA; INSERT&#xA; (&#xA;  [id]&#xA;      ,[order]&#xA;      ,[url]&#xA;      ,[type]&#xA;      ,[SYSMOMENT]&#xA; )&#xA; VALUES&#xA; (&#xA;  SRC.[id]&#xA;      ,SRC.[order]&#xA;      ,SRC.[url]&#xA;      ,SRC.[type]&#xA;      ,GETDATE()&#xA; );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
