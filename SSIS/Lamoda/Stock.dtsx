      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="DECLARE @DATA date&#xA;&#xA;SET @DATA =GETDATE();&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; DELETE FROM [Lamoda].[Stock] WHERE [DATA] = @DATA&#xA;&#xA; INSERT INTO [Lamoda].[Stock] ([DATA], [sku], [quantity], [SYSMOMENT], [sku_nomenclature])&#xA; SELECT&#xA;  @DATA, S.[sku], S.[quantity], GETDATE(), NM.id&#xA; FROM&#xA;  [BUFFER].[Lamoda_Stock] S&#xA;  OUTER APPLY (&#xA;   SELECT&#xA;    TOP 1&#xA;    NM.id&#xA;   FROM&#xA;    [Lamoda].[Nomenclatures] NM&#xA;   WHERE&#xA;    S.sku = NM.supplier_sku&#xA;  ) NM&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
