    public string ApiKey()
    {
        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        oSqlConnection.Open();

        OleDbCommand oSqlCommand = new OleDbCommand("UPDATE [Lamoda].[Token] SET [LastRead] = GETDATE();", oSqlConnection);
        oSqlCommand.ExecuteNonQuery();

        oSqlCommand = new OleDbCommand("SELECT [access_token] FROM [Lamoda].[Token] WHERE ID = 1", oSqlConnection);

        string vApiKey = (string)oSqlCommand.ExecuteScalar();

        oSqlConnection.Close();

        return vApiKey;
    }
    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;


        string vFilter = string.Format("filter=updatedAt%3E%3D%3C{0:yyyyMMdd}000000,{1:yyyyMMdd}000000", Variables.pSYSMOMENT.AddDays(-90), DateTime.Now.AddDays(1));

        try
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(60000);
                    string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/orders?limit=500&{0}", vFilter);
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("Невозможно соединиться с удаленным сервером") 
                        || e.Message.Contains("(500) Внутренняя ошибка сервера")
                        || e.Message.Contains("Время ожидания операции истекло"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Метод https://api-b2b.lamoda.ru/api/v1/orders сервера Lamoda не доступен");

            ResponseFirst oResponseFirst = oJSS.Deserialize<ResponseFirst>(Encoding.UTF8.GetString(oDATA));
            Array.Clear(oDATA, 0, oDATA.Length);

            for (int vPage = 1; vPage <= oResponseFirst.pages; vPage++)
            {
                int j = 1;
                while (j <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(60000);
                        string vURL = String.Format("https://api-b2b.lamoda.ru/api/v1/orders?limit=500&page={0}&{1}", vPage, vFilter);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", ApiKey()));
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests") 
                            || e.Message.Contains("Невозможно соединиться с удаленным сервером") 
                            || e.Message.Contains("(500) Внутренняя ошибка сервера")
                            || e.Message.Contains("Время ожидания операции истекло"))
                        {
                            Thread.Sleep(20000 * j);
                            j++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (j > 6)
                    throw new ApplicationException("Метод https://api-b2b.lamoda.ru/api/v1/orders сервера Lamoda не доступен");

                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));
                Array.Clear(oDATA, 0, oDATA.Length);

                if (oResponse._embedded != null && oResponse._embedded.orders != null)
                {
                    foreach (Response_Embedded_Orders item in oResponse._embedded.orders)
                    {
                        OrderBuffer.AddRow();
                        if (item.id != null && item.id.Length > 0) OrderBuffer.id = item.id.Length > 50 ? item.id.Substring(1, 50) : item.id;
                        if (item.orderNr != null && item.orderNr.Length > 0) OrderBuffer.orderNr = item.orderNr.Length > 50 ? item.orderNr.Substring(1, 50) : item.orderNr;
                        if (item.status != null && item.status.Length > 0) OrderBuffer.status = item.status.Length > 100 ? item.orderNr.Substring(1, 100) : item.status;
                        if (item.paymentMethod != null && item.paymentMethod.Length > 0) OrderBuffer.paymentMethod = item.paymentMethod.Length > 50 ? item.paymentMethod.Substring(1, 50) : item.paymentMethod;
                        if (item.fullSum != null) OrderBuffer.fullSum = (decimal)item.fullSum;
                        if (item.deliveryPrice != null) OrderBuffer.deliveryPrice = (decimal)item.deliveryPrice;
                        if (item.createdAt != null) OrderBuffer.createdAt = (DateTime)item.createdAt;
                        if (item.updatedAt != null) OrderBuffer.updatedAt = (DateTime)item.updatedAt;
                        if (item.dates != null)
                        {
                            if (item.dates.delivered != null) OrderBuffer.datesdelivered = (DateTime)item.dates.delivered;
                            if (item.dates.shipped != null) OrderBuffer.datesshipped = (DateTime)item.dates.shipped;
                        }
                        if (item.isConfirmed != null) OrderBuffer.isConfirmed = (bool)item.isConfirmed;
                        if (item.rejectPrice != null) OrderBuffer.rejectPrice = (decimal)item.rejectPrice;
                        if (item.paymentDate != null) OrderBuffer.paymentDate = (DateTime)item.paymentDate;
                        if (item.comment != null && item.comment.Length > 0) OrderBuffer.comment = item.comment.Length > 1000 ? item.comment.Substring(1, 1000) : item.comment;
                        if (item.itemQuantity != null) OrderBuffer.itemQuantity = (int)item.itemQuantity;
                        if (item.isEditable != null) OrderBuffer.isEditable = (bool)item.isEditable;
                        if (item.currency != null && item.currency.Length > 0) OrderBuffer.currency = item.currency.Length > 20 ? item.currency.Substring(1, 20) : item.currency;
                        if (item.deprecatedId != null) OrderBuffer.deprecatedId = (long)item.deprecatedId;
                        if (item.hasDiscrepancyActs != null) OrderBuffer.hasDiscrepancyActs = (bool)item.hasDiscrepancyActs;
                        if (item._embedded.shippingAddress.id != null) OrderBuffer.shippingAddressid = (long)item._embedded.shippingAddress.id;
                    }
                }

                oResponse = null;
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "orders", e.Message, "", 0, out cancel);
        }
    }

}
