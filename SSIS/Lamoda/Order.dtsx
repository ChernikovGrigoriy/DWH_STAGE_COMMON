    #endregion

    #region шаблон
    public class ResponseFirst
    {
        public int page { get; set; }
        public int limit { get; set; }
        public int pages { get; set; }
        public int total { get; set; }
    }

    public class Response
    {
        public Response_Embedded _embedded { get; set; }
    }

    public class Response_Embedded
    {
        public Response_Embedded_Orders[] orders { get; set; }
    }

    public class Response_Embedded_Orders
    {
        public string id { get; set; }
        public string orderNr { get; set; }
        public string status { get; set; }
        public string paymentMethod { get; set; }
        public decimal? rejectPrice { get; set; }
        public decimal? deliveryPrice { get; set; }
        public DateTime? paymentDate { get; set; }
        public bool? isConfirmed { get; set; }
        public string comment { get; set; }
