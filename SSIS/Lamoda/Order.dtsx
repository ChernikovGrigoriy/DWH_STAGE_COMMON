    <DTS:Executable
      DTS:refId="Package\Загрузка в стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8b9f0bc4-f2b8-435d-83a7-a2d264c90e14}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Lamoda].[Order] TGT &#xA; USING (&#xA; SELECT&#xA;  *&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;    *,&#xA;    ROW_NUMBER() OVER (PARTITION BY ID ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM &#xA;    [BUFFER].[Lamoda_Order]&#xA;  ) TMP&#xA; WHERE&#xA;  RN = 1&#xA; ) SRC ON TGT.[id] = SRC.[id]&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;   SRC.[id]&#xA;      ,SRC.[orderNr]&#xA;      ,SRC.[status]&#xA;      ,SRC.[paymentMethod]&#xA;      ,SRC.[fullSum]&#xA;      ,SRC.[deliveryPrice]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[updatedAt]&#xA;      ,SRC.[dates_delivered]&#xA;      ,SRC.[dates_shipped]&#xA;      ,SRC.[isConfirmed]&#xA;      ,SRC.[rejectPrice]&#xA;      ,SRC.[paymentDate]&#xA;      ,SRC.[comment]&#xA;      ,SRC.[itemQuantity]&#xA;      ,SRC.[isEditable]&#xA;      ,SRC.[currency]&#xA;      ,SRC.[shippingAddress_id]&#xA;   ,SRC.[deprecatedId]&#xA;      ,SRC.[hasDiscrepancyActs]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;   TGT.[id]&#xA;      ,TGT.[orderNr]&#xA;      ,TGT.[status]&#xA;      ,TGT.[paymentMethod]&#xA;      ,TGT.[fullSum]&#xA;      ,TGT.[deliveryPrice]&#xA;      ,TGT.[createdAt]&#xA;      ,TGT.[updatedAt]&#xA;      ,TGT.[dates_delivered]&#xA;      ,TGT.[dates_shipped]&#xA;      ,TGT.[isConfirmed]&#xA;      ,TGT.[rejectPrice]&#xA;      ,TGT.[paymentDate]&#xA;      ,TGT.[comment]&#xA;      ,TGT.[itemQuantity]&#xA;      ,TGT.[isEditable]&#xA;      ,TGT.[currency]&#xA;      ,TGT.[shippingAddress_id]&#xA;   ,TGT.[deprecatedId]&#xA;      ,TGT.[hasDiscrepancyActs]&#xA; ) THEN&#xA; UPDATE SET&#xA;      [orderNr] = SRC.[orderNr]&#xA;      ,[status] = SRC.[status]&#xA;      ,[paymentMethod] =SRC.[paymentMethod]&#xA;      ,[fullSum] = SRC.[fullSum]&#xA;      ,[deliveryPrice] = SRC.[deliveryPrice]&#xA;      ,[createdAt] = SRC.[createdAt]&#xA;      ,[updatedAt] = SRC.[updatedAt]&#xA;      ,[dates_delivered] = SRC.[dates_delivered]&#xA;      ,[dates_shipped] = SRC.[dates_shipped]&#xA;      ,[isConfirmed] = SRC.[isConfirmed]&#xA;      ,[rejectPrice] = SRC.[rejectPrice]&#xA;      ,[paymentDate] = SRC.[paymentDate]&#xA;      ,[comment] = SRC.[comment]&#xA;      ,[itemQuantity] = SRC.[itemQuantity]&#xA;      ,[isEditable] = SRC.[isEditable]&#xA;      ,[currency] = SRC.[currency]&#xA;      ,[shippingAddress_id] = SRC.[shippingAddress_id]&#xA;   ,[deprecatedId] = SRC.[deprecatedId]&#xA;      ,[hasDiscrepancyActs] = SRC.[hasDiscrepancyActs]&#xA;   ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA; INSERT&#xA; (&#xA;  [id]&#xA;      ,[orderNr]&#xA;      ,[status]&#xA;      ,[paymentMethod]&#xA;      ,[fullSum]&#xA;      ,[deliveryPrice]&#xA;      ,[createdAt]&#xA;      ,[updatedAt]&#xA;      ,[dates_delivered]&#xA;      ,[dates_shipped]&#xA;      ,[isConfirmed]&#xA;      ,[rejectPrice]&#xA;      ,[paymentDate]&#xA;      ,[comment]&#xA;      ,[itemQuantity]&#xA;      ,[isEditable]&#xA;      ,[currency]&#xA;      ,[shippingAddress_id]&#xA;   ,[deprecatedId]&#xA;      ,[hasDiscrepancyActs]&#xA;   ,SYSMOMENT&#xA; )&#xA; VALUES&#xA; (&#xA;   SRC.[id]&#xA;      ,SRC.[orderNr]&#xA;      ,SRC.[status]&#xA;      ,SRC.[paymentMethod]&#xA;      ,SRC.[fullSum]&#xA;      ,SRC.[deliveryPrice]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[updatedAt]&#xA;      ,SRC.[dates_delivered]&#xA;      ,SRC.[dates_shipped]&#xA;      ,SRC.[isConfirmed]&#xA;      ,SRC.[rejectPrice]&#xA;      ,SRC.[paymentDate]&#xA;      ,SRC.[comment]&#xA;      ,SRC.[itemQuantity]&#xA;      ,SRC.[isEditable]&#xA;      ,SRC.[currency]&#xA;      ,SRC.[shippingAddress_id]&#xA;   ,SRC.[deprecatedId]&#xA;      ,SRC.[hasDiscrepancyActs]&#xA;   ,GETDATE()&#xA; );&#xA;&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Создание буферной таблиц"
