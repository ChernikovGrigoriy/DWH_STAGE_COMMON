      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D15F417-4FF8-491B-A26D-3723C75F21FF}"
          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Lamoda_Order]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Lamoda_Order]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Lamoda_Order] FROM [Lamoda].[Order]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
