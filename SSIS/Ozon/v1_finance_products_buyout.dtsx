                  SQLTask:SqlStatementSource="DECLARE @id_Account int, @data date&#xA;&#xA;SELECT @id_Account = ?, @data = ?&#xA;&#xA;DELETE FROM [Ozon].[v1_finance_products_buyout] WHERE id_Account = @id_Account AND date = @data&#xA;&#xA;INSERT INTO [Ozon].[v1_finance_products_buyout]&#xA;(&#xA;&#x9;[id_Account]&#xA;    ,[date]&#xA;    ,[amount]&#xA;    ,[buyout_price]&#xA;    ,[deduction_by_category_percent]&#xA;    ,[name]&#xA;    ,[offer_id]&#xA;    ,[posting_number]&#xA;    ,[quantity]&#xA;    ,[seller_price_per_instance]&#xA;    ,[sku]&#xA;    ,[vat_percent]&#xA;    ,[SYSMOMENT]&#xA;)&#xA;SELECT &#xA;&#x9;[id_Account]&#xA;    ,[date]&#xA;    ,[amount]&#xA;    ,[buyout_price]&#xA;    ,[deduction_by_category_percent]&#xA;    ,[name]&#xA;    ,[offer_id]&#xA;    ,[posting_number]&#xA;    ,[quantity]&#xA;    ,[seller_price_per_instance]&#xA;    ,[sku]&#xA;    ,[vat_percent]&#xA;    ,GETDATE()&#xA;FROM &#xA;&#x9;[BUFFER].[Ozon v1_finance_products_buyout]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
