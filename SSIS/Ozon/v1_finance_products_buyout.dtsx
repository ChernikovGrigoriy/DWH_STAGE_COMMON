              SQLTask:SqlStatementSource="SELECT&#xA;&#x9;distinct [date]&#xA;INTO&#xA;&#x9;#temp&#xA;FROM&#xA;&#x9;[Ozon].[v1_finance_products_buyout]&#xA;WHERE&#xA;&#x9;[id_Account] = 1&#xA;&#xA;SELECT&#xA;&#x9;TOP 50 [DATA]&#xA;FROM&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[DATA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[dbo].[fnDATA]('20250101', GETDATE(),0)&#xA;&#x9;&#x9;EXCEPT&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[date]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;#temp&#xA;&#x9;&#x9;UNION&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[DATA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[dbo].[fnDATA](DATEADD(day,-3,GETDATE()), GETDATE(),0)&#xA;&#x9;) TMP&#xA;ORDER BY&#xA;&#x9;[DATA] desc"
