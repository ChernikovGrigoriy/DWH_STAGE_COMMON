                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="&#xA;&#xA;&#x9;DECLARE @step int&#xA;&#xA;&#x9;SET @step = 1&#xA;&#xA;&#x9;WHILE @step &lt;= 2&#xA;&#x9;BEGIN&#xA;&#xA;&#x9; MERGE [Ozon].[v3_product_info_list_commissions] TGT&#xA;&#x9; USING&#xA;&#x9; (&#xA;&#x9;  SELECT &#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[npp]&#xA;&#x9;&#x9;,[delivery_amount]&#xA;&#x9;&#x9;,[percent]&#xA;&#x9;&#x9;,[return_amount]&#xA;&#x9;&#x9;,[sale_schema]&#xA;&#x9;&#x9;,[value]&#xA;&#x9;  FROM&#xA;&#x9;   [BUFFER].[Ozon_v3_product_info_list_commissions]&#xA;&#x9; ) SRC ON TGT.id_account = SRC.id_account AND TGT.[product_id] = SRC.[product_id] AND SRC.npp = TGT.npp AND TGT.[date_finish] = '22000101' &#xA;&#x9; WHEN MATCHED AND&#xA;&#x9;   TGT.[date_start] &lt; CAST(GETDATE() as date) AND&#xA;&#x9;  CHECKSUM&#xA;&#x9;  (&#xA;&#x9;&#x9;SRC.[delivery_amount]&#xA;&#x9;&#x9;,SRC.[percent]&#xA;&#x9;&#x9;,SRC.[return_amount]&#xA;&#x9;&#x9;,SRC.[sale_schema]&#xA;&#x9;&#x9;,SRC.[value]&#xA;&#x9;  ) &lt;&gt;&#xA;&#x9;  CHECKSUM&#xA;&#x9;  (&#xA;&#x9;&#x9;TGT.[delivery_amount]&#xA;&#x9;&#x9;,TGT.[percent]&#xA;&#x9;&#x9;,TGT.[return_amount]&#xA;&#x9;&#x9;,TGT.[sale_schema]&#xA;&#x9;&#x9;,TGT.[value]&#xA;&#x9;  ) THEN&#xA;&#x9;   UPDATE SET &#xA;&#x9;  [date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;&#xA;&#x9; WHEN NOT MATCHED THEN&#xA;&#x9;  INSERT &#xA;&#x9;  (&#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[npp]&#xA;&#x9;&#x9;,DATE_START&#xA;&#x9;&#x9;,DATE_FINISH&#xA;&#x9;&#x9;,[delivery_amount]&#xA;&#x9;&#x9;,[percent]&#xA;&#x9;&#x9;,[return_amount]&#xA;&#x9;&#x9;,[sale_schema]&#xA;&#x9;&#x9;,[value]&#xA;&#x9;&#x9;,[SYSMOMENT]&#xA;&#x9;  )&#xA;&#x9;  VALUES&#xA;&#x9;  (&#xA;  &#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[npp]&#xA;&#x9;&#x9;,CAST(GETDATE() as date)&#xA;&#x9;&#x9;,'22000101'&#xA;&#x9;&#x9;,SRC.[delivery_amount]&#xA;&#x9;&#x9;,SRC.[percent]&#xA;&#x9;&#x9;,SRC.[return_amount]&#xA;&#x9;&#x9;,SRC.[sale_schema]&#xA;&#x9;&#x9;,SRC.[value]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;  );&#xA;&#xA;&#x9;  SET @step = @step + 1&#xA;&#xA;&#x9;END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
