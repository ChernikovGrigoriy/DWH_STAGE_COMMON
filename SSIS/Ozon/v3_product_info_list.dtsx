            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Загрузка в стейджинг\v3_product_info_list_barcodes"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{5cd0126d-e1ef-4df1-8d39-34e80e016354}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="v3_product_info_list_barcodes"
              DTS:ThreadHint="5">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="&#x9;DECLARE @step int&#xA;&#xA;&#x9;SET @step = 1&#xA;&#xA;&#x9;WHILE @step &lt;= 2&#xA;&#x9;BEGIN&#xA;&#xA;&#x9; MERGE [Ozon].[v3_product_info_list_barcodes] TGT&#xA;&#x9; USING&#xA;&#x9; (&#xA;&#x9;  SELECT&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[npp]&#xA;&#x9;&#x9;,[barcode]&#xA;&#x9;  FROM&#xA;&#x9;   [BUFFER].[Ozon_v3_product_info_list_barcodes]&#xA;&#x9; ) SRC ON TGT.id_account = SRC.id_account AND TGT.[product_id] = SRC.[product_id] AND SRC.npp = TGT.npp AND TGT.[date_finish] = '22000101' &#xA;&#x9; WHEN MATCHED AND&#xA;&#x9;   TGT.[date_start] &lt; CAST(GETDATE() as date) AND&#xA;&#x9;  CHECKSUM&#xA;&#x9;  (&#xA;&#x9;&#x9;SRC.[barcode]&#xA;&#x9;  ) &lt;&gt;&#xA;&#x9;  CHECKSUM&#xA;&#x9;  (&#xA;&#x9;&#x9;TGT.[barcode]&#xA;&#x9;  ) THEN&#xA;&#x9;   UPDATE SET &#xA;&#x9;  [date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;&#xA;&#x9; WHEN NOT MATCHED THEN&#xA;&#x9;  INSERT &#xA;&#x9;  (&#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[npp]&#xA;&#x9;&#x9;,DATE_START&#xA;&#x9;&#x9;,DATE_FINISH&#xA;&#x9;&#x9;,[barcode]&#xA;&#x9;&#x9;,[SYSMOMENT]&#xA;&#x9;  )&#xA;&#x9;  VALUES&#xA;&#x9;  (&#xA;  &#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[npp]&#xA;&#x9;&#x9;,CAST(GETDATE() as date)&#xA;&#x9;&#x9;,'22000101'&#xA;&#x9;&#x9;,[barcode]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;  );&#xA;&#xA;&#x9;  SET @step = @step + 1&#xA;&#xA;&#x9;END&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Загрузка в стейджинг\v3_product_info_list_color_image"
