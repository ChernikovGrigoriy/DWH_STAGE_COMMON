    ,[discounted_fbo_stocks] = SRC.[discounted_fbo_stocks]&#xA;    ,[has_discounted_fbo_item] = SRC.[has_discounted_fbo_item]&#xA;    ,[is_archived] = SRC.[is_archived]&#xA;    ,[is_autoarchived] = SRC.[is_autoarchived]&#xA;    ,[is_discounted] = SRC.[is_discounted]&#xA;    ,[is_kgt] = SRC.[is_kgt]&#xA;    ,[is_prepayment_allowed] = SRC.[is_prepayment_allowed]&#xA;    ,[is_super] = SRC.[is_super]&#xA;    ,[marketing_price] = SRC.[marketing_price]&#xA;    ,[min_price] = SRC.[min_price]&#xA;    ,[name] = SRC.[name]&#xA;    ,[offer_id] = SRC.[offer_id]&#xA;    ,[old_price] = SRC.[old_price]&#xA;    ,[price] = SRC.[price]&#xA;    ,[type_id] = SRC.[type_id]&#xA;    ,[updated_at] = SRC.[updated_at]&#xA;    ,[vat] = SRC.[vat]&#xA;    ,[volume_weight] = SRC.[volume_weight]&#xA;    ,[model_info_count] = SRC.[model_info_count]&#xA;    ,[model_info_model_id] = SRC.[model_info_model_id]&#xA;    ,[price_indexes_color_index] = SRC.[price_indexes_color_index]&#xA;    ,[price_indexes_external_index_data_minimal_price] = SRC.[price_indexes_external_index_data_minimal_price]&#xA;    ,[price_indexes_external_index_data_minimal_price_currency] = SRC.[price_indexes_external_index_data_minimal_price_currency]&#xA;    ,[price_indexes_external_index_data_price_index_value] = SRC.[price_indexes_external_index_data_price_index_value]&#xA;    ,[price_indexes_ozon_index_data_minimal_price] = SRC.[price_indexes_ozon_index_data_minimal_price]&#xA;    ,[price_indexes_ozon_index_data_minimal_price_currency] = SRC.[price_indexes_ozon_index_data_minimal_price_currency]&#xA;    ,[price_indexes_ozon_index_data_data_price_index_value] = SRC.[price_indexes_ozon_index_data_data_price_index_value]&#xA;    ,[price_indexes_self_marketplaces_index_data_minimal_price] = SRC.[price_indexes_self_marketplaces_index_data_minimal_price]&#xA;    ,[price_indexes_self_marketplaces_index_data_minimal_price_currency] = SRC.[price_indexes_self_marketplaces_index_data_minimal_price_currency]&#xA;    ,[price_indexes_self_marketplaces_index_data_price_index_value] = SRC.[price_indexes_self_marketplaces_index_data_price_index_value]&#xA;    ,[statuses_is_created] = SRC.[statuses_is_created]&#xA;    ,[statuses_moderate_status] = SRC.[statuses_moderate_status]&#xA;    ,[statuses_status] = SRC.[statuses_status]&#xA;    ,[statuses_status_description] = SRC.[statuses_status_description]&#xA;    ,[statuses_status_failed] = SRC.[statuses_status_failed]&#xA;    ,[statuses_status_name] = SRC.[statuses_status_name]&#xA;    ,[statuses_status_tooltip] = SRC.[statuses_status_tooltip]&#xA;    ,[statuses_status_updated_at] = SRC.[statuses_status_updated_at]&#xA;    ,[statuses_validation_status] = SRC.[statuses_validation_status]&#xA;    ,[stocks_has_stock] = SRC.[stocks_has_stock]&#xA;    ,[visibility_details_has_price] = SRC.[visibility_details_has_price]&#xA;    ,[visibility_details_has_stock] = SRC.[visibility_details_has_stock]&#xA;    ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;&#x9; [id_Account]&#xA;    ,[product_id]&#xA;    ,[created_at]&#xA;    ,[currency_code]&#xA;    ,[description_category_id]&#xA;    ,[discounted_fbo_stocks]&#xA;    ,[has_discounted_fbo_item]&#xA;    ,[is_archived]&#xA;    ,[is_autoarchived]&#xA;    ,[is_discounted]&#xA;    ,[is_kgt]&#xA;    ,[is_prepayment_allowed]&#xA;    ,[is_super]&#xA;    ,[marketing_price]&#xA;    ,[min_price]&#xA;    ,[name]&#xA;    ,[offer_id]&#xA;    ,[old_price]&#xA;    ,[price]&#xA;    ,[type_id]&#xA;    ,[updated_at]&#xA;    ,[vat]&#xA;    ,[volume_weight]&#xA;    ,[model_info_count]&#xA;    ,[model_info_model_id]&#xA;    ,[price_indexes_color_index]&#xA;    ,[price_indexes_external_index_data_minimal_price]&#xA;    ,[price_indexes_external_index_data_minimal_price_currency]&#xA;    ,[price_indexes_external_index_data_price_index_value]&#xA;    ,[price_indexes_ozon_index_data_minimal_price]&#xA;    ,[price_indexes_ozon_index_data_minimal_price_currency]&#xA;    ,[price_indexes_ozon_index_data_data_price_index_value]&#xA;    ,[price_indexes_self_marketplaces_index_data_minimal_price]&#xA;    ,[price_indexes_self_marketplaces_index_data_minimal_price_currency]&#xA;    ,[price_indexes_self_marketplaces_index_data_price_index_value]&#xA;    ,[statuses_is_created]&#xA;    ,[statuses_moderate_status]&#xA;    ,[statuses_status]&#xA;    ,[statuses_status_description]&#xA;    ,[statuses_status_failed]&#xA;    ,[statuses_status_name]&#xA;    ,[statuses_status_tooltip]&#xA;    ,[statuses_status_updated_at]&#xA;    ,[statuses_validation_status]&#xA;    ,[stocks_has_stock]&#xA;    ,[visibility_details_has_price]&#xA;    ,[visibility_details_has_stock]&#xA;   ,SYSMOMENT&#xA; )&#xA; VALUES &#xA; (&#xA;&#x9;SRC.[id_Account]&#xA;    ,SRC.[product_id]&#xA;    ,SRC.[created_at]&#xA;    ,SRC.[currency_code]&#xA;    ,SRC.[description_category_id]&#xA;    ,SRC.[discounted_fbo_stocks]&#xA;    ,SRC.[has_discounted_fbo_item]&#xA;    ,SRC.[is_archived]&#xA;    ,SRC.[is_autoarchived]&#xA;    ,SRC.[is_discounted]&#xA;    ,SRC.[is_kgt]&#xA;    ,SRC.[is_prepayment_allowed]&#xA;    ,SRC.[is_super]&#xA;    ,SRC.[marketing_price]&#xA;    ,SRC.[min_price]&#xA;    ,SRC.[name]&#xA;    ,SRC.[offer_id]&#xA;    ,SRC.[old_price]&#xA;    ,SRC.[price]&#xA;    ,SRC.[type_id]&#xA;    ,SRC.[updated_at]&#xA;    ,SRC.[vat]&#xA;    ,SRC.[volume_weight]&#xA;    ,SRC.[model_info_count]&#xA;    ,SRC.[model_info_model_id]&#xA;    ,SRC.[price_indexes_color_index]&#xA;    ,SRC.[price_indexes_external_index_data_minimal_price]&#xA;    ,SRC.[price_indexes_external_index_data_minimal_price_currency]&#xA;    ,SRC.[price_indexes_external_index_data_price_index_value]&#xA;    ,SRC.[price_indexes_ozon_index_data_minimal_price]&#xA;    ,SRC.[price_indexes_ozon_index_data_minimal_price_currency]&#xA;    ,SRC.[price_indexes_ozon_index_data_data_price_index_value]&#xA;    ,SRC.[price_indexes_self_marketplaces_index_data_minimal_price]&#xA;    ,SRC.[price_indexes_self_marketplaces_index_data_minimal_price_currency]&#xA;    ,SRC.[price_indexes_self_marketplaces_index_data_price_index_value]&#xA;    ,SRC.[statuses_is_created]&#xA;    ,SRC.[statuses_moderate_status]&#xA;    ,SRC.[statuses_status]&#xA;    ,SRC.[statuses_status_description]&#xA;    ,SRC.[statuses_status_failed]&#xA;    ,SRC.[statuses_status_name]&#xA;    ,SRC.[statuses_status_tooltip]&#xA;    ,SRC.[statuses_status_updated_at]&#xA;    ,SRC.[statuses_validation_status]&#xA;    ,SRC.[stocks_has_stock]&#xA;    ,SRC.[visibility_details_has_price]&#xA;    ,SRC.[visibility_details_has_stock]&#xA;   ,GETDATE()&#xA; );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
