                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="MERGE [Ozon].[v3_product_info_list] TGT &#xA;USING (&#xA; SELECT&#xA;&#x9; [id_Account]&#xA;      ,[product_id]&#xA;      ,[created_at]&#xA;      ,[currency_code]&#xA;      ,[description_category_id]&#xA;      ,[discounted_fbo_stocks]&#xA;      ,[has_discounted_fbo_item]&#xA;      ,[is_archived]&#xA;      ,[is_autoarchived]&#xA;      ,[is_discounted]&#xA;      ,[is_kgt]&#xA;      ,[is_prepayment_allowed]&#xA;      ,[is_super]&#xA;      ,[marketing_price]&#xA;      ,[min_price]&#xA;      ,[name]&#xA;      ,[offer_id]&#xA;      ,[old_price]&#xA;      ,[price]&#xA;      ,[type_id]&#xA;      ,[updated_at]&#xA;      ,[vat]&#xA;      ,[volume_weight]&#xA;      ,[model_info_count]&#xA;      ,[model_info_model_id]&#xA;      ,[price_indexes_color_index]&#xA;      ,[price_indexes_external_index_data_minimal_price]&#xA;      ,[price_indexes_external_index_data_minimal_price_currency]&#xA;      ,[price_indexes_external_index_data_price_index_value]&#xA;      ,[price_indexes_ozon_index_data_minimal_price]&#xA;      ,[price_indexes_ozon_index_data_minimal_price_currency]&#xA;      ,[price_indexes_ozon_index_data_data_price_index_value]&#xA;      ,[price_indexes_self_marketplaces_index_data_minimal_price]&#xA;      ,[price_indexes_self_marketplaces_index_data_minimal_price_currency]&#xA;      ,[price_indexes_self_marketplaces_index_data_price_index_value]&#xA;      ,[statuses_is_created]&#xA;      ,[statuses_moderate_status]&#xA;      ,[statuses_status]&#xA;      ,[statuses_status_description]&#xA;      ,[statuses_status_failed]&#xA;      ,[statuses_status_name]&#xA;      ,[statuses_status_tooltip]&#xA;      ,[statuses_status_updated_at]&#xA;      ,[statuses_validation_status]&#xA;      ,[stocks_has_stock]&#xA;      ,[visibility_details_has_price]&#xA;      ,[visibility_details_has_stock]&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;&#x9; [id_Account]&#xA;      ,[product_id]&#xA;      ,[created_at]&#xA;      ,[currency_code]&#xA;      ,[descrip