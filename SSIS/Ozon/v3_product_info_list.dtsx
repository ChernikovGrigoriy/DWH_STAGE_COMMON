ed_at]&#xA;    ,SRC.[currency_code]&#xA;    ,SRC.[description_category_id]&#xA;    ,SRC.[discounted_fbo_stocks]&#xA;    ,SRC.[has_discounted_fbo_item]&#xA;    ,SRC.[is_archived]&#xA;    ,SRC.[is_autoarchived]&#xA;    ,SRC.[is_discounted]&#xA;    ,SRC.[is_kgt]&#xA;    ,SRC.[is_prepayment_allowed]&#xA;    ,SRC.[is_super]&#xA;    ,SRC.[marketing_price]&#xA;    ,SRC.[min_price]&#xA;    ,SRC.[name]&#xA;    ,SRC.[offer_id]&#xA;    ,SRC.[old_price]&#xA;    ,SRC.[price]&#xA;    ,SRC.[type_id]&#xA;    ,SRC.[updated_at]&#xA;    ,SRC.[vat]&#xA;    ,SRC.[volume_weight]&#xA;    ,SRC.[model_info_count]&#xA;    ,SRC.[model_info_model_id]&#xA;    ,SRC.[price_indexes_color_index]&#xA;    ,SRC.[price_indexes_external_index_data_minimal_price]&#xA;    ,SRC.[price_indexes_external_index_data_minimal_price_currency]&#xA;    ,SRC.[price_indexes_external_index_data_price_index_value]&#xA;    ,SRC.[price_indexes_ozon_index_data_minimal_price]&#xA;    ,SRC.[price_indexes_ozon_index_data_minimal_price_currency]&#xA;    ,SRC.[price_indexes_ozon_index_data_data_price_index_value]&#xA;    ,SRC.[price_indexes_self_marketplaces_index_data_minimal_price]&#xA;    ,SRC.[price_indexes_self_marketplaces_index_data_minimal_price_currency]&#xA;    ,SRC.[price_indexes_self_marketplaces_index_data_price_index_value]&#xA;    ,SRC.[statuses_is_created]&#xA;    ,SRC.[statuses_moderate_status]&#xA;    ,SRC.[statuses_status]&#xA;    ,SRC.[statuses_status_description]&#xA;    ,SRC.[statuses_status_failed]&#xA;    ,SRC.[statuses_status_name]&#xA;    ,SRC.[statuses_status_tooltip]&#xA;    ,SRC.[statuses_status_updated_at]&#xA;    ,SRC.[statuses_validation_status]&#xA;    ,SRC.[stocks_has_stock]&#xA;    ,SRC.[visibility_details_has_price]&#xA;    ,SRC.[visibility_details_has_stock]&#xA; ) &lt;&gt; &#xA; CHECKSUM&#xA; (&#xA;&#x9; TGT.[id_Account]&#xA;      ,TGT.[product_id]&#xA;      ,TGT.[created_at]&#xA;      ,TGT.[currency_code]&#xA;      ,TGT.[description_category_id]&#xA;      ,TGT.[discounted_fbo_stocks]&#xA;