     */
    #endregion

    #region Request
    public class Request
    {
        public long[] sku { get; set; }
    }
    #endregion

    #region Response
    public class Response
    {
        public Response_result[] result { get; set; }
    }

    public class Response_result
    {
        public long sku { get; set; }
        public long? present { get; set; }
        public long? product_id { get; set; }
        public long? reserved { get; set; }
        public long? warehouse_id { get; set; }
        public string warehouse_name { get; set; }
    }


    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        #region Список продуктов
        List<long> oProducts = new List<long>();

        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        oSqlConnection.Open();

        string vSQLScript = "SELECT DISTINCT [sku] product_id FROM [Ozon].[product] WHERE ISNULL([sku],0) <> 0";

        OleDbCommand oSqlCommand = new OleDbCommand(vSQLScript);
        oSqlCommand.CommandTimeout = 300;
        oSqlCommand.Connection = oSqlConnection;

        OleDbDataReader oReader = oSqlCommand.ExecuteReader();

        while (oReader.Read())
        {
            oProducts.Add((long)oReader[0]);
        }

        oReader.Close();

        oSqlConnection.Close();
        #endregion

        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        byte[] vDATA = null;
        List<long> oPrdIds = null;

        string vFieldError = "";

        try
        {
            while (oProducts.Count > 0)
            {
                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        oPrdIds = oProducts.Take(500).ToList();

                        Request oRequest = new Request
                        {
                             sku = oPrdIds.ToArray()
                        };


                        oProducts = oProducts.Except(oPrdIds).ToList();

                        TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                        string vURL = String.Format("https://api-seller.ozon.ru/v1/product/info/stocks-by-warehouse/fbs");
                        byte[] vDataSend = Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest));
                        oTWC.Headers.Add("Client-Id", string.Format("{0}",Variables.vClientID));
                        oTWC.Headers.Add("Api-Key", Variables.vApiKey);
                        oTWC.Headers.Add("Content-Type", "application/json");
                        vDATA = oTWC.UploadData(vURL, vDataSend);
                        oTWC = null;

                        break;
                    }
                    catch (WebException e)
                    {
                        if (e.Message.Contains("Too Many Requests"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Сервер Ozon не отвечает");

                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

                foreach (Response_result item in oResponse.result)
                {
                    OutputBuffer.AddRow();
                    OutputBuffer.sku = item.sku;
                    if (item.present != null) OutputBuffer.present = (long)item.present;
                    if (item.product_id != null) OutputBuffer.productid = (long)item.product_id;
                    if (item.reserved != null) OutputBuffer.reserved = (long)item.reserved;
                    if (item.warehouse_id != null) OutputBuffer.warehouseid = (long)item.warehouse_id;
                    if (item.warehouse_name != null) OutputBuffer.warehousename = (string)item.warehouse_name;
                }
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon Поле:{1} {0}", DateTime.Now, vFieldError), e.Message, "", 0, out cancel);
        }
    }

}
]]></arrayElement>
