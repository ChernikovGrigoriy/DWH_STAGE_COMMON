              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="DECLARE @step int&#xA;&#xA;SET @step = 1&#xA;&#xA;WHILE @step &lt;= 2&#xA;BEGIN&#xA;&#xA; MERGE [Ozon].[product_stock_by_warehouse] TGT&#xA; USING&#xA; (&#xA;  SELECT&#xA;    id_account&#xA;    ,[sku]&#xA;    ,[present]&#xA;    ,[product_id]&#xA;    ,[reserved]&#xA;    ,[warehouse_id]&#xA;    ,[warehouse_name]&#xA;  FROM&#xA;   [BUFFER].[Ozon_product_stocks_by_warehouse]&#xA; ) SRC ON TGT.id_account = SRC.id_account AND TGT.[sku] = SRC.[sku] AND TGT.[product_id] = SRC.[product_id] AND TGT.[warehouse_id] = SRC.[warehouse_id] AND TGT.[date_finish] = '22000101'&#xA; WHEN MATCHED AND&#xA;   TGT.[date_start] &lt; CAST(GETDATE() as date) AND&#xA;  CHECKSUM&#xA;  (&#xA;   SRC.[present],&#xA;   SRC.[reserved]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;   TGT.[present],&#xA;   TGT.[reserved]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;  [date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;  ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;    id_account&#xA;    ,[product_id]&#xA;    ,[sku]&#xA;    ,[warehouse_id]&#xA;    ,[DATE_START]&#xA;    ,[DATE_FINISH]&#xA;    ,[present]&#xA;    ,[reserved]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES&#xA;  (&#xA;    SRC.id_account&#xA;    ,SRC.[product_id]&#xA;    ,SRC.[sku]&#xA;    ,SRC.[warehouse_id]&#xA;    ,CAST(GETDATE() as date)&#xA;    ,'22000101'&#xA;    ,SRC.[present]&#xA;    ,SRC.[reserved]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;  SET @step = @step + 1&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Загрузка в стейджинг\warehouse"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{44fb66e1-3e1c-443d-ab59-2965e3e514af}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="warehouse"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="MERGE [Ozon].[warehouse] TGT&#xA;USING&#xA; (&#xA; SELECT&#xA;  id_account,&#xA;  [warehouse_id],&#xA;  [warehouse_name] [name]&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;       id_account,&#xA;    TMP.[warehouse_id],&#xA;    TMP.[warehouse_name],&#xA;    ROW_NUMBER() OVER (PARTITION BY TMP.[warehouse_id] ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;    (&#xA;     SELECT&#xA;      DISTINCT&#xA;      id_account,&#xA;      [warehouse_id],&#xA;      [warehouse_name]&#xA;     FROM&#xA;      [BUFFER].[Ozon_product_stocks_by_warehouse]&#xA;    ) TMP&#xA;  ) TMP&#xA; WHERE&#xA;  RN = 1&#xA; ) SRC ON TGT.id_account = SRC.id_account AND TGT.[warehouse_id] = SRC.[warehouse_id]&#xA;WHEN MATCHED AND&#xA; CHECKSUM(SRC.[name]) &lt;&gt; CHECKSUM(TGT.[name])&#xA;THEN&#xA; UPDATE SET [name] = SRC.[name]&#xA;WHEN NOT MATCHED THEN&#xA; INSERT (id_account, [warehouse_id], [Name])&#xA; VALUES (SRC.id_account, SRC.[warehouse_id], SRC.[Name]);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
