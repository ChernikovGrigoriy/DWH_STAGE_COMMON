            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\загружаемые даты\загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{F22A9EB4-5680-49BA-B75A-520C6F6385F4}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="загрузка в стейджинг"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="DECLARE @id_account int, @Data date&#xA;&#xA;SELECT TOP 1 @id_account = [id_Account], @Data = [data] FROM [BUFFER].[Ozon_v1_analytics_data]&#xA;&#xA;DELETE TGT&#xA;FROM &#xA;[Ozon].[v1_analytics_data] TGT&#xA;WHERE&#xA;TGT.id_account = @id_account&#xA;AND TGT.[Data] = @Data&#xA;&#xA;INSERT INTO [Ozon].[v1_analytics_data]&#xA;(&#xA;&#x9;[id_Account]&#xA;    ,[data]&#xA;    ,[sku]&#xA;    ,[sku_name]&#xA;    ,[revenue]&#xA;    ,[ordered_units]&#xA;    ,[hits_view_search]&#xA;    ,[hits_view_pdp]&#xA;    ,[hits_view]&#xA;    ,[hits_tocart_search]&#xA;    ,[hits_tocart_pdp]&#xA;    ,[hits_tocart]&#xA;    ,[session_view_search]&#xA;    ,[session_view_pdp]&#xA;    ,[session_view]&#xA;    ,[conv_tocart_search]&#xA;    ,[conv_tocart_pdp]&#xA;    ,[position_category]&#xA;    ,[SYSMOMENT]&#xA;)&#xA;SELECT&#xA;&#x9;[id_Account]&#xA;&#x9;,[data]&#xA;&#x9;,[sku]&#xA;&#x9;,[sku_name]&#xA;&#x9;,[revenue]&#xA;&#x9;,[ordered_units]&#xA;&#x9;,[hits_view_search]&#xA;&#x9;,[hits_view_pdp]&#xA;&#x9;,[hits_view]&#xA;&#x9;,[hits_tocart_search]&#xA;&#x9;,[hits_tocart_pdp]&#xA;&#x9;,[hits_tocart]&#xA;&#x9;,[session_view_search]&#xA;&#x9;,[session_view_pdp]&#xA;&#x9;,[session_view]&#xA;&#x9;,[conv_tocart_search]&#xA;&#x9;,[conv_tocart_pdp]&#xA;&#x9;,[position_category]&#xA;&#x9;,GETDATE()&#xA;FROM&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;&#x9;,[data]&#xA;&#x9;&#x9;&#x9;,[sku]&#xA;&#x9;&#x9;&#x9;,[sku_name]&#xA;&#x9;&#x9;&#x9;,[revenue]&#xA;&#x9;&#x9;&#x9;,[ordered_units]&#xA;&#x9;&#x9;&#x9;,[hits_view_search]&#xA;&#x9;&#x9;&#x9;,[hits_view_pdp]&#xA;&#x9;&#x9;&#x9;,[hits_view]&#xA;&#x9;&#x9;&#x9;,[hits_tocart_search]&#xA;&#x9;&#x9;&#x9;,[hits_tocart_pdp]&#xA;&#x9;&#x9;&#x9;,[hits_tocart]&#xA;&#x9;&#x9;&#x9;,[session_view_search]&#xA;&#x9;&#x9;&#x9;,[session_view_pdp]&#xA;&#x9;&#x9;&#x9;,[session_view]&#xA;&#x9;&#x9;&#x9;,[conv_tocart_search]&#xA;&#x9;&#x9;&#x9;,[conv_tocart_pdp]&#xA;&#x9;&#x9;&#x9;,[position_category]&#xA;&#x9;&#x9;&#x9;,ROW_NUMBER() OVER (PARTITION BY [id_Account], [data], [sku] ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[BUFFER].[Ozon_v1_analytics_data]&#xA;&#x9;) TMP&#xA;WHERE&#xA;&#x9;RN = 1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
