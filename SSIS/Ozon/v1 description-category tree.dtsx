              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="v1 description-category tree type"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="&#xA;&#xA; MERGE [Ozon].[v1 description-category tree type] TGT&#xA; USING [BUFFER].[Ozon v1 description-category tree type] SRC ON  TGT.[description_category_id] = SRC.[description_category_id] AND TGT.[type_id] = SRC.[type_id]&#xA; WHEN MATCHED AND&#xA;  CHECKSUM&#xA;  (&#xA;&#x9;SRC.[description_category_id]&#xA;    ,SRC.[type_id]&#xA;    ,SRC.[type_name]&#xA;    ,SRC.[disabled]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;&#x9;TGT.[description_category_id]&#xA;    ,TGT.[type_id]&#xA;    ,TGT.[type_name]&#xA;    ,TGT.[disabled]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;&#x9;[description_category_id] = SRC.[description_category_id]&#xA;    ,[type_id] = SRC.[type_id]&#xA;    ,[type_name] = SRC.[type_name]&#xA;    ,[disabled] = SRC.[disabled]&#xA;    ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;&#x9;[description_category_id]&#xA;    ,[type_id]&#xA;    ,[type_name]&#xA;    ,[disabled]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES&#xA; (&#xA;&#x9;SRC.[description_category_id]&#xA;    ,SRC.[type_id]&#xA;    ,SRC.[type_name]&#xA;    ,SRC.[disabled]&#xA;    ,GETDATE()&#xA;  );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
