              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="&#xA;&#xA; MERGE [Ozon].[v1 description-category tree] TGT&#xA; USING [BUFFER].[Ozon v1 description-category tree] SRC ON  TGT.[description_category_id] = SRC.[description_category_id] &#xA; WHEN MATCHED AND&#xA;  CHECKSUM&#xA;  (&#xA;&#x9;SRC.[description_category_id]&#xA;    ,SRC.[category_name]&#xA;    ,SRC.[disabled]&#xA;    ,SRC.[parent_id]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;&#x9;TGT.[description_category_id]&#xA;    ,TGT.[category_name]&#xA;    ,TGT.[disabled]&#xA;    ,TGT.[parent_id]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;&#x9;[description_category_id] = SRC.[description_category_id]&#xA;    ,[category_name] = SRC.[category_name]&#xA;    ,[disabled] = SRC.[disabled]&#xA;    ,[parent_id] = SRC.[parent_id]&#xA;    ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;&#x9;[description_category_id]&#xA;    ,[category_name]&#xA;    ,[disabled]&#xA;    ,[parent_id]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES&#xA; (&#xA;&#x9; SRC.[description_category_id]&#xA;    ,SRC.[category_name]&#xA;    ,SRC.[disabled]&#xA;    ,SRC.[parent_id]&#xA;    ,GETDATE()&#xA;  );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Sequence Container\v1 description-category tree type"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
