    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public void Traversing_Tree(long? description_category_id, Response_result[] children)
    {
        foreach (Response_result child in children)
        {
            if (child.children != null && child.children.Length > 0)
            {
                treeBuffer.AddRow();
                if (child.description_category_id != null) treeBuffer.descriptioncategoryid = (long)child.description_category_id;
                if (child.category_name != null && child.category_name.Length > 0) treeBuffer.categoryname = child.category_name.Length > 200 ? child.category_name.Substring(0, 200) : child.category_name;
                if (child.disabled != null) treeBuffer.disabled = (bool)child.disabled;
                if (description_category_id != null) treeBuffer.parentid = (long)description_category_id; 
            }
            else
            {
                treetypeBuffer.AddRow();
                treetypeBuffer.descriptioncategoryid = (long)description_category_id;
                if (child.type_id != null) treetypeBuffer.typeid = (long)child.type_id;
                if (child.type_name != null && child.type_name.Length > 0) treetypeBuffer.typename = child.type_name.Length > 200 ? child.type_name.Substring(0, 200) : child.type_name;
                if (child.disabled != null) treetypeBuffer.disabled = (bool)child.disabled;
            }                      

            if (child.children != null && child.children.Length > 0)
                Traversing_Tree(child.description_category_id, child.children);
        }
    }

    public override void CreateNewOutputRows()
    {
        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        string vFieldError = "";

        Request oRequest = new Request
        {
            language = "DEFAULT"
        };


        try
        {
            OzonWebClient oOWC = new OzonWebClient(30000, 6, 26000);
            byte[] vDATA = oOWC.SendRequestWithRateLimit(String.Format("https://api-seller.ozon.ru/v1/description-category/tree"), string.Format("{0}", Variables.vClientID), Variables.vApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));

            Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

            if (oResponse.result != null)
            {
                Traversing_Tree(null,  oResponse.result);
            }
            
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon Поле:{1} {0}", DateTime.Now, vFieldError), e.Message, "", 0, out cancel);
        }
    }
}


