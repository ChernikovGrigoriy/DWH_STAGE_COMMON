        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{52d677aa-d2bf-42a6-99b3-f953154979d1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в стейджинг"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
              SQLTask:SqlStatementSource="DECLARE @id_account int, @Date date&#xA;&#xA;DECLARE CUR1 CURSOR FOR&#xA;SELECT DISTINCT id_account, [Date] FROM [BUFFER].[Ozon_V3_finance_transaction]&#xA;&#xA;OPEN CUR1&#xA;&#xA;FETCH NEXT FROM CUR1 INTO @id_account, @Date&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;&#xA; BEGIN TRANSACTION;  &#xA;  &#xA; BEGIN TRY  &#xA;&#xA;  DELETE TGT&#xA;  FROM &#xA;   [Ozon].[V3_finance_transaction_services] TGT&#xA;  WHERE&#xA;   TGT.id_account = @id_account&#xA;   AND TGT.[Date] = @Date&#xA;&#xA;  DELETE TGT&#xA;  FROM &#xA;   [Ozon].[V3_finance_transaction] TGT&#xA;  WHERE&#xA;   TGT.id_account = @id_account&#xA;   AND TGT.[Date] = @Date&#xA;&#xA;  INSERT INTO [Ozon].[V3_finance_transaction_operation_type]&#xA;  (&#xA;   id_account,&#xA;   [operation_type],&#xA;   [operation_type_name],&#xA;   SYSMOMENT&#xA;  )&#xA;  SELECT&#xA;   id_account,&#xA;   [operation_type],&#xA;   [operation_type_name],&#xA;   GETDATE()&#xA;  FROM&#xA;   (&#xA;    SELECT&#xA;     DISTINCT&#xA;     id_account,&#xA;     [operation_type],&#xA;     [operation_type_name]&#xA;    FROM&#xA;     [BUFFER].[Ozon_V3_finance_transaction]&#xA;    WHERE&#xA;     @Date =[Date]&#xA;   ) TMP&#xA;  WHERE&#xA;   NOT EXISTS(SELECT TOP 1 1 FROM [Ozon].[V3_finance_transaction_operation_type] T WHERE TMP.id_account = T.id_account AND TMP.[operation_type] = T.[operation_type])&#xA;&#xA;  INSERT INTO [Ozon].[V3_finance_transaction]&#xA;  (&#xA;    [id_account]&#xA;    ,[operation_id]&#xA;    ,[Date]&#xA;    ,[accruals_for_sale]&#xA;    ,[amount]&#xA;    ,[delivery_charge]&#xA;    ,[item_name]&#xA;    ,[item_sku]&#xA;    ,[operation_date]&#xA;    ,[operation_type]&#xA;    ,[posting_delivery_schema]&#xA;    ,[posting_order_date]&#xA;    ,[posting_posting_number]&#xA;    ,[posting_warehouse_id]&#xA;    ,[return_delivery_charge]&#xA;    ,[sale_commission]&#xA;    ,[type]&#xA;    ,SYSMOMENT&#xA;  )&#xA;  SELECT&#xA;    [id_account]&#xA;    ,[operation_id]&#xA;    ,[Date]&#xA;    ,[accruals_for_sale]&#xA;    ,[amount]&#xA;    ,[delivery_charge]&#xA;    ,[item_name]&#xA;    ,[item_sku]&#xA;    ,[operation_date]&#xA;    ,[operation_type]&#xA;    ,[posting_delivery_schema]&#xA;    ,[posting_order_date]&#xA;    ,[posting_posting_number]&#xA;    ,[posting_warehouse_id]&#xA;    ,[return_delivery_charge]&#xA;    ,[sale_commission]&#xA;    ,[type]&#xA;    ,GETDATE()  &#xA;  FROM&#xA;   [BUFFER].[Ozon_V3_finance_transaction]&#xA;  WHERE&#xA;   [Date] = @Date&#xA;&#xA;  INSERT INTO [Ozon].[V3_finance_transaction_services]&#xA;  (&#xA;    [id_account]&#xA;    ,[operation_id]&#xA;    ,[Date]&#xA;    ,[name]&#xA;    ,[price]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  SELECT&#xA;    [id_account]&#xA;    ,[operation_id]&#xA;    ,[Date]&#xA;    ,[name]&#xA;    ,[price]&#xA;    ,GETDATE()&#xA;  FROM&#xA;   [BUFFER].[Ozon_V3_finance_transaction_services]&#xA;  WHERE&#xA;   [Date] = @Date&#xA;&#xA; END TRY  &#xA; BEGIN CATCH  &#xA;  DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;  DECLARE @ErrorSeverity INT;  &#xA;  DECLARE @ErrorState INT;  &#xA;  &#xA;  SELECT   &#xA;   @ErrorMessage = ERROR_MESSAGE(),  &#xA;   @ErrorSeverity = ERROR_SEVERITY(),  &#xA;   @ErrorState = ERROR_STATE();  &#xA;  &#xA;  IF @@TRANCOUNT &gt; 0  &#xA;   ROLLBACK TRANSACTION;  &#xA;&#xA;  RAISERROR (@ErrorMessage, -- Message text.  &#xA;       @ErrorSeverity, -- Severity.  &#xA;       @ErrorState -- State.  &#xA;       ); &#xA; &#xA; END CATCH;  &#xA;  &#xA; IF @@TRANCOUNT &gt; 0  &#xA;  COMMIT TRANSACTION;  &#xA;&#xA;    FETCH NEXT FROM CUR1 INTO @id_account, @Date&#xA;END&#xA;CLOSE CUR1;&#xA;DEALLOCATE CUR1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
