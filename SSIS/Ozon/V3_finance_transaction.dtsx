    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        byte[] vDATA = null;

        string vFieldError = "";

        Response oResponse = null;

        DateTime vWorkDate = Variables.pSYSMOMENT.Date;

        try
        {
            while (vWorkDate <= DateTime.Now)
            {
                Request oRequest = new Request
                {
                    filter = new Request_Filter
                    {
                        date = new Request_Filter_Date
                        {
                            from = string.Format("{0:yyyy-MM-dd}T00:00:00.000Z", vWorkDate),
                            to = string.Format("{0:yyyy-MM-dd}T23:59:59.000Z", vWorkDate)
                        },
                        transaction_type = "all"
                    },
                    page = 1,
                    page_size = 1000
                };

                do
                {
                    OzonWebClient oOWC = new OzonWebClient(80000, 6, 26000);
                    vDATA = oOWC.SendRequestWithRateLimit(String.Format("https://api-seller.ozon.ru/v3/finance/transaction/list"), string.Format("{0}", Variables.vClientID), Variables.vApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));

                    vFieldError = "Парсинг";
                    oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

                    foreach (Response_Result_Operation item in oResponse.result.Operations)
                    {
                        V3financetransactionBuffer.AddRow();
                        vFieldError = "operationid";
                        V3financetransactionBuffer.operationid = item.operation_id;
                        vFieldError = "Date";
                        V3financetransactionBuffer.Date = vWorkDate;
                        vFieldError = "accruals_for_sale";
                        if (item.accruals_for_sale != null) V3financetransactionBuffer.accrualsforsale = (decimal)item.accruals_for_sale;
                        vFieldError = "amount";
                        if (item.amount != null) V3financetransactionBuffer.amount = (decimal)item.amount;
                        vFieldError = "delivery_charge";
                        if (item.delivery_charge != null) V3financetransactionBuffer.deliverycharge = (decimal)item.delivery_charge;
                        vFieldError = "items";
                        if (item.items != null && item.items.Length > 0)
                        {
                            vFieldError = "items[0].name";
                            if (item.items[0].name != null && item.items[0].name.Length > 0) V3financetransactionBuffer.itemname = item.items[0].name.Length > 200 ? item.items[0].name.Substring(0, 200) : item.items[0].name;
                            vFieldError = "items[0].sku";
                            V3financetransactionBuffer.itemsku = item.items[0].sku;
                        }
                        vFieldError = "operation_date";
                        if (item.operation_date != null) V3financetransactionBuffer.operationdate = (DateTime)item.operation_date;
                        vFieldError = "operation_type";
                        if (item.operation_type != null && item.operation_type.Length > 0) V3financetransactionBuffer.operationtype = item.operation_type.Length > 100 ? item.operation_type.Substring(0, 100) : item.operation_type;
                        vFieldError = "operation_type_name";
                        if (item.operation_type_name != null && item.operation_type_name.Length > 0) V3financetransactionBuffer.operationtypename = item.operation_type_name.Length > 200 ? item.operation_type_name.Substring(0, 200) : item.operation_type_name;
                        vFieldError = "posting";
                        if (item.posting != null)
                        {
                            if (item.posting.delivery_schema != null && item.posting.delivery_schema.Length > 0) V3financetransactionBuffer.postingdeliveryschema = item.posting.delivery_schema.Length > 100 ? item.posting.delivery_schema.Substring(0, 100) : item.posting.delivery_schema;
                            if (item.posting.order_date != null) V3financetransactionBuffer.postingorderdate = (DateTime)item.posting.order_date;
                            if (item.posting.posting_number != null && item.posting.posting_number.Length > 0) V3financetransactionBuffer.postingpostingnumber = item.posting.posting_number.Length > 100 ? item.posting.posting_number.Substring(0, 100) : item.posting.posting_number;
                            if (item.posting.warehouse_id != null && item.posting.warehouse_id != 0) V3financetransactionBuffer.postingwarehouseid = (long)item.posting.warehouse_id;
                        }
                        vFieldError = "return_delivery_charge";
                        if (item.return_delivery_charge != null) V3financetransactionBuffer.returndeliverycharge = (decimal)item.return_delivery_charge;
                        vFieldError = "sale_commission";
                        if (item.sale_commission != null) V3financetransactionBuffer.salecommission = (decimal)item.sale_commission;
                        vFieldError = "type";
                        if (item.type != null && item.type.Length > 0) V3financetransactionBuffer.type = item.type.Length > 100 ? item.type.Substring(0, 100) : item.type;
                        vFieldError = "services";
                        if (item.services != null)
                        {
                            foreach (Response_Result_Operation_Services oService in item.services)
                            {
                                V3financetransactionservicesBuffer.AddRow();
                                V3financetransactionservicesBuffer.Date = vWorkDate;
                                V3financetransactionservicesBuffer.operationid = item.operation_id;
                                V3financetransactionservicesBuffer.name = oService.name;
                                if (oService.price != null) V3financetransactionservicesBuffer.price = (decimal)oService.price;
                            }
                        }
                    }

                    oRequest.page++;

                } while (oRequest.page <= oResponse.result.page_count);

                vWorkDate = vWorkDate.AddDays(1);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon Поле:{1} {0}", DateTime.Now, vFieldError), e.Message, "", 0, out cancel);
        }
    }

}
