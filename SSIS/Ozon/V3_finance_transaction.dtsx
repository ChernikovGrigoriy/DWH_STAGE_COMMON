     */
    #endregion

    #region Request
    public class Request
    {
        public Request_Filter filter {get;set;}
        public long page { get; set; }
        public long page_size { get; set; }
    }
    public class Request_Filter
    {
        public Request_Filter_Date date { get; set; }
        public string[] operation_type { get; set; }
        public string posting_number { get; set; }
        public string transaction_type { get; set; }
    }

    public class Request_Filter_Date
    {
        public string from { get; set; }
        public string to { get; set; }
    }
    #endregion

    #region Response
    public class Response
    {
        public Response_Result result { get; set; }
    }

    public class Response_Result
    {
        public Response_Result_Operation[] Operations { get; set; }
        public long page_count { get; set; }
        public long row_count { get; set; }
    }

    public class Response_Result_Operation
    {
        public decimal? accruals_for_sale { get; set; }
        public decimal? amount { get; set; }
        public decimal? delivery_charge { get; set; }
        public Response_Result_Operation_Item[] items { get; set; }
        public DateTime? operation_date { get; set; }
        public long operation_id { get; set; }
        public string operation_type { get; set; }
        public string operation_type_name { get; set; }
        public Response_Result_Operation_Posting posting { get; set; }
        public decimal? return_delivery_charge { get; set; }
        public decimal? sale_commission { get; set; }
        public Response_Result_Operation_Services[] services { get; set; }
        public string type { get; set; }

    }

    public class Response_Result_Operation_Item
    {
        public string name { get; set; }
        public long sku { get; set; }
    }

    public class Response_Result_Operation_Posting
    {
        public string delivery_schema { get; set; }
        public DateTime? order_date { get; set; }
        public string posting_number { get; set; }
        public long? warehouse_id { get; set; }
    }

    public class Response_Result_Operation_Services
    {
        public string name { get; set; }
        public decimal? price { get; set; }
    }
