      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8fe95fe2-0b84-42e8-bdaf-2ed71c967a37}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в стейджинг"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
              SQLTask:SqlStatementSource="&#xA;&#xA; MERGE [Ozon].[V1_report_postings] TGT&#xA; USING [BUFFER].[Ozon_V1_report_postings] SRC ON TGT.id_account = SRC.id_account&#xA; AND SRC.[OZON id] = TGT.[OZON id]&#xA; AND TGT.[delivery_schema] = SRC.[delivery_schema]&#xA; AND TGT.[Номер заказа] = SRC.[Номер заказа]&#xA; AND TGT.[Номер отправления] = SRC.[Номер отправления]&#xA; WHEN MATCHED AND&#xA;  CHECKSUM&#xA;  (&#xA;   SRC.id_account&#xA;   ,SRC.[delivery_schema]&#xA;      ,SRC.[Номер заказа]&#xA;      ,SRC.[Номер отправления]&#xA;      ,SRC.[Принят в обработку]&#xA;      ,SRC.[Дата отгрузки]&#xA;      ,SRC.[Статус]&#xA;      ,SRC.[Дата доставки]&#xA;      ,SRC.[Фактическая дата передачи в доставку]&#xA;      ,SRC.[Сумма отправления]&#xA;      ,SRC.[Код валюты отправления]&#xA;      ,SRC.[Наименование товара]&#xA;      ,SRC.[OZON id]&#xA;      ,SRC.[Артикул]&#xA;      ,SRC.[Итоговая стоимость товара]&#xA;      ,SRC.[Код валюты товара]&#xA;      ,SRC.[Стоимость товара для покупателя]&#xA;      ,SRC.[Код валюты покупателя]&#xA;      ,SRC.[Количество]&#xA;      ,SRC.[Стоимость доставки]&#xA;      ,SRC.[Связанные отправления]&#xA;      ,SRC.[Выкуп товара]&#xA;      ,SRC.[Цена товара до скидок]&#xA;      ,SRC.[Скидка %]&#xA;      ,SRC.[Скидка руб]&#xA;      ,SRC.[Акции]&#xA;      ,SRC.[объемный вес товаров, кг]&#xA;&#x9;  ,SRC.[Дата отгрузки без просрочки]&#xA;&#x9;  ,SRC.[Ваша цена]&#xA;&#x9;  ,SRC.[Дата отмены]&#xA;&#x9;  ,SRC.[Оплачено покупателем]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;   TGT.id_account&#xA;      ,TGT.[delivery_schema]&#xA;      ,TGT.[Номер заказа]&#xA;      ,TGT.[Номер отправления]&#xA;      ,TGT.[Принят в обработку]&#xA;      ,TGT.[Дата отгрузки]&#xA;      ,TGT.[Статус]&#xA;      ,TGT.[Дата доставки]&#xA;      ,TGT.[Фактическая дата передачи в доставку]&#xA;      ,TGT.[Сумма отправления]&#xA;      ,TGT.[Код валюты отправления]&#xA;      ,TGT.[Наименование товара]&#xA;      ,TGT.[OZON id]&#xA;      ,TGT.[Артикул]&#xA;      ,TGT.[Итоговая стоимость товара]&#xA;      ,TGT.[Код валюты товара]&#xA;      ,TGT.[Стоимость товара для покупателя]&#xA;      ,TGT.[Код валюты покупателя]&#xA;      ,TGT.[Количество]&#xA;      ,TGT.[Стоимость доставки]&#xA;      ,TGT.[Связанные отправления]&#xA;      ,TGT.[Выкуп товара]&#xA;      ,TGT.[Цена товара до скидок]&#xA;      ,TGT.[Скидка %]&#xA;      ,TGT.[Скидка руб]&#xA;      ,TGT.[Акции]&#xA;      ,TGT.[объемный вес товаров, кг]&#xA;&#x9;  ,TGT.[Дата отгрузки без просрочки]&#xA;&#x9;  ,TGT.[Ваша цена]&#xA;&#x9;  ,TGT.[Дата отмены]&#xA;&#x9;  ,TGT.[Оплачено покупателем]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;      id_account = SRC.id_account&#xA;   ,[delivery_schema] = SRC.[delivery_schema]&#xA;      ,[Номер заказа] = SRC.[Номер заказа]&#xA;      ,[Номер отправления] = SRC.[Номер отправления]&#xA;      ,[Принят в обработку] = SRC.[Принят в обработку]&#xA;      ,[Дата отгрузки] = SRC.[Дата отгрузки]&#xA;      ,[Статус] = SRC.[Статус]&#xA;      ,[Дата доставки] = SRC.[Дата доставки]&#xA;      ,[Фактическая дата передачи в доставку] = SRC.[Фактическая дата передачи в доставку]&#xA;      ,[Сумма отправления] = SRC.[Сумма отправления]&#xA;      ,[Код валюты отправления] = SRC.[Код валюты отправления]&#xA;      ,[Наименование товара] = SRC.[Наименование товара]&#xA;      ,[OZON id] = SRC.[OZON id]&#xA;      ,[Артикул] = SRC.[Артикул]&#xA;      ,[Итоговая стоимость товара] = SRC.[Итоговая стоимость товара]&#xA;      ,[Код валюты товара] = SRC.[Код валюты товара]&#xA;      ,[Стоимость товара для покупателя] = SRC.[Стоимость товара для покупателя]&#xA;      ,[Код валюты покупателя] = SRC.[Код валюты покупателя]&#xA;      ,[Количество] = SRC.[Количество]&#xA;      ,[Стоимость доставки] = SRC.[Стоимость доставки]&#xA;      ,[Связанные отправления] = SRC.[Связанные отправления]&#xA;      ,[Выкуп товара] = SRC.[Выкуп товара]&#xA;      ,[Цена товара до скидок] = SRC.[Цена товара до скидок]&#xA;      ,[Скидка %] = SRC.[Скидка %]&#xA;      ,[Скидка руб] = SRC.[Скидка руб]&#xA;      ,[Акции] = SRC.[Акции]&#xA;      ,[объемный вес товаров, кг] = SRC.[объемный вес товаров, кг]&#xA;&#x9;  ,[Дата отгрузки без просрочки] = SRC.[Дата отгрузки без просрочки]&#xA;&#x9;  ,[Ваша цена] = SRC.[Ваша цена]&#xA;&#x9;  ,[Дата отмены] = SRC.[Дата отмены]&#xA;&#x9;  ,[Оплачено покупателем] = SRC.[Оплачено покупателем]&#xA;      ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;   id_account&#xA;   ,[delivery_schema]&#xA;      ,[Номер заказа]&#xA;      ,[Номер отправления]&#xA;      ,[Принят в обработку]&#xA;      ,[Дата отгрузки]&#xA;      ,[Статус]&#xA;      ,[Дата доставки]&#xA;      ,[Фактическая дата передачи в доставку]&#xA;      ,[Сумма отправления]&#xA;      ,[Код валюты отправления]&#xA;      ,[Наименование товара]&#xA;      ,[OZON id]&#xA;      ,[Артикул]&#xA;      ,[Итоговая стоимость товара]&#xA;      ,[Код валюты товара]&#xA;      ,[Стоимость товара для покупателя]&#xA;      ,[Код валюты покупателя]&#xA;      ,[Количество]&#xA;      ,[Стоимость доставки]&#xA;      ,[Связанные отправления]&#xA;      ,[Выкуп товара]&#xA;      ,[Цена товара до скидок]&#xA;      ,[Скидка %]&#xA;      ,[Скидка руб]&#xA;      ,[Акции]&#xA;      ,[объемный вес товаров, кг]&#xA;      ,[SYSMOMENT]&#xA;&#x9;  ,[Дата отгрузки без просрочки]&#xA;&#x9;  ,[Ваша цена]&#xA;&#x9;  ,[Дата отмены]&#xA;&#x9;  ,[Оплачено покупателем]&#xA;  )&#xA;  VALUES&#xA; (&#xA;   SRC.id_account&#xA;   ,SRC.[delivery_schema]&#xA;      ,SRC.[Номер заказа]&#xA;      ,SRC.[Номер отправления]&#xA;      ,SRC.[Принят в обработку]&#xA;      ,SRC.[Дата отгрузки]&#xA;      ,SRC.[Статус]&#xA;      ,SRC.[Дата доставки]&#xA;      ,SRC.[Фактическая дата передачи в доставку]&#xA;      ,SRC.[Сумма отправления]&#xA;      ,SRC.[Код валюты отправления]&#xA;      ,SRC.[Наименование товара]&#xA;      ,SRC.[OZON id]&#xA;      ,SRC.[Артикул]&#xA;      ,SRC.[Итоговая стоимость товара]&#xA;      ,SRC.[Код валюты товара]&#xA;      ,SRC.[Стоимость товара для покупателя]&#xA;      ,SRC.[Код валюты покупателя]&#xA;      ,SRC.[Количество]&#xA;      ,SRC.[Стоимость доставки]&#xA;      ,SRC.[Связанные отправления]&#xA;      ,SRC.[Выкуп товара]&#xA;      ,SRC.[Цена товара до скидок]&#xA;      ,SRC.[Скидка %]&#xA;      ,SRC.[Скидка руб]&#xA;      ,SRC.[Акции]&#xA;      ,SRC.[объемный вес товаров, кг]&#xA;      ,GETDATE()&#xA;&#x9;  ,SRC.[Дата отгрузки без просрочки]&#xA;&#x9;  ,SRC.[Ваша цена]&#xA;&#x9;  ,SRC.[Дата отмены]&#xA;&#x9;  ,SRC.[Оплачено покупателем]&#xA;  );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
