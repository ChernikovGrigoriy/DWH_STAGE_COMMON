     * Visual Studio, and update the ReadOnlyVariables and ReadWriteVariables properties in the
     * Script Transformation Editor window.
     * To use a parameter in this script, follow the same steps. Parameters are always read-only.
     *
     * Example of reading from a variable or parameter:
     *  DateTime startTime = Variables.MyStartTime;
     *
     * Example of writing to a variable:
     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Request_CreateReport
    public class Request_CreateReport
    {
        public Request_CreateReport_Filter filter { get; set; }
        //public Request_CreateReport_With with { get; set; }
        public string language { get; set; }
        //public long page_size { get; set; }
    }
    public class Request_CreateReport_Filter
    {
        public string processed_at_from { get; set; }
        public string processed_at_to { get; set; }
        public string[] delivery_schema { get; set; }
        /*
        public string[] sku { get; set; }
        public string[] cancel_reason_id { get; set; }
        public string offer_id { get; set; }
        public string[] status_alias { get; set; }
        public string[] statuses { get; set; }
        public string title { get; set; }
        public int[] warehouse_id { get; set; }
        public int[] delivery_method_id { get; set; }
        public bool? is_express { get; set; }
        */
    }

    public class Request_CreateReport_With
    {
        public bool? additional_data { get; set; }
        public bool? analytics_data { get; set; }
        public bool? customer_data { get; set; }
        public bool? jewelry_codes { get; set; }
    }
    #endregion

    #region Response_CreateReport
    public class Response_CreateReport
    {
        public Response_CreateReport_Result result { get; set; }
    }

    public class Response_CreateReport_Result
    {
        public string code { get; set; }
    }
    #endregion

    #region Request_ReportInfo
    public class Request_ReportInfo
    {
        public string code { get; set; }
    }
    #endregion

    #region Response_ReportInfo
    public class Response_ReportInfo
    {
        public Response_ReportInfo_Result result { get; set; }

    }
    public class Response_ReportInfo_Result
    {
        public string code { get; set; }
        public string status { get; set; }
        public string error { get; set; }
        public string file { get; set; }
        public string report_type { get; set; }
        public DateTime created_at { get; set; }
    }
    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;
        _JSS = new JavaScriptSerializer();
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    private JavaScriptSerializer _JSS { get; set; }

    private string _ErrField { get; set; }

    #region Первый шаг
    private string Step_First(DateTime DateStart, DateTime DateFinish, string Delivery_Schema)
    {
        byte[] vDATA = null;

        int i = 1;
        while (i <= 6)
        {
            try
            {
                Request_CreateReport oRequest = new Request_CreateReport
                {
                    filter = new Request_CreateReport_Filter
                    {
                        processed_at_from = string.Format("{0:yyyy-MM-dd}T{1:HH:mm:ss.000}Z", DateStart, DateStart),
                        processed_at_to = string.Format("{0:yyyy-MM-dd}T{1:HH:mm:ss.000}Z", DateFinish, DateFinish),
                        delivery_schema = new string[] { Delivery_Schema }
                    },
                    language = "DEFAULT"
                };


                TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                string vURL = String.Format("https://api-seller.ozon.ru/v1/report/postings/create");
                byte[] vDataSend = Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest));
                oTWC.Headers.Add("Client-Id", string.Format("{0}",Variables.vClientID));
                oTWC.Headers.Add("Api-Key", Variables.vApiKey);
                vDATA = oTWC.UploadData(vURL, vDataSend);
                oTWC = null;

                break;
            }
            catch (WebException e)
            {
                if (e.Message.Contains("Невозможно соединиться с удаленным сервером"))
                {
                    Thread.Sleep(26000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Метод https://api-seller.ozon.ru/v1/report/postings/create на сервере Ozon не отвечает");

        Response_CreateReport oResponse = _JSS.Deserialize<Response_CreateReport>(Encoding.UTF8.GetString(vDATA));

        return oResponse.result.code;
    }
    #endregion

    #region Второй шаг
    public string Step_Two(string Code)
    {
        byte[] vDATA = null;

        Response_ReportInfo oResponse = null;

        int j = 1;
        do
        {
            if (j != 1) { Thread.Sleep(60000); }

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    Request_ReportInfo oRequest = new Request_ReportInfo
                    {
                        code = Code
                    };


                    TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                    string vURL = String.Format("https://api-seller.ozon.ru/v1/report/info");
                    byte[] vDataSend = Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest));
                    oTWC.Headers.Add("Client-Id", string.Format("{0}",Variables.vClientID));
                    oTWC.Headers.Add("Api-Key", Variables.vApiKey);
                    vDATA = oTWC.UploadData(vURL, vDataSend);
                    oTWC = null;

                    break;
                }
                catch (WebException e)
                {
                    if (e.Message.Contains("Невозможно соединиться с удаленным сервером"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Сервер Ozon не отвечает");

            oResponse = _JSS.Deserialize<Response_ReportInfo>(Encoding.UTF8.GetString(vDATA));

            j++;
        } while (oResponse.result.status != "success" && j < 10);

        if (j >= 10)
            throw new ApplicationException("Отчет не сформирован");

        return oResponse.result.file;
    }
    #endregion

    #region Третий шаг
    public void Step_Three(string deliveryschema, string File)
    {
        byte[] vDATA = null;

        int i = 1;
        while (i <= 6)
        {
            try
            {
                TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                string vURL = String.Format(File);
                vDATA = oTWC.DownloadData(vURL);
                oTWC = null;

                break;
            }
            catch (WebException e)
            {
                if (e.Message.Contains("Невозможно соединиться с удаленным сервером"))
                {
                    Thread.Sleep(26000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Сервер Ozon не отвечает");

        using (var oMemoryStream = new MemoryStream(vDATA, 0, vDATA.Length, true, true))
        {
            oMemoryStream.Position = 0;

            using (TextFieldParser oTFP = new TextFieldParser(oMemoryStream))
            {
                oTFP.Delimiters = new string[] { ";" };
                oTFP.HasFieldsEnclosedInQuotes = true;

                string[] vFields = oTFP.ReadFields();

                while (!oTFP.EndOfData)
                {
                    string[] vValues = oTFP.ReadFields();

                    if (vFields.Length == vValues.Length)
                    {
                        OutputBuffer.AddRow();
                        OutputBuffer.deliveryschema = deliveryschema;
                        for (int j = 0; j < vFields.Length; j++)
                        {
                            _ErrField = string.Format("Field={0}", vFields[j]);
                            switch (vFields[j])
                            {
                                case "Номер заказа":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Номерзаказа = RemoveQuotes(vValues[j]).Length > 50 ? RemoveQuotes(vValues[j]).Substring(0, 50) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Номер отправления":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Номеротправления = RemoveQuotes(vValues[j]).Length > 50 ? RemoveQuotes(vValues[j]).Substring(0, 50) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Принят в обработку":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Принятвобработку = DateTime.ParseExact(RemoveQuotes(vValues[j]), "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                                    break;

                                case "Дата отгрузки":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Датаотгрузки = DateTime.ParseExact(RemoveQuotes(vValues[j]), "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                                    break;

                                case "Дата отгрузки без просрочки":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Датаотгрузкибезпросрочки = DateTime.ParseExact(RemoveQuotes(vValues[j]), "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                                    break;

                                case "Статус":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Статус = RemoveQuotes(vValues[j]).Length > 50 ? RemoveQuotes(vValues[j]).Substring(0, 50) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Дата доставки":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Датадоставки = DateTime.ParseExact(RemoveQuotes(vValues[j]), "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                                    break;

                                case "Фактическая дата передачи в доставку":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Фактическаядатапередачивдоставку = DateTime.ParseExact(RemoveQuotes(vValues[j]), "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                                    break;

                                case "Дата отмены":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Датаотмены = DateTime.ParseExact(RemoveQuotes(vValues[j]), "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                                    break;

                                case "Сумма отправления":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Суммаотправления = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    break;

                                case "Код валюты отправления":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Кодвалютыотправления = RemoveQuotes(vValues[j]).Length > 10 ? RemoveQuotes(vValues[j]).Substring(0, 10) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Наименование товара":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Наименованиетовара = RemoveQuotes(vValues[j]).Length > 200 ? RemoveQuotes(vValues[j]).Substring(0, 200) : RemoveQuotes(vValues[j]);
                                    break;

                                case "OZON id":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.OZONid = RemoveQuotes(vValues[j]).Length > 50 ? RemoveQuotes(vValues[j]).Substring(0, 50) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Артикул":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Артикул = RemoveQuotes(vValues[j]).Length > 20 ? RemoveQuotes(vValues[j]).Substring(0, 20) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Ваша цена":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Итоговаястоимостьтовара = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Вашацена = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    break;

                                case "Код валюты товара":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Кодвалютытовара = RemoveQuotes(vValues[j]).Length > 10 ? RemoveQuotes(vValues[j]).Substring(0, 10) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Оплачено покупателем":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Стоимостьтоварадляпокупателя = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Оплаченопокупателем = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    break;

                                case "Код валюты покупателя":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Кодвалютыпокупателя = RemoveQuotes(vValues[j]).Length > 10 ? RemoveQuotes(vValues[j]).Substring(0, 10) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Количество":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Количество = int.Parse(RemoveQuotes(vValues[j]));
                                    break;

                                case "Стоимость доставки":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Стоимостьдоставки = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    break;

                                case "Связанные отправления":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Связанныеотправления = RemoveQuotes(vValues[j]).Length > 500 ? RemoveQuotes(vValues[j]).Substring(0, 500) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Выкуп товара":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Выкуптовара = RemoveQuotes(vValues[j]).Length > 500 ? RemoveQuotes(vValues[j]).Substring(0, 500) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Цена товара до скидок":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Ценатоварадоскидок = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    break;

                                case "Скидка %":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.СкидкаПроц = RemoveQuotes(vValues[j]).Length > 50 ? RemoveQuotes(vValues[j]).Substring(0, 50) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Скидка руб":
                                    try
                                    {
                                        if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Скидкаруб = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    }
                                    catch
                                    {

                                    }
                                    break;

                                case "Акции":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.Акции = RemoveQuotes(vValues[j]).Length > 500 ? RemoveQuotes(vValues[j]).Substring(0, 500) : RemoveQuotes(vValues[j]);
                                    break;

                                case "Объемный вес товаров, кг":
                                    if (RemoveQuotes(vValues[j]) != null) OutputBuffer.объемныйвестоваровкг = Decimal.Parse(RemoveQuotes(vValues[j]), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture);
                                    break;

                            }

                        }
                    }

                    i++;
                }
            }

        }
    }
    #endregion

    private string RemoveQuotes(string Field)
    {
        if (Field.Length == 0)
        {
            return null;
        }

        if ((char)Field[0] == 34 && Field[Field.Length - 1] == 34)
        {
            string vField = Field.Remove(0, 1);
            vField = vField.Remove(vField.Length - 1);

            if (vField.Length == 0)
            {
                return null;
            }

            return vField;
        }        

        return Field;
    }

    public override void CreateNewOutputRows()
    {
        string vError = "";
        string vErrorStr = "";
        string vErrField = "";

        try
        {
            DateTime vWorkDate = Variables.pSYSMOMENT;

            while (vWorkDate <= DateTime.Now)
            {
                DateTime vDateStart = vWorkDate;
                DateTime vDateFinish = vWorkDate.AddDays(30);

                if (vDateFinish > DateTime.Now)
                {
                    vDateFinish = DateTime.Now;
                }

                #region Заказы fbo
                vError = "fbo Step_First";
                string vCode = Step_First(vDateStart, vDateFinish, "fbo");

                vError = "fbo Step_Two";
                string vFile = Step_Two(vCode);

                vError = "fbo загрузка отчета";
                Step_Three("fbo", vFile);
                #endregion

                #region Заказы fbs
                vError = "fbs Step_First";
                vCode = Step_First(vDateStart, vDateFinish, "fbs");

                vError = "fbs Step_Two";
                vFile = Step_Two(vCode);

                vError = "fbs основная загрузка";
                Step_Three("fbs",vFile);
                #endregion

                vWorkDate = vWorkDate.AddDays(30);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon {0}", _ErrField), e.Message, "", 0, out cancel);
        }
    }
}
