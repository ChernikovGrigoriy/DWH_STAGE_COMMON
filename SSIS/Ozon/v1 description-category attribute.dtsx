        public string group_name { get; set; }
        public long? group_id { get; set; }
        public long? dictionary_id { get; set; }
        public bool? category_dependent { get; set; }
        public bool? complex_is_collection { get; set; }
    }

    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        byte[] vDATA = null;

        string vFieldError = "";

        Request oRequest = new Request
        {
            description_category_id = Variables.vdescriptioncategoryid,
            language = "DEFAULT",
            type_id = Variables.vtypeid
        };

        bool error_type = false;

        try
        {            

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                    string vURL = String.Format("https://api-seller.ozon.ru/v1/description-category/attribute");
                    oTWC.Headers.Add("Client-Id", string.Format("{0}",Variables.vClientID));
                    oTWC.Headers.Add("Api-Key", Variables.vApiKey);
                    vDATA = oTWC.UploadData(vURL, "POST", Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));
                    oTWC = null;

                    break;
                }
                catch (WebException e)
                {
                    if (e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("Время ожидания операции истекло"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    } 
                    else if (e.Message.Contains("(400) Недопустимый запрос") && e.Response != null)
                    {
                        using (StreamReader reader = new StreamReader(e.Response.GetResponseStream()))
                        {
                            string errorBody = reader.ReadToEnd();
                            if (errorBody.Contains("category") && errorBody.Contains("is not found"))
                            {
                                error_type = true;
                                break;
                            }
                        }
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Метод https://api-seller.ozon.ru/v1/description-category/attribut сервера Озон не отвечает");

            if (!error_type)
            {
                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

                if (oResponse.result != null)
                {
                    foreach (Response_result item in oResponse.result)
                    {
                        attributeBuffer.AddRow();
                        attributeBuffer.descriptioncategoryid = Variables.vdescriptioncategoryid;
                        attributeBuffer.typeid = Variables.vtypeid;
                        attributeBuffer.id = (long)item.id;
                        if (item.category_dependent != null) attributeBuffer.categorydependent = (bool)item.category_dependent;
                        if (item.description != null && item.description.Length > 0) attributeBuffer.description = item.description.Length > 200 ? item.description.Substring(0, 200) : item.description;
                        if (item.dictionary_id != null) attributeBuffer.dictionaryid = (long)item.dictionary_id;
                        if (item.group_id != null) attributeBuffer.groupid = (long)item.group_id;
                        if (item.group_name != null && item.group_name.Length > 0) attributeBuffer.groupname = item.group_name.Length > 200 ? item.group_name.Substring(0, 200) : item.group_name;
                        if (item.is_aspect != null) attributeBuffer.isaspect = (bool)item.is_aspect;
                        if (item.is_collection != null) attributeBuffer.iscollection = (bool)item.is_collection;
                        if (item.is_required != null) attributeBuffer.isrequired = (bool)item.is_required;
                        if (item.type != null && item.type.Length > 0) attributeBuffer.type = item.type.Length > 200 ? item.type.Substring(0, 200) : item.type;
                        if (item.name != null && item.name.Length > 0) attributeBuffer.name = item.name.Length > 200 ? item.name.Substring(0, 200) : item.name;
                        if (item.attribute_complex_id != null) attributeBuffer.attributecomplexid = (long)item.attribute_complex_id;
                        if (item.max_value_count != null) attributeBuffer.maxvaluecount = (long)item.max_value_count;
                        if (item.complex_is_collection != null) attributeBuffer.complexiscollection = (bool)item.complex_is_collection;
                    }
                }
            }
            else 
            {
                errortypeBuffer.AddRow();
                errortypeBuffer.descriptioncategoryid = Variables.vdescriptioncategoryid;
                errortypeBuffer.typeid = Variables.vtypeid;
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon Поле:{1} {0}", DateTime.Now, vFieldError), e.Message, "", 0, out cancel);
        }
    }
}


