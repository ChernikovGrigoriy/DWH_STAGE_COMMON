              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="&#xA;&#xA; MERGE [Ozon].[v1 description-category attribute] TGT&#xA; USING [BUFFER].[Ozon v1 description-category attribute] SRC ON  TGT.[description_category_id] = SRC.[description_category_id] AND TGT.[type_id] =  SRC.[type_id] AND TGT.[id] = SRC.[id]&#xA; WHEN MATCHED AND&#xA;  CHECKSUM&#xA;  (&#xA;&#x9;SRC.[description_category_id]&#xA;    ,SRC.[type_id]&#xA;    ,SRC.[id]&#xA;    ,SRC.[category_dependent]&#xA;    ,SRC.[description]&#xA;    ,SRC.[dictionary_id]&#xA;    ,SRC.[group_id]&#xA;    ,SRC.[group_name]&#xA;    ,SRC.[is_aspect]&#xA;    ,SRC.[is_collection]&#xA;    ,SRC.[is_required]&#xA;    ,SRC.[type]&#xA;    ,SRC.[name]&#xA;    ,SRC.[attribute_complex_id]&#xA;    ,SRC.[max_value_count]&#xA;    ,SRC.[complex_is_collection]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;&#x9;TGT.[description_category_id]&#xA;    ,TGT.[type_id]&#xA;    ,TGT.[id]&#xA;    ,TGT.[category_dependent]&#xA;    ,TGT.[description]&#xA;    ,TGT.[dictionary_id]&#xA;    ,TGT.[group_id]&#xA;    ,TGT.[group_name]&#xA;    ,TGT.[is_aspect]&#xA;    ,TGT.[is_collection]&#xA;    ,TGT.[is_required]&#xA;    ,TGT.[type]&#xA;    ,TGT.[name]&#xA;    ,TGT.[attribute_complex_id]&#xA;    ,TGT.[max_value_count]&#xA;    ,TGT.[complex_is_collection]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;&#x9;[description_category_id] = SRC.[description_category_id]&#xA;    ,[type_id] = SRC.[type_id]&#xA;    ,[id] = SRC.[id]&#xA;    ,[category_dependent] = SRC.[category_dependent]&#xA;    ,[description] = SRC.[description]&#xA;    ,[dictionary_id] = SRC.[dictionary_id]&#xA;    ,[group_id] = SRC.[group_id]&#xA;    ,[group_name] = SRC.[group_name]&#xA;    ,[is_aspect] = SRC.[is_aspect]&#xA;    ,[is_collection] = SRC.[is_collection]&#xA;    ,[is_required] = SRC.[is_required]&#xA;    ,[type] = SRC.[type]&#xA;    ,[name] = SRC.[name]&#xA;    ,[attribute_complex_id] = SRC.[attribute_complex_id]&#xA;    ,[max_value_count] = SRC.[max_value_count]&#xA;    ,[complex_is_collection] = SRC.[complex_is_collection]&#xA;    ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;&#x9;[description_category_id]&#xA;    ,[type_id]&#xA;    ,[id]&#xA;    ,[category_dependent]&#xA;    ,[description]&#xA;    ,[dictionary_id]&#xA;    ,[group_id]&#xA;    ,[group_name]&#xA;    ,[is_aspect]&#xA;    ,[is_collection]&#xA;    ,[is_required]&#xA;    ,[type]&#xA;    ,[name]&#xA;    ,[attribute_complex_id]&#xA;    ,[max_value_count]&#xA;    ,[complex_is_collection]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES&#xA; (&#xA;&#x9;SRC.[description_category_id]&#xA;    ,SRC.[type_id]&#xA;    ,SRC.[id]&#xA;    ,SRC.[category_dependent]&#xA;    ,SRC.[description]&#xA;    ,SRC.[dictionary_id]&#xA;    ,SRC.[group_id]&#xA;    ,SRC.[group_name]&#xA;    ,SRC.[is_aspect]&#xA;    ,SRC.[is_collection]&#xA;    ,SRC.[is_required]&#xA;    ,SRC.[type]&#xA;    ,SRC.[name]&#xA;    ,SRC.[attribute_complex_id]&#xA;    ,SRC.[max_value_count]&#xA;    ,SRC.[complex_is_collection]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;UPDATE TGT&#xA;&#x9;SET TGT.[error_type] = 1&#xA;FROM &#xA;&#x9;[Ozon].[v1 description-category tree type] TGT&#xA;&#x9;INNER JOIN [BUFFER].[Ozon v1 description-category attribute err] ERR ON TGT.[description_category_id] = ERR.[description_category_id] AND TGT.[type_id] = ERR.[type_id]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
