    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        string vErrorStr = "";
        Request oRequest = new Request
        {
            cursor = "",
            filter = new Request_Filter
            {
                visibility = "ALL"
            },
            limit = 1000
        };
        Response oResponse = null;

        try
        {
            do
            {


                vErrorStr = "Запрос к Ozon";

                OzonWebClient oOWC = new OzonWebClient(30000, 6, 26000);
                byte[] oDATA = oDATA = oOWC.SendRequestWithRateLimit(String.Format("https://api-seller.ozon.ru/v5/product/info/prices"), string.Format("{0}", Variables.vClientID), Variables.vApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));

                vErrorStr = "Парсинг";


                oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                if (oResponse.items != null)
                {
                    foreach (Response_Item oItem in oResponse.items)
                    {
                        OutputBuffer.AddRow();
                        vErrorStr = "Поле product_id";
                        OutputBuffer.productid = (int)oItem.product_id;
                        vErrorStr = "Поле acquiring";
                        if (oItem.acquiring != null) OutputBuffer.acquiring = (decimal)oItem.acquiring;
                        if (oItem.commissions != null)
                        {
                            Response_Item_Comission oComission = oItem.commissions;

                            vErrorStr = "Поле commissions_fbo_deliv_to_customer_amount";
                            if (oComission.fbo_deliv_to_customer_amount != null) OutputBuffer.commissionsfbodelivtocustomeramount = (decimal)oComission.fbo_deliv_to_customer_amount;
                            vErrorStr = "Поле commissions_fbo_direct_flow_trans_max_amount";
                            if (oComission.fbo_direct_flow_trans_max_amount != null) OutputBuffer.commissionsfbodirectflowtransmaxamount = (decimal)oComission.fbo_direct_flow_trans_max_amount;
                            vErrorStr = "Поле commissions_fbo_direct_flow_trans_min_amount";
                            if (oComission.fbo_direct_flow_trans_min_amount != null) OutputBuffer.commissionsfbodirectflowtransminamount = (decimal)oComission.fbo_direct_flow_trans_min_amount;
                            vErrorStr = "Поле commissions_fbo_return_flow_amount";
                            if (oComission.fbo_return_flow_amount != null) OutputBuffer.commissionsfboreturnflowamount = (decimal)oComission.fbo_return_flow_amount;
                            vErrorStr = "Поле commissions_fbs_deliv_to_customer_amount";
                            if (oComission.fbs_deliv_to_customer_amount != null) OutputBuffer.commissionsfbsdelivtocustomeramount = (decimal)oComission.fbs_deliv_to_customer_amount;
                            vErrorStr = "Поле commissions_fbs_direct_flow_trans_max_amount";
                            if (oComission.fbs_direct_flow_trans_max_amount != null) OutputBuffer.commissionsfbsdirectflowtransmaxamount = (decimal)oComission.fbs_direct_flow_trans_max_amount;
                            vErrorStr = "Поле commissions_fbs_direct_flow_trans_min_amount";
                            if (oComission.fbs_direct_flow_trans_min_amount != null) OutputBuffer.commissionsfbsdirectflowtransminamount = (decimal)oComission.fbs_direct_flow_trans_min_amount;
                            vErrorStr = "Поле commissions_fbs_direct_flow_trans_min_amount";
                            if (oComission.fbs_first_mile_max_amount != null) OutputBuffer.commissionsfbsfirstmilemaxamount = (decimal)oComission.fbs_first_mile_max_amount;
                            vErrorStr = "Поле commissions_fbs_first_mile_min_amount";
                            if (oComission.fbs_first_mile_min_amount != null) OutputBuffer.commissionsfbsfirstmileminamount = (decimal)oComission.fbs_first_mile_min_amount;
                            vErrorStr = "Поле commissions_fbs_return_flow_amount";
                            if (oComission.fbs_return_flow_amount != null) OutputBuffer.commissionsfbsreturnflowamount = (decimal)oComission.fbs_return_flow_amount;
                            vErrorStr = "Поле commissions_sales_percent_fbo";
                            if (oComission.sales_percent_fbo != null) OutputBuffer.commissionssalespercentfbo = (decimal)oComission.sales_percent_fbo;
                            vErrorStr = "Поле commissions_sales_percent_fbs";
                            if (oComission.sales_percent_fbs != null) OutputBuffer.commissionssalespercentfbs = (decimal)oComission.sales_percent_fbs;
                        }
                        if (oItem.price != null)
                        {
                            Response_Item_Price oPrice = oItem.price;

                            vErrorStr = "Поле price_marketing_price";
                            if (oPrice.marketing_price != null) OutputBuffer.pricemarketingprice = (decimal)oPrice.marketing_price;
                            vErrorStr = "Поле price_marketing_seller_price";
                            if (oPrice.marketing_seller_price != null) OutputBuffer.pricemarketingsellerprice = (decimal)oPrice.marketing_seller_price;
                            vErrorStr = "Поле price_min_price";
                            if (oPrice.min_price != null) OutputBuffer.priceminprice = (decimal)oPrice.min_price;
                            vErrorStr = "Поле price_net_price";
                            if (oPrice.net_price != null) OutputBuffer.pricenetprice = (decimal)oPrice.net_price;
                            vErrorStr = "Поле price_old_price";
                            if (oPrice.old_price != null) OutputBuffer.priceoldprice = (decimal)oPrice.old_price;
                            vErrorStr = "Поле price_price";
                            if (oPrice.price != null) OutputBuffer.priceprice = (decimal)oPrice.price;
                            vErrorStr = "Поле price_retail_price";
                            if (oPrice.retail_price != null) OutputBuffer.priceretailprice = (decimal)oPrice.retail_price;
                            vErrorStr = "Поле price_vat";
                            if (oPrice.vat != null) OutputBuffer.pricevat = (decimal)oPrice.vat;
                        }
                    }

                    oRequest.cursor = oResponse.cursor;
                }

            } while (oResponse.cursor != null && oResponse.cursor.Length > 0 && oResponse.items != null && oResponse.items.Length > 0);
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("v5/product/info/prices"), string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }

}
