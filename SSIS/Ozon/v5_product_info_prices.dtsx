          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
              SQLTask:SqlStatementSource="DECLARE @step int&#xA;&#xA;SET @step = 1&#xA;&#xA;WHILE @step &lt;= 2&#xA;BEGIN&#xA;&#xA;&#x9;MERGE [Ozon].[v5_product_info_prices] TGT&#xA;&#x9;USING&#xA;&#x9;(&#xA;&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;  [id_Account]&#xA;&#x9;&#x9;  ,[product_id]&#xA;&#x9;&#x9;  ,[acquiring]&#xA;&#x9;&#x9;  ,[commissions_fbo_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,[commissions_fbo_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,[commissions_fbo_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,[commissions_fbo_return_flow_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_first_mile_max_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_first_mile_min_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_return_flow_amount]&#xA;&#x9;&#x9;  ,[commissions_sales_percent_fbo]&#xA;&#x9;&#x9;  ,[commissions_sales_percent_fbs]&#xA;&#x9;&#x9;  ,[marketing_actions_current_period_from]&#xA;&#x9;&#x9;  ,[marketing_actions_current_period_to]&#xA;&#x9;&#x9;  ,[marketing_actions_ozon_actions_exist]&#xA;&#x9;&#x9;  ,[offer_id]&#xA;&#x9;&#x9;  ,[auto_action_enabled]&#xA;&#x9;&#x9;  ,[auto_add_to_ozon_actions_list_enabled]&#xA;&#x9;&#x9;  ,[currency_code]&#xA;&#x9;&#x9;  ,[price_marketing_price]&#xA;&#x9;&#x9;  ,[price_marketing_seller_price]&#xA;&#x9;&#x9;  ,[price_min_price]&#xA;&#x9;&#x9;  ,[price_net_price]&#xA;&#x9;&#x9;  ,[price_old_price]&#xA;&#x9;&#x9;  ,[price_price]&#xA;&#x9;&#x9;  ,[price_retail_price]&#xA;&#x9;&#x9;  ,[price_vat]&#xA;&#x9;&#x9;  ,[color_index]&#xA;&#x9;&#x9;  ,[external_index_data_min_price]&#xA;&#x9;&#x9;  ,[external_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,[external_index_data_price_index_value]&#xA;&#x9;&#x9;  ,[external_index_data_min_price2]&#xA;&#x9;&#x9;  ,[ozon_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,[ozon_index_data_price_index_value]&#xA;&#x9;&#x9;  ,[external_index_data_min_price3]&#xA;&#x9;&#x9;  ,[self_marketplaces_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,[self_marketplaces_index_data_price_index_value]&#xA;&#x9;&#x9;  ,[volume_weight]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;  [BUFFER].[Ozon_v5_product_info_prices]&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;) SRC ON TGT.id_account = SRC.id_account AND TGT.[product_id] = SRC.[product_id] AND TGT.[date_finish] = '22000101'&#xA;&#x9;WHEN MATCHED &#xA;&#x9;&#x9;AND TGT.[date_start] &lt; CAST(GETDATE() as date) &#xA;&#x9;&#x9;AND&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  SRC.[id_Account]&#xA;&#x9;&#x9;  ,SRC.[product_id]&#xA;&#x9;&#x9;  ,SRC.[acquiring]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbo_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbo_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbo_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbo_return_flow_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbs_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbs_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbs_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbs_first_mile_max_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbs_first_mile_min_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_fbs_return_flow_amount]&#xA;&#x9;&#x9;  ,SRC.[commissions_sales_percent_fbo]&#xA;&#x9;&#x9;  ,SRC.[commissions_sales_percent_fbs]&#xA;&#x9;&#x9;  ,SRC.[marketing_actions_current_period_from]&#xA;&#x9;&#x9;  ,SRC.[marketing_actions_current_period_to]&#xA;&#x9;&#x9;  ,SRC.[marketing_actions_ozon_actions_exist]&#xA;&#x9;&#x9;  ,SRC.[offer_id]&#xA;&#x9;&#x9;  ,SRC.[auto_action_enabled]&#xA;&#x9;&#x9;  ,SRC.[auto_add_to_ozon_actions_list_enabled]&#xA;&#x9;&#x9;  ,SRC.[currency_code]&#xA;&#x9;&#x9;  ,SRC.[price_marketing_price]&#xA;&#x9;&#x9;  ,SRC.[price_marketing_seller_price]&#xA;&#x9;&#x9;  ,SRC.[price_min_price]&#xA;&#x9;&#x9;  ,SRC.[price_net_price]&#xA;&#x9;&#x9;  ,SRC.[price_old_price]&#xA;&#x9;&#x9;  ,SRC.[price_price]&#xA;&#x9;&#x9;  ,SRC.[price_retail_price]&#xA;&#x9;&#x9;  ,SRC.[price_vat]&#xA;&#x9;&#x9;  ,SRC.[color_index]&#xA;&#x9;&#x9;  ,SRC.[external_index_data_min_price]&#xA;&#x9;&#x9;  ,SRC.[external_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,SRC.[external_index_data_price_index_value]&#xA;&#x9;&#x9;  ,SRC.[external_index_data_min_price2]&#xA;&#x9;&#x9;  ,SRC.[ozon_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,SRC.[ozon_index_data_price_index_value]&#xA;&#x9;&#x9;  ,SRC.[external_index_data_min_price3]&#xA;&#x9;&#x9;  ,SRC.[self_marketplaces_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,SRC.[self_marketplaces_index_data_price_index_value]&#xA;&#x9;&#x9;  ,SRC.[volume_weight]&#xA;&#x9;&#x9;) &lt;&gt;&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  TGT.[id_Account]&#xA;&#x9;&#x9;  ,TGT.[product_id]&#xA;&#x9;&#x9;  ,TGT.[acquiring]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbo_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbo_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbo_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbo_return_flow_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbs_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbs_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbs_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbs_first_mile_max_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbs_first_mile_min_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_fbs_return_flow_amount]&#xA;&#x9;&#x9;  ,TGT.[commissions_sales_percent_fbo]&#xA;&#x9;&#x9;  ,TGT.[commissions_sales_percent_fbs]&#xA;&#x9;&#x9;  ,TGT.[marketing_actions_current_period_from]&#xA;&#x9;&#x9;  ,TGT.[marketing_actions_current_period_to]&#xA;&#x9;&#x9;  ,TGT.[marketing_actions_ozon_actions_exist]&#xA;&#x9;&#x9;  ,TGT.[offer_id]&#xA;&#x9;&#x9;  ,TGT.[auto_action_enabled]&#xA;&#x9;&#x9;  ,TGT.[auto_add_to_ozon_actions_list_enabled]&#xA;&#x9;&#x9;  ,TGT.[currency_code]&#xA;&#x9;&#x9;  ,TGT.[price_marketing_price]&#xA;&#x9;&#x9;  ,TGT.[price_marketing_seller_price]&#xA;&#x9;&#x9;  ,TGT.[price_min_price]&#xA;&#x9;&#x9;  ,TGT.[price_net_price]&#xA;&#x9;&#x9;  ,TGT.[price_old_price]&#xA;&#x9;&#x9;  ,TGT.[price_price]&#xA;&#x9;&#x9;  ,TGT.[price_retail_price]&#xA;&#x9;&#x9;  ,TGT.[price_vat]&#xA;&#x9;&#x9;  ,TGT.[color_index]&#xA;&#x9;&#x9;  ,TGT.[external_index_data_min_price]&#xA;&#x9;&#x9;  ,TGT.[external_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,TGT.[external_index_data_price_index_value]&#xA;&#x9;&#x9;  ,TGT.[external_index_data_min_price2]&#xA;&#x9;&#x9;  ,TGT.[ozon_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,TGT.[ozon_index_data_price_index_value]&#xA;&#x9;&#x9;  ,TGT.[external_index_data_min_price3]&#xA;&#x9;&#x9;  ,TGT.[self_marketplaces_index_data_min_price_currency]&#xA;&#x9;&#x9;  ,TGT.[self_marketplaces_index_data_price_index_value]&#xA;&#x9;&#x9;  ,TGT.[volume_weight]&#xA;&#x9;&#x9;) THEN&#xA;&#x9;  UPDATE SET &#xA;&#x9;&#x9;[date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;&#xA;&#x9;WHEN NOT MATCHED THEN&#xA;&#x9;&#x9;INSERT &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  [id_Account]&#xA;&#x9;&#x9;  ,[product_id]&#xA;&#x9;&#x9;  ,[DATE_START]&#xA;&#x9;&#x9;  ,[DATE_FINISH]&#xA;&#x9;&#x9;  ,[acquiring]&#xA;&#x9;&#x9;  ,[commissions_fbo_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,[commissions_fbo_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,[commissions_fbo_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,[commissions_fbo_return_flow_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_deliv_to_customer_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_direct_flow_trans_max_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_direct_flow_trans_min_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_first_mile_max_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_first_mile_min_amount]&#xA;&#x9;&#x9;  ,[commissions_fbs_return_flow_amount]&#xA;&#x9;&#x9;  ,[commissions_sales_percent_fbo]&#xA;&#x9;&#x9;  ,[commissions_sales_percent_fbs]&#xA;&#x9;&#x9;  ,[marketing_actions_current_p