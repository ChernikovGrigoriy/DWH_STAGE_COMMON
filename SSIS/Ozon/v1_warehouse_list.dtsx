            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Warehouse\загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{c122ea88-cd60-4e04-b01a-a6b830831f22}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="загрузка в стейджинг"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="&#xA;&#xA; MERGE [Ozon].[warehouse] TGT&#xA; USING&#xA; (&#xA;  SELECT&#xA;   id_account&#xA;   ,[warehouse_id]&#xA;      ,[Name]&#xA;      ,[has_entrusted_acceptance]&#xA;      ,[is_rfbs]&#xA;      ,[can_print_act_in_advance]&#xA;      ,[first_mile_type_dropoff_timeslot_id]&#xA;      ,[first_mile_type_first_mile_is_changing]&#xA;      ,[first_mile_type_dropoff_point_id]&#xA;      ,[first_mile_type_first_mile_type]&#xA;      ,[has_postings_limit]&#xA;      ,[is_karantin]&#xA;      ,[is_kgt]&#xA;      ,[is_timetable_editable]&#xA;      ,[min_postings_limit]&#xA;      ,[postings_limit]&#xA;      ,[min_working_days]&#xA;      ,[status]&#xA;      ,[working_days]   &#xA;  FROM&#xA;   [BUFFER].[Ozon_warehouse1]&#xA; ) SRC ON TGT.id_account = SRC.id_account AND  TGT.[warehouse_id] = SRC.[warehouse_id]&#xA; WHEN MATCHED AND&#xA;  CHECKSUM&#xA;  (&#xA;   SRC.id_account&#xA;   ,SRC.[warehouse_id]&#xA;      ,SRC.[Name]&#xA;      ,SRC.[has_entrusted_acceptance]&#xA;      ,SRC.[is_rfbs]&#xA;      ,SRC.[can_print_act_in_advance]&#xA;      ,SRC.[first_mile_type_dropoff_timeslot_id]&#xA;      ,SRC.[first_mile_type_first_mile_is_changing]&#xA;      ,SRC.[first_mile_type_dropoff_point_id]&#xA;      ,SRC.[first_mile_type_first_mile_type]&#xA;      ,SRC.[has_postings_limit]&#xA;      ,SRC.[is_karantin]&#xA;      ,SRC.[is_kgt]&#xA;      ,SRC.[is_timetable_editable]&#xA;      ,SRC.[min_postings_limit]&#xA;      ,SRC.[postings_limit]&#xA;      ,SRC.[min_working_days]&#xA;      ,SRC.[status]&#xA;      ,SRC.[working_days]&#xA;  ) &lt;&gt;&#xA;  CHECKSUM&#xA;  (&#xA;   TGT.id_account&#xA;   ,TGT.[warehouse_id]&#xA;      ,TGT.[Name]&#xA;      ,TGT.[has_entrusted_acceptance]&#xA;      ,TGT.[is_rfbs]&#xA;      ,TGT.[can_print_act_in_advance]&#xA;      ,TGT.[first_mile_type_dropoff_timeslot_id]&#xA;      ,TGT.[first_mile_type_first_mile_is_changing]&#xA;      ,TGT.[first_mile_type_dropoff_point_id]&#xA;      ,TGT.[first_mile_type_first_mile_type]&#xA;      ,TGT.[has_postings_limit]&#xA;      ,TGT.[is_karantin]&#xA;      ,TGT.[is_kgt]&#xA;      ,TGT.[is_timetable_editable]&#xA;      ,TGT.[min_postings_limit]&#xA;      ,TGT.[postings_limit]&#xA;      ,TGT.[min_working_days]&#xA;      ,TGT.[status]&#xA;      ,TGT.[working_days]&#xA;  ) THEN&#xA;   UPDATE SET &#xA;   id_account = SRC.id_account&#xA;   ,[warehouse_id] = SRC.[warehouse_id]&#xA;      ,[Name] = SRC.[Name]&#xA;      ,[has_entrusted_acceptance] = SRC.[has_entrusted_acceptance]&#xA;      ,[is_rfbs] = SRC.[is_rfbs]&#xA;      ,[can_print_act_in_advance] = SRC.[can_print_act_in_advance]&#xA;      ,[first_mile_type_dropoff_timeslot_id] = SRC.[first_mile_type_dropoff_timeslot_id]&#xA;      ,[first_mile_type_first_mile_is_changing] = SRC.[first_mile_type_first_mile_is_changing]&#xA;      ,[first_mile_type_dropoff_point_id] = SRC.[first_mile_type_dropoff_point_id]&#xA;      ,[first_mile_type_first_mile_type] = SRC.[first_mile_type_first_mile_type]&#xA;      ,[has_postings_limit] = SRC.[has_postings_limit]&#xA;      ,[is_karantin] = SRC.[is_karantin]&#xA;      ,[is_kgt] = SRC.[is_kgt]&#xA;      ,[is_timetable_editable] = SRC.[is_timetable_editable]&#xA;      ,[min_postings_limit] = SRC.[min_postings_limit]&#xA;      ,[postings_limit] = SRC.[postings_limit]&#xA;      ,[min_working_days] = SRC.[min_working_days]&#xA;      ,[status] = SRC.[status]&#xA;      ,[working_days] = SRC.[working_days]&#xA;   ,SYSMOMENT = GETDATE()&#xA;&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT &#xA;  (&#xA;   [id_account]&#xA;   ,[warehouse_id]&#xA;      ,[Name]&#xA;      ,[has_entrusted_acceptance]&#xA;      ,[is_rfbs]&#xA;      ,[can_print_act_in_advance]&#xA;      ,[first_mile_type_dropoff_timeslot_id]&#xA;      ,[first_mile_type_first_mile_is_changing]&#xA;      ,[first_mile_type_dropoff_point_id]&#xA;      ,[first_mile_type_first_mile_type]&#xA;      ,[has_postings_limit]&#xA;      ,[is_karantin]&#xA;      ,[is_kgt]&#xA;      ,[is_timetable_editable]&#xA;      ,[min_postings_limit]&#xA;      ,[postings_limit]&#xA;      ,[min_working_days]&#xA;      ,[status]&#xA;      ,[working_days]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES&#xA; (&#xA;   SRC.id_account&#xA;   ,SRC.[warehouse_id]&#xA;      ,SRC.[Name]&#xA;      ,SRC.[has_entrusted_acceptance]&#xA;      ,SRC.[is_rfbs]&#xA;      ,SRC.[can_print_act_in_advance]&#xA;      ,SRC.[first_mile_type_dropoff_timeslot_id]&#xA;      ,SRC.[first_mile_type_first_mile_is_changing]&#xA;      ,SRC.[first_mile_type_dropoff_point_id]&#xA;      ,SRC.[first_mile_type_first_mile_type]&#xA;      ,SRC.[has_postings_limit]&#xA;      ,SRC.[is_karantin]&#xA;      ,SRC.[is_kgt]&#xA;      ,SRC.[is_timetable_editable]&#xA;      ,SRC.[min_postings_limit]&#xA;      ,SRC.[postings_limit]&#xA;      ,SRC.[min_working_days]&#xA;      ,SRC.[status]&#xA;      ,SRC.[working_days]&#xA;      ,GETDATE()&#xA;  );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
