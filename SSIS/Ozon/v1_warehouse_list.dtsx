                if (oItem.is_kgt != null) OutputBuffer.iskgt = (bool)oItem.is_kgt;
                if (oItem.is_timetable_editable != null) OutputBuffer.istimetableeditable = (bool)oItem.is_timetable_editable;
                if (oItem.min_postings_limit != null) OutputBuffer.minpostingslimit = (int)oItem.min_postings_limit;
