                          dataType="System.String"><![CDATA[#region Help:  Introduction to the Script Component
/* The Script Component allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services data flow.
 *
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script component. */
#endregion

#region Namespaces
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Linq;
using System.Net;
using System.Security.Policy;
using System.Text;
using System.Threading;
using System.Web.Script.Serialization;
using static ScriptMain;
using DWH_STAGE_COMMON;
#endregion

/// <summary>
/// This is the class to which to add your code.  Do not change the name, attributes, or parent
/// of this class.
/// </summary>
[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    #region Help:  Using Integration Services variables and parameters
    /* To use a variable in this script, first ensure that the variable has been added to
     * either the list contained in the ReadOnlyVariables property or the list contained in
     * the ReadWriteVariables property of this script component, according to whether or not your
     * code needs to write into the variable.  To do so, save this script, close this instance of
     * Visual Studio, and update the ReadOnlyVariables and ReadWriteVariables properties in the
     * Script Transformation Editor window.
     * To use a parameter in this script, follow the same steps. Parameters are always read-only.
     *
     * Example of reading from a variable or parameter:
     *  DateTime startTime = Variables.MyStartTime;
     *
     * Example of writing to a variable:
     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Request
    public class Request
    {
        public Request_Filter filter { get; set; }
        public int limit { get; set; }
        public string sort_dir { get; set; }
    }
    public class Request_Filter
    {
        public string[] offer_id { get; set; }
        public long[] product_id { get; set; }
        public long[] sku { get; set; }
        public string visibility { get; set; }
    }
    #endregion

    #region Response
    public class Response
    {
        public Response_Result[] result { get; set; }
        public int total { get; set; }
        public string last_id { get; set; }
    }

    public class Response_Result
    {
        public long id { get; set; }
        public string barcode { get; set; }
        /*"barcodes": [
        "123124123",
        "123342455"
        ],*/
        public string name { get; set; }
        public string offer_id { get; set; }
        public long? type_id { get; set; }
        public int? height { get; set; }
        public int? depth { get; set; }
        public int? width { get; set; }
        public string dimension_unit { get; set; }
        public int? weight { get; set; }
        public string weight_unit { get; set; }
        public string primary_image { get; set; }
        public long? sku { get; set; } 
        //"model_info": {},
        //"images": [],
        //"pdf_list": [ ],
        //"attributes": [],
        //"complex_attributes": [ ],
        public string color_image { get; set; }
        public long? description_category_id { get; set; }
    }
    #endregion


    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;
    }

    JavaScriptSerializer oJSS;

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    private void LoadBlock(Request Request, int STEP)
    {
        byte[] vDATA = null;

        OzonWebClient oOWC = new OzonWebClient(30000, 6, 26000);
        vDATA = oOWC.SendRequestWithRateLimit(String.Format("https://api-seller.ozon.ru/v4/product/info/attributes"), string.Format("{0}", Variables.vClientID), Variables.vApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(Request)));

        Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));


        foreach (Response_Result item in oResponse.result)
        {
            v4productinfoattributesBuffer.AddRow();
            v4productinfoattributesBuffer.STEP = STEP;
            v4productinfoattributesBuffer.productid = item.id;
            if (item.barcode != null && item.barcode.Length > 0) v4productinfoattributesBuffer.barcode = item.barcode.Length > 200 ? item.barcode.Substring(0, 100) : item.barcode;
            if (item.name != null && item.name.Length > 0) v4productinfoattributesBuffer.name = item.name.Length > 200 ? item.name.Substring(0, 100) : item.name;
            if (item.offer_id != null && item.offer_id.Length > 0) v4productinfoattributesBuffer.offerid = item.offer_id.Length > 200 ? item.offer_id.Substring(0, 100) : item.offer_id;
            if (item.type_id != null) v4productinfoattributesBuffer.typeid = (int)item.type_id;
            if (item.height != null) v4productinfoattributesBuffer.height = (int)item.height;
            if (item.depth != null) v4productinfoattributesBuffer.depth = (int)item.depth;
            if (item.width != null) v4productinfoattributesBuffer.width = (int)item.width;
            if (item.dimension_unit != null && item.dimension_unit.Length > 0) v4productinfoattributesBuffer.dimensionunit = item.dimension_unit.Length > 200 ? item.dimension_unit.Substring(0, 100) : item.dimension_unit;
            if (item.weight != null) v4productinfoattributesBuffer.weight = (int)item.weight;
            if (item.weight_unit != null && item.weight_unit.Length > 0) v4productinfoattributesBuffer.weightunit = item.weight_unit.Length > 200 ? item.weight_unit.Substring(0, 100) : item.weight_unit;
            if (item.primary_image != null && item.primary_image.Length > 0) v4productinfoattributesBuffer.primaryimage = item.primary_image.Length > 200 ? item.primary_image.Substring(0, 100) : item.primary_image;
            if (item.sku != null) v4productinfoattributesBuffer.sku = (long)item.sku;
            if (item.color_image != null && item.color_image.Length > 0) v4productinfoattributesBuffer.colorimage = item.color_image.Length > 200 ? item.color_image.Substring(0, 100) : item.color_image;
            if (item.description_category_id != null) v4productinfoattributesBuffer.descriptioncategoryid = (int)item.description_category_id;
        }
    }

    public override void CreateNewOutputRows()
    {
        #region Список продуктов
        List<long> oProducts = new List<long>();

        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGE.ConnectionString);
        oSqlConnection.Open();

        string vSQLScript = string.Format("SELECT product_id FROM Ozon.v3_product_list WHERE id_account = {0}",Variables.vIDAccount);

        OleDbCommand oSqlCommand = new OleDbCommand(vSQLScript);
        oSqlCommand.CommandTimeout = 300;
        oSqlCommand.Connection = oSqlConnection;

        OleDbDataReader oReader = oSqlCommand.ExecuteReader();

        while (oReader.Read())
        {
            oProducts.Add( (long)oReader[0] );
        }

        oReader.Close();

        oSqlConnection.Close();
        #endregion

        #region Список SKU
        List<long> oSKUs = new List<long>();

        oSqlConnection = new OleDbConnection(Connections.DWHSTAGE.ConnectionString);
        oSqlConnection.Open();

        vSQLScript = string.Format(
            "SELECT DISTINCT [OZON id] FROM [Ozon].[V1_report_postings] WHERE id_account = {0} AND [OZON id] is not null\r\n" +
            "UNION\r\n" +
            "SELECT DISTINCT sku FROM [Ozon].[V2_analytics_stock_on_warehouses] WHERE id_account = {0} AND sku is not null\r\n" +
            "UNION\r\n" +
            "SELECT DISTINCT [item_sku] FROM [Ozon].[V3_finance_transaction] WHERE id_account = {0} AND [item_sku] is not null",
            Variables.vIDAccount);

        oSqlCommand = new OleDbCommand(vSQLScript);
        oSqlCommand.CommandTimeout = 300;
        oSqlCommand.Connection = oSqlConnection;

        oReader = oSqlCommand.ExecuteReader();

        while (oReader.Read())
        {
            oSKUs.Add((long)oReader[0]);
        }

        oReader.Close();

        oSqlConnection.Close();
        #endregion

        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;        

        string vFieldError = "";

        try
        {
            List<long> oPrdIds = null;
            while (oProducts.Count > 0)
            {
                oPrdIds = oProducts.Take(1000).ToList();

                Request oRequest = new Request
                {
                    filter = new Request_Filter
                    {
                        product_id = oPrdIds.ToArray(),
                        visibility = "ALL"
                    },
                    limit = 1000,
                    sort_dir = "ASC"
                };

                oProducts = oProducts.Except(oPrdIds).ToList();

                LoadBlock(oRequest, 1);
            }

            List<long> oSKUIds = null;
            while (oSKUs.Count > 0)
            {
                oSKUIds = oSKUs.Take(1000).ToList();

                Request oRequest = new Request
                {
                    filter = new Request_Filter
                    {
                        sku = oSKUIds.ToArray(),
                        visibility = "ALL"
                    },
                    limit = 1000,
                    sort_dir = "ASC"
                };

                oSKUs = oSKUs.Except(oSKUIds).ToList();

                LoadBlock(oRequest, 2);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon Поле:{1} {0}", DateTime.Now, vFieldError), e.Message, "", 0, out cancel);
        }
    }

}
]]></arrayElement>
