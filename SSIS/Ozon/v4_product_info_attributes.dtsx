          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Загрузка в стейджинг\v4_product_info_attributes"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{80c2a96a-358a-402d-b2c2-25aacd96c1f7}"
