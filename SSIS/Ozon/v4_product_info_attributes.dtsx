              DTS:ObjectName="v4_product_info_attributes"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="DECLARE @STEP int&#xA;&#xA;SET @STEP = 1&#xA;&#xA;WHILE @STEP &lt;= 2&#xA;BEGIN&#xA;&#xA;&#x9;MERGE [Ozon].[v4_product_info_attributes] TGT &#xA;&#x9;USING (&#xA;&#x9; SELECT&#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[barcode]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[offer_id]&#xA;&#x9;&#x9;,[type_id]&#xA;&#x9;&#x9;,[height]&#xA;&#x9;&#x9;,[depth]&#xA;&#x9;&#x9;,[width]&#xA;&#x9;&#x9;,[dimension_unit]&#xA;&#x9;&#x9;,[weight]&#xA;&#x9;&#x9;,[weight_unit]&#xA;&#x9;&#x9;,[primary_image]&#xA;&#x9;&#x9;,[sku]&#xA;&#x9;&#x9;,[color_image]&#xA;&#x9;&#x9;,[description_category_id]&#xA;&#x9; FROM&#xA;&#x9;  (&#xA;&#x9;   SELECT&#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[barcode]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[offer_id]&#xA;&#x9;&#x9;,[type_id]&#xA;&#x9;&#x9;,[height]&#xA;&#x9;&#x9;,[depth]&#xA;&#x9;&#x9;,[width]&#xA;&#x9;&#x9;,[dimension_unit]&#xA;&#x9;&#x9;,[weight]&#xA;&#x9;&#x9;,[weight_unit]&#xA;&#x9;&#x9;,[primary_image]&#xA;&#x9;&#x9;,[sku]&#xA;&#x9;&#x9;,[color_image]&#xA;&#x9;&#x9;,[description_category_id]&#xA;&#x9;&#x9;,ROW_NUMBER() OVER (PARTITION BY [product_id] ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;   FROM&#xA;&#x9;&#x9;[BUFFER].[Ozon_v4_product_info_attributes]&#xA;&#x9;   WHERE&#xA;&#x9;&#x9;STEP = @STEP&#xA;&#x9;  ) TMP&#xA;&#x9; WHERE&#xA;&#x9;  RN = 1&#xA;&#x9;) SRC ON TGT.id_account = SRC.id_account AND TGT.[product_id] = SRC.[product_id]&#xA;&#x9;WHEN MATCHED AND&#xA;&#x9; CHECKSUM&#xA;&#x9; (&#xA;&#x9;&#x9;SRC.[id_Account]&#xA;&#x9;&#x9;,SRC.[product_id]&#xA;&#x9;&#x9;,SRC.[barcode]&#xA;&#x9;&#x9;,SRC.[name]&#xA;&#x9;&#x9;,SRC.[offer_id]&#xA;&#x9;&#x9;,SRC.[type_id]&#xA;&#x9;&#x9;,SRC.[height]&#xA;&#x9;&#x9;,SRC.[depth]&#xA;&#x9;&#x9;,SRC.[width]&#xA;&#x9;&#x9;,SRC.[dimension_unit]&#xA;&#x9;&#x9;,SRC.[weight]&#xA;&#x9;&#x9;,SRC.[weight_unit]&#xA;&#x9;&#x9;,SRC.[primary_image]&#xA;&#x9;&#x9;,SRC.[sku]&#xA;&#x9;&#x9;,SRC.[color_image]&#xA;&#x9;&#x9;,SRC.[description_category_id]&#xA;&#x9; ) &lt;&gt; &#xA;&#x9; CHECKSUM&#xA;&#x9; (&#xA;&#x9;&#x9;TGT.[id_Account]&#xA;&#x9;&#x9;,TGT.[product_id]&#xA;&#x9;&#x9;,TGT.[barcode]&#xA;&#x9;&#x9;,TGT.[name]&#xA;&#x9;&#x9;,TGT.[offer_id]&#xA;&#x9;&#x9;,TGT.[type_id]&#xA;&#x9;&#x9;,TGT.[height]&#xA;&#x9;&#x9;,TGT.[depth]&#xA;&#x9;&#x9;,TGT.[width]&#xA;&#x9;&#x9;,TGT.[dimension_unit]&#xA;&#x9;&#x9;,TGT.[weight]&#xA;&#x9;&#x9;,TGT.[weight_unit]&#xA;&#x9;&#x9;,TGT.[primary_image]&#xA;&#x9;&#x9;,TGT.[sku]&#xA;&#x9;&#x9;,TGT.[color_image]&#xA;&#x9;&#x9;,TGT.[description_category_id]&#xA;&#x9; ) THEN&#xA;&#x9; UPDATE SET &#xA;&#x9;&#x9;[id_Account] = SRC.[id_Account]&#xA;&#x9;&#x9;,[product_id] = SRC.[product_id]&#xA;&#x9;&#x9;,[barcode] = SRC.[barcode]&#xA;&#x9;&#x9;,[name] = SRC.[name]&#xA;&#x9;&#x9;,[offer_id] = SRC.[offer_id]&#xA;&#x9;&#x9;,[type_id] = SRC.[type_id]&#xA;&#x9;&#x9;,[height] = SRC.[height]&#xA;&#x9;&#x9;,[depth] = SRC.[depth]&#xA;&#x9;&#x9;,[width] = SRC.[width]&#xA;&#x9;&#x9;,[dimension_unit] = SRC.[dimension_unit]&#xA;&#x9;&#x9;,[weight] = SRC.[weight]&#xA;&#x9;&#x9;,[weight_unit] = SRC.[weight_unit]&#xA;&#x9;&#x9;,[primary_image] = SRC.[primary_image]&#xA;&#x9;&#x9;,[sku] = SRC.[sku]&#xA;&#x9;&#x9;,[color_image] = SRC.[color_image]&#xA;&#x9;&#x9;,[description_category_id] = SRC.[description_category_id]&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;&#x9;WHEN NOT MATCHED THEN&#xA;&#x9; INSERT &#xA;&#x9; (&#xA;&#x9;&#x9;[id_Account]&#xA;&#x9;&#x9;,[product_id]&#xA;&#x9;&#x9;,[barcode]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[offer_id]&#xA;&#x9;&#x9;,[type_id]&#xA;&#x9;&#x9;,[height]&#xA;&#x9;&#x9;,[depth]&#xA;&#x9;&#x9;,[width]&#xA;&#x9;&#x9;,[dimension_unit]&#xA;&#x9;&#x9;,[weight]&#xA;&#x9;&#x9;,[weight_unit]&#xA;&#x9;&#x9;,[primary_image]&#xA;&#x9;&#x9;,[sku]&#xA;&#x9;&#x9;,[color_image]&#xA;&#x9;&#x9;,[description_category_id]&#xA;&#x9;   ,SYSMOMENT&#xA;&#x9; )&#xA;&#x9; VALUES &#xA;&#x9; (&#xA;&#x9;&#x9;SRC.[id_Account]&#xA;&#x9;&#x9;,SRC.[product_id]&#xA;&#x9;&#x9;,SRC.[barcode]&#xA;&#x9;&#x9;,SRC.[name]&#xA;&#x9;&#x9;,SRC.[offer_id]&#xA;&#x9;&#x9;,SRC.[type_id]&#xA;&#x9;&#x9;,SRC.[height]&#xA;&#x9;&#x9;,SRC.[depth]&#xA;&#x9;&#x9;,SRC.[width]&#xA;&#x9;&#x9;,SRC.[dimension_unit]&#xA;&#x9;&#x9;,SRC.[weight]&#xA;&#x9;&#x9;,SRC.[weight_unit]&#xA;&#x9;&#x9;,SRC.[primary_image]&#xA;&#x9;&#x9;,SRC.[sku]&#xA;&#x9;&#x9;,SRC.[color_image]&#xA;&#x9;&#x9;,SRC.[description_category_id]&#xA;&#x9;   ,GETDATE()&#xA;&#x9; );&#xA;&#xA;&#x9;SET @STEP = @STEP +1&#xA; END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
