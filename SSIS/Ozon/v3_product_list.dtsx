              SQLTask:SqlStatementSource="MERGE [Ozon].[v3_product_list] TGT &#xA;USING (&#xA; SELECT&#xA;&#x9;[id_Account]&#xA;&#x9;,[product_id]&#xA;&#x9;,[offer_id]&#xA;&#x9;,[archived]&#xA;&#x9;,[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks]&#xA;&#x9;,[is_discounted]&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;&#x9;[id_Account]&#xA;&#x9;,[product_id]&#xA;&#x9;,[offer_id]&#xA;&#x9;,[archived]&#xA;&#x9;,[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks]&#xA;&#x9;,[is_discounted]&#xA;    ,ROW_NUMBER() OVER (PARTITION BY [product_id] ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;    [BUFFER].[Ozon_v3_product_list]&#xA;  ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;) SRC ON TGT.id_account = SRC.id_account AND TGT.[product_id] = SRC.[product_id]&#xA;WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;&#x9;SRC.[id_Account]&#xA;&#x9;,SRC.[product_id]&#xA;&#x9;,SRC.[offer_id]&#xA;&#x9;,SRC.[archived]&#xA;&#x9;,SRC.[has_fbo_stocks]&#xA;&#x9;,SRC.[has_fbs_stocks]&#xA;&#x9;,SRC.[is_discounted]&#xA; ) &lt;&gt; &#xA; CHECKSUM&#xA; (&#xA;&#x9;TGT.[id_Account]&#xA;&#x9;,TGT.[product_id]&#xA;&#x9;,TGT.[offer_id]&#xA;&#x9;,TGT.[archived]&#xA;&#x9;,TGT.[has_fbo_stocks]&#xA;&#x9;,TGT.[has_fbs_stocks]&#xA;&#x9;,TGT.[is_discounted]&#xA; ) THEN&#xA; UPDATE SET &#xA;&#x9;[id_Account] = SRC.[id_Account]&#xA;&#x9;,[product_id] = SRC.[product_id]&#xA;&#x9;,[offer_id] = SRC.[offer_id]&#xA;&#x9;,[archived] = SRC.[archived]&#xA;&#x9;,[has_fbo_stocks] = SRC.[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks] = SRC.[has_fbs_stocks]&#xA;&#x9;,[is_discounted] = SRC.[is_discounted]&#xA;    ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;&#x9;[id_Account]&#xA;&#x9;,[product_id]&#xA;&#x9;,[offer_id]&#xA;&#x9;,[archived]&#xA;&#x9;,[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks]&#xA;&#x9;,[is_discounted]&#xA;    ,SYSMOMENT&#xA; )&#xA; VALUES &#xA; (&#xA;&#x9;SRC.[id_Account]&#xA;&#x9;,SRC.[product_id]&#xA;&#x9;,SRC.[offer_id]&#xA;&#x9;,SRC.[archived]&#xA;&#x9;,SRC.[has_fbo_stocks]&#xA;&#x9;,SRC.[has_fbs_stocks]&#xA;&#x9;,SRC.[is_discounted]&#xA;    ,GETDATE()&#xA; );&#xA;&#xA;&#xA; MERGE [Ozon].[v3_product_list] TGT &#xA;USING (&#xA; SELECT&#xA;&#x9;[id_Account]&#xA;&#x9;,[product_id]&#xA;&#x9;,[offer_id]&#xA;&#x9;,[archived]&#xA;&#x9;,[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks]&#xA;&#x9;,[is_discounted]&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;&#x9;[id_Account]&#xA;&#x9;,[product_id]&#xA;&#x9;,[offer_id]&#xA;&#x9;,[archived]&#xA;&#x9;,[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks]&#xA;&#x9;,[is_discounted]&#xA;    ,ROW_NUMBER() OVER (PARTITION BY [product_id] ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;    [BUFFER].[Ozon_v3_product_list_2] PL&#xA;   WHERE&#xA;    NOT EXISTS(SELECT TOP 1 1 FROM [Ozon].[v3_product_list] L WHERE L.[id_Account] = PL.[id_Account] AND L.[product_id] = PL.[product_id])&#xA;  ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;) SRC ON TGT.id_account = SRC.id_account AND TGT.[product_id] = SRC.[product_id]&#xA;WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;&#x9;SRC.[id_Account]&#xA;&#x9;,SRC.[product_id]&#xA;&#x9;,SRC.[offer_id]&#xA;&#x9;,SRC.[archived]&#xA;&#x9;,SRC.[has_fbo_stocks]&#xA;&#x9;,SRC.[has_fbs_stocks]&#xA;&#x9;,SRC.[is_discounted]&#xA; ) &lt;&gt; &#xA; CHECKSUM&#xA; (&#xA;&#x9;TGT.[id_Account]&#xA;&#x9;,TGT.[product_id]&#xA;&#x9;,TGT.[offer_id]&#xA;&#x9;,TGT.[archived]&#xA;&#x9;,TGT.[has_fbo_stocks]&#xA;&#x9;,TGT.[has_fbs_stocks]&#xA;&#x9;,TGT.[is_discounted]&#xA; ) THEN&#xA; UPDATE SET &#xA;&#x9;[id_Account] = SRC.[id_Account]&#xA;&#x9;,[product_id] = SRC.[product_id]&#xA;&#x9;,[offer_id] = SRC.[offer_id]&#xA;&#x9;,[archived] = SRC.[archived]&#xA;&#x9;,[has_fbo_stocks] = SRC.[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks] = SRC.[has_fbs_stocks]&#xA;&#x9;,[is_discounted] = SRC.[is_discounted]&#xA;    ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;&#x9;[id_Account]&#xA;&#x9;,[product_id]&#xA;&#x9;,[offer_id]&#xA;&#x9;,[archived]&#xA;&#x9;,[has_fbo_stocks]&#xA;&#x9;,[has_fbs_stocks]&#xA;&#x9;,[is_discounted]&#xA;    ,SYSMOMENT&#xA; )&#xA; VALUES &#xA; (&#xA;&#x9;SRC.[id_Account]&#xA;&#x9;,SRC.[product_id]&#xA;&#x9;,SRC.[offer_id]&#xA;&#x9;,SRC.[archived]&#xA;&#x9;,SRC.[has_fbo_stocks]&#xA;&#x9;,SRC.[has_fbs_stocks]&#xA;&#x9;,SRC.[is_discounted]&#xA;    ,GETDATE()&#xA; );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
