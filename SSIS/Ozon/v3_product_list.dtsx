         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }


    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        byte[] vDATA = null;

        string vFieldError = "";
        Request oRequest = new Request
        {
            filter = new Request_Filter
            {
                visibility = "ALL"
            },
            limit = 1000
        };
        Response oResponse = null;

        try
        {
            while (oResponse == null || oResponse.result.items.Length > 0)
            {
                if (oResponse != null)
                {
                    oRequest.last_id = oResponse.result.last_id;
                }

                OzonWebClient oOWC = new OzonWebClient(30000, 6, 26000);
                vDATA = oOWC.SendRequestWithRateLimit(String.Format("https://api-seller.ozon.ru/v3/product/list"), string.Format("{0}", Variables.vClientID), Variables.vApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));

                oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

                foreach (Response_result_item oItem in oResponse.result.items)
                {
                    vFieldError = "Не  определено";
                    OutputBuffer.AddRow();
                    if (oItem.product_id != null)
                    {
                        vFieldError = "product_id";
                        OutputBuffer.productid = (long)oItem.product_id;
                        vFieldError = "offer_id";
                        if (oItem.offer_id != null && oItem.offer_id.Length > 0) OutputBuffer.offerid = oItem.offer_id.Length > 100 ? oItem.offer_id.Substring(0, 100) : oItem.offer_id;
                        vFieldError = "has_fbo_stocks";
                        if (oItem.has_fbo_stocks != null) OutputBuffer.hasfbostocks = (bool)oItem.has_fbo_stocks;
                        vFieldError = "has_fbs_stocks";
                        if (oItem.has_fbs_stocks != null) OutputBuffer.hasfbsstocks = (bool)oItem.has_fbs_stocks;
                        vFieldError = "archived";
                        if (oItem.archived != null) OutputBuffer.archived = (bool)oItem.archived;
                        vFieldError = "isdiscounted";
                        if (oItem.is_discounted != null) OutputBuffer.isdiscounted = (bool)oItem.is_discounted;
                        vFieldError = "quants";
                        if (oItem.quants != null)
                        {
                            int vNpp = 1;
                            foreach(Response_result_item_quant oQuant in oItem.quants)
                            {
                                OutputquantsBuffer.AddRow();
                                OutputquantsBuffer.productid = (long)oItem.product_id;
                                OutputquantsBuffer.npp = vNpp;
                                if (oQuant.quant_code != null && oQuant.quant_code.Length > 0) OutputquantsBuffer.quantcode = oQuant.quant_code.Length > 100 ? oQuant.quant_code.Substring(0, 100) : oQuant.quant_code;
                                if (oQuant.quant_size != null) OutputquantsBuffer.quantsize = (long)oQuant.quant_size;
                            }
                        }
                    }
                }
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("Ozon Поле:{1} {0}", DateTime.Now, vFieldError), e.Message, "", 0, out cancel);
        }
    }
}
]]></arrayElement>
