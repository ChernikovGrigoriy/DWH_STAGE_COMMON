              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{0AFE73E7-6D6D-4ECC-A945-CD8BD8053E9F}"
                  SQLTask:SqlStatementSource="DECLARE @id_Account int, @YEAR int, @MONTH int, @DAY int&#xA;&#xA;DECLARE @CHECKSUM_AGG_BUF int, @CHECKSUM_AGG int&#xA;&#xA;SELECT @id_Account = [id_Account], @YEAR = [YEAR], @MONTH = [MONTH], @DAY = [DAY] FROM [BUFFER].[Ozon v1_finance_realization_by-day]&#xA;&#xA;SELECT &#xA;&#x9;@CHECKSUM_AGG_BUF = CHECKSUM_AGG(&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;[rowNumber]&#xA;&#x9;&#x9;&#x9;,[seller_price_per_instance]&#xA;&#x9;&#x9;&#x9;,[commission_ratio]&#xA;&#x9;&#x9;&#x9;,[item_barcode]&#xA;&#x9;&#x9;&#x9;,[item_sku]&#xA;&#x9;&#x9;&#x9;,[item_name]&#xA;&#x9;&#x9;&#x9;,[item_offer_id]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_amount]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_bonus]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_commission]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_compensation]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_price_per_instance]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_quantity]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_standard_fee]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_bank_coinvestment]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_stars]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_pick_up_point_coinvestment]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_total]&#xA;&#x9;&#x9;&#x9;,[return_commission_amount]&#xA;&#x9;&#x9;&#x9;,[return_commission_bonus]&#xA;&#x9;&#x9;&#x9;,[return_commission_commission]&#xA;&#x9;&#x9;&#x9;,[return_commission_compensation]&#xA;&#x9;&#x9;&#x9;,[return_commission_price_per_instance]&#xA;&#x9;&#x9;&#x9;,[return_commission_quantity]&#xA;&#x9;&#x9;&#x9;,[return_commission_standard_fee]&#xA;&#x9;&#x9;&#x9;,[return_commission_bank_coinvestment]&#xA;&#x9;&#x9;&#x9;,[return_commission_stars]&#xA;&#x9;&#x9;&#x9;,[return_commission_pick_up_point_coinvestment]&#xA;&#x9;&#x9;)&#xA;&#x9;)&#xA;FROM &#xA;&#x9;[BUFFER].[Ozon v1_finance_realization_by-day]&#xA;&#xA;SELECT &#xA;&#x9;@CHECKSUM_AGG = CHECKSUM_AGG(&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;[rowNumber]&#xA;&#x9;&#x9;&#x9;,[seller_price_per_instance]&#xA;&#x9;&#x9;&#x9;,[commission_ratio]&#xA;&#x9;&#x9;&#x9;,[item_barcode]&#xA;&#x9;&#x9;&#x9;,[item_sku]&#xA;&#x9;&#x9;&#x9;,[item_name]&#xA;&#x9;&#x9;&#x9;,[item_offer_id]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_amount]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_bonus]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_commission]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_compensation]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_price_per_instance]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_quantity]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_standard_fee]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_bank_coinvestment]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_stars]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_pick_up_point_coinvestment]&#xA;&#x9;&#x9;&#x9;,[delivery_commission_total]&#xA;&#x9;&#x9;&#x9;,[return_commission_amount]&#xA;&#x9;&#x9;&#x9;,[return_commission_bonus]&#xA;&#x9;&#x9;&#x9;,[return_commission_commission]&#xA;&#x9;&#x9;&#x9;,[return_commission_compensation]&#xA;&#x9;&#x9;&#x9;,[return_commission_price_per_instance]&#xA;&#x9;&#x9;&#x9;,[return_commission_quantity]&#xA;&#x9;&#x9;&#x9;,[return_commission_standard_fee]&#xA;&#x9;&#x9;&#x9;,[return_commission_bank_coinvestment]&#xA;&#x9;&#x9;&#x9;,[return_commission_stars]&#xA;&#x9;&#x9;&#x9;,[return_commission_pick_up_point_coinvestment]&#xA;&#x9;&#x9;)&#xA;&#x9;)&#xA;FROM &#xA;&#x9;[Ozon].[v1_finance_realization_by-day]&#xA;WHERE&#xA;&#x9;[id_Account] = @id_Account&#xA;&#x9;AND [YEAR] = @YEAR&#xA;&#x9;AND [MONTH] = @Month&#xA;&#x9;AND [DAY] = @Day&#xA;&#xA;IF (ISNULL(@CHECKSUM_AGG_BUF,0) &lt;&gt; ISNULL(@CHECKSUM_AGG,0))&#xA;BEGIN&#xA;&#x9;DELETE FROM [Ozon].[v1_finance_realization_by-day]&#xA;&#x9;WHERE&#xA;&#x9;&#x9;[id_Account] = @id_Account&#xA;&#x9;&#x9;AND [YEAR] = @YEAR&#xA;&#x9;&#x9;AND [MONTH] = @Month&#xA;&#x9;&#x9;AND [DAY] = @Day&#xA;&#xA;&#x9;INSERT INTO [Ozon].[v1_finance_realization_by-day]&#xA;&#x9;(&#xA;&#x9;  [id_Account]&#xA;      ,[YEAR]&#xA;      ,[MONTH]&#xA;      ,[DAY]&#xA;      ,[rowNumber]&#xA;      ,[seller_price_per_instance]&#xA;      ,[commission_ratio]&#xA;      ,[item_barcode]&#xA;      ,[item_sku]&#xA;      ,[item_name]&#xA;      ,[item_offer_id]&#xA;      ,[delivery_commission_amount]&#xA;      ,[delivery_commission_bonus]&#xA;      ,[delivery_commission_commission]&#xA;      ,[delivery_commission_compensation]&#xA;      ,[delivery_commission_price_per_instance]&#xA;      ,[delivery_commission_quantity]&#xA;      ,[delivery_commission_standard_fee]&#xA;      ,[delivery_commission_bank_coinvestment]&#xA;      ,[delivery_commission_stars]&#xA;      ,[delivery_commission_pick_up_point_coinvestment]&#xA;      ,[delivery_commission_total]&#xA;      ,[return_commission_amount]&#xA;      ,[return_commission_bonus]&#xA;      ,[return_commission_commission]&#xA;      ,[return_commission_compensation]&#xA;      ,[return_commission_price_per_instance]&#xA;      ,[return_commission_quantity]&#xA;      ,[return_commission_standard_fee]&#xA;      ,[return_commission_bank_coinvestment]&#xA;      ,[return_commission_stars]&#xA;      ,[return_commission_pick_up_point_coinvestment]&#xA;      ,[return_commission_total]&#xA;      ,[SYSMOMENT]&#xA;&#x9;)&#xA;&#x9;SELECT&#xA;&#x9;  [id_Account]&#xA;      ,[YEAR]&#xA;      ,[MONTH]&#xA;      ,[DAY]&#xA;      ,[rowNumber]&#xA;      ,[seller_price_per_instance]&#xA;      ,[commission_ratio]&#xA;      ,[item_barcode]&#xA;      ,[item_sku]&#xA;      ,[item_name]&#xA;      ,[item_offer_id]&#xA;      ,[delivery_commission_amount]&#xA;      ,[delivery_commission_bonus]&#xA;      ,[delivery_commission_commission]&#xA;      ,[delivery_commission_compensation]&#xA;      ,[delivery_commission_price_per_instance]&#xA;      ,[delivery_commission_quantity]&#xA;      ,[delivery_commission_standard_fee]&#xA;      ,[delivery_commission_bank_coinvestment]&#xA;      ,[delivery_commission_stars]&#xA;      ,[delivery_commission_pick_up_point_coinvestment]&#xA;      ,[delivery_commission_total]&#xA;      ,[return_commission_amount]&#xA;      ,[return_commission_bonus]&#xA;      ,[return_commission_commission]&#xA;      ,[return_commission_compensation]&#xA;      ,[return_commission_price_per_instance]&#xA;      ,[return_commission_quantity]&#xA;      ,[return_commission_standard_fee]&#xA;      ,[return_commission_bank_coinvestment]&#xA;      ,[return_commission_stars]&#xA;      ,[return_commission_pick_up_point_coinvestment]&#xA;      ,[return_commission_total]&#xA;      ,GETDATE()&#xA;&#x9;FROM&#xA;&#x9;  [BUFFER].[Ozon v1_finance_realization_by-day]&#xA;&#xA;END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
