        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Создание буферной таблицы"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8D8E677D-882B-43D3-8C71-1B9C5A50B428}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Создание буферной таблицы"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BD0392A8-A766-449E-83D2-41AA0593E516}"
              SQLTask:SqlStatementSource="&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[buffer].[Mpstats_v1_seller_categories]')&#xA;            and   type = 'U')&#xA;   drop table [buffer].[Mpstats_v1_seller_categories]&#xA;&#xA;SELECT TOP 0 * INTO [buffer].[Mpstats_v1_seller_categories] FROM [Mpstats].[v1_seller_categories]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7068E2AC-BF81-49A1-916C-BEF817DF154E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BD0392A8-A766-449E-83D2-41AA0593E516}"
              SQLTask:SqlStatementSource="MERGE [Mpstats].[v1_seller_categories] TGT&#xA;USING [BUFFER].[Mpstats_v1_seller_categories] SRC ON TGT.[marketplace] = SRC.[marketplace] AND TGT.[supplier_id] = SRC.[supplier_id] AND TGT.[date] = SRC.[date] AND TGT.[name] = SRC.[name]&#xA;WHEN MATCHED AND &#xA;     (&#xA;      ISNULL(SRC.[items],0) &lt;&gt; ISNULL(TGT.[items],0)&#xA;      OR ISNULL(SRC.[items_with_sells],0) &lt;&gt; ISNULL(TGT.[items_with_sells],0)&#xA;      OR ISNULL(SRC.[items_with_sells_percent],0) &lt;&gt; ISNULL(TGT.[items_with_sells_percent],0)&#xA;      OR ISNULL(SRC.[brands],0) &lt;&gt; ISNULL(TGT.[brands],0)&#xA;      OR ISNULL(SRC.[brands_with_sells],0) &lt;&gt; ISNULL(TGT.[brands_with_sells],0)&#xA;      OR ISNULL(SRC.[brands_with_sells_percent],0) &lt;&gt; ISNULL(TGT.[brands_with_sells_percent],0)&#xA;      OR ISNULL(SRC.[sellers],0) &lt;&gt; ISNULL(TGT.[sellers],0)&#xA;      OR ISNULL(SRC.[sellers_with_sells],0) &lt;&gt; ISNULL(TGT.[sellers_with_sells],0)&#xA;      OR ISNULL(SRC.[sellers_with_sells_percent],0) &lt;&gt; ISNULL(TGT.[sellers_with_sells_percent],0)&#xA;      OR ISNULL(SRC.[sales_per_items_average],0) &lt;&gt; ISNULL(TGT.[sales_per_items_average],0)&#xA;      OR ISNULL(SRC.[sales_per_items_with_sells_average],0) &lt;&gt; ISNULL(TGT.[sales_per_items_with_sells_average],0)&#xA;      OR ISNULL(SRC.[sales],0) &lt;&gt; ISNULL(TGT.[sales],0)&#xA;      OR ISNULL(SRC.[revenue],0) &lt;&gt; ISNULL(TGT.[revenue],0)&#xA;      OR ISNULL(SRC.[revenue_per_items_average],0) &lt;&gt; ISNULL(TGT.[revenue_per_items_average],0)&#xA;      OR ISNULL(SRC.[revenue_per_items_with_sells_average],0) &lt;&gt; ISNULL(TGT.[revenue_per_items_with_sells_average],0)&#xA;      OR ISNULL(SRC.[avg_price],0) &lt;&gt; ISNULL(TGT.[avg_price],0)&#xA;      OR ISNULL(SRC.[comments],0) &lt;&gt; ISNULL(TGT.[comments],0)&#xA;      OR ISNULL(SRC.[rating],0) &lt;&gt; ISNULL(TGT.[rating],0)&#xA;&#x9;  )&#xA;   THEN&#xA;   UPDATE SET&#xA;      [items] = SRC.[items]&#xA;      ,[items_with_sells] = SRC.[items_with_sells]&#xA;      ,[items_with_sells_percent] = SRC.[items_with_sells_percent]&#xA;      ,[brands] = SRC.[brands]&#xA;      ,[brands_with_sells] = SRC.[brands_with_sells]&#xA;      ,[brands_with_sells_percent] = SRC.[brands_with_sells_percent]&#xA;      ,[sellers] = SRC.[sellers]&#xA;      ,[sellers_with_sells] = SRC.[sellers_with_sells]&#xA;      ,[sellers_with_sells_percent] = SRC.[sellers_with_sells_percent]&#xA;      ,[sales_per_items_average] = SRC.[sales_per_items_average]&#xA;      ,[sales_per_items_with_sells_average] = SRC.[sales_per_items_with_sells_average]&#xA;      ,[sales] = SRC.[sales]&#xA;      ,[revenue] = SRC.[revenue]&#xA;      ,[revenue_per_items_average] = SRC.[revenue_per_items_average]&#xA;      ,[revenue_per_items_with_sells_average] = SRC.[revenue_per_items_with_sells_average]&#xA;      ,[avg_price] = SRC.[avg_price]&#xA;      ,[comments] = SRC.[comments]&#xA;      ,[rating] = SRC.[rating]&#xA;      ,[SYSMOMENT] = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA; INSERT (&#xA;&#x9; [marketplace]&#xA;      ,[date]&#xA;      ,[supplier_id]&#xA;      ,[name]&#xA;      ,[items]&#xA;      ,[items_with_sells]&#xA;      ,[items_with_sells_percent]&#xA;      ,[brands]&#xA;      ,[brands_with_sells]&#xA;      ,[brands_with_sells_percent]&#xA;      ,[sellers]&#xA;      ,[sellers_with_sells]&#xA;      ,[sellers_with_sells_percent]&#xA;      ,[sales_per_items_average]&#xA;      ,[sales_per_items_with_sells_average]&#xA;      ,[sales]&#xA;      ,[revenue]&#xA;      ,[revenue_per_items_average]&#xA;      ,[revenue_per_items_with_sells_average]&#xA;      ,[avg_price]&#xA;      ,[comments]&#xA;      ,[rating]&#xA;      ,[SYSMOMENT]&#xA; )&#xA; VALUES (&#xA;&#x9;  SRC.[marketplace]&#xA;      ,SRC.[Date]&#xA;      ,SRC.[supplier_id]&#xA;      ,SRC.[name]&#xA;      ,SRC.[items]&#xA;      ,SRC.[items_with_sells]&#xA;      ,SRC.[items_with_sells_percent]&#xA;      ,SRC.[brands]&#xA;      ,SRC.[brands_with_sells]&#xA;      ,SRC.[brands_with_sells_percent]&#xA;      ,SRC.[sellers]&#xA;      ,SRC.[sellers_with_sells]&#xA;      ,SRC.[sellers_with_sells_percent]&#xA;      ,SRC.[sales_per_items_average]&#xA;      ,SRC.[sales_per_items_with_sells_average]&#xA;      ,SRC.[sales]&#xA;      ,SRC.[revenue]&#xA;      ,SRC.[revenue_per_items_average]&#xA;      ,SRC.[revenue_per_items_with_sells_average]&#xA;      ,SRC.[avg_price]&#xA;      ,SRC.[comments]&#xA;      ,SRC.[rating]&#xA;      ,GETDATE()&#xA; );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
