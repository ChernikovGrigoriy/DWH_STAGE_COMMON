            <DTS:Executable
              DTS:refId="Package\Foreach Loop AccountObj\Foreach Loop AccountObj, DateObj\Создание буферной таблицы"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{2190bdc7-ad31-4ace-92c5-06f4196752c9}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Создание буферной таблицы"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{BD0392A8-A766-449E-83D2-41AA0593E516}"
                  SQLTask:SqlStatementSource="&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[buffer].[Mpstats_Seller_Product]')&#xA;            and   type = 'U')&#xA;   drop table [buffer].[Mpstats_Seller_Product]&#xA;&#xA;SELECT TOP 0 * INTO [buffer].[Mpstats_Seller_Product] FROM [Mpstats].[Seller_Product]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Foreach Loop AccountObj\Foreach Loop AccountObj, DateObj\Стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{42A14929-9C50-472E-BEE8-CFC55B51D9B5}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Стейджинг"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{BD0392A8-A766-449E-83D2-41AA0593E516}"
                  SQLTask:SqlStatementSource="MERGE [Mpstats].[Seller_Product] TGT&#xA;USING [BUFFER].[Mpstats_Seller_Product] SRC ON TGT.[id_account] = SRC.[id_account] AND TGT.[id] = SRC.[id] AND TGT.[date] = SRC.[date]&#xA;WHEN MATCHED AND &#xA;      ISNULL(SRC.[itemid],-1) &lt;&gt; ISNULL(TGT.[itemid],-1)&#xA;      AND ISNULL(SRC.[name],'') &lt;&gt; ISNULL(TGT.[name],'')&#xA;      AND ISNULL(SRC.[brand],'') &lt;&gt; ISNULL(TGT.[brand],'')&#xA;      AND ISNULL(SRC.[seller],'') &lt;&gt; ISNULL(TGT.[seller],'')&#xA;      AND ISNULL(SRC.[supplier_id],-1) &lt;&gt; ISNULL(TGT.[supplier_id],-1)&#xA;      AND ISNULL(SRC.[color],'') &lt;&gt; ISNULL(TGT.[color],'')&#xA;      AND ISNULL(SRC.[balance],-1) &lt;&gt; ISNULL(TGT.[balance],-1)&#xA;      AND ISNULL(SRC.[balance_fbs],-1) &lt;&gt; ISNULL(TGT.[balance_fbs],-1)&#xA;      AND ISNULL(SRC.[comments],-1) &lt;&gt; ISNULL(TGT.[comments],-1)&#xA;      AND ISNULL(SRC.[rating],-1) &lt;&gt; ISNULL(TGT.[rating],-1)&#xA;      AND ISNULL(SRC.[final_price],-1) &lt;&gt; ISNULL(TGT.[final_price],-1)&#xA;      AND ISNULL(SRC.[final_price_max],-1) &lt;&gt; ISNULL(TGT.[final_price_max],-1)&#xA;      AND ISNULL(SRC.[final_price_min],-1) &lt;&gt; ISNULL(TGT.[final_price_min],-1) &#xA;&#xA;      AND ISNULL(SRC.[final_price_average],-1) &lt;&gt; ISNULL(TGT.[final_price_average],-1)&#xA;      AND ISNULL(SRC.[final_price_median],-1) &lt;&gt; ISNULL(TGT.[final_price_median],-1)&#xA;      AND ISNULL(SRC.[basic_sale],-1) &lt;&gt; ISNULL(TGT.[basic_sale],-1)&#xA;      AND ISNULL(SRC.[basic_price],-1) &lt;&gt; ISNULL(TGT.[basic_price],-1)&#xA;      AND ISNULL(SRC.[promo_sale],-1) &lt;&gt; ISNULL(TGT.[promo_sale],-1)&#xA;      AND ISNULL(SRC.[client_sale],-1) &lt;&gt; ISNULL(TGT.[client_sale],-1)&#xA;      AND ISNULL(SRC.[client_price],-1) &lt;&gt; ISNULL(TGT.[client_price],-1)&#xA;      AND ISNULL(SRC.[start_price],-1) &lt;&gt; ISNULL(TGT.[start_price],-1)&#xA;      AND ISNULL(SRC.[wallet_price],-1) &lt;&gt; ISNULL(TGT.[wallet_price],-1)&#xA;      AND ISNULL(SRC.[sales],-1) &lt;&gt; ISNULL(TGT.[sales],-1)&#xA;      AND ISNULL(SRC.[sales_per_day_average],-1) &lt;&gt; ISNULL(TGT.[sales_per_day_average],-1)&#xA;      AND ISNULL(SRC.[sales_per_comments],-1) &lt;&gt; ISNULL(TGT.[sales_per_comments],-1) &#xA;      AND ISNULL(SRC.[revenue],-1) &lt;&gt; ISNULL(TGT.[sales_per_comments],-1) &#xA;      AND ISNULL(SRC.[percent_from_revenue],-1) &lt;&gt; ISNULL(TGT.[percent_from_revenue],-1)&#xA;      AND ISNULL(SRC.[revenue_potential],-1) &lt;&gt; ISNULL(TGT.[revenue_potential],-1)&#xA;      AND ISNULL(SRC.[revenue_average],-1) &lt;&gt; ISNULL(TGT.[revenue_average],-1)&#xA;      AND ISNULL(SRC.[lost_profit],-1) &lt;&gt; ISNULL(TGT.[lost_profit],-1)&#xA;      AND ISNULL(SRC.[lost_profit_percent],-1) &lt;&gt; ISNULL(TGT.[lost_profit_percent],-1)&#xA;&#xA;      AND ISNULL(SRC.[days_in_site],-1) &lt;&gt; ISNULL(TGT.[days_in_site],-1)&#xA;      AND ISNULL(SRC.[days_in_stock],-1) &lt;&gt; ISNULL(TGT.[days_in_stock],-1)&#xA;      AND ISNULL(SRC.[days_with_sales],-1) &lt;&gt; ISNULL(TGT.[days_with_sales],-1)&#xA;      AND ISNULL(SRC.[average_if_in_stock],-1) &lt;&gt; ISNULL(TGT.[average_if_in_stock],-1)&#xA;      AND ISNULL(SRC.[is_fbs],-1) &lt;&gt; ISNULL(TGT.[is_fbs],-1)&#xA;      AND ISNULL(SRC.[subject_id],-1) &lt;&gt; ISNULL(TGT.[subject_id],-1)&#xA;      AND ISNULL(SRC.[subject],-1) &lt;&gt; ISNULL(TGT.[subject],-1)&#xA;      AND ISNULL(SRC.[purchase],-1) &lt;&gt; ISNULL(TGT.[purchase],-1)&#xA;      AND ISNULL(SRC.[purchase_after_return],-1) &lt;&gt; ISNULL(TGT.[purchase_after_return],-1)&#xA;      AND ISNULL(SRC.[country],-1) &lt;&gt; ISNULL(TGT.[country],-1)&#xA;      AND ISNULL(SRC.[gender],-1) &lt;&gt; ISNULL(TGT.[gender],-1)&#xA;      AND ISNULL(SRC.[sku_first_date],'19000101') &lt;&gt; ISNULL(TGT.[sku_first_date],'19000101')&#xA;      AND ISNULL(SRC.[firstcommentdate],'19000101') &lt;&gt; ISNULL(TGT.[firstcommentdate],'19000101')&#xA;      AND ISNULL(SRC.[picscount],-1) &lt;&gt; ISNULL(TGT.[picscount],-1)&#xA;      AND ISNULL(SRC.[has3d],-1) &lt;&gt; ISNULL(TGT.[has3d],-1)&#xA;&#x9;  &#xA;      AND ISNULL(SRC.[hasvideo],-1) &lt;&gt; ISNULL(TGT.[hasvideo],-1)&#xA;      AND ISNULL(SRC.[commentsvaluation],-1) &lt;&gt; ISNULL(TGT.[commentsvaluation],-1)&#xA;      AND ISNULL(SRC.[cardratingval],-1) &lt;&gt; ISNULL(TGT.[cardratingval],-1) &#xA;      AND ISNULL(SRC.[categories_last_count],-1) &lt;&gt; ISNULL(TGT.[categories_last_count],-1)&#xA;      AND ISNULL(SRC.[category],-1) &lt;&gt; ISNULL(TGT.[category],-1)   &#xA;      AND ISNULL(SRC.[category_position],-1) &lt;&gt; ISNULL(TGT.[category_position],-1)&#xA;      AND ISNULL(SRC.[thumb],-1) &lt;&gt; ISNULL(TGT.[thumb],-1)&#xA;      AND ISNULL(SRC.[thumb_middle],-1) &lt;&gt; ISNULL(TGT.[thumb_middle],-1)&#xA;      AND ISNULL(SRC.[url],-1) &lt;&gt; ISNULL(TGT.[url],-1)&#xA;      AND ISNULL(SRC.[turnover_days],-1) &lt;&gt; ISNULL(TGT.[turnover_days],-1)&#xA;      AND ISNULL(SRC.[turnover_once],-1) &lt;&gt; ISNULL(TGT.[turnover_once],-1)&#xA;      AND ISNULL(SRC.[frozen_stocks],-1) &lt;&gt; ISNULL(TGT.[frozen_stocks],-1)&#xA;      AND ISNULL(SRC.[frozen_stocks_cost],-1) &lt;&gt; ISNULL(TGT.[frozen_stocks_cost],-1)&#xA;&#x9;  AND ISNULL(SRC.[ozon_card_price],-1) &lt;&gt; ISNULL(TGT.[ozon_card_price],-1)&#xA;&#x9;  /*&#xA;      ,[frozen_stocks_percent]&#xA;      ,[search_words_count]&#xA;      ,[search_position_avg]&#xA;      ,[search_visibility]&#xA;      ,[search_words_in_ad]&#xA;      ,[category_position_avg]&#xA;      ,[category_visibility]&#xA;      ,[category_promo_count]&#xA;      ,[warehouses_count]&#xA;      ,[size_count]&#xA;      ,[size_count_in_stock]&#xA;      ,[avg_latest_rating]&#xA;      ,[latest_negative_comments_percent]&#xA;      ,[commission_fbo]&#xA;      ,[commission_fbs]&#xA;      ,[revenue_top_products_in_subject_percent]&#xA;      ,[ext_advertising]&#xA;      ,[related_products_count]&#xA;      ,[related_products_in_stock_count]&#xA;      ,[search_cpm_avg]&#xA;      ,[search_ad_position_avg]&#xA;      ,[search_organic_position_avg]&#xA;      ,[top_sells]&#xA;      ,[description_length]&#xA;      ,[name_length]&#xA;      ,[package_length]&#xA;      ,[package_width]&#xA;      ,[package_height]&#xA;      ,[last_parse_full_page] */&#xA;&#x9;  THEN&#xA;&#x9;  UPDATE SET&#xA;&#x9;&#x9;  [itemid] = SRC.[itemid]&#xA;&#x9;&#x9;  ,[name] = SRC.[name]&#xA;&#x9;&#x9;  ,[brand] = SRC.[brand]&#xA;&#x9;&#x9;  ,[seller] = SRC.[seller]&#xA;&#x9;&#x9;  ,[supplier_id] = SRC.[supplier_id]&#xA;&#x9;&#x9;  ,[color] = SRC.[color]&#xA;&#x9;&#x9;  ,[balance] = SRC.[balance]&#xA;&#x9;&#x9;  ,[balance_fbs] = SRC.[balance_fbs]&#xA;&#x9;&#x9;  ,[comments] = SRC.[comments]&#xA;&#x9;&#x9;  ,[rating] = SRC.[rating]&#xA;&#x9;&#x9;  ,[final_price] = SRC.[final_price]&#xA;&#x9;&#x9;  ,[final_price_max] = SRC.[final_price_max]&#xA;&#x9;&#x9;  ,[final_price_min] = SRC.[final_price_min]&#xA;&#x9;&#x9;  ,[final_price_average] = SRC.[final_price_average]&#xA;&#x9;&#x9;  ,[final_price_median] = SRC.[final_price_median]&#xA;&#x9;&#x9;  ,[basic_sale] =  SRC.[basic_sale]&#xA;&#x9;&#x9;  ,[basic_price] = SRC.[basic_price]&#xA;&#x9;&#x9;  ,[promo_sale] = SRC.[promo_sale]&#xA;&#x9;&#x9;  ,[client_sale] = SRC.[client_sale]&#xA;&#x9;&#x9;  ,[client_price] = SRC.[client_price]&#xA;&#x9;&#x9;  ,[start_price] = SRC.[start_price]&#xA;&#x9;&#x9;  ,[wallet_price] = SRC.[wallet_price]&#xA;&#x9;&#x9;  ,[sales] = SRC.[sales]&#xA;&#x9;&#x9;  ,[sales_per_day_average] = SRC.[sales_per_day_average]&#xA;&#x9;&#x9;  ,[sales_per_comments] = SRC.[sales_per_comments]&#xA;&#x9;&#x9;  ,[revenue] = SRC.[revenue]&#xA;&#x9;&#x9;  ,[percent_from_revenue] = SRC.[percent_from_revenue]&#xA;&#x9;&#x9;  ,[revenue_potential] = SRC.[revenue_potential]&#xA;&#x9;&#x9;  ,[revenue_average] = SRC.[revenue_average]&#xA;&#x9;&#x9;  ,[lost_profit] = SRC.[lost_profit]&#xA;&#x9;&#x9;  ,[lost_profit_percent] = SRC.[lost_profit_percent]&#xA;&#x9;&#x9;  ,[days_in_site] = SRC.[days_in_site]&#xA;&#x9;&#x9;  ,[days_in_stock] = SRC.[days_in_stock]&#xA;&#x9;&#x9;  ,[d