    public override void CreateNewOutputRows()
    {
        string vErrorActor = "";
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        int vWorkRow = 0;

        Response oResponse = null;

        try
        {
            do
            {
                byte[] vDATA = null;
                int i = 1;
                while (i <= 10)
                {
                    try
                    {

                        TimeoutWebClient oTWC = new TimeoutWebClient(300000);

                        string vURL = null;
                        switch (Variables.vMarketplace)
                        {
                            case "wb":
                                vURL = String.Format("https://mpstats.io/api/{4}/get/seller?d1={0:yyyy-MM-dd}&d2={1:yyyy-MM-dd}&path={2}&fbs={3}", Variables.vDate, Variables.vDate, Variables.vPath, Variables.vFbs ? 1 : 0, Variables.vMarketplace);
                                break;
                            case "oz":
                                vURL = String.Format("https://mpstats.io/api/{4}/get/seller?d1={0:yyyy-MM-dd}&d2={1:yyyy-MM-dd}&path={2}&fbs={3}&supplierId={5}", Variables.vDate, Variables.vDate, Variables.vPath, Variables.vFbs ? 1 : 0, Variables.vMarketplace, Variables.vSupplierid);
                                break;
                        }
                        vErrorActor = vURL;
                        oTWC.Headers["content-type"] = "application/json";
                        oTWC.Headers.Add("X-Mpstats-TOKEN", Variables.pToken);
                        Request oRequest = new Request
                        {
                            startRow = vWorkRow,
                            endRow = vWorkRow + 5000,
                            sortModel = new[] { new Request_SortModel { colId = "id", sort = "desc" } }
                        };
                        vDATA = oTWC.UploadData(vURL, "post", Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));
                        oTWC.Dispose();

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("(500) Internal Server Error") 
                            || e.Message.Contains("(502) Bad Gateway") 
                            || e.Message.Contains("(504) Gateway Timeout") 
                            || e.Message.Contains("The operation has timed out") 
                            || e.Message.Contains("(502) Недопустимый шлюз") 
                            || e.Message.Contains("Время ожидания операции истекло") 
                            || e.Message.Contains("(500) Внутренняя ошибка сервера") 
                            || e.Message.Contains("Базовое соединение закрыто: Соединение было неожиданно закрыто") 
                            || e.Message.Contains("Невозможно соединиться с удаленным сервером"))
                        {
                            Thread.Sleep(30000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Не доступен сервер mpstats");
                
                oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));
                Array.Clear(vDATA, 0, vDATA.Length);

                foreach (Response_Data item in oResponse.data)
                {
                    OutputBuffer.AddRow();
                    vErrorActor = "Поле id";
                    OutputBuffer.id = item.id;
                    vErrorActor = "Поле itemid";
                    if (item.itemid != null) OutputBuffer.itemid = (long)item.itemid;
                    vErrorActor = "Поле Name";
                    if (item.name != null && item.name.Length > 0) OutputBuffer.name = item.name.Length > 200 ? item.name.Substring(1, 200) : item.name;
                    vErrorActor = "Поле brand";
                    if (item.brand != null && item.brand.Length > 0) OutputBuffer.brand = item.brand.Length > 200 ? item.brand.Substring(1, 200) : item.brand;
                    vErrorActor = "Поле seller";
                    if (item.seller != null && item.seller.Length > 0) OutputBuffer.seller = item.seller.Length > 200 ? item.seller.Substring(1, 200) : item.seller;
                    vErrorActor = "Поле supplier_id";
                    if (item.supplier_id != null) OutputBuffer.supplierid = (int)item.supplier_id;
                    vErrorActor = "Поле color";
                    if (item.color != null && item.color.Length > 0) OutputBuffer.color = item.color.Length > 200 ? item.color.Substring(1, 200) : item.color;
                    vErrorActor = "Поле balance";
                    if (item.balance != null) OutputBuffer.balance = (int)item.balance;
                    vErrorActor = "Поле balance_fbs";
                    if (item.balance_fbs != null) OutputBuffer.balancefbs = (int)item.balance_fbs;
                    vErrorActor = "Поле comments";
                    if (item.comments != null) OutputBuffer.comments = (int)item.comments;
                    vErrorActor = "Поле rating";
                    if (item.rating != null) OutputBuffer.rating = (decimal)item.rating;//
                    vErrorActor = "Поле final_price";
                    if (item.final_price != null) OutputBuffer.finalprice = (int)item.final_price;
                    vErrorActor = "Поле final_price_max";
                    if (item.final_price_max != null) OutputBuffer.finalpricemax = (int)item.final_price_max;
                    vErrorActor = "Поле final_price_min";
                    if (item.final_price_min != null) OutputBuffer.finalpricemin = (int)item.final_price_min;
                    vErrorActor = "Поле final_price_average";
                    if (item.final_price_average != null) OutputBuffer.finalpriceaverage = (decimal)item.final_price_average;
                    vErrorActor = "Поле basic_sale";
                    if (item.basic_sale != null) OutputBuffer.basicsale = (int)item.basic_sale;
                    vErrorActor = "Поле basic_price";
                    if (item.basic_price != null) OutputBuffer.basicprice = (int)item.basic_price;
                    vErrorActor = "Поле promo_sale";
                    if (item.promo_sale != null) OutputBuffer.promosale = (int)item.promo_sale;
                    vErrorActor = "Поле client_sale";
                    if (item.client_sale != null) OutputBuffer.clientsale = (int)item.client_sale;
                    vErrorActor = "Поле client_price";
                    if (item.client_price != null) OutputBuffer.clientprice = (int)item.client_price;
                    vErrorActor = "Поле start_price";
                    if (item.start_price != null) OutputBuffer.startprice = (int)item.start_price;
                    vErrorActor = "Поле wallet_price";
                    if (item.wallet_price != null) OutputBuffer.walletprice = (decimal)item.wallet_price;
                    vErrorActor = "Поле sales";
                    if (item.sales != null) OutputBuffer.sales = (int)item.sales;
                    vErrorActor = "Поле sales_per_day_average";
                    if (item.sales_per_day_average != null) OutputBuffer.salesperdayaverage = (decimal)item.sales_per_day_average;
                    vErrorActor = "Поле sales_per_comments";
