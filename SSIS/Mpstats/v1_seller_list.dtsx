    JavaScriptSerializer _JSS = null;
    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = int.MaxValue;
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();        
    }

    public override void CreateNewOutputRows()
    {
        string vErrorActor = "";

        Request oRequest = new Request
        {
            startRow = 0,
            endRow = 500,
            sortModel = new Request_SortModel[]
              {
                  new Request_SortModel
                  {
                    colId = "supplier_id",
                     sort  = "asc"
                  }
              },
            filterModel = new Request_filterModel
            {
                sales = new Request_filterModel_sales
                {
                    filterType = "number",
                    type = "greaterThan",
                    filter = 500
                }
            }
        };

        Response oResponse = null;

        try
        {
            do
            {
                MpstatsWebClient oMPWC = new MpstatsWebClient(60000, 15, 26000);
                string vURL = String.Format("https://mpstats.io/api/analytics/v1/{0}/seller/list", Variables.vMarketplace);
                byte[] vPostData = Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest));
                byte[] oDATA = oMPWC.SendRequestWithRateLimit(vURL, Variables.pXMpstatsTOKEN, vPostData);                
                oResponse = _JSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));
                Array.Clear(oDATA, 0, oDATA.Length);

                foreach (Response_Data item in oResponse.data)
                {
                    OutputBuffer.AddRow();
                    vErrorActor = "Поле supplier_id";
                    OutputBuffer.supplierid = (long)item.supplier_id;
                    vErrorActor = "Поле Name";
                    if (item.name != null && item.name.Length > 0) OutputBuffer.name = item.name.Length > 200 ? item.name.Substring(1, 200) : item.name;
                    vErrorActor = "Поле first_date";
                    if (item.first_date != null) OutputBuffer.firstdate = (DateTime) item.first_date;
                    vErrorActor = "Поле ogrn";
                    if (item.ogrn != null && item.ogrn.Length > 0) OutputBuffer.ogrn = item.ogrn.Length > 100 ? item.ogrn.Substring(1, 100) : item.ogrn;
                    vErrorActor = "Поле position";
                    if (item.position != null) OutputBuffer.position = (decimal)item.position;
                    vErrorActor = "Поле niches";
                    if (item.niches != null) OutputBuffer.niches = (decimal)item.niches;
                    vErrorActor = "Поле niches_with_sells";
                    if (item.niches_with_sells != null) OutputBuffer.nicheswithsells = (decimal)item.niches_with_sells;
                    vErrorActor = "Поле niches_with_sells_percent";
                    if (item.niches_with_sells_percent != null) OutputBuffer.nicheswithsellspercent = (decimal)item.niches_with_sells_percent;
                    vErrorActor = "Поле items";
                    if (item.items != null) OutputBuffer.items = (decimal)item.items;
                    vErrorActor = "Поле items_with_count";
                    if (item.items_with_count != null) OutputBuffer.itemswithcount = (decimal)item.items_with_count;
                    vErrorActor = "Поле items_with_sells";
                    if (item.items_with_sells != null) OutputBuffer.itemswithsells = (decimal)item.items_with_sells;
