    #region Request
    public class Request
    {
        public int startRow { get; set; }
        public int endRow { get; set; }
        public Request_SortModel[] sortModel { get; set; }
        public Request_filterModel filterModel { get; set; }
    }

    public class Request_SortModel
    {
        public string colId { get; set; }
        public string sort { get; set; }
    }

    public class Request_filterModel
    {
        public Request_filterModel_sales sales { get; set; }
    }

    public class Request_filterModel_sales
    {
        public string filterType { get; set; }
        public string type { get; set; }
        public int filter { get; set; }
    }
    #endregion
    #region Response
    public class Response
    {
        public Response_Data[] data { get; set; }
        public int total { get; set; }
        public int startRow { get; set; }
        public int endRow { get; set; }

    }
    public class Response_Data
    {
        public long supplier_id { get; set; }
        public string name { get; set; }
        public DateTime first_date { get; set; }
        public string ogrn { get; set; }
        public decimal? position { get; set; }
        public decimal? niches { get; set; }
        public decimal? niches_with_sells { get; set; }
        public decimal? niches_with_sells_percent { get; set; }
        public decimal? items { get; set; }
        public decimal? items_with_count { get; set; }
        public decimal? items_with_sells { get; set; }
        public decimal? items_with_sells_percent { get; set; }
        public decimal? live_items { get; set; }
        public decimal? items_new { get; set; }
        public decimal? items_new_percent { get; set; }
        public decimal? items_new_with_sells { get; set; }
        public decimal? items_new_with_sells_percent { get; set; }
        public decimal? brands { get; set; }
        public decimal? brands_with_sells { get; set; }
        public decimal? brands_with_sells_percent { get; set; }
        public decimal? sales { get; set; }
        public decimal? balance { get; set; }
        public decimal? revenue { get; set; }
        public decimal? revenue_potential { get; set; }
        public decimal? lost_profit { get; set; }
        public decimal? lost_profit_percent { get; set; }
        public decimal? min_price { get; set; }
        public decimal? min_price_with_sells { get; set; }
        public decimal? max_price { get; set; }
        public decimal? max_price_with_sells { get; set; }
        public decimal? avg_price { get; set; }
        public decimal? avg_price_with_sells { get; set; }
        public decimal? median_price { get; set; }
        public decimal? median_price_with_sells { get; set; }
        public decimal? avg_rating { get; set; }
        public decimal? avg_rating_with_sells { get; set; }
        public decimal? turnover_in_days { get; set; }
        public decimal? frozen_stocks { get; set; }
        public decimal? frozen_stocks_cost { get; set; }
        public decimal? frozen_stocks_percent { get; set; }
        public decimal? sells_on_wb { get; set; }
        public decimal? wb_supplier_id { get; set; }
        public bool? favorite { get; set; }
    }
