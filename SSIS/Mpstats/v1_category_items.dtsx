                  SQLTask:SqlStatementSource="&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[buffer].[Mpstats_v1_category_items]')&#xA;            and   type = 'U')&#xA;   drop table [buffer].[Mpstats_v1_category_items]&#xA;&#xA;SELECT TOP 0 * INTO [buffer].[Mpstats_v1_category_items] FROM [Mpstats].[v1_category_items]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
