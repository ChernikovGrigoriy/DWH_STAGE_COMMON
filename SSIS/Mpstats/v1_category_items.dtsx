              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{BD0392A8-A766-449E-83D2-41AA0593E516}"
                  SQLTask:SqlStatementSource="MERGE [Mpstats].[v1_category_items] TGT&#xA;USING &#xA;&#x9;(&#x9;SELECT&#xA;&#x9;&#x9;*&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;*,&#xA;&#x9;&#x9;&#x9;&#x9;ROW_NUMBER() OVER (PARTITION BY [marketplace],[date],[id] ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[Mpstats_v1_category_items]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;&#x9;WHERE RN = 1&#xA;&#x9;) SRC ON TGT.[marketplace] = SRC.[marketplace] AND TGT.[date] = SRC.[date] AND TGT.[id] = SRC.[id]&#xA;WHEN MATCHED AND &#xA;     (&#xA;      ISNULL(TGT.[itemid],0) &lt;&gt; ISNULL(SRC.[itemid],0)&#xA;      OR ISNULL(TGT.[name],'') &lt;&gt; ISNULL(SRC.[name],'')&#xA;      OR ISNULL(TGT.[url],'') &lt;&gt; ISNULL(SRC.[url],'')&#xA;      OR ISNULL(TGT.[thumb],'') &lt;&gt; ISNULL(SRC.[thumb],'')&#xA;      OR ISNULL(TGT.[thumb_middle],'') &lt;&gt; ISNULL(SRC.[thumb_middle],'')&#xA;      OR ISNULL(TGT.[niche_id],0) &lt;&gt; ISNULL(SRC.[niche_id],0)&#xA;      OR ISNULL(TGT.[niche],'') &lt;&gt; ISNULL(SRC.[niche],'')&#xA;      OR ISNULL(TGT.[brand],'') &lt;&gt; ISNULL(SRC.[brand],'')&#xA;      OR ISNULL(TGT.[seller],'') &lt;&gt; ISNULL(SRC.[seller],'')&#xA;      OR ISNULL(TGT.[seller_id],0) &lt;&gt; ISNULL(SRC.[seller_id],0)&#xA;      OR ISNULL(TGT.[category],'') &lt;&gt; ISNULL(SRC.[category],'')&#xA;      OR ISNULL(TGT.[category_position],0) &lt;&gt; ISNULL(SRC.[category_position],0)&#xA;      OR ISNULL(TGT.[categories_count],0) &lt;&gt; ISNULL(SRC.[categories_count],0)&#xA;      OR ISNULL(TGT.[final_price],0) &lt;&gt; ISNULL(SRC.[final_price],0)&#xA;      OR ISNULL(TGT.[final_price_average],0) &lt;&gt; ISNULL(SRC.[final_price_average],0)&#xA;      OR ISNULL(TGT.[final_price_min],0) &lt;&gt; ISNULL(SRC.[final_price_min],0)&#xA;      OR ISNULL(TGT.[final_price_max],0) &lt;&gt; ISNULL(SRC.[final_price_max],0)&#xA;      OR ISNULL(TGT.[final_price_median],0) &lt;&gt; ISNULL(SRC.[final_price_median],0)&#xA;