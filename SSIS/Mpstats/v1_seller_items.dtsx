    public override void CreateNewOutputRows()
    {
        string vErrorActor = "";

        Response oResponse = null;

        Request oRequest = new Request
        {
            startRow = 0,
            endRow = 500,
            sortModel = new Request_SortModel[]
              {
                        new Request_SortModel
                        {
                            colId = "id",
                            sort  = "asc"
                        }
              }
        };

        try
        {
            do
            {
                MpstatsWebClient oMPWC = new MpstatsWebClient(60000, 15, 26000);
                string vURL = String.Format("https://mpstats.io/api/analytics/v1/{0}/seller/items?path={1}&d1={2:yyyy-MM-dd}&d2={2:yyyy-MM-dd}", Variables.vMarketplace, Variables.vSupplerId, Variables.vDate);
                byte[] vPostData = Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest));
                byte[] oDATA = oMPWC.SendRequestWithRateLimit(vURL, Variables.pXMpstatsTOKEN, vPostData);
                oResponse = _JSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));
                Array.Clear(oDATA, 0, oDATA.Length);

                foreach (Response_Data item in oResponse.data)
                {
                    OutputBuffer.AddRow();
                    vErrorActor = "Поле date";
                    OutputBuffer.date = Variables.vDate;
                    vErrorActor = "Поле id";
                    OutputBuffer.id = (long)item.id;
                    vErrorActor = "Поле itemid";
                    if (item.itemid != null) OutputBuffer.itemid = (long)item.itemid;
                    vErrorActor = "Поле Name";
                    if (item.name != null && item.name.Length > 0) OutputBuffer.name = item.name.Length > 4000 ? item.name.Substring(0, 4000) : item.name;
                    vErrorActor = "Поле url";
                    if (item.url != null && item.url.Length > 0) OutputBuffer.url = item.url.Length > 4000 ? item.url.Substring(0, 4000) : item.url;
                    vErrorActor = "Поле thumb";
                    if (item.thumb != null && item.thumb.Length > 0) OutputBuffer.thumb = item.thumb.Length > 4000 ? item.thumb.Substring(0, 4000) : item.thumb;
                    vErrorActor = "Поле thumb_middle";
                    if (item.thumb_middle != null && item.thumb_middle.Length > 0) OutputBuffer.thumbmiddle = item.thumb_middle.Length > 4000 ? item.thumb_middle.Substring(0, 4000) : item.thumb_middle;
                    vErrorActor = "Поле niche_id";
                    if (item.niche_id != null) OutputBuffer.nicheid = (long)item.niche_id;
                    vErrorActor = "Поле niche";
                    if (item.niche != null && item.niche.Length > 0) OutputBuffer.niche = item.niche.Length > 4000 ? item.niche.Substring(0, 4000) : item.niche;
                    vErrorActor = "Поле niche";
                    if (item.brand != null && item.brand.Length > 0) OutputBuffer.brand = item.brand.Length > 4000 ? item.brand.Substring(0, 4000) : item.brand;
                    vErrorActor = "Поле seller";
                    if (item.seller != null && item.seller.Length > 0) OutputBuffer.seller = item.seller.Length > 4000 ? item.seller.Substring(0, 4000) : item.seller;
