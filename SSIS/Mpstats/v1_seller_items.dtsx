                      SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[buffer].[Mpstats_v1_seller_items]')&#xA;            and   type = 'U')&#xA;   drop table [buffer].[Mpstats_v1_seller_items]&#xA;&#xA;SELECT TOP 0 * INTO [buffer].[Mpstats_v1_seller_items] FROM [Mpstats].[v1_seller_items]&#xA;&#xA;&#xA;CREATE INDEX IX_buffer_Mpstats_v1_seller_items ON [buffer].[Mpstats_v1_seller_items] ([marketplace],[date],[id])" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
