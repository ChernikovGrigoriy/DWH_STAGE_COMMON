      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5EE326D3-848C-45E4-8A8A-9231CADF14DD}"
          SQLTask:SqlStatementSource="MERGE [Mindbox].[exports_CDP_Segments] TGT&#xA;USING (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[externalId]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[systemName]&#xA;&#x9;&#x9;,[segmentationId]&#xA;&#x9;&#x9;,[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts]&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;  [id]&#xA;&#x9;&#x9;&#x9;  ,[externalId]&#xA;&#x9;&#x9;&#x9;  ,[name]&#xA;&#x9;&#x9;&#x9;  ,[systemName]&#xA;&#x9;&#x9;&#x9;  ,[segmentationId]&#xA;&#x9;&#x9;&#x9;  ,[_isDeleted]&#xA;&#x9;&#x9;&#x9;  ,[_rowversion_ts]&#xA;&#x9;&#x9;&#x9;  ,ROW_NUMBER() OVER (partition by [id] order by [version] desc) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[mindbos_exports_CDP_Segments_CSV]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA;) SRC ON TGT.id = SRC.id&#xA;WHEN MATCHED THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[id] = SRC.[id]&#xA;&#x9;&#x9;,[externalId] = SRC.[externalId]&#xA;&#x9;&#x9;,[name] = SRC.[name]&#xA;&#x9;&#x9;,[systemName] = SRC.[systemName]&#xA;&#x9;&#x9;,[segmentationId] = SRC.[segmentationId]&#xA;&#x9;&#x9;,[_isDeleted] = SRC.[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts] = SRC.[_rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[externalId]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[systemName]&#xA;&#x9;&#x9;,[segmentationId]&#xA;&#x9;&#x9;,[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[id]&#xA;&#x9;&#x9;,SRC.[externalId]&#xA;&#x9;&#x9;,SRC.[name]&#xA;&#x9;&#x9;,SRC.[systemName]&#xA;&#x9;&#x9;,SRC.[segmentationId]&#xA;&#x9;&#x9;,SRC.[_isDeleted]&#xA;&#x9;&#x9;,SRC.[_rowversion_ts]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;);&#xA;&#xA;UPDATE TGT SET&#xA;&#x9;TGT.[sign_table] = 1,&#xA;&#x9;TGT.[Parquet] = NULL,&#xA;&#x9;TGT.[CSV] = NULL&#xA;FROM&#xA;&#x9;[Mindbox].[LogParquetToCSV] TGT&#xA;WHERE&#xA;&#x9;TGT.TableName = 'exports.CDP.Segments'&#xA;&#x9;AND [id] in (SELECT DISTINCT [id_file] FROM [BUFFER].[mindbos_exports_CDP_Segments_CSV])" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
