          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[mindbos_exports_CDP_Segments_CSV]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[mindbos_exports_CDP_Segments_CSV]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[mindbos_exports_CDP_Segments_CSV] FROM [Mindbox].[exports_CDP_Segments]&#xA;&#xA;ALTER TABLE [BUFFER].[mindbos_exports_CDP_Segments_CSV] add [version] int&#xA;ALTER TABLE [BUFFER].[mindbos_exports_CDP_Segments_CSV] add [id_file] nvarchar(100)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
