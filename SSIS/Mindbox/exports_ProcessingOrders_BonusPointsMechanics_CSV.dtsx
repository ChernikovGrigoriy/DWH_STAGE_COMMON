    public static byte[] Decompress(byte[] data)
    {
        using (MemoryStream compressedStream = new MemoryStream(data))
        using (GZipStream gzipStream = new GZipStream(compressedStream, CompressionMode.Decompress))
        using (MemoryStream resultStream = new MemoryStream())
        {
            gzipStream.CopyTo(resultStream);
            return resultStream.ToArray();
        }
    }

    public string _ErrField;

    public override void CreateNewOutputRows()
    {
        OleDbConnection oOleDbConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        byte[] vDATA;

        try
        {
            oOleDbConnection.Open();
            OleDbCommand oSqlCommand = new OleDbCommand("SELECT CSV, [TableName], [id], [version] FROM [Mindbox].[LogParquetToCSV] WHERE [TableName] = 'exports.ProcessingOrders.BonusPointsMechanics' AND [sign_csv] = 1 AND [sign_table] = 0 ORDER BY [version]", oOleDbConnection);
            
            OleDbDataReader oSqlDataReader = oSqlCommand.ExecuteReader();
            while (oSqlDataReader.Read())
            {
                vDATA = Decompress((byte[])oSqlDataReader["CSV"]);
                using (var oMemoryStream = new MemoryStream(vDATA, 0, vDATA.Length, true, true))
                {
                    oMemoryStream.Position = 0;

                    using (TextFieldParser oTFP = new TextFieldParser(oMemoryStream))
                    {
                        oTFP.Delimiters = new string[] { ";" };
                        oTFP.HasFieldsEnclosedInQuotes = true;

                        string[] vFields = oTFP.ReadFields();

                         while (!oTFP.EndOfData)
                        {
                            string[] vValues = oTFP.ReadFields();

                            if (vFields.Length == vValues.Length)
                            {
                                OutputBuffer.AddRow();
                                OutputBuffer.version = (int) oSqlDataReader["version"];
                                OutputBuffer.idfile = (string) oSqlDataReader["id"];
                                for (int j = 0; j < vFields.Length; j++)
                                {
                                    _ErrField = string.Format("Field={0}", vFields[j]);
                                    switch (vFields[j])
                                    {

                                        case "id":
                                            if (vValues[j] != null) OutputBuffer.id = int.Parse(vValues[j]);
                                            break;

                                        case "internalId":
                                            if (vValues[j] != null) OutputBuffer.internalId = vValues[j].Length > 100 ? vValues[j].Substring(0, 100) : vValues[j];
                                            break;

                                        case "discriminator":
                                            if (vValues[j] != null) OutputBuffer.discriminator = vValues[j].Length > 500 ? vValues[j].Substring(0, 100) : vValues[j];
                                            break;

                                        case "name":
                                            if (vValues[j] != null) OutputBuffer.name = vValues[j].Length > 500 ? vValues[j].Substring(0, 100) : vValues[j];
                                            break;

                                        case "ownerId":
                                            if (vValues[j] != null) OutputBuffer.ownerId = vValues[j].Length > 500 ? vValues[j].Substring(0, 100) : vValues[j];
                                            break;

                                        case "ownerType":
                                            if (vValues[j] != null) OutputBuffer.ownerType = vValues[j].Length > 500 ? vValues[j].Substring(0, 100) : vValues[j];
                                            break;

                                        case "_rowversion_ts":
                                            try
                                            {
                                                if (vValues[j] != null) OutputBuffer.rowversionts = DateTime.ParseExact(vValues[j], "dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture);
                                            }
                                            catch
                                            {
                                                try
                                                {
                                                    if (vValues[j] != null) OutputBuffer.rowversionts = DateTime.ParseExact(vValues[j], "dd.MM.yyyy H:mm:ss", CultureInfo.InvariantCulture);
                                                }
                                                catch
                                                {

                                                }
                                            }
                                            break;
                                    }

                                }
                            }
                        } 
                    }                     

                }
            }
            oSqlDataReader.Close();

            oOleDbConnection.Close();
        }
        catch(Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "exports.ProcessingOrders.BonusPointsMechanics CSV", string.Format("Поле {0}  Сообщение:{1}", _ErrField,e.Message), "", 0, out cancel);
        }
    }

}
