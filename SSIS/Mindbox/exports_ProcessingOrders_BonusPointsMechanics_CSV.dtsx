          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV] FROM [Mindbox].[exports_ProcessingOrders_BonusPointsMechanics]&#xA;&#xA;ALTER TABLE [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV] add [version] int&#xA;ALTER TABLE [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV] add [id_file] nvarchar(100)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
