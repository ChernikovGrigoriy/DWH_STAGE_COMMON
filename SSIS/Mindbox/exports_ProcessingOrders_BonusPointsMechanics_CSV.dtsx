      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5EE326D3-848C-45E4-8A8A-9231CADF14DD}"
          SQLTask:SqlStatementSource="MERGE [Mindbox].[exports_ProcessingOrders_BonusPointsMechanics] TGT&#xA;USING (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[internalId]&#xA;&#x9;&#x9;,[discriminator]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[ownerId]&#xA;&#x9;&#x9;,[ownerType]&#xA;&#x9;&#x9;,[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts]&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;  [id]&#xA;&#x9;&#x9;&#x9;  ,[internalId]&#xA;&#x9;&#x9;&#x9;  ,[discriminator]&#xA;&#x9;&#x9;&#x9;  ,[name]&#xA;&#x9;&#x9;&#x9;  ,[ownerId]&#xA;&#x9;&#x9;&#x9;  ,[ownerType]&#xA;&#x9;&#x9;&#x9;  ,[_isDeleted]&#xA;&#x9;&#x9;&#x9;  ,[_rowversion_ts]&#xA;&#x9;&#x9;&#x9;  ,ROW_NUMBER() OVER (partition by [id] order by [version] desc) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA;) SRC ON TGT.id = SRC.id&#xA;WHEN MATCHED THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[id] = SRC.[id]&#xA;&#x9;&#x9;,[internalId] = SRC.[internalId]&#xA;&#x9;&#x9;,[discriminator] = SRC.[discriminator]&#xA;&#x9;&#x9;,[name] = SRC.[name]&#xA;&#x9;&#x9;,[ownerId] = SRC.[ownerId]&#xA;&#x9;&#x9;,[ownerType] = SRC.[ownerType]&#xA;&#x9;&#x9;,[_isDeleted] = SRC.[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts] = SRC.[_rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[internalId]&#xA;&#x9;&#x9;,[discriminator]&#xA;&#x9;&#x9;,[name]&#xA;&#x9;&#x9;,[ownerId]&#xA;&#x9;&#x9;,[ownerType]&#xA;&#x9;&#x9;,[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[id]&#xA;&#x9;&#x9;,SRC.[internalId]&#xA;&#x9;&#x9;,SRC.[discriminator]&#xA;&#x9;&#x9;,SRC.[name]&#xA;&#x9;&#x9;,SRC.[ownerId]&#xA;&#x9;&#x9;,SRC.[ownerType]&#xA;&#x9;&#x9;,SRC.[_isDeleted]&#xA;&#x9;&#x9;,SRC.[_rowversion_ts]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;);&#xA;&#xA;UPDATE TGT SET&#xA;&#x9;TGT.[sign_table] = 1,&#xA;&#x9;TGT.[Parquet] = NULL,&#xA;&#x9;TGT.[CSV] = NULL&#xA;FROM&#xA;&#x9;[Mindbox].[LogParquetToCSV] TGT&#xA;WHERE&#xA;&#x9;TGT.TableName = 'exports.ProcessingOrders.BonusPointsMechanics'&#xA;&#x9;AND [id] in (SELECT DISTINCT [id_file] FROM [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics_CSV])" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
