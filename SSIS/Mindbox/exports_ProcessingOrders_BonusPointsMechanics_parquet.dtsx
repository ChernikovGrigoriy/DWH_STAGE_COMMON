              SQLTask:Connection="{5EE326D3-848C-45E4-8A8A-9231CADF14DD}"
              SQLTask:SqlStatementSource="MERGE [Mindbox].[LogParquetToCSV] TGT&#xA;USING [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics] SRC ON TGT.[TableName] = SRC.[TableName] AND TGT.[id] = SRC.[id]&#xA;WHEN MATCHED  THEN&#xA;&#x9;UPDATE SET &#xA;&#x9;&#x9;[TableName] = SRC.[TableName],&#xA;&#x9;&#x9;[id] = SRC.[id],&#xA;&#x9;&#x9;[version] = SRC.[version],&#xA;&#x9;&#x9;[Parquet] = SRC.[Parquet],&#xA;&#x9;&#x9;[sign_parquet] = 1,&#xA;&#x9;&#x9;[sign_csv] = 0,&#xA;&#x9;&#x9;[sign_table] = 0,&#xA;&#x9;&#x9;SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT ([TableName], [id], [version], [Parquet], [sign_parquet], [sign_csv], [sign_table], SYSMOMENT)&#xA;&#x9;VALUES (SRC.[TableName], SRC.[id], SRC.[version], SRC.[Parquet], 1, 0, 0, GETDATE());&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
