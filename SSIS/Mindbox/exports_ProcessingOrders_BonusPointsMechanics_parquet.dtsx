              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointsMechanics] FROM [Mindbox].[LogParquetToCSV]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
