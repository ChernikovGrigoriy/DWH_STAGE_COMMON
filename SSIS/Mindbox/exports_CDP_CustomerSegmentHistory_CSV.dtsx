      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5EE326D3-848C-45E4-8A8A-9231CADF14DD}"
          SQLTask:SqlStatementSource="MERGE [Mindbox].[exports_CDP_CustomerSegmentHistory] TGT&#xA;USING (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[unmergedCustomerId]&#xA;&#x9;&#x9;,[segmentationId]&#xA;&#x9;&#x9;,[segmentId]&#xA;&#x9;&#x9;,[calculatedDateTimeUtc]&#xA;&#x9;&#x9;,[isDeleted]&#xA;&#x9;&#x9;,[rowversion_ts]&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;  [id]&#xA;&#x9;&#x9;&#x9;  ,[unmergedCustomerId]&#xA;&#x9;&#x9;&#x9;  ,[segmentationId]&#xA;&#x9;&#x9;&#x9;  ,[segmentId]&#xA;&#x9;&#x9;&#x9;  ,[calculatedDateTimeUtc]&#xA;&#x9;&#x9;&#x9;  ,[isDeleted]&#xA;&#x9;&#x9;&#x9;  ,[rowversion_ts]&#xA;&#x9;&#x9;&#x9;  ,ROW_NUMBER() OVER (partition by [id] order by [version] desc) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[mindbos_exports_CDP_CustomerSegmentHistory_CSV]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA;) SRC ON TGT.id = SRC.id&#xA;WHEN MATCHED THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[id] = SRC.[id]&#xA;&#x9;&#x9;,[unmergedCustomerId] = SRC.[unmergedCustomerId]&#xA;&#x9;&#x9;,[segmentationId] = SRC.[segmentationId]&#xA;&#x9;&#x9;,[segmentId] = SRC.[segmentId]&#xA;&#x9;&#x9;,[calculatedDateTimeUtc] = SRC.[calculatedDateTimeUtc]&#xA;&#x9;&#x9;,[isDeleted] = SRC.[isDeleted]&#xA;&#x9;&#x9;,[rowversion_ts] = SRC.[rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[unmergedCustomerId]&#xA;&#x9;&#x9;,[segmentationId]&#xA;&#x9;&#x9;,[segmentId]&#xA;&#x9;&#x9;,[calculatedDateTimeUtc]&#xA;&#x9;&#x9;,[isDeleted]&#xA;&#x9;&#x9;,[rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[id]&#xA;&#x9;&#x9;,SRC.[unmergedCustomerId]&#xA;&#x9;&#x9;,SRC.[segmentationId]&#xA;&#x9;&#x9;,SRC.[segmentId]&#xA;&#x9;&#x9;,SRC.[calculatedDateTimeUtc]&#xA;&#x9;&#x9;,SRC.[isDeleted]&#xA;&#x9;&#x9;,SRC.[rowversion_ts]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;);&#xA;&#xA;UPDATE TGT SET&#xA;&#x9;TGT.[sign_table] = 1,&#xA;&#x9;TGT.[Parquet] = NULL,&#xA;&#x9;TGT.[CSV] = NULL&#xA;FROM&#xA;&#x9;[Mindbox].[LogParquetToCSV] TGT&#xA;WHERE&#xA;&#x9;TGT.TableName = 'exports.CDP.CustomerSegmentHistory'&#xA;&#x9;AND [id] in (SELECT DISTINCT [id_file] FROM [BUFFER].[mindbos_exports_CDP_CustomerSegmentHistory_CSV])" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
