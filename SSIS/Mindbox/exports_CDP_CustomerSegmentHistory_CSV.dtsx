          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Mindbos_exports_CDP_CustomerSegmentHistory_CSV]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Mindbos_exports_CDP_CustomerSegmentHistory_CSV]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Mindbos_exports_CDP_CustomerSegmentHistory_CSV] FROM [Mindbox].[exports_CDP_CustomerSegmentHistory]&#xA;&#xA;ALTER TABLE [BUFFER].[Mindbos_exports_CDP_CustomerSegmentHistory_CSV] add [version] int&#xA;ALTER TABLE [BUFFER].[Mindbos_exports_CDP_CustomerSegmentHistory_CSV] add [id_file] nvarchar(100)&#xA;&#xA;CREATE INDEX IX_hgfAHSDGahsg ON [BUFFER].[Mindbos_exports_CDP_CustomerSegmentHistory_CSV] ([id], [version] desc)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
