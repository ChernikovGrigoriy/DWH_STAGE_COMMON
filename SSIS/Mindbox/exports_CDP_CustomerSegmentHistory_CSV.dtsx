         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public static byte[] Decompress(byte[] data)
    {
        using (MemoryStream compressedStream = new MemoryStream(data))
        using (GZipStream gzipStream = new GZipStream(compressedStream, CompressionMode.Decompress))
        using (MemoryStream resultStream = new MemoryStream())
        {
            gzipStream.CopyTo(resultStream);
            return resultStream.ToArray();
        }
    }

    public string _ErrField;

    public override void CreateNewOutputRows()
    {
        OleDbConnection oOleDbConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        byte[] vDATA;

        try
        {
            oOleDbConnection.Open();
            OleDbCommand oSqlCommand = new OleDbCommand("SELECT CSV, [TableName], [id], [version] FROM [Mindbox].[LogParquetToCSV] WHERE [TableName] = 'exports.CDP.CustomerSegmentHistory' AND [sign_csv] = 1 AND [sign_table] = 0", oOleDbConnection);
            
            OleDbDataReader oSqlDataReader = oSqlCommand.ExecuteReader();
            while (oSqlDataReader.Read())
            {
                vDATA = Decompress((byte[])oSqlDataReader["CSV"]);
                using (var oMemoryStream = new MemoryStream(vDATA, 0, vDATA.Length, true, true))
                {
                    oMemoryStream.Position = 0;

                    using (TextFieldParser oTFP = new TextFieldParser(oMemoryStream))
                    {
                        oTFP.Delimiters = new string[] { ";" };
                        oTFP.HasFieldsEnclosedInQuotes = true;

                        string[] vFields = oTFP.ReadFields();

                         while (!oTFP.EndOfData)
                        {
                            string[] vValues = oTFP.ReadFields();

                            if (vFields.Length == vValues.Length)
                            {
                                OutputBuffer.AddRow();
                                OutputBuffer.version = (int) oSqlDataReader["version"];
                                OutputBuffer.idfile = (string)oSqlDataReader["id"];
                                for (int j = 0; j < vFields.Length; j++)
                                {
                                    _ErrField = string.Format("Field={0}", vFields[j]);
                                    switch (vFields[j])
                                    {

                                        case "id":
                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.id = long.Parse(vValues[j]);
                                            break;

                                        case "unmergedCustomerId":
                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.unmergedCustomerId = long.Parse(vValues[j]);
                                            break;

                                        case "segmentationId":
                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.segmentationId = int.Parse(vValues[j]);
                                            break;

                                        case "segmentId":
                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.segmentId = int.Parse(vValues[j]);
                                            break;

                                        case "calculatedDateTimeUtc":
                                            try
                                            {
                                                if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.calculatedDateTimeUtc = DateTime.ParseExact(vValues[j], "dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture);
                                            }
                                            catch
                                            {
                                                try
                                                {
                                                    if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.calculatedDateTimeUtc = DateTime.ParseExact(vValues[j], "dd.MM.yyyy H:mm:ss", CultureInfo.InvariantCulture);
                                                }
                                                catch
                                                {

                                                }
                                            }
                                            break;

                                        case "_rowversion_ts":
                                            try
                                            {
                                                if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.rowversionts = DateTime.ParseExact(vValues[j], "dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture);
                                            }
                                            catch
                                            {
                                                try
                                                {
                                                    if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.rowversionts = DateTime.ParseExact(vValues[j], "dd.MM.yyyy H:mm:ss", CultureInfo.InvariantCulture);
                                                }
                                                catch
                                                {

                                                }
                                            }
                                            break;
                                    }

                                }
                            }
                        } 
                    }                     

                }
            }
            oSqlDataReader.Close();

            oOleDbConnection.Close();
        }
        catch(Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "exports.CDP.CustomerSegmentHistory CSV", string.Format("Поле {0}  Сообщение:{1}", _ErrField,e.Message), "", 0, out cancel);
        }
    }

}
