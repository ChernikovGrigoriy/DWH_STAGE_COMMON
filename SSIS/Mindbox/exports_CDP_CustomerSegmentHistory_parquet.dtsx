              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[mindbox_exports_CDP_CustomerSegmentHistory_parquet]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[mindbox_exports_CDP_CustomerSegmentHistory_parquet]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[mindbox_exports_CDP_CustomerSegmentHistory_parquet] FROM [Mindbox].[LogParquetToCSV]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
