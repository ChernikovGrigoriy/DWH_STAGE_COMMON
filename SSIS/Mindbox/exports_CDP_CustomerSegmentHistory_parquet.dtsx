          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5EE326D3-848C-45E4-8A8A-9231CADF14DD}"
              SQLTask:SqlStatementSource="DECLARE @TableName nvarchar(200), @version int&#xA;&#xA;SELECT @TableName = ?, @version = ?&#xA;&#xA;MERGE [Mindbox].[LogParquetToCSV] TGT&#xA;USING [BUFFER].[mindbox_exports_CDP_CustomerSegmentHistory_parquet] SRC ON TGT.[TableName] = SRC.[TableName] AND TGT.[id] = SRC.[id]&#xA;WHEN MATCHED  THEN&#xA;&#x9;UPDATE SET &#xA;&#x9;&#x9;[TableName] = SRC.[TableName],&#xA;&#x9;&#x9;[id] = SRC.[id],&#xA;&#x9;&#x9;[version] = SRC.[version],&#xA;&#x9;&#x9;[Parquet] = SRC.[Parquet],&#xA;&#x9;&#x9;[sign_parquet] = 1,&#xA;&#x9;&#x9;[sign_csv] = 0,&#xA;&#x9;&#x9;[sign_table] = 0,&#xA;&#x9;&#x9;SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT ([TableName], [id], [version], [Parquet], [sign_parquet], [sign_csv], [sign_table], SYSMOMENT)&#xA;&#x9;VALUES (SRC.[TableName], SRC.[id], SRC.[version], SRC.[Parquet], 1, 0, 0, GETDATE());&#xA;&#xA;MERGE [Mindbox].[MaxParquet] TGT&#xA;USING (SELECT @TableName [TableName], @version [version]) SRC ON TGT.[TableName] = SRC.[TableName] &#xA;WHEN MATCHED THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[TableName] = SRC.[TableName],&#xA;&#x9;&#x9;[version] = SRC.[version],&#xA;&#x9;&#x9;[SYSMOMENT] = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT ([TableName], [version], [SYSMOMENT])&#xA;&#x9;VALUES (SRC.[TableName], SRC.[version], GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="$Package::pTableName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::vMaxVersion"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="20"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
