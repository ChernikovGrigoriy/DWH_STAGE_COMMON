      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5EE326D3-848C-45E4-8A8A-9231CADF14DD}"
          SQLTask:SqlStatementSource="MERGE [Mindbox].[exports_ProcessingOrders_BonusPointChanges] TGT&#xA;USING (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[kindSystemName]&#xA;&#x9;&#x9;,[mechanicsInternalId]&#xA;&#x9;&#x9;,[balanceInternalId]&#xA;&#x9;&#x9;,[changeAmount]&#xA;&#x9;&#x9;,[availableFromDateTimeUtc]&#xA;&#x9;&#x9;,[expirationDateTimeUtc]&#xA;&#x9;&#x9;,[dateTimeUtc]&#xA;&#x9;&#x9;,[unmergedCustomerId]&#xA;&#x9;&#x9;,[orderId]&#xA;&#x9;&#x9;,[comments]&#xA;&#x9;&#x9;,[pointOfContactInternalId]&#xA;&#x9;&#x9;,[brandInternalId]&#xA;&#x9;&#x9;,[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts]&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;  [id]&#xA;&#x9;&#x9;&#x9;  ,[kindSystemName]&#xA;&#x9;&#x9;&#x9;  ,[mechanicsInternalId]&#xA;&#x9;&#x9;&#x9;  ,[balanceInternalId]&#xA;&#x9;&#x9;&#x9;  ,[changeAmount]&#xA;&#x9;&#x9;&#x9;  ,[availableFromDateTimeUtc]&#xA;&#x9;&#x9;&#x9;  ,[expirationDateTimeUtc]&#xA;&#x9;&#x9;&#x9;  ,[dateTimeUtc]&#xA;&#x9;&#x9;&#x9;  ,[unmergedCustomerId]&#xA;&#x9;&#x9;&#x9;  ,[orderId]&#xA;&#x9;&#x9;&#x9;  ,[comments]&#xA;&#x9;&#x9;&#x9;  ,[pointOfContactInternalId]&#xA;&#x9;&#x9;&#x9;  ,[brandInternalId]&#xA;&#x9;&#x9;&#x9;  ,[_isDeleted]&#xA;&#x9;&#x9;&#x9;  ,[_rowversion_ts]&#xA;&#x9;&#x9;&#x9;  ,ROW_NUMBER() OVER (partition by [id] order by [version] desc) RN&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointChanges_CSV]&#xA;&#x9;&#x9;) TMP&#xA;&#x9;WHERE&#xA;&#x9;&#x9;RN = 1&#xA;) SRC ON TGT.id = SRC.id&#xA;WHEN MATCHED THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[id] = SRC.[id]&#xA;&#x9;&#x9;,[kindSystemName] = SRC.[kindSystemName]&#xA;&#x9;&#x9;,[mechanicsInternalId] = SRC.[mechanicsInternalId]&#xA;&#x9;&#x9;,[balanceInternalId] = SRC.[balanceInternalId]&#xA;&#x9;&#x9;,[changeAmount] = SRC.[changeAmount]&#xA;&#x9;&#x9;,[availableFromDateTimeUtc] = SRC.[availableFromDateTimeUtc]&#xA;&#x9;&#x9;,[expirationDateTimeUtc] = SRC.[expirationDateTimeUtc]&#xA;&#x9;&#x9;,[dateTimeUtc] = SRC.[dateTimeUtc]&#xA;&#x9;&#x9;,[unmergedCustomerId] = SRC.[unmergedCustomerId]&#xA;&#x9;&#x9;,[orderId] = SRC.[orderId]&#xA;&#x9;&#x9;,[comments] = SRC.[comments]&#xA;&#x9;&#x9;,[pointOfContactInternalId] = SRC.[pointOfContactInternalId]&#xA;&#x9;&#x9;,[brandInternalId] = SRC.[brandInternalId]&#xA;&#x9;&#x9;,[_isDeleted] = SRC.[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts] = SRC.[_rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;&#x9;[id]&#xA;&#x9;&#x9;,[kindSystemName]&#xA;&#x9;&#x9;,[mechanicsInternalId]&#xA;&#x9;&#x9;,[balanceInternalId]&#xA;&#x9;&#x9;,[changeAmount]&#xA;&#x9;&#x9;,[availableFromDateTimeUtc]&#xA;&#x9;&#x9;,[expirationDateTimeUtc]&#xA;&#x9;&#x9;,[dateTimeUtc]&#xA;&#x9;&#x9;,[unmergedCustomerId]&#xA;&#x9;&#x9;,[orderId]&#xA;&#x9;&#x9;,[comments]&#xA;&#x9;&#x9;,[pointOfContactInternalId]&#xA;&#x9;&#x9;,[brandInternalId]&#xA;&#x9;&#x9;,[_isDeleted]&#xA;&#x9;&#x9;,[_rowversion_ts]&#xA;&#x9;&#x9;,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[id]&#xA;&#x9;&#x9;,SRC.[kindSystemName]&#xA;&#x9;&#x9;,SRC.[mechanicsInternalId]&#xA;&#x9;&#x9;,SRC.[balanceInternalId]&#xA;&#x9;&#x9;,SRC.[changeAmount]&#xA;&#x9;&#x9;,SRC.[availableFromDateTimeUtc]&#xA;&#x9;&#x9;,SRC.[expirationDateTimeUtc]&#xA;&#x9;&#x9;,SRC.[dateTimeUtc]&#xA;&#x9;&#x9;,SRC.[unmergedCustomerId]&#xA;&#x9;&#x9;,SRC.[orderId]&#xA;&#x9;&#x9;,SRC.[comments]&#xA;&#x9;&#x9;,SRC.[pointOfContactInternalId]&#xA;&#x9;&#x9;,SRC.[brandInternalId]&#xA;&#x9;&#x9;,SRC.[_isDeleted]&#xA;&#x9;&#x9;,SRC.[_rowversion_ts]&#xA;&#x9;&#x9;,GETDATE()&#xA;&#x9;);&#xA;&#xA;&#x9;&#xA;UPDATE TGT SET&#xA;&#x9;TGT.[sign_table] = 1,&#xA;&#x9;TGT.[Parquet] = NULL,&#xA;&#x9;TGT.[CSV] = NULL&#xA;FROM&#xA;&#x9;[Mindbox].[LogParquetToCSV] TGT&#xA;WHERE&#xA;&#x9;TGT.TableName = 'exports.ProcessingOrders.BonusPointChanges'&#xA;&#x9;AND [id] in (SELECT DISTINCT [id_file] FROM[BUFFER].[Mindbox_exports_ProcessingOrders_BonusPointChanges_CSV] )&#xA;&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
