    private void Parse_services_and_orders_margin(ZipArchiveEntry entry)
    {
        if (entry.Name != "services_and_orders_margin.csv")
            return;

        using (var oEntryStream = entry.Open())
        {
            using (var reader = new StreamReader(oEntryStream))
            {
                string content = reader.ReadToEnd();

                using (var oCSVStream = new MemoryStream())
                {
                    using (var oWriter = new StreamWriter(oCSVStream))
                    {
                        oWriter.Write(content);
                        oWriter.Flush();

                        oCSVStream.Position = 0;

                        int vNumStr = 1;

                        using (Microsoft.VisualBasic.FileIO.TextFieldParser oTFP = new TextFieldParser(oCSVStream))
                        {
                            oTFP.Delimiters = new string[] { "," };
                            oTFP.HasFieldsEnclosedInQuotes = true;

                            string[] vFields = oTFP.ReadFields();

                            while (!oTFP.EndOfData)
                            {
                                vNumStr++;

                                string[] vValues = oTFP.ReadFields();

                                if (vFields.Length == vValues.Length)
                                {
                                    servicesandordersmarginBuffer.AddRow();
                                    for (int j = 0; j < vFields.Length; j++)
                                    {
                                        _Error = string.Format("Parse_banners Field={0}, строка {1}, Дата начала {2}, дата окончания {3}", vFields[j], vNumStr, Variables.vDATESTART, Variables.vDATEFINISH);
                                        switch (vFields[j])
                                        {

                                            case "MODEL":
                                                if (vValues[j] != null && vValues[j].Length > 0) servicesandordersmarginBuffer.MODEL = vValues[j].Length > 100 ? vValues[j].Substring(0, 100) : vValues[j];
                                                break;

                                            case "PARTNER_ID":
                                                if (vValues[j] != null && vValues[j].Length > 0) servicesandordersmarginBuffer.PARTNERID = Int32.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                break;

                                            case "SHOP_NAME":
                                                if (vValues[j] != null && vValues[j].Length > 0) servicesandordersmarginBuffer.SHOPNAME = vValues[j].Length > 200 ? vValues[j].Substring(0, 200) : vValues[j];
                                                break;

                                            case "INN":
                                                if (vValues[j] != null && vValues[j].Length > 0) servicesandordersmarginBuffer.INN = vValues[j].Length > 20 ? vValues[j].Substring(0, 20) : vValues[j];
