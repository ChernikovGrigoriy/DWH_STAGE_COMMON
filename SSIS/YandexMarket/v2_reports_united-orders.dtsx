    public override void CreateNewOutputRows()
    {

        string vURL = null;

        try
        {
            Mutex oMutex = new Mutex(false, "Mutex_YM_4e32812a-5cea-4846-8612-918346ae8501");

            oMutex.WaitOne();

            try
