            catch (Exception)
            {
                throw;
            }
            finally
            {
                oMutex.ReleaseMutex();
            }

            if (vURL != null)
            {

                CultureInfo provider = CultureInfo.InvariantCulture;

                YandexMarketWebClient oYMWC = new YandexMarketWebClient(30000, 6, 20000);

                byte[] oDATA = oYMWC.SendRequestWithRateLimit(vURL, Variables.vApiKey);

                using (var oMemoryStream = new MemoryStream(oDATA))
                {
                    using (var oZipArchive = new ZipArchive(oMemoryStream, ZipArchiveMode.Read))
                    {
                        foreach (ZipArchiveEntry entry in oZipArchive.Entries)
                        {
                            Parse_orders_and_offers_transactions(entry);
                            Parse_services_and_orders_margin(entry);
                            Parse_services_with_decoupling(entry);
