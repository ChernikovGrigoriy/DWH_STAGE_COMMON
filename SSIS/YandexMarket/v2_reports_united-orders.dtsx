                  SQLTask:SqlStatementSource="DECLARE @BUSINESS_ID bigint&#xA;&#xA;SET @BUSINESS_ID =?&#xA;&#xA;&#xA;SELECT &#xA; [Data] DATE_START, EOMONTH([Data]) DATE_FINISH&#xA;FROM&#xA; [dbo].[fnDATA] (DATEADD(month,-2,GETDATE()), GETDATE(),1)&#xA;EXCEPT&#xA;SELECT [DATE_START], [DATE_FINISH]&#xA;FROM&#xA;(&#xA;SELECT&#xA; DISTINCT&#xA; [DATE_START], [DATE_FINISH]&#xA;FROM&#xA; [YandexMarket].[v2_reports_united-orders_orders_and_offers_transactions]&#xA;WHERE&#xA; [BUSINESS_ID] = @BUSINESS_ID&#xA;UNION&#xA;SELECT&#xA; DISTINCT&#xA; [DATE_START], [DATE_FINISH]&#xA;FROM&#xA; [YandexMarket].[v2_reports_united-orders_services_with_decoupling]&#xA;WHERE&#xA; [BUSINESS_ID] = @BUSINESS_ID&#xA;UNION&#xA;SELECT&#xA; DISTINCT&#xA; [DATE_START], [DATE_FINISH]&#xA;FROM&#xA; [YandexMarket].[v2_reports_united-orders_services_and_orders_margin]&#xA;WHERE&#xA; [BUSINESS_ID] = @BUSINESS_ID&#xA;) TMP&#xA;UNION&#xA;SELECT &#xA; [Data] DATE_START, EOMONTH([Data]) DATE_FINISH&#xA;FROM&#xA; [dbo].[fnDATA] (DATEADD(month,-2,GETDATE()), GETDATE(), 1)&#xA;"
