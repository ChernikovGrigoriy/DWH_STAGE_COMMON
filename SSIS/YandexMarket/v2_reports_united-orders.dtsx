                      <DTS:ObjectData>
                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                          SQLTask:SqlStatementSource="DECLARE @BUSINESS_ID bigint, @DATE_START date, @DATE_FINISH date&#xA;&#xA;SELECT @BUSINESS_ID = ?, @DATE_START = ?, @DATE_FINISH = ?&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA;DELETE FROM [YandexMarket].[v2_reports_united-orders_orders_and_offers_transactions] WHERE [BUSINESS_ID] = @BUSINESS_ID AND [DATE_START] = @DATE_START AND [DATE_FINISH] = @DATE_FINISH&#xA;&#xA;INSERT INTO [YandexMarket].[v2_reports_united-orders_orders_and_offers_transactions]&#xA;(&#xA;&#x9;  [BUSINESS_ID]&#xA;      ,[DATE_START]&#xA;      ,[DATE_FINISH]&#xA;      ,[MODEL]&#xA;      ,[PARTNER_ID]&#xA;      ,[SHOP_NAME]&#xA;      ,[INN]&#xA;      ,[PLACEMENT_CONTRACT]&#xA;      ,[PROMOTION_CONTRACT]&#xA;      ,[ORDER_ID]&#xA;      ,[PARTNER_ORDER_ID]&#xA;      ,[CREATION_DATE]&#xA;      ,[ORDER_TYPE]&#xA;      ,[SHOP_SKU]&#xA;      ,[OFFER_NAME]&#xA;      ,[PARTNER_PRICE_FOR_DELIVERY]&#xA;      ,[BILLING_PRICE]&#xA;      ,[COFINANCE_TRESHOLD]&#xA;      ,[COFINANCE_VALUE]&#xA;      ,[COFINANCE_SUBSIDY]&#xA;      ,[MARKETPLACE_SUBSIDY]&#xA;      ,[SPASIBO]&#xA;      ,[YANDEX_PLUS]&#xA;      ,[TRANSFERRED_FOR_DELIVERY]&#xA;      ,[DELIVERED_OR_RETURNED]&#xA;      ,[DELIVERY_DATE]&#xA;      ,[OFFER_STATUS]&#xA;      ,[STATUS_CHANGED]&#xA;      ,[PAYMENT_TYPE]&#xA;      ,[SHIPMENT_WAREHOUSE]&#xA;      ,[SHIPMENT_DATE]&#xA;      ,[DELIVERY_REGION]&#xA;      ,[BUYER_PAYMENT_AMOUNT]&#xA;      ,[BUYER_PAYMENT_BANK_ORDER_ID]&#xA;      ,[BUYER_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[BUYER_PAYMENT_ID]&#xA;      ,[BUYER_PAYMENT_HANDLING_TIME]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_AMOUNT]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_ID]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_ID]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_HANDLING_TIME]&#xA;      ,[SPASIBO_PAYMENT_AMOUNT]&#xA;      ,[SPASIBO_PAYMENT_BANK_ORDER_ID]&#xA;      ,[SPASIBO_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[SPASIBO_PAYMENT_ID]&#xA;      ,[SPASIBO_PAYMENT_HANDLING_TIME]&#xA;      ,[YANDEX_PLUS_PAYMENT_AMOUNT]&#xA;      ,[YANDEX_PLUS_PAYMENT_BANK_ORDER_ID]&#xA;      ,[YANDEX_PLUS_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[YANDEX_PLUS_PAYMENT_ID]&#xA;      ,[YANDEX_PLUS_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_BUYER_PAYMENT_AMOUNT]&#xA;      ,[REFUND_BUYER_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_BUYER_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_BUYER_PAYMENT_ID]&#xA;      ,[REFUND_BUYER_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_AMOUNT]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_ID]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_SPASIBO_PAYMENT_AMOUNT]&#xA;      ,[REFUND_SPASIBO_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_SPASIBO_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_SPASIBO_PAYMENT_ID]&#xA;      ,[REFUND_SPASIBO_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_AMOUNT]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_ID]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_HANDLING_TIME]&#xA;      ,[DEFECT_REFUND_PAYMENT_AMOUNT]&#xA;      ,[DEFECT_REFUND_PAYMENT_BANK_ORDER_ID]&#xA;      ,[DEFECT_REFUND_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[DEFECT_REFUND_PAYMENT_ID]&#xA;      ,[DEFECT_REFUND_PAYMENT_HANDLING_TIME]&#xA;      ,[NETTING_AMOUNT]&#xA;      ,[NETTING_TRANSACTION_STATUS]&#xA;      ,[SYSMOMENT]&#xA;&#x9;  ,id_account&#xA;)&#xA;SELECT [BUSINESS_ID]&#xA;      ,[DATE_START]&#xA;      ,[DATE_FINISH]&#xA;      ,[MODEL]&#xA;      ,[PARTNER_ID]&#xA;      ,[SHOP_NAME]&#xA;      ,[INN]&#xA;      ,[PLACEMENT_CONTRACT]&#xA;      ,[PROMOTION_CONTRACT]&#xA;      ,[ORDER_ID]&#xA;      ,[PARTNER_ORDER_ID]&#xA;      ,[CREATION_DATE]&#xA;      ,[ORDER_TYPE]&#xA;      ,[SHOP_SKU]&#xA;      ,[OFFER_NAME]&#xA;      ,[PARTNER_PRICE_FOR_DELIVERY]&#xA;      ,[BILLING_PRICE]&#xA;      ,[COFINANCE_TRESHOLD]&#xA;      ,[COFINANCE_VALUE]&#xA;      ,[COFINANCE_SUBSIDY]&#xA;      ,[MARKETPLACE_SUBSIDY]&#xA;      ,[SPASIBO]&#xA;      ,[YANDEX_PLUS]&#xA;      ,[TRANSFERRED_FOR_DELIVERY]&#xA;      ,[DELIVERED_OR_RETURNED]&#xA;      ,[DELIVERY_DATE]&#xA;      ,[OFFER_STATUS]&#xA;      ,[STATUS_CHANGED]&#xA;      ,[PAYMENT_TYPE]&#xA;      ,[SHIPMENT_WAREHOUSE]&#xA;      ,[SHIPMENT_DATE]&#xA;      ,[DELIVERY_REGION]&#xA;      ,[BUYER_PAYMENT_AMOUNT]&#xA;      ,[BUYER_PAYMENT_BANK_ORDER_ID]&#xA;      ,[BUYER_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[BUYER_PAYMENT_ID]&#xA;      ,[BUYER_PAYMENT_HANDLING_TIME]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_AMOUNT]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_ID]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_ID]&#xA;      ,[MARKETPLACE_DISCOUNT_PAYMENT_HANDLING_TIME]&#xA;      ,[SPASIBO_PAYMENT_AMOUNT]&#xA;      ,[SPASIBO_PAYMENT_BANK_ORDER_ID]&#xA;      ,[SPASIBO_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[SPASIBO_PAYMENT_ID]&#xA;      ,[SPASIBO_PAYMENT_HANDLING_TIME]&#xA;      ,[YANDEX_PLUS_PAYMENT_AMOUNT]&#xA;      ,[YANDEX_PLUS_PAYMENT_BANK_ORDER_ID]&#xA;      ,[YANDEX_PLUS_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[YANDEX_PLUS_PAYMENT_ID]&#xA;      ,[YANDEX_PLUS_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_BUYER_PAYMENT_AMOUNT]&#xA;      ,[REFUND_BUYER_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_BUYER_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_BUYER_PAYMENT_ID]&#xA;      ,[REFUND_BUYER_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_AMOUNT]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_ID]&#xA;      ,[REFUND_MARKETPLACE_DISCOUNT_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_SPASIBO_PAYMENT_AMOUNT]&#xA;      ,[REFUND_SPASIBO_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_SPASIBO_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_SPASIBO_PAYMENT_ID]&#xA;      ,[REFUND_SPASIBO_PAYMENT_HANDLING_TIME]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_AMOUNT]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_BANK_ORDER_ID]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_ID]&#xA;      ,[REFUND_YANDEX_PLUS_PAYMENT_HANDLING_TIME]&#xA;      ,[DEFECT_REFUND_PAYMENT_AMOUNT]&#xA;      ,[DEFECT_REFUND_PAYMENT_BANK_ORDER_ID]&#xA;      ,[DEFECT_REFUND_PAYMENT_BANK_ORDER_DATE]&#xA;      ,[DEFECT_REFUND_PAYMENT_ID]&#xA;      ,[DEFECT_REFUND_PAYMENT_HANDLING_TIME]&#xA;      ,[NETTING_AMOUNT]&#xA;      ,[NETTING_TRANSACTION_STATUS]&#xA;      ,GETDATE()&#xA;&#x9;  ,id_account&#xA;  FROM &#xA;&#x9;[BUFFER].[YandexMarket_v2_reports_united-orders_orders_and_offers_transactions]&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                          <SQLTask:ParameterBinding
