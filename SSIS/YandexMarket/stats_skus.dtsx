            <DTS:Executable
              DTS:refId="Package\Загрузка\Foreach Loop Container\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{6BDE4C6C-EC56-4BE7-A28D-E3D79C6AA50B}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка в стейджинг"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="INSERT INTO [YandexMarket].[stats_skus]&#xA;(&#xA;[campaign_id]&#xA;      ,[shopSku]&#xA;      ,[marketSku]&#xA;      ,[name]&#xA;      ,[price]&#xA;      ,[categoryId]&#xA;      ,[categoryName]&#xA;      ,[weightDimensions_length]&#xA;      ,[weightDimensions_width]&#xA;      ,[weightDimensions_height]&#xA;      ,[weightDimensions_weight]&#xA;      ,[SYSMOMENT]&#xA;)&#xA;SELECT[campaign_id]&#xA;      ,[shopSku]&#xA;      ,[marketSku]&#xA;      ,[name]&#xA;      ,[price]&#xA;      ,[categoryId]&#xA;      ,[categoryName]&#xA;      ,[weightDimensions_length]&#xA;      ,[weightDimensions_width]&#xA;      ,[weightDimensions_height]&#xA;      ,[weightDimensions_weight]&#xA;      ,GETDATE()&#xA;FROM&#xA;&#x9;[BUFFER].[YandexMarket_stats_skus] SS&#xA;WHERE&#xA;&#x9;NOT EXISTS(SELECT TOP 1 1 FROM [YandexMarket].[stats_skus] YSS WHERE YSS.[campaign_id] = SS.[campaign_id] AND YSS.[shopSku] = SS.[shopSku])&#xA;&#xA;&#xA;INSERT INTO [YandexMarket].[stats_skus_tariffs]&#xA;(&#xA;[campaign_id]&#xA;      ,[shopSku]&#xA;      ,[type]&#xA;      ,[percent]&#xA;      ,[amount]&#xA;      ,[currency]&#xA;      ,[SYSMOMENT]&#xA;)&#xA;SELECT [campaign_id]&#xA;      ,[shopSku]&#xA;      ,[type]&#xA;      ,[percent]&#xA;      ,[amount]&#xA;      ,[currency]&#xA;      ,GETDATE()&#xA;  FROM [BUFFER].[YandexMarket_stats_skus_tariffs] SS&#xA;  WHERE&#xA;&#x9;&#x9;NOT EXISTS(SELECT TOP 1 1 FROM [YandexMarket].[stats_skus_tariffs] YSS WHERE YSS.[campaign_id] = SS.[campaign_id] AND YSS.[shopSku] = SS.[shopSku])&#xA;&#xA;INSERT INTO [YandexMarket].[stats_skus_tariffs_parameters]&#xA;(&#xA;[campaign_id]&#xA;      ,[shopSku]&#xA;      ,[type]&#xA;      ,[name]&#xA;      ,[value]&#xA;      ,[SYSMOMENT]&#xA;)&#xA;SELECT [campaign_id]&#xA;      ,[shopSku]&#xA;      ,[type]&#xA;      ,[name]&#xA;      ,[value]&#xA;      ,GETDATE()&#xA;  FROM [BUFFER].[YandexMarket_stats_skus_tariffs_parameters] SS&#xA;  WHERE&#xA;&#x9;&#x9;NOT EXISTS(SELECT TOP 1 1 FROM [YandexMarket].[stats_skus_tariffs_parameters] YSS WHERE YSS.[campaign_id] = SS.[campaign_id] AND YSS.[shopSku] = SS.[shopSku])&#xA;&#xA;&#xA;INSERT INTO [YandexMarket].[stats_skus_pictures]&#xA;(&#xA;[campaign_id]&#xA;      ,[shopSku]&#xA;      ,[value]&#xA;      ,[SYSMOMENT]&#xA;)&#xA;SELECT [campaign_id]&#xA;      ,[shopSku]&#xA;      ,[value]&#xA;      ,GETDATE()&#xA;  FROM [BUFFER].[YandexMarket_stats_skus_pictures] SS&#xA;  WHERE&#xA;&#x9;&#x9;NOT EXISTS(SELECT TOP 1 1 FROM [YandexMarket].[stats_skus_pictures] YSS WHERE YSS.[campaign_id] = SS.[campaign_id] AND YSS.[shopSku] = SS.[shopSku])" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
