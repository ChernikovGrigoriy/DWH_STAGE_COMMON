    public override void CreateNewOutputRows()
    {
        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        List<string> oShopSkus = new List<string>();

        OleDbConnection oConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);

        try
        {
            byte[] oDATA = null;

            oConnection.Open();
            OleDbCommand oCommand = new OleDbCommand(string.Format("SELECT DISTINCT [offerId] FROM [YandexMarket].[offerMappings] OM WHERE NOT EXISTS(SELECT TOP 1 1 FROM [YandexMarket].stats_skus SS WHERE SS.campaign_id = {0} AND SS.shopSku = OM.offerId)", Variables.vCampaignId), oConnection);

            OleDbDataReader oReader = oCommand.ExecuteReader();

            while (oReader.Read()) 
            {
                oShopSkus.Add((string) oReader[0]);
            }

            oReader.Close();

            if (oShopSkus.Count > 0)
            {
                do
                {
                    string[] oShopSkus500 = oShopSkus.Take<string>(500).ToArray();
                    Request oRequest = new Request
                    {
                        shopSkus = oShopSkus500
                    };
                    foreach (string item in oShopSkus500) { oShopSkus.Remove(item); }
                    ;

                    YandexMarketWebClient oYMWC = new YandexMarketWebClient(60000, 15, 20000);

                    oDATA = oYMWC.SendRequestWithRateLimit(String.Format("https://api.partner.market.yandex.ru/campaigns/{0}/stats/skus", Variables.vCampaignId), Variables.pApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));

                    Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                    if (oResponse != null && oResponse.status == "OK" && oResponse.result != null && oResponse.result.shopSkus != null)
                    {
                        foreach (Response_Result_shopSku item in oResponse.result.shopSkus)
                        {
                            statsskusBuffer.AddRow();
                            statsskusBuffer.shopSku = item.shopSku;
                            if (item.marketSku != null) statsskusBuffer.marketSku = (long)item.marketSku;
                            if (item.name != null && item.name.Length > 0) statsskusBuffer.name = item.name.Length > 200 ? item.name.Substring(0, 200) : item.name;
                            if (item.price != null) statsskusBuffer.price = (decimal)item.price;
                            if (item.categoryId != null) statsskusBuffer.categoryId = (long)item.categoryId;
                            if (item.categoryName != null && item.categoryName.Length > 0) statsskusBuffer.categoryName = item.categoryName.Length > 200 ? item.categoryName.Substring(0, 200) : item.categoryName;
                            if (item.weightDimensions != null)
                            {
                                if (item.weightDimensions.length != null) statsskusBuffer.weightDimensionslength = (decimal)item.weightDimensions.length;
                                if (item.weightDimensions.width != null) statsskusBuffer.weightDimensionswidth = (decimal)item.weightDimensions.width;
                                if (item.weightDimensions.height != null) statsskusBuffer.weightDimensionsheight = (decimal)item.weightDimensions.height;
                                if (item.weightDimensions.weight != null) statsskusBuffer.weightDimensionsweight = (decimal)item.weightDimensions.weight;
                            }

                            if (item.pictures != null)
                            {
                                foreach (string value in item.pictures)
                                {
                                    statsskuspicturesBuffer.AddRow();
                                    statsskuspicturesBuffer.shopSku = item.shopSku;
                                    statsskuspicturesBuffer.value = value;
                                }
                            }

                            if (item.tariffs != null)
                            {
                                foreach (Response_Result_shopSku_tariff tariff in item.tariffs)
                                {
                                    statsskustariffsBuffer.AddRow();
                                    statsskustariffsBuffer.shopSku = item.shopSku;
                                    statsskustariffsBuffer.type = tariff.type;
                                    if (tariff.percent != null) statsskustariffsBuffer.percent = (decimal)tariff.percent;
                                    if (tariff.amount != null) statsskustariffsBuffer.amount = (decimal)tariff.amount;
                                    if (tariff.currency != null && tariff.currency.Length > 0) statsskustariffsBuffer.currency = tariff.currency.Length > 20 ? tariff.currency.Substring(0, 20) : tariff.currency;

                                    if (tariff.parameters != null)
                                    {
                                        foreach (Response_Result_shopSku_tariff_parameter param in tariff.parameters)
                                        {
                                            statsskustariffsparametersBuffer.AddRow();
                                            statsskustariffsparametersBuffer.shopSku = item.shopSku;
                                            statsskustariffsparametersBuffer.type = tariff.type;
                                            if (param.name != null && param.name.Length > 0) statsskustariffsparametersBuffer.name = param.name.Length > 50 ? param.name.Substring(0, 50) : param.name;
                                            if (param.value != null && param.value.Length > 0) statsskustariffsparametersBuffer.value = param.value.Length > 50 ? param.value.Substring(0, 50) : param.value;
                                        }
                                    }
                                }
                            }
                        }
                    }

                } while (oShopSkus.Count > 0);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "stats_skus", e.Message, "", 0, out cancel);
        }
        finally
        {
            if (oConnection.State == ConnectionState.Open) oConnection.Close();
        }

    }

}
