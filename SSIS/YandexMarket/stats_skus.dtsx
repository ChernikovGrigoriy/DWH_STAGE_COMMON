          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A70DFED7-E19A-4974-9899-9542F65CB2B6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="UPDATE stats_skus"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
              SQLTask:SqlStatementSource="UPDATE SKU SET &#xA;&#x9;barcode = B.barcode,&#xA;&#x9;[Is_Actual] = IIF(C.[placementType] = 'FBY' AND CHARINDEX('_',SKU.shopsku) &lt;&gt; 0, 1,0)&#xA;FROM&#xA;&#x9;[YandexMarket].[stats_skus] SKU&#xA;&#x9;LEFT JOIN [YandexMarket].[Campaign] C ON SKU.campaign_id = C.id&#xA;&#x9;OUTER APPLY (&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;TOP 1&#xA;&#x9;&#x9;&#x9;B.barcode&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[offerMappings_barcodes] B&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;B.business_id = C.business_id&#xA;&#x9;&#x9;&#x9;AND B.offerId = SKU.shopSku&#xA;&#x9;&#x9;ORDER BY&#xA;&#x9;&#x9;&#x9;B.SYSMOMENT desc&#xA;&#x9;) B&#xA;WHERE&#xA;&#x9;ISNULL(SKU.barcode,'') &lt;&gt; ISNULL(B.barcode,'')&#xA;&#x9;AND ISNULL(SKU.[Is_Actual],0) &lt;&gt; IIF(C.[placementType] = 'FBY' AND CHARINDEX('_',SKU.shopsku) &lt;&gt; 0, 1,0)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
