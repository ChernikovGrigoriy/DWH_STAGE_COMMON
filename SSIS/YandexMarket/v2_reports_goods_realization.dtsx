    private void Parse_lost_items(ZipArchiveEntry entry)
    {
        if (entry.Name != "lost_items.csv")
            return;

        using (var oEntryStream = entry.Open())
        {
            using (var reader = new StreamReader(oEntryStream))
            {
                string content = reader.ReadToEnd();

                using (var oCSVStream = new MemoryStream())
                {
                    using (var oWriter = new StreamWriter(oCSVStream))
                    {
                        oWriter.Write(content);
                        oWriter.Flush();

                        oCSVStream.Position = 0;

                        int vNumStr = 1;

                        using (Microsoft.VisualBasic.FileIO.TextFieldParser oTFP = new TextFieldParser(oCSVStream))
                        {
                            oTFP.Delimiters = new string[] { "," };
                            oTFP.HasFieldsEnclosedInQuotes = true;

                            string[] vFields = oTFP.ReadFields();

                            while (!oTFP.EndOfData)
                            {
                                vNumStr++;

                                string[] vValues = oTFP.ReadFields();

                                if (vFields.Length == vValues.Length)
                                {

                                    lostitemsBuffer.AddRow();
                                    lostitemsBuffer.campaignid = Variables.vCampaignID;
                                    lostitemsBuffer.Year = Variables.vYear;
                                    lostitemsBuffer.Month = Variables.vMonth;

                                    for (int j = 0; j < vFields.Length; j++)
                                    {
                                        _Error = string.Format("Field={0}, строка {1}, Год {2}, Месяц {3:yyyy-MM-dd}", vFields[j], vNumStr, Variables.vYear, Variables.vMonth);
                                        switch (vFields[j])
                                        {
                                            case "ORDER_ID":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.ORDERID = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "YOUR_ORDER_ID":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.YOURORDERID = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;//
                                            case "ORDER_TYPE":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.ORDERTYPE = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "OFFER_NAME":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.OFFERNAME = vValues[j].Length > 200 ? vValues[j].Substring(0, 200) : vValues[j];
                                                break;
                                            case "YOUR_SKU":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.YOURSKU = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "SHOP_SKU":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.SHOPSKU = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "TRANSFERRED_TO_DELIVERY_COUNT":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.TRANSFERREDTODELIVERYCOUNT = int.Parse(vValues[j], System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "ORDER_CREATION_DATE":
                                                if (vValues[j] != null && vValues[j].Length > 0) lostitemsBuffer.ORDERCREATIONDATE = DateTime.ParseExact(vValues[j], "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture);
