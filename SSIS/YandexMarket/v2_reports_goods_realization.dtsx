      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
          SQLTask:SqlStatementSource="SELECT &#xA;&#x9;Year([Data]) [Year], Month([Data]) [Month]&#xA;FROM&#xA;&#x9;[dbo].[fnDATA] ('20250101', GETDATE(),NULL)&#xA;EXCEPT&#xA;SELECT&#xA;&#x9;DISTINCT [Year], [Month]&#xA;FROM&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;DISTINCT [Year], [Month]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[v2_reports_goods_realization_delivered]&#xA;&#x9;&#x9;UNION&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;DISTINCT [Year], [Month]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[v2_reports_goods_realization_lost_items]&#xA;&#x9;&#x9;UNION&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;DISTINCT [Year], [Month]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[v2_reports_goods_realization_returned]&#xA;&#x9;&#x9;UNION&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;DISTINCT [Year], [Month]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[v2_reports_goods_realization_transferred_to_delivery]&#xA;&#x9;&#x9;UNION&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;DISTINCT [Year], [Month]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[v2_reports_goods_realization_unredeemed]&#xA;&#x9;) TMP&#xA;UNION&#xA;SELECT &#xA;&#x9;DISTINCT &#xA;&#x9;Year([Data]) [Year], Month([Data]) [Month]&#xA;FROM&#xA;&#x9;[dbo].[fnDATA] (DATEADD(month,-2,GETDATE()), DATEADD(month,0,GETDATE()),NULL) "
          SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::vDateObj" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
