     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Шаблон
    #region Шаг 1
    public class Request1
    {
        public long campaignId { get; set; }
        public int year{ get; set; }
        public int month{ get; set; }
    }

    public class Response1
    {
        public string status { get; set; }
        public Response1_Result result { get; set; }
    }

    public class Response1_Result
    {
        public string reportId { get; set; }
        public int estimatedGenerationTime { get; set; }
    }
    #endregion

    #region  Шаг 2
    public class Response2
    {
        public string status { get; set; }
        public Response2_Result result { get; set; }
    }
    public class Response2_Result
    {
        public string status { get; set; }
        public DateTime? generationRequestedAt { get; set; }
        public DateTime? generationFinishedAt { get; set; }
        public string file { get; set; }
    }
    #endregion
    #endregion


    JavaScriptSerializer _JSS;
    string _Error = null;
    SHA256 _sha256Hash;
    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = int.MaxValue;
        _sha256Hash = SHA256.Create();
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        _sha256Hash.Clear();
        base.PostExecute();        
    }

    private string GetHash(string input)
    {

        // Convert the input string to a byte array and compute the hash.
        byte[] data = _sha256Hash.ComputeHash(Encoding.UTF8.GetBytes(input));

        // Create a new Stringbuilder to collect the bytes
        // and create a string.
        var sBuilder = new StringBuilder();

        // Loop through each byte of the hashed data
        // and format each one as a hexadecimal string.
        for (int i = 0; i < data.Length; i++)
        {
            sBuilder.Append(data[i].ToString("x2"));
        }

        // Return the hexadecimal string.
        return sBuilder.ToString();
    }

    private string Step1()
    {
        byte[] oDATA = null;

        Request1 oRequest = new Request1
        {
             campaignId = Variables.vCampaignID,
              year = Variables.vYear,
              month = Variables.vMonth
        };

        YandexMarketWebClient oYMWC = new YandexMarketWebClient(30000, 15, 20000);

        oDATA = oYMWC.SendRequestWithRateLimit("https://api.partner.market.yandex.ru/v2/reports/goods-realization/generate?format=CSV", Variables.pApiKey, Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest)));

        Response1 oResponse = _JSS.Deserialize<Response1>(Encoding.UTF8.GetString(oDATA));

        return oResponse.result.reportId;
    }

    private string Step2(string reportId)
    {
        Response2 oResponse = null;
        int vCnt = 1;

        do
        {
            YandexMarketWebClient oYMWC = new YandexMarketWebClient(30000, 15, 20000);

            byte[] oDATA = oYMWC.SendRequestWithRateLimit(String.Format("https://api.partner.market.yandex.ru/v2/reports/info/{0}", reportId), Variables.pApiKey);

            oResponse = _JSS.Deserialize<Response2>(Encoding.UTF8.GetString(oDATA));

            if (oResponse.result.status != "DONE" && vCnt < 20)
            {
                vCnt++;
                Thread.Sleep(30000);
            }

        } while (oResponse.result.status != "DONE" && vCnt < 20);

        if (oResponse.result.status != "DONE" && vCnt >= 20)
        {
            throw new ApplicationException("Не получен отчет");
        }

        return oResponse.result.file;
    }

    #region parse
    private void Parse_unredeemed(ZipArchiveEntry entry)
    {
        if (entry.Name != "unredeemed.csv")
            return;

        using (var oEntryStream = entry.Open())
        {
            using (var reader = new StreamReader(oEntryStream))
            {
                string content = reader.ReadToEnd();

                using (var oCSVStream = new MemoryStream())
                {
                    using (var oWriter = new StreamWriter(oCSVStream))
                    {
                        oWriter.Write(content);
                        oWriter.Flush();

                        oCSVStream.Position = 0;

                        int vNumStr = 1;

                        using (Microsoft.VisualBasic.FileIO.TextFieldParser oTFP = new TextFieldParser(oCSVStream))
                        {
                            oTFP.Delimiters = new string[] { "," };
                            oTFP.HasFieldsEnclosedInQuotes = true;

                            string[] vFields = oTFP.ReadFields();

                            while (!oTFP.EndOfData)
                            {
                                vNumStr++;

                                string[] vValues = oTFP.ReadFields();

                                if (vFields.Length == vValues.Length)
                                {
                                    unredeemedBuffer.AddRow();
                                    unredeemedBuffer.campaignid = Variables.vCampaignID;
                                    unredeemedBuffer.Year = Variables.vYear;
                                    unredeemedBuffer.Month = Variables.vMonth;

                                    for (int j = 0; j < vFields.Length; j++)
                                    {
                                        _Error = string.Format("Field={0}, строка {1}, Год {2}, Месяц {3:yyyy-MM-dd}", vFields[j], vNumStr, Variables.vYear, Variables.vMonth);
                                        switch (vFields[j])
                                        {
                                            case "ORDER_ID":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.ORDERID = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "YOUR_ORDER_ID":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.YOURORDERID = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "ORDER_TYPE":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.ORDERTYPE = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "OFFER_NAME":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.OFFERNAME = vValues[j].Length > 200 ? vValues[j].Substring(0, 200) : vValues[j];
                                                break;
                                            case "YOUR_SKU":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.YOURSKU = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "SHOP_SKU":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.SHOPSKU = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "TRANSFERRED_TO_DELIVERY_COUNT":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.TRANSFERREDTODELIVERYCOUNT = int.Parse(vValues[j], System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "UNREDEEMED_COUNT":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.UNREDEEMEDCOUNT = int.Parse(vValues[j], System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "ORDER_CREATION_DATE":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.ORDERCREATIONDATE = DateTime.ParseExact(vValues[j], "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "TRANSFERRED_TO_DELIVERY_DATE":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.TRANSFERREDTODELIVERYDATE = DateTime.ParseExact(vValues[j], "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "DELIVERY_DATE":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.DELIVERYDATE = DateTime.ParseExact(vValues[j], "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "UNREDEEMED_WAREHOUSE_OR_SC_ACCEPT_DATE":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.UNREDEEMEDWAREHOUSEORSCACCEPTDATE = DateTime.ParseExact(vValues[j], "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "PAYMENT_TYPE":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.PAYMENTTYPE = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "VAT":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.VAT = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                                break;
                                            case "PRICE_WITH_VAT_AND_NO_DISCOUNT":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.PRICEWITHVATANDNODISCOUNT = decimal.Parse(vValues[j], System.Globalization.CultureInfo.InvariantCulture);
                                                break;
                                            case "SHOP_MARKETPLACE_DISCOUNT":
                                                if (vValues[j] != null && vValues[j].Length > 0) unredeemedBuffer.SHOPMARKETPLACEDISCOUNT = decimal.Parse(vValues[j], System.Globalization.CultureInfo.InvariantCulture);
