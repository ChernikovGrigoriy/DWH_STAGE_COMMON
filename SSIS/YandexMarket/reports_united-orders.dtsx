    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    JavaScriptSerializer _JSS;
    string _Error = null;
    SHA256 _sha256Hash;
    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = int.MaxValue;
        _sha256Hash = SHA256.Create();
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        _sha256Hash.Clear();
        base.PostExecute();        
    }

    private string GetHash(string input)
    {

        // Convert the input string to a byte array and compute the hash.
        byte[] data = _sha256Hash.ComputeHash(Encoding.UTF8.GetBytes(input));

        // Create a new Stringbuilder to collect the bytes
        // and create a string.
        var sBuilder = new StringBuilder();

        // Loop through each byte of the hashed data
        // and format each one as a hexadecimal string.
        for (int i = 0; i < data.Length; i++)
        {
            sBuilder.Append(data[i].ToString("x2"));
        }

        // Return the hexadecimal string.
        return sBuilder.ToString();
    }

    

    private string Step1()
    {
        byte[] oDATA = null;

        Request1 oRequest = new Request1
        {
            businessId = Variables.vBuisnessID,
            dateFrom = string.Format("{0:yyyy-MM-dd}",Variables.vDATESTART),
            dateTo = string.Format("{0:yyyy-MM-dd}", Variables.vDATEFINISH > DateTime.Now ? DateTime.Now.Date : Variables.vDATEFINISH),
            campaignIds = Variables.vCampaignIDs.Split(',').Select(x=> Int64.Parse(x, NumberStyles.Any, CultureInfo.InvariantCulture)).ToArray()
        };

        int i = 1;
        while (i <= 6)
        {
            try
            {
                TimeoutWebClient oTWC = new TimeoutWebClient(300000);
                string vURL = String.Format("https://api.partner.market.yandex.ru/reports/united-orders/generate?format=CSV");
                oTWC.Headers.Add("Api-Key", Variables.pApiKey);
                byte[] vDataSend = Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest));
                oDATA = oTWC.UploadData(vURL, vDataSend);
                oTWC = null;

                break;
            }
            catch (Exception e)
            {
                if (
                    e.Message.Contains("Too Many Requests")
                    || e.Message.Contains("(420) Enhance your Calm")
                    )
                {
                    Thread.Sleep(20000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Слишком большое количество обращений к серверу YandexMarket");


        Response1 oResponse = _JSS.Deserialize<Response1>(Encoding.UTF8.GetString(oDATA));

        return oResponse.result.reportId;
    }

    private string Step2(string reportId)
    {
        Response2 oResponse = null;
        int vCnt = 1;

        do
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(300000);
                    string vURL = String.Format("https://api.partner.market.yandex.ru/reports/info/{0}", reportId);
                    oTWC.Headers.Add("Api-Key", Variables.pApiKey);
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (
                        e.Message.Contains("Too Many Requests")
                        || e.Message.Contains("(420) Enhance your Calm")
                        )
                    {
                        Thread.Sleep(20000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Слишком большое количество обращений к серверу YandexMetrica");

            oResponse = _JSS.Deserialize<Response2>(Encoding.UTF8.GetString(oDATA));

            if (oResponse.result.status != "DONE" && vCnt < 10)
            {
                vCnt++;
                Thread.Sleep(30000);
            }

        } while (oResponse.result.status != "DONE" && vCnt < 10);

        if (oResponse.result.status != "DONE" && vCnt >= 10)
        {
            throw new ApplicationException("Не получен отчет");
        }

        return oResponse.result.file;
    }

    private void Parse__reports_united_orders_and_offers_transactions(ZipArchiveEntry entry)
    {
        if (entry.Name != "orders_and_offers_transactions.csv")
            return;

        using (var oEntryStream = entry.Open())
        {
            using (var reader = new StreamReader(oEntryStream))
            {
                string content = reader.ReadToEnd();

                using (var oCSVStream = new MemoryStream())
                {
                    using (var oWriter = new StreamWriter(oCSVStream))
                    {
                        oWriter.Write(content);
                        oWriter.Flush();

                        oCSVStream.Position = 0;

                        int vNumStr = 1;

                        using (Microsoft.VisualBasic.FileIO.TextFieldParser oTFP = new TextFieldParser(oCSVStream))
                        {
                            oTFP.Delimiters = new string[] { "," };
                            oTFP.HasFieldsEnclosedInQuotes = true;

                            string[] vFields = oTFP.ReadFields();

                            while (!oTFP.EndOfData)
                            {
                                vNumStr++;

                                string[] vValues = oTFP.ReadFields();

                                if (vFields.Length == vValues.Length)
                                {

