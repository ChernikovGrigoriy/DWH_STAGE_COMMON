                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                      SQLTask:SqlStatementSource="DECLARE @buisness_id bigint, @date date&#xA;&#xA;SELECT @buisness_id = ?, @date = ?&#xA;&#xA;DELETE FROM [YandexMarket].[SalesBoost] WHERE [business_id] = @buisness_id AND [date] = @date&#xA;&#x9;&#xA;INSERT INTO [YandexMarket].[SalesBoost]&#xA;(&#xA;&#x9;[business_id]&#xA;      ,[date]&#xA;      ,[SHOP_SKU]&#xA;      ,[OFFER_NANE]&#xA;      ,[SHOWS_WITH_FEE]&#xA;      ,[SHOWS]&#xA;      ,[CLICKS_VENDOR_WITH_FEE]&#xA;      ,[CLICKS_VENDOR]&#xA;      ,[CLICKS_CPA_WIH_FEE]&#xA;      ,[CLICKS_CPA]&#xA;      ,[ORDER_ITEMS_WITH_FEE]&#xA;      ,[ORDER_ITEMS]&#xA;      ,[ORDER_ITEMS_DELIVERED_WITH_FEE]&#xA;      ,[ORDER_ITEMS_DELIVERED]&#xA;      ,[BILLED_AMOUNT]&#xA;      ,[DEDUCTED_BONUSES]&#xA;      ,[AVERAGE_BOOST_COST]&#xA;      ,[COST_REVENUE_RATIO]&#xA;      ,[ORDERS_GVM_DELIVERED_WITH_FEE]&#xA;      ,[ORDERS_GVM_DELIVERED]&#xA;      ,[REVENUE_SHARE]&#xA;      ,[SALES_CAMPAIGN_IDS]&#xA;      ,[SALES_CAMPAIGN_NAMES]&#xA;      ,[SYSMOMENT]&#xA;)&#xA;SELECT [business_id]&#xA;      ,[date]&#xA;      ,[SHOP_SKU]&#xA;      ,[OFFER_NANE]&#xA;      ,[SHOWS_WITH_FEE]&#xA;      ,[SHOWS]&#xA;      ,[CLICKS_VENDOR_WITH_FEE]&#xA;      ,[CLICKS_VENDOR]&#xA;      ,[CLICKS_CPA_WIH_FEE]&#xA;      ,[CLICKS_CPA]&#xA;      ,[ORDER_ITEMS_WITH_FEE]&#xA;      ,[ORDER_ITEMS]&#xA;      ,[ORDER_ITEMS_DELIVERED_WITH_FEE]&#xA;      ,[ORDER_ITEMS_DELIVERED]&#xA;      ,[BILLED_AMOUNT]&#xA;      ,[DEDUCTED_BONUSES]&#xA;      ,[AVERAGE_BOOST_COST]&#xA;      ,[COST_REVENUE_RATIO]&#xA;      ,[ORDERS_GVM_DELIVERED_WITH_FEE]&#xA;      ,[ORDERS_GVM_DELIVERED]&#xA;      ,[REVENUE_SHARE]&#xA;      ,[SALES_CAMPAIGN_IDS]&#xA;      ,[SALES_CAMPAIGN_NAMES]&#xA;      ,GETDATE()&#xA;  FROM [BUFFER].[YandexMarket_SalesBoost]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
