      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[YandexMarket_Campaign]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[YandexMarket_Campaign]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[YandexMarket_Campaign] FROM [YandexMarket].[Campaign]&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
