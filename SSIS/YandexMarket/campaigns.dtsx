    <DTS:Executable
      DTS:refId="Package\Загрузка в стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{262743de-9eb0-4c14-8e1a-6a1e4fd830d1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [YandexMarket].[Campaign] WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING [BUFFER].[YandexMarket_Campaign] SRC ON (TGT.[id]  = SRC.[id])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA; SRC.[id]&#xA;    ,SRC.[domain]&#xA;    ,SRC.[clientId]&#xA;    ,SRC.[business_id]&#xA;    ,SRC.[business_name]&#xA;    ,SRC.[placementType]&#xA; ) &lt;&gt; CHECKSUM(&#xA; TGT.[id]&#xA;    ,TGT.[domain]&#xA;    ,TGT.[clientId]&#xA;    ,TGT.[business_id]&#xA;    ,TGT.[business_name]&#xA;    ,TGT.[placementType]&#xA; ) THEN&#xA;  UPDATE SET &#xA;    [domain] = SRC.[domain]&#xA;    ,[clientId] = SRC.[clientId]&#xA;    ,[business_id] = SRC.[business_id]&#xA;    ,[business_name] = SRC.[business_name]&#xA;    ,[placementType] = SRC.[placementType]&#xA;    ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA; [id]&#xA;    ,[domain]&#xA;    ,[clientId]&#xA;    ,[business_id]&#xA;    ,[business_name]&#xA;    ,[placementType]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA; SRC.[id]&#xA;    ,SRC.[domain]&#xA;    ,SRC.[clientId]&#xA;    ,SRC.[business_id]&#xA;    ,SRC.[business_name]&#xA;    ,SRC.[placementType]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
