        <DTS:Executable
          DTS:refId="Package\цикл\Создание буферных таблиц"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{14d61ca4-9353-46f4-bbe9-826b23e88117}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Создание буферных таблиц"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[YandexMarket_offerMappings]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[YandexMarket_offerMappings]&#xA;&#xA;CREATE TABLE [BUFFER].[YandexMarket_offerMappings]&#xA;(&#xA;   business_id   bigint,&#xA;   offerId              nvarchar(40)         not null,&#xA;   Name                 nvarchar(200)        null,&#xA;   category             nvarchar(200)        null,&#xA;   vendor               nvarchar(200)        null,&#xA;   description          nvarchar(4000)       null,&#xA;   manufacturerCountries nvarchar(4000)       null,&#xA;   weightDimensions_width decimal(20,10)       null,&#xA;   weightDimensions_length decimal(20,10)       null,&#xA;   weightDimensions_height decimal(20,10)       null,&#xA;   weightDimensions_weight decimal(20,10)       null,&#xA;   vendorCode           nvarchar(50)         null,&#xA;customsCommodityCode nvarchar(50)         null,&#xA;   boxCount             int                  null,&#xA;   cardStatus           nvarchar(100)        null,&#xA;   tags                 nvarchar(4000)       null,&#xA;   Mapping_marketSku    bigint               null,&#xA;   Mapping_marketSkuName nvarchar(500)        null,&#xA;   Mapping_marketModelId bigint               null,&#xA;   Mapping_marketModelName nvarchar(500)        null,&#xA;   Mapping_marketCategoryId bigint               null,&#xA;   Mapping_marketCategoryName nvarchar(500)        null&#xA;)&#xA;&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[YandexMarket_offerMappings_pictures]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[YandexMarket_offerMappings_pictures]&#xA;&#xA;CREATE TABLE [BUFFER].[YandexMarket_offerMappings_pictures]&#xA;(&#xA;   business_id   bigint,&#xA;   offerId              nvarchar(40)         not null,&#xA;   npp int,&#xA;   URL nvarchar(51