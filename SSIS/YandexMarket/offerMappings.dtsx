                        <arrayElement
                          dataType="System.String"><![CDATA[#region Help:  Introduction to the Script Component
/* The Script Component allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services data flow.
 *
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script component. */
#endregion

#region Namespaces
using System;
using System.Data;
using System.Data.OleDb;
using System.Net;
using System.Text;
using System.Threading;
using System.Web.Script.Serialization;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

/// <summary>
/// This is the class to which to add your code.  Do not change the name, attributes, or parent
/// of this class.
/// </summary>
[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    #region Help:  Using Integration Services variables and parameters
    /* To use a variable in this script, first ensure that the variable has been added to
     * either the list contained in the ReadOnlyVariables property or the list contained in
     * the ReadWriteVariables property of this script component, according to whether or not your
     * code needs to write into the variable.  To do so, save this script, close this instance of
     * Visual Studio, and update the ReadOnlyVariables and ReadWriteVariables properties in the
     * Script Transformation Editor window.
     * To use a parameter in this script, follow the same steps. Parameters are always read-only.
     *
     * Example of reading from a variable or parameter:
     *  DateTime startTime = Variables.MyStartTime;
     *
     * Example of writing to a variable:
     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region шаблон
    public class Request
    {

    }

    public class Response
    {
        public string status { get; set; }
        public Response_Result result { get; set; }
    }

    public class Response_Result
    {
        public Response_Result_Paging paging { get; set; }
        public Response_Result_offerMapping[] offerMappings { get; set; }
    }

    public class Response_Result_Paging
    {
        public string nextPageToken { get; set; }
    }

    public class Response_Result_offerMapping
    {
        public Response_Result_offerMapping_offer offer { get; set; }
        public Response_Result_offerMapping_mapping mapping { get; set; }
    }

    public class Response_Result_offerMapping_offer
    {
        public string offerId { get; set; }
        public string name { get; set; }
        public string category { get; set; }
        public string[] pictures { get; set; }
        public string[] videos { get; set; }
        public string vendor { get; set; }
        public string[] barcodes { get; set; }
        public string description { get; set; }
        public string[] manufacturerCountries { get; set; }
        public Response_Result_offerMapping_offer_weightDimensions weightDimensions { get; set; }
        public string vendorCode { get; set; }
        public string customsCommodityCode { get; set; }
        public int? boxCount { get; set; }

        public Response_Result_offerMapping_offer_basicPrice basicPrice { get; set; }
        public string cardStatus { get; set; }
        public Response_Result_offerMapping_offer_campaign[] campaigns { get; set; }
        public Response_Result_offerMapping_offer_sellingProgram[] sellingPrograms { get; set; }
    }

    public class Response_Result_offerMapping_offer_basicPrice
    {
        public double? value { get; set; }
        public string currencyId { get; set; }
        public double? discountBase { get; set; }
        public DateTime? updatedAt { get; set; }
    }

    public class Response_Result_offerMapping_offer_weightDimensions
    {
        public decimal? length { get; set; }
        public decimal? width { get; set; }
        public decimal? height { get; set; }
        public decimal? weight { get; set; }
    }

    public class Response_Result_offerMapping_offer_campaign
    {
        public int? campaignId { get; set; }
        public string status { get; set; }
    }

    public class Response_Result_offerMapping_offer_sellingProgram
    {
        public string sellingProgram { get; set; }
        public string status { get; set; }
    }

    public class Response_Result_offerMapping_mapping
    {
        public long? marketCategoryId { get; set; }
        public string marketCategoryName { get; set; }
        public long? marketSku { get; set; }
        public string marketSkuName { get; set; }
        public long? marketModelId { get; set; }
        public string marketModelName { get; set; }
    }
    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        string vNextPageToken = "";
        int j = 0;
        bool vSignFinish = true;

        try
        {
            byte[] oDATA = null;

            do
            {
                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(150000);
                        string vURL = String.Format("https://api.partner.market.yandex.ru/businesses/{1}/offer-mappings?page_token={0}&limit=200",  vNextPageToken, Variables.vBusinessID);
                        oTWC.Headers.Add("Api-Key", string.Format("{0}", Variables.pApiKey));
                        byte[] vPostData = Encoding.UTF8.GetBytes(oJSS.Serialize(new Request { }));
                        oDATA = oTWC.UploadData(vURL, "post", vPostData);
                        oTWC = null;

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests") 
                            || e.Message.Contains("Query timeout expired")
                            || e.Message.Contains("(503) Сервер не доступен"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Слишком большое количество обращений к серверу Yandex Market");

                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                vSignFinish = true;

                if (oResponse.status == "OK" && oResponse.result != null && oResponse.result.offerMappings != null && oResponse.result.offerMappings.Length > 0)
                {
                    vNextPageToken = oResponse.result.paging.nextPageToken;
                    vSignFinish = oResponse.result.offerMappings.Length != 200;
                    foreach (Response_Result_offerMapping oItem in oResponse.result.offerMappings)
                    {
                        offerBuffer.AddRow();
                        if (oItem.offer != null)
                        {
                            offerBuffer.offerId = oItem.offer.offerId;
                            if (oItem.offer.name != null && oItem.offer.name.Length > 0) offerBuffer.Name = oItem.offer.name.Length > 200 ? oItem.offer.name.Substring(0, 200) : oItem.offer.name;
                            if (oItem.offer.category != null && oItem.offer.category.Length > 0) offerBuffer.category = oItem.offer.category.Length > 200 ? oItem.offer.category.Substring(0, 200) : oItem.offer.category;
                            if (oItem.offer.vendor != null && oItem.offer.vendor.Length > 0) offerBuffer.vendor = oItem.offer.vendor.Length > 200 ? oItem.offer.vendor.Substring(0, 200) : oItem.offer.vendor;
                            if (oItem.offer.description != null && oItem.offer.description.Length > 0) offerBuffer.description = oItem.offer.description.Length > 4000 ? oItem.offer.description.Substring(0, 4000) : oItem.offer.description;
                            if (oItem.offer.manufacturerCountries != null && oItem.offer.manufacturerCountries.Length > 0) offerBuffer.manufacturerCountries = string.Join(",", oItem.offer.manufacturerCountries);
                            if (oItem.offer.weightDimensions != null)
                            {
                                if (oItem.offer.weightDimensions.height != null) offerBuffer.weightDimensionsheight =(decimal)oItem.offer.weightDimensions.height;
                                if (oItem.offer.weightDimensions.length != null) offerBuffer.weightDimensionslength = (decimal)oItem.offer.weightDimensions.length;
                                if (oItem.offer.weightDimensions.height != null) offerBuffer.weightDimensionsheight = (decimal)oItem.offer.weightDimensions.height;
                                if (oItem.offer.weightDimensions.weight != null) offerBuffer.weightDimensionsweight = (decimal)oItem.offer.weightDimensions.weight;
                            }
                            if (oItem.offer.vendorCode != null && oItem.offer.vendorCode.Length > 0) offerBuffer.vendorCode = oItem.offer.vendorCode.Length > 50 ? oItem.offer.vendorCode.Substring(0, 50) : oItem.offer.vendorCode;
                            if (oItem.offer.customsCommodityCode != null && oItem.offer.customsCommodityCode.Length > 0) offerBuffer.customsCommodityCode = oItem.offer.customsCommodityCode.Length > 50 ? oItem.offer.customsCommodityCode.Substring(0, 50) : oItem.offer.customsCommodityCode;
                            if (oItem.offer.boxCount != null) offerBuffer.boxCount = (int)oItem.offer.boxCount;

                            if (oItem.offer.basicPrice != null)
                            {
                                basicPriceBuffer.AddRow();
                                basicPriceBuffer.offerId = oItem.offer.offerId;
                                if (oItem.offer.basicPrice.currencyId != null && oItem.offer.basicPrice.currencyId.Length > 0) basicPriceBuffer.currencyId = oItem.offer.basicPrice.currencyId.Length > 50 ? oItem.offer.basicPrice.currencyId.Substring(0, 50) : oItem.offer.basicPrice.currencyId;
                                if (oItem.offer.basicPrice.value != null) basicPriceBuffer.value = (decimal) oItem.offer.basicPrice.value;
                                if (oItem.offer.basicPrice.discountBase != null) basicPriceBuffer.discountBase = (decimal)oItem.offer.basicPrice.discountBase;
                                if (oItem.offer.basicPrice.updatedAt != null) basicPriceBuffer.updatedAt = (DateTime)oItem.offer.basicPrice.updatedAt;
                            }
                            if (oItem.offer.cardStatus != null) offerBuffer.cardStatus = oItem.offer.cardStatus.Length > 100 ? oItem.offer.cardStatus.Substring(0, 100) : oItem.offer.cardStatus;

                            if (oItem.offer.pictures != null)
                            {
                                int vNpp = 1;
                                foreach (string vUrl in oItem.offer.pictures)
                                {
                                    pictureBuffer.AddRow();
                                    pictureBuffer.offerId = oItem.offer.offerId;
                                    pictureBuffer.npp = vNpp;
                                    pictureBuffer.URL = vUrl;
                                    vNpp++;
                                }
                            }

                            if (oItem.offer.videos != null)
                            {
                                int vNpp = 1;
                                foreach (string vUrl in oItem.offer.videos)
                                {
                                    videoBuffer.AddRow();
                                    videoBuffer.offerId = oItem.offer.offerId;
                                    videoBuffer.npp = vNpp;
                                    videoBuffer.URL = vUrl;
                                    vNpp++;
                                }
                            }

                            if (oItem.offer.barcodes != null)
                            {
                                int vNpp = 1;
                                foreach (string vBarcode in oItem.offer.barcodes)
                                {
                                    barcodeBuffer.AddRow();
                                    barcodeBuffer.offerId = oItem.offer.offerId;
                                    barcodeBuffer.npp = vNpp;
                                    barcodeBuffer.barcode = vBarcode.Length > 40 ? vBarcode.Substring(0,40) : vBarcode;
                                    vNpp++;
                                }
                            }
                        }

                        if (oItem.mapping != null)
                        {
                            if (oItem.mapping.marketCategoryId != null) offerBuffer.MappingmarketCategoryId = (long)oItem.mapping.marketCategoryId;
                            if (oItem.mapping.marketCategoryName != null && oItem.mapping.marketCategoryName.Length > 0) offerBuffer.MappingmarketCategoryName = oItem.mapping.marketCategoryName.Length > 500 ? oItem.mapping.marketCategoryName.Substring(0, 500) : oItem.mapping.marketCategoryName;
                            if (oItem.mapping.marketModelId != null) offerBuffer.MappingmarketModelId = (long)oItem.mapping.marketModelId;
                            if (oItem.mapping.marketModelName != null && oItem.mapping.marketModelName.Length > 0) offerBuffer.MappingmarketModelName = oItem.mapping.marketModelName.Length > 500 ? oItem.mapping.marketModelName.Substring(0, 500) : oItem.mapping.marketModelName;
                            if (oItem.mapping.marketSku != null) offerBuffer.MappingmarketSku = (long)oItem.mapping.marketSku;
                            if (oItem.mapping.marketSkuName != null && oItem.mapping.marketSkuName.Length > 0) offerBuffer.MappingmarketSkuName = oItem.mapping.marketSkuName.Length > 500 ? oItem.mapping.marketSkuName.Substring(0, 500) : oItem.mapping.marketSkuName;
                        }
                    }
                }

                Array.Clear(oDATA, 0, oDATA.Length);

                j++;

            } while (j < 10000 && vSignFinish == false);

        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "offerMappings", e.Message, "", 0, out cancel);
        }

    }

}
