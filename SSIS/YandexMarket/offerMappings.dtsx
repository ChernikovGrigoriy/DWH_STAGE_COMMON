using Microsoft.SqlServer.Dts.Runtime.Wrapper;

public class UserComponent: ScriptComponent
{
    public Connections Connections;
    public Variables Variables;
    public UserComponent()
    {
        Connections = new Connections(this);
        Variables = new Variables(this);
    }

    public offerBuffer offerBuffer;

    public basicPriceBuffer basicPriceBuffer;

    public pictureBuffer pictureBuffer;

    public videoBuffer videoBuffer;

    public barcodeBuffer barcodeBuffer;

    public virtual void FinishOutputs()
    {
    }

    private void MarkOutputsFinished()
    {

        if (null != offerBuffer)
        {
            offerBuffer.SetEndOfRowset();
            offerBuffer = null;
        }

        if (null != basicPriceBuffer)
        {
            basicPriceBuffer.SetEndOfRowset();
            basicPriceBuffer = null;
        }

        if (null != pictureBuffer)
        {
            pictureBuffer.SetEndOfRowset();
            pictureBuffer = null;
        }

        if (null != videoBuffer)
        {
            videoBuffer.SetEndOfRowset();
            videoBuffer = null;
        }

        if (null != barcodeBuffer)
        {
            barcodeBuffer.SetEndOfRowset();
            barcodeBuffer = null;
        }

    }

    public override void PrimeOutput(int Outputs, int[] OutputIDs, PipelineBuffer[] Buffers, OutputNameMap OutputMap)
    {
       for(int Idx = 0; Idx < Outputs; Idx++)
       {
            if(OutputIDs[Idx] == GetOutputID(OutputMap, @"offer"))
            {
                offerBuffer = new offerBuffer(Buffers[Idx], GetColumnIndexes(OutputIDs[Idx]), OutputMap);
            }
            if(OutputIDs[Idx] == GetOutputID(OutputMap, @"basicPrice"))
            {
                basicPriceBuffer = new basicPriceBuffer(Buffers[Idx], GetColumnIndexes(OutputIDs[Idx]), OutputMap);
            }
            if(OutputIDs[Idx] == GetOutputID(OutputMap, @"picture"))
            {
                pictureBuffer = new pictureBuffer(Buffers[Idx], GetColumnIndexes(OutputIDs[Idx]), OutputMap);
            }
            if(OutputIDs[Idx] == GetOutputID(OutputMap, @"video"))
            {
                videoBuffer = new videoBuffer(Buffers[Idx], GetColumnIndexes(OutputIDs[Idx]), OutputMap);
            }
            if(OutputIDs[Idx] == GetOutputID(OutputMap, @"barcode"))
            {
                barcodeBuffer = new barcodeBuffer(Buffers[Idx], GetColumnIndexes(OutputIDs[Idx]), OutputMap);
            }
        }

        CreateNewOutputRows();

        FinishOutputs();
        MarkOutputsFinished();

    }

    public virtual void CreateNewOutputRows()
    {
    }

}

