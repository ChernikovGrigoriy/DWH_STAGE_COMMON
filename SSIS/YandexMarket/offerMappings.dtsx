                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [YandexMarket].[offerMappings] WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING &#xA; (&#xA; SELECT&#xA;  *&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;     [business_id]&#xA;     ,[offerId]&#xA;     ,[Name]&#xA;     ,[category]&#xA;     ,[vendor]&#xA;     ,[description]&#xA;     ,[manufacturerCountries]&#xA;     ,[weightDimensions_width]&#xA;     ,[weightDimensions_length]&#xA;     ,[weightDimensions_height]&#xA;     ,[weightDimensions_weight]&#xA;     ,[vendorCode]&#xA;     ,[customsCommodityCode]&#xA;     ,[boxCount]&#xA;     ,[cardStatus]&#xA;     ,[tags]&#xA;     ,[Mapping_marketSku]&#xA;     ,[Mapping_marketSkuName]&#xA;     ,[Mapping_marketModelId]&#xA;     ,[Mapping_marketModelName]&#xA;     ,[Mapping_marketCategoryId]&#xA;     ,[Mapping_marketCategoryName]&#xA;     ,ROW_NUMBER() OVER (PARTITION BY [business_id], [offerId] ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;     [BUFFER].[YandexMarket_offerMappings]&#xA;   ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;&#xA; ) SRC ON (TGT.[business_id] = SRC.[business_id] AND TGT.[offerId] = SRC.[offerId])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA;      SRC.[Name]&#xA;      ,SRC.[category]&#xA;      ,SRC.[vendor]&#xA;      ,SRC.[description]&#xA;      ,SRC.[manufacturerCountries]&#xA;      ,SRC.[weightDimensions_width]&#xA;      ,SRC.[weightDimensions_length]&#xA;      ,SRC.[weightDimensions_height]&#xA;      ,SRC.[weightDimensions_weight]&#xA;      ,SRC.[vendorCode]&#xA;      ,SRC.[customsCommodityCode]&#xA;      ,SRC.[boxCount]&#xA;      ,SRC.[cardStatus]&#xA;      ,SRC.[tags]&#xA;      ,SRC.[Mapping_marketSku]&#xA;      ,SRC.[Mapping_marketSkuName]&#xA;      ,SRC.[Mapping_marketModelId]&#xA;      ,SRC.[Mapping_marketModelName]&#xA;      ,SRC.[Mapping_marketCategoryId]&#xA;      ,SRC.[Mapping_marketCategoryName]&#xA; ) &lt;&gt; CHECKSUM(&#xA;      TGT.[Name]&#xA;      ,TGT.[category]&#xA;      ,TGT.[vendor]&#xA;      ,TGT.[description]&#xA;      ,TGT.[manufacturerCountries]&#xA;      ,TGT.[weightDimensions_width]&#xA;      ,TGT.[weightDimensions_length]&#xA;      ,TGT.[weightDimensions_height]&#xA;      ,TGT.[weightDimensions_weight]&#xA;      ,TGT.[vendorCode]&#xA;      ,TGT.[customsCommodityCode]&#xA;      ,TGT.[boxCount]&#xA;      ,TGT.[cardStatus]&#xA;      ,TGT.[tags]&#xA;      ,TGT.[Mapping_marketSku]&#xA;      ,TGT.[Mapping_marketSkuName]&#xA;      ,TGT.[Mapping_marketModelId]&#xA;      ,TGT.[Mapping_marketModelName]&#xA;      ,TGT.[Mapping_marketCategoryId]&#xA;      ,TGT.[Mapping_marketCategoryName]&#xA; ) THEN&#xA;  UPDATE SET &#xA;      [Name] = SRC.[Name]&#xA;      ,[category] = SRC.[category]&#xA;      ,[vendor] = SRC.[vendor]&#xA;      ,[description] = SRC.[description]&#xA;      ,[manufacturerCountries] = SRC.[manufacturerCountries]&#xA;      ,[weightDimensions_width] = SRC.[weightDimensions_width]&#xA;      ,[weightDimensions_length] = SRC.[weightDimensions_length]&#xA;      ,[weightDimensions_height] = SRC.[weightDimensions_height]&#xA;      ,[weightDimensions_weight] = SRC.[weightDimensions_weight]&#xA;      ,[vendorCode] = SRC.[vendorCode]&#xA;      ,[customsCommodityCode] = SRC.[customsCommodityCode]&#xA;      ,[boxCount] = SRC.[boxCount]&#xA;      ,[cardStatus] = SRC.[cardStatus]&#xA;      ,[tags] = SRC.[tags]&#xA;      ,[Mapping_marketSku] = SRC.[Mapping_marketSku]&#xA;      ,[Mapping_marketSkuName] = SRC.[Mapping_marketSkuName]&#xA;      ,[Mapping_marketModelId] = SRC.[Mapping_marketModelId]&#xA;      ,[Mapping_marketModelName] = SRC.[Mapping_marketModelName]&#xA;      ,[Mapping_marketCategoryId] = SRC.[Mapping_marketCategoryId]&#xA;      ,[Mapping_marketCategoryName] = SRC.[Mapping_marketCategoryName]&#xA;      ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;   [business_id]&#xA;      ,[offerId]&#xA;      ,[Name]&#xA;      ,[category]&#xA;      ,[vendor]&#xA;      ,[description]&#xA;      ,[manufacturerCountries]&#xA;      ,[weightDimensions_width]&#xA;      ,[weightDimensions_length]&#xA;      ,[weightDimensions_height]&#xA;      ,[weightDimensions_weight]&#xA;      ,[vendorCode]&#xA;      ,[customsCommodityCode]&#xA;      ,[boxCount]&#xA;      ,[cardStatus]&#xA;      ,[tags]&#xA;      ,[Mapping_marketSku]&#xA;      ,[Mapping_marketSkuName]&#xA;      ,[Mapping_marketModelId]&#xA;      ,[Mapping_marketModelName]&#xA;      ,[Mapping_marketCategoryId]&#xA;      ,[Mapping_marketCategoryName]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA;   SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[Name]&#xA;      ,SRC.[category]&#xA;      ,SRC.[vendor]&#xA;      ,SRC.[description]&#xA;      ,SRC.[manufacturerCountries]&#xA;      ,SRC.[weightDimensions_width]&#xA;      ,SRC.[weightDimensions_length]&#xA;      ,SRC.[weightDimensions_height]&#xA;      ,SRC.[weightDimensions_weight]&#xA;      ,SRC.[vendorCode]&#xA;      ,SRC.[customsCommodityCode]&#xA;      ,SRC.[boxCount]&#xA;      ,SRC.[cardStatus]&#xA;      ,SRC.[tags]&#xA;      ,SRC.[Mapping_marketSku]&#xA;      ,SRC.[Mapping_marketSkuName]&#xA;      ,SRC.[Mapping_marketModelId]&#xA;      ,SRC.[Mapping_marketModelName]&#xA;      ,SRC.[Mapping_marketCategoryId]&#xA;      ,SRC.[Mapping_marketCategoryName]&#xA;      ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
