    <DTS:Executable
      DTS:refId="Package\Загрузка в стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{513c382f-9ecc-4404-b0fd-d87b5d5fd8cf}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [YandexMarket].[warehouses] WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING [BUFFER].[YandexMarket_warehouses] SRC ON (TGT.[id]  = SRC.[id])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA;&#x9;SRC.[id]&#xA;    ,SRC.[name]&#xA;    ,SRC.[address_city]&#xA;    ,SRC.[address_street]&#xA;    ,SRC.[address_number]&#xA;    ,SRC.[address_building]&#xA;    ,SRC.[address_gps_latitude]&#xA;    ,SRC.[address_gps_longitude]&#xA; ) &lt;&gt; CHECKSUM(&#xA;&#x9;TGT.[id]&#xA;    ,TGT.[name]&#xA;    ,TGT.[address_city]&#xA;    ,TGT.[address_street]&#xA;    ,TGT.[address_number]&#xA;    ,TGT.[address_building]&#xA;    ,TGT.[address_gps_latitude]&#xA;    ,TGT.[address_gps_longitude]&#xA; ) THEN&#xA;  UPDATE SET &#xA;&#x9;[id] = SRC.[id]&#xA;    ,[name] = SRC.[name]&#xA;    ,[address_city] = SRC.[address_city]&#xA;    ,[address_street] = SRC.[address_street]&#xA;    ,[address_number] = SRC.[address_number]&#xA;    ,[address_building] = SRC.[address_building]&#xA;    ,[address_gps_latitude] = SRC.[address_gps_latitude]&#xA;    ,[address_gps_longitude] = SRC.[address_gps_longitude]&#xA;    ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;&#x9;[id]&#xA;    ,[name]&#xA;    ,[address_city]&#xA;    ,[address_street]&#xA;    ,[address_number]&#xA;    ,[address_building]&#xA;    ,[address_gps_latitude]&#xA;    ,[address_gps_longitude]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA;&#x9;SRC.[id]&#xA;    ,SRC.[name]&#xA;    ,SRC.[address_city]&#xA;    ,SRC.[address_street]&#xA;    ,SRC.[address_number]&#xA;    ,SRC.[address_building]&#xA;    ,SRC.[address_gps_latitude]&#xA;    ,SRC.[address_gps_longitude]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
