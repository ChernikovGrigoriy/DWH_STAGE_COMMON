              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[YandexMarket_v2_reports_shows-sales]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[YandexMarket_v2_reports_shows-sales]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[YandexMarket_v2_reports_shows-sales] FROM [YandexMarket].[v2_reports_shows-sales]&#xA;&#xA;CREATE INDEX [IX_buffer_YandexMarket_v2_reports_shows-sales] ON [BUFFER].[YandexMarket_v2_reports_shows-sales] ([DAY])&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
