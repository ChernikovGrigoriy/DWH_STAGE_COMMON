     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Request_Step1
    public class Request_Step1
    {
        public long businessId { get; set; }
        public string dateFrom { get; set; }
        public string dateTo { get; set; }
        public string grouping { get; set; }
    }
    #endregion

    #region Response_Step1
    public class Response_Step1
    {
        public Response_Step1_Result result { get; set; }
        public Response_Error[] Errors { get; set; }
    }

    public class Response_Step1_Result
    {
        public string reportId { get; set; }
        public int estimatedGenerationTime { get; set; }
    }
    #endregion

    #region Response_Step2
    public class Response_Step2
    {
        public string status { get; set; }
        public Response_Step2_Result result { get; set; }
        public Response_Error[] Errors { get; set; }
    }

    public class Response_Step2_Result
    {
        public string status { get; set; }
        public DateTime? generationRequestedAt { get; set; }
        public DateTime? generationFinishedAt { get; set; }
        public string file { get; set; }
    }
    #endregion

    public class Response_Error
    {
        public string code { get; set; }
        public string message { get; set; }
    }

    JavaScriptSerializer _JSS = null;

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = int.MaxValue;

        vErrorStr = string.Empty;
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
    }

    public string vErrorStr;

    private string Step1()
    {
        Request_Step1 oRequest = new Request_Step1
        {
            businessId = Variables.vBusinessid,
            dateFrom = string.Format("{0:yyyy-MM-dd}", DateTime.Now.AddDays(-88)),
            dateTo = string.Format("{0:yyyy-MM-dd}", DateTime.Now),
            grouping = "OFFERS"
        };

        YandexMarketWebClient oYMWC = new YandexMarketWebClient(30000, 6, 26000);

        byte[] oDATA = oYMWC.SendRequestWithRateLimit(String.Format("https://api.partner.market.yandex.ru/v2/reports/shows-sales/generate?format=CSV"), Variables.pApiKey, Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest)));

        Response_Step1 oResponse = _JSS.Deserialize<Response_Step1>(Encoding.UTF8.GetString(oDATA));

        return oResponse.result.reportId;
    }

    private string Step2(string ReportID)
    {
        CultureInfo provider = CultureInfo.InvariantCulture;

        Response_Step2 oResponse = null;
        int vStep = 1;

        do
        {
            YandexMarketWebClient oYMWC = new YandexMarketWebClient(30000, 6, 26000);

            byte[] oDATA = oYMWC.SendRequestWithRateLimit(String.Format("https://api.partner.market.yandex.ru/v2/reports/info/{0}", ReportID), Variables.pApiKey);

            oResponse = _JSS.Deserialize<Response_Step2>(Encoding.UTF8.GetString(oDATA));

            vStep++;

            if (oResponse.result.status != "DONE") Thread.Sleep(600000);

        } while (oResponse.result.status != "DONE" && vStep < 10);

        if (oResponse.result.status != "DONE")
        {
            if (oResponse.Errors != null)
                throw new ApplicationException(oResponse.Errors[0].message);

            throw new ApplicationException("Время формирования https://api.partner.market.yandex.ru/v2/reports/info/ истекло");
        }

        return oResponse.result.file;
    }

