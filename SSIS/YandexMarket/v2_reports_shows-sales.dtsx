          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
              SQLTask:SqlStatementSource="DECLARE @TABLE as TABLE&#xA;(&#xA;&#x9;[BUSINESS_ID] bigint,&#xA;&#x9;[DAY] date&#xA;)&#xA;&#xA;INSERT INTO @TABLE &#xA;(&#xA;&#x9;[BUSINESS_ID],&#xA;&#x9;[DAY]&#xA;)&#xA;SELECT&#xA;&#x9;[BUSINESS_ID],&#xA;&#x9;[DAY]&#xA;FROM&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;[BUSINESS_ID],&#xA;&#x9;&#x9;&#x9;[DAY],&#xA;&#x9;&#x9;&#x9;CAST(CHECKSUM_AGG(CHECKSUM(&#xA;&#x9;&#x9;&#x9;[DAY]&#xA;&#x9;&#x9;&#x9;  ,[MONTH]&#xA;&#x9;&#x9;&#x9;  ,[YEAR]&#xA;&#x9;&#x9;&#x9;  ,[CATEGORY_NAME]&#xA;&#x9;&#x9;&#x9;  ,[BRAND_NAME]&#xA;&#x9;&#x9;&#x9;  ,[OFFER_ID]&#xA;&#x9;&#x9;&#x9;  ,[OFFER_NAME]&#xA;&#x9;&#x9;&#x9;  ,[VISIBILITY_INDEX]&#xA;&#x9;&#x9;&#x9;  ,[SHOWS]&#xA;&#x9;&#x9;&#x9;  ,[SHOWS_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[SHOWS_SHARE]&#xA;&#x9;&#x9;&#x9;  ,[CLICKS]&#xA;&#x9;&#x9;&#x9;  ,[CLICKS_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART_CONVERSION]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART_SHARE]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_TOTAL_AMOUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[TO_ORDER_CONVERSION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_SHARE]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_COUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_CANCELED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_CANCELED_BY_CREATED_AT_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_RETURNED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_RETURNED_BY_CREATED_AT_COUNT]&#xA;&#x9;&#x9;&#x9;  )) as bigint) [CHECKSUM],&#xA;&#x9;&#x9;&#x9;  COUNT(*) [Count]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[BUFFER].[YandexMarket_v2_reports_shows-sales]&#xA;&#x9;&#x9;GROUP BY&#xA;&#x9;&#x9;&#x9;[BUSINESS_ID],&#xA;&#x9;&#x9;&#x9;[DAY]&#xA;&#x9;&#x9;UNION&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;T1.[BUSINESS_ID],&#xA;&#x9;&#x9;&#x9;T1.[DAY],&#xA;&#x9;&#x9;&#x9;-CAST(CHECKSUM_AGG(CHECKSUM(&#xA;&#x9;&#x9;&#x9;T1.[DAY]&#xA;&#x9;&#x9;&#x9;  ,[MONTH]&#xA;&#x9;&#x9;&#x9;  ,[YEAR]&#xA;&#x9;&#x9;&#x9;  ,[CATEGORY_NAME]&#xA;&#x9;&#x9;&#x9;  ,[BRAND_NAME]&#xA;&#x9;&#x9;&#x9;  ,[OFFER_ID]&#xA;&#x9;&#x9;&#x9;  ,[OFFER_NAME]&#xA;&#x9;&#x9;&#x9;  ,[VISIBILITY_INDEX]&#xA;&#x9;&#x9;&#x9;  ,[SHOWS]&#xA;&#x9;&#x9;&#x9;  ,[SHOWS_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[SHOWS_SHARE]&#xA;&#x9;&#x9;&#x9;  ,[CLICKS]&#xA;&#x9;&#x9;&#x9;  ,[CLICKS_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART_CONVERSION]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[TO_CART_SHARE]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_TOTAL_AMOUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[TO_ORDER_CONVERSION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_SHARE]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_COUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_CANCELED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_CANCELED_BY_CREATED_AT_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_RETURNED_COUNT]&#xA;&#x9;&#x9;&#x9;  ,[ORDER_ITEMS_RETURNED_BY_CREATED_AT_COUNT]&#xA;&#x9;&#x9;&#x9;  )) as bigint) [CHECKSUM],&#xA;&#x9;&#x9;&#x9;  -COUNT(*) [Count]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMarket].[v2_reports_shows-sales] T1&#xA;&#x9;&#x9;&#x9;INNER JOIN (SELECT DISTINCT BUSINESS_ID, [DAY] FROM [BUFFER].[YandexMarket_v2_reports_shows-sales]) T2 ON T1.[BUSINESS_ID] = T2.[BUSINESS_ID] AND T1.[DAY] = T2.[DAY]&#x9;&#xA;&#x9;&#x9;GROUP BY&#xA;&#x9;&#x9;&#x9;T1.[BUSINESS_ID],&#xA;&#x9;&#x9;&#x9;T1.[DAY]&#xA;&#x9;&#x9;) TMP&#xA;GROUP BY&#xA;&#x9;[BUSINESS_ID],&#xA;&#x9;[DAY]&#xA;HAVING&#xA;&#x9;SUM([Count]) &lt;&gt; 0 OR SUM([CHECKSUM]) &lt;&gt; 0&#xA;&#xA;DECLARE cur1 CURSOR LOCAL FOR&#xA;SELECT BUSINESS_ID, [DAY] FROM @TABLE&#xA;&#xA;OPEN CUR1&#xA;&#xA;DECLARE @BUSINESS_ID bigint, @DAY date&#xA;&#xA;FETCH NEXT FROM CUR1 INTO @BUSINESS_ID, @DAY&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;&#xA; DELETE FROM [YandexMarket].[v2_reports_shows-sales]  WHERE  business_id =  @business_id  AND [DAY] = @Day&#xA; &#xA; INSERT INTO [YandexMarket].[v2_reports_shows-sales]&#xA; (&#xA;      [business_id]&#xA;      ,[DAY]&#xA;      ,[MONTH]&#xA;      ,[YEAR]&#xA;      ,[CATEGORY_NAME]&#xA;      ,[BRAND_NAME]&#xA;      ,[OFFER_ID]&#xA;      ,[OFFER_NAME]&#xA;      ,[VISIBILITY_INDEX]&#xA;      ,[SHOWS]&#xA;      ,[SHOWS_WITH_PROMOTION]&#xA;      ,[SHOWS_SHARE]&#xA;      ,[CLICKS]&#xA;      ,[CLICKS_WITH_PROMOTION]&#xA;      ,[TO_CART_CONVERSION]&#xA;      ,[TO_CART]&#xA;      ,[TO_CART_WITH_PROMOTION]&#xA;      ,[TO_CART_SHARE]&#xA;      ,[ORDER_ITEMS]&#xA;      ,[ORDER_ITEMS_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;      ,[TO_ORDER_CONVERSION]&#xA;      ,[ORDER_ITEMS_SHARE]&#xA;      ,[ORDER_ITEMS_DELIVERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_COUNT_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_CANCELED_COUNT]&#xA;      ,[ORDER_ITEMS_CANCELED_BY_CREATED_AT_COUNT]&#xA;      ,[ORDER_ITEMS_RETURNED_COUNT]&#xA;      ,[ORDER_ITEMS_RETURNED_BY_CREATED_AT_COUNT]&#xA;      ,[SYSMOMENT]&#xA; )&#xA; SELECT &#xA;      [business_id]&#xA;      ,[DAY]&#xA;      ,[MONTH]&#xA;      ,[YEAR]&#xA;      ,[CATEGORY_NAME]&#xA;      ,[BRAND_NAME]&#xA;      ,[OFFER_ID]&#xA;      ,[OFFER_NAME]&#xA;      ,[VISIBILITY_INDEX]&#xA;      ,[SHOWS]&#xA;      ,[SHOWS_WITH_PROMOTION]&#xA;      ,[SHOWS_SHARE]&#xA;      ,[CLICKS]&#xA;      ,[CLICKS_WITH_PROMOTION]&#xA;      ,[TO_CART_CONVERSION]&#xA;      ,[TO_CART]&#xA;      ,[TO_CART_WITH_PROMOTION]&#xA;      ,[TO_CART_SHARE]&#xA;      ,[ORDER_ITEMS]&#xA;      ,[ORDER_ITEMS_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;      ,[TO_ORDER_CONVERSION]&#xA;      ,[ORDER_ITEMS_SHARE]&#xA;      ,[ORDER_ITEMS_DELIVERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_COUNT_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT_WITH_PROMOTION]&#xA;      ,[ORDER_ITEMS_CANCELED_COUNT]&#xA;      ,[ORDER_ITEMS_CANCELED_BY_CREATED_AT_COUNT]&#xA;      ,[ORDER_ITEMS_RETURNED_COUNT]&#xA;      ,[ORDER_ITEMS_RETURNED_BY_CREATED_AT_COUNT]&#xA;      ,GETDATE()&#xA;  FROM &#xA;&#x9;[BUFFER].[YandexMarket_v2_reports_shows-sales]&#xA;  WHERE  &#xA;&#x9;business_id =  @business_id  AND [DAY] = @Day&#xA;&#xA;  FETCH NEXT FROM CUR1 INTO @BUSINESS_ID, @DAY&#xA;END&#xA;CLOSE CUR1;&#xA;DEALLOCATE CUR1;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
