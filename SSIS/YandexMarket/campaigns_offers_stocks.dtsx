          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
              SQLTask:SqlStatementSource="DECLARE @step int&#xA;&#xA;SET @step = 1&#xA;&#xA;WHILE @step &lt;= 2&#xA;BEGIN&#xA;&#xA;&#x9;MERGE [YandexMarket].[campaigns_offers_stocks_offer_stock] TGT&#xA;&#x9;USING&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[campaignid],&#xA;&#x9;&#x9;&#x9;[warehouseId],&#xA;&#x9;&#x9;&#x9;[offerId],&#xA;&#x9;&#x9;&#x9;[date],&#xA;&#x9;&#x9;&#x9;[type],&#xA;&#x9;&#x9;&#x9;[count],&#xA;&#x9;&#x9;&#x9;[updatedAt]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[BUFFER].[YandexMarket_campaigns_offers_stocks_offer_stock]&#xA;&#x9;) SRC ON TGT.campaignid = SRC.campaignid AND TGT.warehouseId = SRC.warehouseId AND TGT.offerId = SRC.offerId AND TGT.offerId = SRC.offerId AND TGT.[type] = SRC.[type] AND TGT.[date_finish] = '22000101'&#xA;&#x9;WHEN MATCHED AND&#xA;&#x9;&#x9;TGT.[date_start] &lt; CAST(GETDATE() as date) AND&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SRC.[campaignid],&#xA;&#x9;&#x9;&#x9;SRC.[warehouseId],&#xA;&#x9;&#x9;&#x9;SRC.[offerId],&#xA;&#x9;&#x9;&#x9;SRC.[type],&#xA;&#x9;&#x9;&#x9;SRC.[count],&#xA;&#x9;&#x9;&#x9;SRC.[updatedAt]&#xA;&#x9;&#x9;) &lt;&gt;&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;TGT.[campaignid],&#xA;&#x9;&#x9;&#x9;TGT.[warehouseId],&#xA;&#x9;&#x9;&#x9;TGT.[offerId],&#xA;&#x9;&#x9;&#x9;TGT.[type],&#xA;&#x9;&#x9;&#x9;TGT.[count],&#xA;&#x9;&#x9;&#x9;TGT.[updatedAt]&#xA;&#x9;&#x9;) THEN&#xA;&#x9;  UPDATE SET &#xA;&#x9;&#x9;[date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;&#xA;&#x9;WHEN NOT MATCHED THEN&#xA;&#x9;&#x9;INSERT &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  [campaignid]&#xA;&#x9;&#x9;  ,[warehouseId]&#xA;&#x9;&#x9;  ,[offerId]&#xA;&#x9;&#x9;  ,[type]&#xA;&#x9;&#x9;  ,[DATE_START]&#xA;&#x9;&#x9;  ,[DATE_FINISH]&#xA;&#x9;&#x9;  ,[count]&#xA;&#x9;&#x9;  ,[updatedAt]&#xA;&#x9;&#x9;  ,[SYSMOMENT]&#xA;&#x9;&#x9;)&#xA;&#x9;&#x9;VALUES&#xA;&#x9;&#x9;(&#xA;[campaignid]&#xA;&#x9;&#x9;  ,[warehouseId]&#xA;&#x9;&#x9;  ,[offerId]&#xA;&#x9;&#x9;  ,[type]&#xA;&#x9;&#x9;   ,CAST(GETDATE() as date)&#xA;&#x9;&#x9;  ,'22000101'&#xA;&#x9;&#x9;  ,[count]&#xA;&#x9;&#x9;  ,[updatedAt]&#xA;&#x9;&#x9;  ,GETDATE()&#xA;&#x9;&#x9;);&#xA;&#xA;&#x9;&#x9;SET @step = @step + 1&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::vCampaignId"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
