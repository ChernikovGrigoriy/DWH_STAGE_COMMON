    public override void CreateNewOutputRows()
    {
        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        string vNextPageToken = "";
        int j = 0;
        bool vSignFinish = true;

        try
        {
            byte[] oDATA = null;

            do
            {
                YandexMarketWebClient oYMWC = new YandexMarketWebClient(30000, 6, 20000);

                oDATA = oYMWC.SendRequestWithRateLimit(String.Format("https://api.partner.market.yandex.ru/v2/businesses/{1}/offer-mappings?page_token={0}&limit=100", vNextPageToken, Variables.vBusinessID), Variables.pApiKey, Encoding.UTF8.GetBytes(oJSS.Serialize(new Request { })));

                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                vSignFinish = true;

                if (oResponse.status == "OK" && oResponse.result != null && oResponse.result.offerMappings != null && oResponse.result.offerMappings.Length > 0)
                {
                    vNextPageToken = oResponse.result.paging.nextPageToken;
                    vSignFinish = oResponse.result.offerMappings.Length != 100;
                    foreach (Response_Result_offerMapping oItem in oResponse.result.offerMappings)
                    {
                        offerBuffer.AddRow();
                        if (oItem.offer != null)
                        {
                            offerBuffer.offerId = oItem.offer.offerId;
                            if (oItem.offer.name != null && oItem.offer.name.Length > 0) offerBuffer.Name = oItem.offer.name.Length > 200 ? oItem.offer.name.Substring(0, 200) : oItem.offer.name;
                            if (oItem.offer.category != null && oItem.offer.category.Length > 0) offerBuffer.category = oItem.offer.category.Length > 200 ? oItem.offer.category.Substring(0, 200) : oItem.offer.category;
                            if (oItem.offer.vendor != null && oItem.offer.vendor.Length > 0) offerBuffer.vendor = oItem.offer.vendor.Length > 200 ? oItem.offer.vendor.Substring(0, 200) : oItem.offer.vendor;
                            if (oItem.offer.description != null && oItem.offer.description.Length > 0) offerBuffer.description = oItem.offer.description.Length > 4000 ? oItem.offer.description.Substring(0, 4000) : oItem.offer.description;
                            if (oItem.offer.manufacturerCountries != null && oItem.offer.manufacturerCountries.Length > 0) offerBuffer.manufacturerCountries = string.Join(",", oItem.offer.manufacturerCountries);
                            if (oItem.offer.weightDimensions != null)
                            {
                                if (oItem.offer.weightDimensions.width != null) offerBuffer.weightDimensionswidth =(decimal)oItem.offer.weightDimensions.width;
                                if (oItem.offer.weightDimensions.length != null) offerBuffer.weightDimensionslength = (decimal)oItem.offer.weightDimensions.length;
                                if (oItem.offer.weightDimensions.height != null) offerBuffer.weightDimensionsheight = (decimal)oItem.offer.weightDimensions.height;
                                if (oItem.offer.weightDimensions.weight != null) offerBuffer.weightDimensionsweight = (decimal)oItem.offer.weightDimensions.weight;
                            }
                            if (oItem.offer.vendorCode != null && oItem.offer.vendorCode.Length > 0) offerBuffer.vendorCode = oItem.offer.vendorCode.Length > 50 ? oItem.offer.vendorCode.Substring(0, 50) : oItem.offer.vendorCode;
                            if (oItem.offer.guaranteePeriod != null)
                            {
                                if (oItem.offer.guaranteePeriod.timePeriod != null) offerBuffer.guaranteePeriodtimePeriod = (int)oItem.offer.guaranteePeriod.timePeriod;
                                if (oItem.offer.guaranteePeriod.timeUnit != null && oItem.offer.guaranteePeriod.timeUnit.Length > 0) offerBuffer.guaranteePeriodtimeUnit = oItem.offer.guaranteePeriod.timeUnit.Length > 50 ? oItem.offer.guaranteePeriod.timeUnit.Substring(0,50) : oItem.offer.guaranteePeriod.timeUnit;
                            }
                            if (oItem.offer.customsCommodityCode != null && oItem.offer.customsCommodityCode.Length > 0) offerBuffer.customsCommodityCode = oItem.offer.customsCommodityCode.Length > 50 ? oItem.offer.customsCommodityCode.Substring(0, 50) : oItem.offer.customsCommodityCode;
                            if (oItem.offer.boxCount != null) offerBuffer.boxCount = (int)oItem.offer.boxCount;
                            if (oItem.offer.basicPrice != null)
                            {
                                if (oItem.offer.basicPrice.currencyId != null && oItem.offer.basicPrice.currencyId.Length > 0) offerBuffer.basicPricecurrencyId = oItem.offer.basicPrice.currencyId.Length > 50 ? oItem.offer.basicPrice.currencyId.Substring(0, 50) : oItem.offer.basicPrice.currencyId;
                                if (oItem.offer.basicPrice.value != null) offerBuffer.basicPricevalue = (int) oItem.offer.basicPrice.value;
                                if (oItem.offer.basicPrice.discountBase != null) offerBuffer.basicPricediscountBase = (decimal)oItem.offer.basicPrice.discountBase;
                                if (oItem.offer.basicPrice.updatedAt != null) offerBuffer.basicPriceupdatedAt = (DateTime)oItem.offer.basicPrice.updatedAt;
                            }
                            if (oItem.offer.cardStatus != null) offerBuffer.cardStatus = oItem.offer.cardStatus.Length > 100 ? oItem.offer.cardStatus.Substring(0, 100) : oItem.offer.cardStatus;

                            if (oItem.offer.pictures != null)
                            {
                                int vNpp = 1;
                                foreach (string vUrl in oItem.offer.pictures)
