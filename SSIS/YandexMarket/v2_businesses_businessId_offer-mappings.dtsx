xCount]&#xA;      ,SRC.[basicPrice_value]&#xA;      ,SRC.[basicPrice_currencyId]&#xA;      ,SRC.[basicPrice_discountBase]&#xA;      ,SRC.[basicPrice_updatedAt]&#xA;      ,SRC.[cardStatus]&#xA;      ,SRC.[Mapping_marketSku]&#xA;      ,SRC.[Mapping_marketSkuName]&#xA;      ,SRC.[Mapping_marketModelId]&#xA;      ,SRC.[Mapping_marketModelName]&#xA;      ,SRC.[Mapping_marketCategoryId]&#xA;      ,SRC.[Mapping_marketCategoryName]&#xA; ) &lt;&gt; CHECKSUM(&#xA;     TGT.[business_id]&#xA;      ,TGT.[offerId]&#xA;      ,TGT.[Name]&#xA;      ,TGT.[category]&#xA;      ,TGT.[vendor]&#xA;      ,TGT.[description]&#xA;      ,TGT.[manufacturerCountries]&#xA;      ,TGT.[weightDimensions_width]&#xA;      ,TGT.[weightDimensions_length]&#xA;      ,TGT.[weightDimensions_height]&#xA;      ,TGT.[weightDimensions_weight]&#xA;      ,TGT.[vendorCode]&#xA;      ,TGT.[guaranteePeriod_timePeriod]&#xA;      ,TGT.[guaranteePeriod_timeUnit]&#xA;      ,TGT.[customsCommodityCode]&#xA;      ,TGT.[boxCount]&#xA;      ,TGT.[basicPrice_value]&#xA;      ,TGT.[basicPrice_currencyId]&#xA;      ,TGT.[basicPrice_discountBase]&#xA;      ,TGT.[basicPrice_updatedAt]&#xA;      ,TGT.[cardStatus]&#xA;      ,TGT.[Mapping_marketSku]&#xA;      ,TGT.[Mapping_marketSkuName]&#xA;      ,TGT.[Mapping_marketModelId]&#xA;      ,TGT.[Mapping_marketModelName]&#xA;      ,TGT.[Mapping_marketCategoryId]&#xA;      ,TGT.[Mapping_marketCategoryName]&#xA; ) THEN&#xA;  UPDATE SET &#xA;&#x9;  [business_id] = SRC.[business_id]&#xA;      ,[offerId] = SRC.[offerId]&#xA;      ,[Name] = SRC.[Name]&#xA;      ,[category] = SRC.[category]&#xA;      ,[vendor] = SRC.[vendor]&#xA;      ,[description] = SRC.[description]&#xA;      ,[manufacturerCountries] = SRC.[manufacturerCountries]&#xA;      ,[weightDimensions_width] = SRC.[weightDimensions_width]&#xA;      ,[weightDimensions_length] = SRC.[weightDimensions_length]&#xA;      ,[weightDimensions_height] = SRC.[weightDimensions_height]&#xA;      ,[weightDimensions_weight] = SRC.[weightDimensions_