              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [YandexMarket].[v2_businesses_buisnessid_offer-mappings_offer_showcaseUrls] WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING &#xA; (&#xA; SELECT&#xA;  *&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;     [business_id]&#xA;     ,[offerId]&#xA;     ,[npp]&#xA;     ,[showcaseType]&#xA;&#x9; ,[showcaseUrl]&#xA;     ,ROW_NUMBER() OVER (PARTITION BY [business_id], [offerId], npp ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;    [BUFFER].[YandexMarket v2_businesses_buisnessid_offer-mappings_offer_showcaseUrls]&#xA;   ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;&#xA; ) SRC ON (TGT.[business_id] = SRC.[business_id] AND TGT.[offerId] = SRC.[offerId] AND TGT.npp = SRC.[npp])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA;      SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[showcaseType]&#xA;   ,SRC.[showcaseUrl]&#xA; ) &lt;&gt; CHECKSUM(&#xA;      TGT.[business_id]&#xA;      ,TGT.[offerId]&#xA;      ,TGT.[npp]&#xA;      ,TGT.[showcaseType]&#xA;   ,TGT.[showcaseUrl]&#xA; ) THEN&#xA;  UPDATE SET &#xA;      [showcaseType] = SRC.[showcaseType]&#xA;   ,[showcaseUrl] = SRC.[showcaseUrl]&#xA;      ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;   [business_id]&#xA;      ,[offerId]&#xA;      ,[npp]&#xA;      ,[showcaseType]&#xA;   ,[showcaseUrl]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA;   SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[showcaseType]&#xA;   ,SRC.[showcaseUrl]&#xA;      ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
