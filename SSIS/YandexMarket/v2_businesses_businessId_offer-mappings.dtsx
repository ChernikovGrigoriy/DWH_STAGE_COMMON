              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE[YandexMarket].[v2_businesses_buisnessid_offer-mappings_offer_barcodes]  WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING &#xA; (&#xA; SELECT&#xA;  *&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;     [business_id]&#xA;     ,[offerId]&#xA;     ,[npp]&#xA;     ,[barcode]&#xA;     ,ROW_NUMBER() OVER (PARTITION BY [business_id], [offerId], npp ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;     [BUFFER].[YandexMarket v2_businesses_buisnessid_offer-mappings_offer_barcodes]&#xA;   ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;&#xA; ) SRC ON (TGT.[business_id] = SRC.[business_id] AND TGT.[offerId] = SRC.[offerId] AND TGT.npp = SRC.[npp])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA;      SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[barcode]&#xA; ) &lt;&gt; CHECKSUM(&#xA;      TGT.[business_id]&#xA;      ,TGT.[offerId]&#xA;      ,TGT.[npp]&#xA;      ,TGT.[barcode]&#xA; ) THEN&#xA;  UPDATE SET &#xA;      [barcode] = SRC.[barcode]&#xA;      ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;   [business_id]&#xA;      ,[offerId]&#xA;      ,[npp]&#xA;      ,[barcode]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA;   SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[barcode]&#xA;      ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\цикл\Загрузка в стейджинг\offerMappings_basicPrice"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{29B5918B-C976-4DB9-8125-25ED07C61A99}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="offerMappings_basicPrice"
              DTS:ThreadHint="4">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="DECLARE @step int&#xA;&#xA;SET @step = 1&#xA;&#xA;WHILE @step &lt;= 2&#xA;BEGIN&#xA;&#xA;&#x9;MERGE [YandexMarket].[v2_businesses_buisnessid_offer-mappings_offer_basicPrice]  TGT&#xA;&#x9;USING&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[business_id],&#xA;&#x9;&#x9;&#x9;[offerId],&#xA;&#x9;&#x9;&#x9;[basicPrice_value] [value],&#xA;&#x9;&#x9;&#x9;[basicPrice_currencyId] [currencyId],&#xA;&#x9;&#x9;&#x9;[basicPrice_discountBase] [discountBase],&#xA;&#x9;&#x9;&#x9;[basicPrice_updatedAt] [updatedAt]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[BUFFER].[YandexMarket v2_businesses_buisnessid_offer-mappings_offer]&#xA;&#x9;) SRC ON TGT.[business_id] = SRC.[business_id] AND  TGT.offerId = SRC.offerId AND TGT.offerId = SRC.offerId AND  TGT.[date_finish] = '22000101'&#xA;&#x9;WHEN MATCHED AND&#xA;&#x9;&#x9;TGT.[date_start] &lt; CAST(GETDATE() as date) AND&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  SRC.[business_id]&#xA;&#x9;&#x9;  ,SRC.[offerId]&#xA;&#x9;&#x9;  ,SRC.[value]&#xA;&#x9;&#x9;  ,SRC.[currencyId]&#xA;&#x9;&#x9;  ,SRC.[discountBase]&#xA;&#x9;&#x9;  ,SRC.[updatedAt]&#xA;&#x9;&#x9;) &lt;&gt;&#xA;&#x9;&#x9;CHECKSUM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  TGT.[business_id]&#xA;&#x9;&#x9;  ,TGT.[offerId]&#xA;&#x9;&#x9;  ,TGT.[value]&#xA;&#x9;&#x9;  ,TGT.[currencyId]&#xA;&#x9;&#x9;  ,TGT.[discountBase]&#xA;&#x9;&#x9;  ,TGT.[updatedAt]&#xA;&#x9;&#x9;) THEN&#xA;&#x9;  UPDATE SET &#xA;&#x9;&#x9;[date_finish] = DATEADD(day, -1, CAST(GETDATE() as date))&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;&#xA;&#x9;WHEN NOT MATCHED THEN&#xA;&#x9;&#x9;INSERT &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  [business_id]&#xA;&#x9;&#x9;  ,[offerId]&#xA;&#x9;&#x9;  ,[DATE_START]&#xA;&#x9;&#x9;  ,[DATE_FINISH]&#xA;&#x9;&#x9;  ,[value]&#xA;&#x9;&#x9;  ,[currencyId]&#xA;&#x9;&#x9;  ,[discountBase]&#xA;&#x9;&#x9;  ,[updatedAt]&#xA;&#x9;&#x9;  ,[SYSMOMENT]&#xA;&#x9;&#x9;)&#xA;&#x9;&#x9;VALUES&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;  [business_id]&#xA;&#x9;&#x9;  ,[offerId]&#xA;&#x9;&#x9;   ,CAST(GETDATE() as date)&#xA;&#x9;&#x9;  ,'22000101'&#xA;&#x9;&#x9;  ,[value]&#xA;&#x9;&#x9;  ,[currencyId]&#xA;&#x9;&#x9;  ,[discountBase]&#xA;&#x9;&#x9;  ,[updatedAt]&#xA;&#x9;&#x9;  ,GETDATE()&#xA;&#x9;&#x9;);&#xA;&#xA;&#x9;&#x9;SET @step = @step + 1&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\цикл\Загрузка в стейджинг\pictures"
