          DTS:LocaleID="-1"
          DTS:ObjectName="Загрузка в стейджинг">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\цикл\Загрузка в стейджинг\campaigns"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{175F133E-0374-467E-8B93-4B1061D5DAF9}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="campaigns"
              DTS:ThreadHint="3">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [YandexMarket].[v2_businesses_buisnessid_offer-mappings_offer_campaigns] WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING &#xA; (&#xA; SELECT&#xA;  *&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;     [business_id]&#xA;     ,[offerId]&#xA;     ,[npp]&#xA;     ,[campaignId]&#xA;&#x9; ,[status]&#xA;     ,ROW_NUMBER() OVER (PARTITION BY [business_id], [offerId], npp ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;    [BUFFER].[YandexMarket v2_businesses_buisnessid_offer-mappings_offer_campaigns]&#xA;   ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;&#xA; ) SRC ON (TGT.[business_id] = SRC.[business_id] AND TGT.[offerId] = SRC.[offerId] AND TGT.npp = SRC.[npp])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA;      SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[campaignId]&#xA;&#x9;  ,SRC.[status]&#xA; ) &lt;&gt; CHECKSUM(&#xA;      TGT.[business_id]&#xA;      ,TGT.[offerId]&#xA;      ,TGT.[npp]&#xA;      ,TGT.[campaignId]&#xA;&#x9;  ,TGT.[status]&#xA; ) THEN&#xA;  UPDATE SET &#xA;      [campaignId] = SRC.[campaignId]&#xA;&#x9;  ,[status] = SRC.[status]&#xA;      ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;   [business_id]&#xA;      ,[offerId]&#xA;      ,[npp]&#xA;      ,[campaignId]&#xA;&#x9;  ,[status]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA;   SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[campaignId]&#xA;&#x9;  ,SRC.[status]&#xA;      ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\цикл\Загрузка в стейджинг\commodityCodes"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{6697A9C2-1340-4801-9BC5-B45075C6D09D}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="commodityCodes"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [YandexMarket].[v2_businesses_buisnessid_offer-mappings_offer_commodityCodes] WITH(TABLOCKX, HOLDLOCK) TGT&#xA; USING &#xA; (&#xA; SELECT&#xA;  *&#xA; FROM&#xA;  (&#xA;   SELECT&#xA;     [business_id]&#xA;     ,[offerId]&#xA;     ,[npp]&#xA;     ,[code]&#xA;&#x9; ,[type]&#xA;     ,ROW_NUMBER() OVER (PARTITION BY [business_id], [offerId], npp ORDER BY CURRENT_TIMESTAMP) RN&#xA;   FROM&#xA;    [BUFFER].[YandexMarket v2_businesses_buisnessid_offer-mappings_offer_commodityCodes]&#xA;   ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;&#xA; ) SRC ON (TGT.[business_id] = SRC.[business_id] AND TGT.[offerId] = SRC.[offerId] AND TGT.npp = SRC.[npp])&#xA; WHEN MATCHED AND &#xA; CHECKSUM(&#xA;      SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[code]&#xA;&#x9;  ,SRC.[type]&#xA; ) &lt;&gt; CHECKSUM(&#xA;      TGT.[business_id]&#xA;      ,TGT.[offerId]&#xA;      ,TGT.[npp]&#xA;      ,TGT.[code]&#xA;&#x9;  ,TGT.[type]&#xA; ) THEN&#xA;  UPDATE SET &#xA;      [code] = SRC.[code]&#xA;&#x9;  ,[type] = SRC.[type]&#xA;      ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;   [business_id]&#xA;      ,[offerId]&#xA;      ,[npp]&#xA;      ,[code]&#xA;&#x9;  ,[type]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA;   SRC.[business_id]&#xA;      ,SRC.[offerId]&#xA;      ,SRC.[npp]&#xA;      ,SRC.[code]&#xA;&#x9;  ,SRC.[type]&#xA;      ,GETDATE()&#xA;  );&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\цикл\Загрузка в стейджинг\mediaFiles_pictures"
