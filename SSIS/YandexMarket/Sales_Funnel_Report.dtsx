                  SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[YandexMarket_Sales_Funnel_Report]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[YandexMarket_Sales_Funnel_Report]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[YandexMarket_Sales_Funnel_Report] FROM [YandexMarket].[Sales_Funnel_Report]&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
