            <DTS:Executable
              DTS:refId="Package\Загрузка по кампаниям\Загрузка по диапазону дат\Стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{028ba269-9b2d-4608-b452-df3b7ed35d88}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
