              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A8AE848C-C20D-4D50-91D9-9AEA14023632}"
                  SQLTask:SqlStatementSource="DECLARE @Campaign_ID bigint, @Day date, @DateStart date, @DateFinish date&#xA;&#xA;SELECT @Campaign_ID = ?, @DateStart = ?, @DateFinish = ?&#xA;&#xA;DECLARE CUR1 CURSOR FOR&#xA;SELECT &#xA; [DAY]&#xA;FROM &#xA; [BUFFER].[YandexMarket_Sales_Funnel_Report]&#xA;GROUP BY&#xA; [DAY]&#xA;&#xA;OPEN CUR1 &#xA;&#xA;FETCH NEXT FROM CUR1 INTO @Day&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA; DELETE FROM [YandexMarket].[Sales_Funnel_Report] WHERE [ID_Campaign] = @Campaign_ID AND [Day] = @Day &#xA; &#xA;&#xA; INSERT INTO [YandexMarket].[Sales_Funnel_Report]&#xA; (&#xA;   [ID_Campaign]&#xA;      ,[DAY]&#xA;      ,[MONTH]&#xA;      ,[YEAR]&#xA;      ,[CATEGORY_NAME]&#xA;      ,[BRAND_NAME]&#xA;      ,[OFFER_ID]&#xA;      ,[OFFER_NAME]&#xA;      ,[BY_MSKU_SHOWS]&#xA;      ,[VISIBILITY_INDEX]&#xA;      ,[MAX_VISIBILITY_INDEX]&#xA;      ,[SHOWS]&#xA;      ,[SHOWS_SHARE]&#xA;      ,[TO_CART_CONVERSION]&#xA;      ,[TO_CART]&#xA;      ,[TO_CART_SHARE]&#xA;      ,[ORDER_ITEMS]&#xA;      ,[ORDER_ITEMS_TOTAL_AMOUNT]&#xA;      ,[TO_ORDER_CONVERSION]&#xA;      ,[ORDER_ITEMS_SHARE]&#xA;      ,[ORDER_ITEMS_DELIVERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_CANCELED_COUNT]&#xA;      ,[ORDER_ITEMS_RETURNED_COUNT]&#xA;      ,SYSMOMENT&#xA; )&#xA; SELECT &#xA;   [ID_Campaign]&#xA;      ,[DAY]&#xA;      ,[MONTH]&#xA;      ,[YEAR]&#xA;      ,[CATEGORY_NAME]&#xA;      ,[BRAND_NAME]&#xA;      ,[OFFER_ID]&#xA;      ,[OFFER_NAME]&#xA;      ,[BY_MSKU_SHOWS]&#xA;      ,[VISIBILITY_INDEX]&#xA;      ,[MAX_VISIBILITY_INDEX]&#xA;      ,[SHOWS]&#xA;      ,[SHOWS_SHARE]&#xA;      ,[TO_CART_CONVERSION]&#xA;      ,[TO_CART]&#xA;      ,[TO_CART_SHARE]&#xA;      ,[ORDER_ITEMS]&#xA;      ,[ORDER_ITEMS_TOTAL_AMOUNT]&#xA;      ,[TO_ORDER_CONVERSION]&#xA;      ,[ORDER_ITEMS_SHARE]&#xA;      ,[ORDER_ITEMS_DELIVERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT]&#xA;      ,[ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT]&#xA;      ,[ORDER_ITEMS_CANCELED_COUNT]&#xA;      ,[ORDER_ITEMS_RETURNED_COUNT]&#xA;      ,GETDATE()&#xA;  FROM &#xA; [BUFFER].[YandexMarket_Sales_Funnel_Report]&#xA;  WHERE&#xA; [ID_Campaign] = @Campaign_ID AND [Day] = @Day &#xA;&#xA;  FETCH NEXT FROM CUR1 INTO  @Day&#xA;END&#xA;&#xA;CLOSE CUR1&#xA;DEALLOCATE CUR1&#xA;&#xA;&#xA;MERGE [dbo].[LoadAnalyze] WITH(TABLOCK) TGT &#xA;USING (&#xA;SELECT 'YandexMarket.Sales_Funnel_Report' [TableName], CAST(@Campaign_ID as nvarchar(200)) [Key], [DATA] [DateLoad], GETDATE() SYSMOMENT FROM [dbo].[fnDATA](@DateStart, @DateFinish, NULL)&#xA;) SRC ON TGT.[TableName] = SRC.[TableName] AND TGT.[Key] = SRC.[Key] AND TGT.[DateLoad] = SRC.[DateLoad]&#xA;WHEN MATCHED THEN&#xA;UPDATE SET SYSMOMENT = SRC.SYSMOMENT&#xA;WHEN NOT MATCHED THEN&#xA;INSERT ([TableName],[Key], [DateLoad], [SYSMOMENT])&#xA;VALUES (SRC.[TableName],SRC.[Key], SRC.[DateLoad], SRC.[SYSMOMENT]);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::vID_Campaign"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="3"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
