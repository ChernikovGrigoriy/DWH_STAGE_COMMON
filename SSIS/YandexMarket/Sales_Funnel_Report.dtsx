                              dataType="System.String"><![CDATA[#region Help:  Introduction to the Script Component
/* The Script Component allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services data flow.
 *
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script component. */
#endregion

#region Namespaces
using System;
using System.Collections.Generic;
using System.Data;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using Microsoft.VisualBasic.FileIO;
using System.IO.Compression;
using System.Web.Script.Serialization;
#endregion

/// <summary>
/// This is the class to which to add your code.  Do not change the name, attributes, or parent
/// of this class.
/// </summary>
[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    #region Help:  Using Integration Services variables and parameters
    /* To use a variable in this script, first ensure that the variable has been added to
     * either the list contained in the ReadOnlyVariables property or the list contained in
     * the ReadWriteVariables property of this script component, according to whether or not your
     * code needs to write into the variable.  To do so, save this script, close this instance of
     * Visual Studio, and update the ReadOnlyVariables and ReadWriteVariables properties in the
     * Script Transformation Editor window.
     * To use a parameter in this script, follow the same steps. Parameters are always read-only.
     *
     * Example of reading from a variable or parameter:
     *  DateTime startTime = Variables.MyStartTime;
     *
     * Example of writing to a variable:
     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Request_Step1
    public class Request_Step1
    {
        public long campaignId { get; set; }
        public string dateFrom { get; set; }
        public string dateTo { get; set; }
        public string grouping { get; set; }
    }
    #endregion

    #region Response_Step1
    public class Response_Step1
    {
        public Response_Step1_Result result { get; set; }
        public Response_Error[] Errors { get; set; }
    }

    public class Response_Step1_Result
    {
        public string reportId { get; set; }
        public int estimatedGenerationTime { get; set; }
    }
    #endregion

    #region Response_Step2
    public class Response_Step2
    {
        public string status { get; set; }
        public Response_Step2_Result result { get; set; }
        public Response_Error[] Errors { get; set; }
    }

    public class Response_Step2_Result
    {
        public string status { get; set; }
        public DateTime? generationRequestedAt { get; set; }
        public DateTime? generationFinishedAt { get; set; }
        public string file { get; set; }
    }
    #endregion

    public class Response_Error
    {
        public string code { get; set; }
        public string message { get; set; }
    }

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        vErrorStr = string.Empty;
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
    }

    public string vErrorStr;

    private string Step1(long CampaignID, DateTime DateStart, DateTime DateFinish)
    {
        byte[] oDATA = null;
        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        Request_Step1 oRequest = new Request_Step1
        {
            campaignId = CampaignID,
            dateFrom = string.Format("{0:yyyy-MM-dd}", DateStart),
            dateTo = string.Format("{0:yyyy-MM-dd}", DateFinish),
            grouping = "OFFERS"
        };


        int i = 1;
        while (i <= 6)
        {
            try
            {
                TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                string vURL = String.Format("https://api.partner.market.yandex.ru/reports/shows-sales/generate?format=CSV");
                oTWC.Headers.Add("Api-Key", string.Format("{0}", Variables.pApiKey));
                oDATA = oTWC.UploadData(vURL, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));
                oTWC = null;

                break;
            }
            catch (Exception e)
            {
                if (e.Message.Contains("Too Many Requests"))
                {
                    Thread.Sleep(20000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Слишком большое количество обращений к серверу YandexMarket");


        Response_Step1 oResponse = oJSS.Deserialize<Response_Step1>(Encoding.UTF8.GetString(oDATA));

        return oResponse.result.reportId;
    }

    private string Step2(string ReportID)
    {
        CultureInfo provider = CultureInfo.InvariantCulture;

        Response_Step2 oResponse = null;
        int vStep = 1;

        do
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                    string vURL = String.Format("https://api.partner.market.yandex.ru/reports/info/{0}", ReportID);
                    oTWC.Headers.Add("Api-Key", string.Format("{0}", Variables.pApiKey));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests"))
                    {
                        Thread.Sleep(20000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Слишком большое количество обращений к серверу YandexMarket");

            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            oResponse = oJSS.Deserialize<Response_Step2>(Encoding.UTF8.GetString(oDATA));

            vStep++;

            if (oResponse.result.status != "DONE") Thread.Sleep(20000);

        } while (oResponse.result.status != "DONE" && vStep < 10);

        if (oResponse.result.status != "DONE")
        {
            if (oResponse.Errors != null)
                throw new ApplicationException(oResponse.Errors[0].message);

            throw new ApplicationException("Закончилось время ожидания отчета SalesFunnel для YandexMarket");
        }

        return oResponse.result.file;
    }

    private void Step3(string file)
    {
        CultureInfo provider = CultureInfo.InvariantCulture;

        byte[] oDATA = null;

        int i = 1;
        while (i <= 6)
        {
            try
            {
                TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                string vURL = String.Format(file);
                oDATA = oTWC.DownloadData(vURL);
                oTWC = null;

                break;
            }
            catch (Exception e)
            {
                if (e.Message.Contains("Too Many Requests"))
                {
                    Thread.Sleep(20000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Слишком большое количество обращений к серверу YandexMarket");


        using (var oMemoryStream = new MemoryStream(oDATA))
        {
            using (var oZipArchive = new ZipArchive(oMemoryStream, ZipArchiveMode.Read))
            {
                foreach (var entry in oZipArchive.Entries)
                {
                    using (var oEntryStream = entry.Open())
                    {
                        using (var reader = new StreamReader(oEntryStream))
                        {
                            string content = reader.ReadToEnd();

                            using (var oCSVStream = new MemoryStream())
                            {
                                using (var oWriter = new StreamWriter(oCSVStream))
                                {
                                    oWriter.Write(content);
                                    oWriter.Flush();

                                    oCSVStream.Position = 0;

                                    using (Microsoft.VisualBasic.FileIO.TextFieldParser oTFP = new TextFieldParser(oCSVStream))
                                    {
                                        oTFP.Delimiters = new string[] { "," };
                                        oTFP.HasFieldsEnclosedInQuotes = true;

                                        string[] vFields = oTFP.ReadFields();

                                        while (!oTFP.EndOfData)
                                        {
                                            string[] vValues = oTFP.ReadFields();

                                            if (vFields.Length == vValues.Length)
                                            {
                                                OutputBuffer.AddRow();
                                                for (int j = 0; j < vFields.Length; j++)
                                                {
                                                    vErrorStr = string.Format("Field={0}", vFields[j]);
                                                    switch (vFields[j])
                                                    {
                                                        case "DAY":
                                                            if (vValues[j] != null) OutputBuffer.DAY = DateTime.ParseExact(vValues[j], "dd-MM-yyyy", provider);
                                                            break;

                                                        case "MONTH":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.MONTH = vValues[j].Length > 10 ? vValues[j].Substring(0, 10) : vValues[j];
                                                            break;

                                                        case "YEAR":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.YEAR = vValues[j].Length > 10 ? vValues[j].Substring(0, 10) : vValues[j];
                                                            break;

                                                        case "CATEGORY_NAME":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.CATEGORYNAME = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "BRAND_NAME":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.BRANDNAME = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "OFFER_ID":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.OFFERID = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "OFFER_NAME":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.OFFERNAME = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "VISIBILITY_INDEX":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.VISIBILITYINDEX = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "BY_MSKU_SHOWS":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.BYMSKUSHOWS = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "MAX_VISIBILITY_INDEX":
                                                            if (vValues[j] != null && vValues[j].Length > 0) OutputBuffer.MAXVISIBILITYINDEX = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                                            break;

                                                        case "SHOWS":
                                                            if (vValues[j] != null) OutputBuffer.SHOWS = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "SHOWS_SHARE":
                                                            if (vValues[j] != null) OutputBuffer.SHOWSSHARE = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "TO_CART_CONVERSION":
                                                            if (vValues[j] != null) OutputBuffer.TOCARTCONVERSION = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "TO_CART":
                                                            if (vValues[j] != null) OutputBuffer.TOCART = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "TO_CART_SHARE":
                                                            if (vValues[j] != null) OutputBuffer.TOCARTSHARE = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMS = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_TOTAL_AMOUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSTOTALAMOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "TO_ORDER_CONVERSION":
                                                            if (vValues[j] != null) OutputBuffer.TOORDERCONVERSION = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_SHARE":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSSHARE = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_DELIVERED_COUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSDELIVEREDCOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_DELIVERED_TOTAL_AMOUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSDELIVEREDTOTALAMOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_DELIVERED_FROM_ORDERED_COUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSDELIVEREDFROMORDEREDCOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_DELIVERED_FROM_ORDERED_TOTAL_AMOUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSDELIVEREDFROMORDEREDTOTALAMOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_CANCELED_COUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSCANCELEDCOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;

                                                        case "ORDER_ITEMS_RETURNED_COUNT":
                                                            if (vValues[j] != null) OutputBuffer.ORDERITEMSRETURNEDCOUNT = Decimal.Parse(vValues[j], NumberStyles.Any, CultureInfo.InvariantCulture);
                                                            break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    public override void CreateNewOutputRows()
    {
        
        try
        {
            string ReportID = Step1(Variables.vIDCampaign, Variables.vDateStart, Variables.vDateFinish);

            Thread.Sleep(5000);

            string vFilePath = Step2(ReportID);

            if (vFilePath != null)
                Step3(vFilePath);

        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("{0}", vErrorStr), e.Message, "", 0, out cancel);
        }
    }

}
