    public override void CreateNewOutputRows()
    {
        string oDATA = null;

        string vError = null;

        DateTime vDateStart = Variables.vDate;
        DateTime vDateFinish = vDateStart.AddHours(23).AddMinutes(59).AddSeconds(59);
        bool vEnd = false;

        try
        {
            int i = 1; int j = 100;
            while (i <= 6)
            {
                try
                {
                    do
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                        string vURL = String.Format("https://api.appmetrica.yandex.ru/logs/v1/export/events.json?application_id={0}&date_since={1:yyyy-MM-dd HH:mm:ss}&date_until={2:yyyy-MM-dd HH:mm:ss}&date_dimension=default&use_utf8_bom=false&fields=event_datetime,event_json,event_name,event_receive_datetime,event_receive_timestamp,event_timestamp,session_id,installation_id,appmetrica_device_id,city,connection_type,country_iso_code,device_ipv6,device_locale,device_manufacturer,device_model,device_type,google_aid,ios_ifa,ios_ifv,mcc,mnc,operator_name,original_device_model,os_name,os_version,profile_id,windows_aid,app_build_number,app_package_name,app_version_name,application_id", Variables.pApplication, vDateStart, vDateFinish);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.pToken));
                        oTWC.Headers.Add("Cache-Control", string.Format("max-age=6000"));
                        oDATA = Encoding.UTF8.GetString(oTWC.DownloadData(vURL));
                        oTWC = null;
                        j--;
                        vError = "Данные с сервера: " + (oDATA.Length > 500 ? oDATA.Substring(0,500) : oDATA);
                        if (
                                oDATA.Contains("Wait for result. Progress is") || 
                                oDATA.Contains("Your query is added to the queue.") || 
                                oDATA.Contains("Your query is moved to the end of the queue due to provided Cache-Control restriction.")
                                )
                            Thread.Sleep(30000);
                        else
                            vEnd = true;
                    } while (j > 0 && vEnd == false);

                    if (j == 0) throw new ApplicationException("Время ожидания отчета истекло");

                    break;
                }
                catch (Exception e)
                {
                    if (
                        e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("(504) Истекло время ожидания шлюза.") 
                        || e.Message.Contains("(500) Внутренняя ошибка сервера.")
                        )
                    {
                        Thread.Sleep(20000 * i);
                        i++;
                    }
                    else
                    {
