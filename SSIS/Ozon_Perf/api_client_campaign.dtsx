        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5f9c1927-d676-4f30-b016-4f7c7f487636}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в стейджинг"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
              SQLTask:SqlStatementSource="MERGE [Ozon_Perf].[api_client_campaign] TGT&#xA;USING [BUFFER].[Ozon_Perf_api_client_campaign] SRC ON TGT.id_account = SRC.id_account AND TGT.id = SRC.id&#xA;WHEN MATCHED AND&#xA;&#x9;CHECKSUM(&#xA;&#x9;&#x9;SRC.[id]&#xA;      ,SRC.[title]&#xA;      ,SRC.[state]&#xA;      ,SRC.[advObjectType]&#xA;      ,SRC.[fromDate]&#xA;      ,SRC.[toDate]&#xA;      ,SRC.[dailyBudget]&#xA;      ,SRC.[placement]&#xA;      ,SRC.[budget]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[updatedAt]&#xA;      ,SRC.[productCampaignMode]&#xA;      ,SRC.[productAutopilotStrategy]&#xA;      ,SRC.[autopilot]&#xA;      ,SRC.[PaymentType]&#xA;      ,SRC.[expenseStrategy]&#xA;      ,SRC.[weeklyBudget]&#xA;      ,SRC.[budgetType]&#xA;      ,SRC.[startWeekDay]&#xA;      ,SRC.[endWeekDay]&#xA;      ,SRC.[autoIncrease]&#xA;      ,SRC.[ProductAdvPlacements]&#xA;      ,SRC.[isAutocreated]&#xA;      ,SRC.[autostopStatus]&#xA;&#x9;) &lt;&gt;&#xA;&#x9;CHECKSUM(&#xA;&#x9;&#x9;TGT.[id]&#xA;      ,TGT.[title]&#xA;      ,TGT.[state]&#xA;      ,TGT.[advObjectType]&#xA;      ,TGT.[fromDate]&#xA;      ,TGT.[toDate]&#xA;      ,TGT.[dailyBudget]&#xA;      ,TGT.[placement]&#xA;      ,TGT.[budget]&#xA;      ,TGT.[createdAt]&#xA;      ,TGT.[updatedAt]&#xA;      ,TGT.[productCampaignMode]&#xA;      ,TGT.[productAutopilotStrategy]&#xA;      ,TGT.[autopilot]&#xA;      ,TGT.[PaymentType]&#xA;      ,TGT.[expenseStrategy]&#xA;      ,TGT.[weeklyBudget]&#xA;      ,TGT.[budgetType]&#xA;      ,TGT.[startWeekDay]&#xA;      ,TGT.[endWeekDay]&#xA;      ,TGT.[autoIncrease]&#xA;      ,TGT.[ProductAdvPlacements]&#xA;      ,TGT.[isAutocreated]&#xA;      ,TGT.[autostopStatus]&#xA;&#x9;) THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[id] = SRC.[id]&#xA;      ,[title] = SRC.[title]&#xA;      ,[state] = SRC.[state]&#xA;      ,[advObjectType] = SRC.[advObjectType]&#xA;      ,[fromDate] = SRC.[fromDate]&#xA;      ,[toDate] = SRC.[toDate]&#xA;      ,[dailyBudget] =SRC.[dailyBudget]&#xA;      ,[placement] = SRC.[placement]&#xA;      ,[budget] = SRC.[budget]&#xA;      ,[createdAt] = SRC.[createdAt]&#xA;      ,[updatedAt] = SRC.[updatedAt]&#xA;      ,[productCampaignMode] = SRC.[productCampaignMode]&#xA;      ,[productAutopilotStrategy] = SRC.[productAutopilotStrategy]&#xA;      ,[autopilot] = SRC.[autopilot]&#xA;      ,[PaymentType] = SRC.[PaymentType]&#xA;      ,[expenseStrategy] = SRC.[expenseStrategy]&#xA;      ,[weeklyBudget] = SRC.[weeklyBudget]&#xA;      ,[budgetType] = SRC.[budgetType]&#xA;      ,[startWeekDay] = SRC.[startWeekDay]&#xA;      ,[endWeekDay] = SRC.[endWeekDay]&#xA;      ,[autoIncrease] = SRC.[autoIncrease]&#xA;      ,[ProductAdvPlacements] = SRC.[ProductAdvPlacements]&#xA;      ,[isAutocreated] = SRC.[isAutocreated]&#xA;      ,[autostopStatus] = SRC.[autostopStatus]&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;&#x9;[id_Account]&#xA;      ,[id]&#xA;      ,[title]&#xA;      ,[state]&#xA;      ,[advObjectType]&#xA;      ,[fromDate]&#xA;      ,[toDate]&#xA;      ,[dailyBudget]&#xA;      ,[placement]&#xA;      ,[budget]&#xA;      ,[createdAt]&#xA;      ,[updatedAt]&#xA;      ,[productCampaignMode]&#xA;      ,[productAutopilotStrategy]&#xA;      ,[autopilot]&#xA;      ,[PaymentType]&#xA;      ,[expenseStrategy]&#xA;      ,[weeklyBudget]&#xA;      ,[budgetType]&#xA;      ,[startWeekDay]&#xA;      ,[endWeekDay]&#xA;      ,[autoIncrease]&#xA;      ,[ProductAdvPlacements]&#xA;      ,[isAutocreated]&#xA;      ,[autostopStatus]&#xA;      ,[SYSMOMENT]&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;&#x9;SRC.[id_Account]&#xA;      ,SRC.[id]&#xA;      ,SRC.[title]&#xA;      ,SRC.[state]&#xA;      ,SRC.[advObjectType]&#xA;      ,SRC.[fromDate]&#xA;      ,SRC.[toDate]&#xA;      ,SRC.[dailyBudget]&#xA;      ,SRC.[placement]&#xA;      ,SRC.[budget]&#xA;      ,SRC.[createdAt]&#xA;      ,SRC.[updatedAt]&#xA;      ,SRC.[productCampaignMode]&#xA;      ,SRC.[productAutopilotStrategy]&#xA;      ,SRC.[autopilot]&#xA;      ,SRC.[PaymentType]&#xA;      ,SRC.[expenseStrategy]&#xA;      ,SRC.[weeklyBudget]&#xA;      ,SRC.[budgetType]&#xA;      ,SRC.[startWeekDay]&#xA;      ,SRC.[endWeekDay]&#xA;      ,SRC.[autoIncrease]&#xA;      ,SRC.[ProductAdvPlacements]&#xA;      ,SRC.[isAutocreated]&#xA;      ,SRC.[autostopStatus]&#xA;      ,GETDATE()&#xA;&#x9;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
