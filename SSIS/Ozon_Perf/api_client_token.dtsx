      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Ozon_Perf_Account]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Ozon_Perf_Account]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Ozon_Perf_Account] FROM [Ozon_Perf].[Account]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
