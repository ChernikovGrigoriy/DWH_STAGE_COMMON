    <DTS:Executable
      DTS:refId="Package\Загрузка в стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D30ECAFD-3D23-459E-B797-2DC7AF6EA124}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Загрузка в стейджинг"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
          SQLTask:SqlStatementSource="MERGE [Ozon_Perf].[Account] WITH (TABLOCK) TGT&#xA;USING [BUFFER].[Ozon_Perf_Account] SRC ON TGT.id_account = SRC.id_account&#xA;WHEN MATCHED THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[Name] = SRC.[Name],&#xA;&#x9;&#x9;[access_token] = SRC.[access_token],&#xA;&#x9;&#x9;[expires_in] = SRC.[expires_in],&#xA;&#x9;&#x9;[token_type] = SRC.[token_type],&#xA;&#x9;&#x9;SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT ([id_account], [Name], [access_token], [expires_in], [token_type], [SYSMOMENT])&#xA;&#x9;VALUES (SRC.[id_account], SRC.[Name], SRC.[access_token], SRC.[expires_in], SRC.[token_type], GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
