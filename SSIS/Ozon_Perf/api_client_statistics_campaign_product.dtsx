              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
                  SQLTask:SqlStatementSource="&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[buffer].[Ozon_Perf_api_client_statistics_campaign_product]')&#xA;            and   type = 'U')&#xA;   drop table [buffer].[Ozon_Perf_api_client_statistics_campaign_product]&#xA;&#xA;SELECT TOP 0 * INTO [buffer].[Ozon_Perf_api_client_statistics_campaign_product] FROM [Ozon_Perf].[api_client_statistics_campaign_product]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\загрузка\список кампаний"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{F35CC91F-7816-4EA6-A1F7-F7A93FC65C78}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="список кампаний"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
                  SQLTask:SqlStatementSource="SELECT&#xA;&#x9;STRING_AGG('&amp;campaignIds=' + cast(id as nvarchar(100)),'') campaigns&#xA;FROM&#xA;&#x9;(&#xA;&#x9;SELECT&#x9;&#xA;&#x9;&#x9;id,&#xA;&#x9;&#x9;ROW_NUMBER() OVER (ORDER BY CURRENT_TIMESTAMP) / 100 [set]&#xA;&#x9;FROM&#xA;&#x9;&#x9;(SELECT DISTINCT id_account,[id] FROM [Ozon_Perf].[api_client_campaign] WHERE ? BETWEEN [fromDate] AND ISNULL([toDate], '22000101')) TMP&#xA;&#x9;) TMP&#xA;GROUP BY&#xA;&#x9;[set]"
                  SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ResultBinding
                    SQLTask:ResultName="0"
                    SQLTask:DtsVariableName="User::vCampaignsObj" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::vDate"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="7"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
