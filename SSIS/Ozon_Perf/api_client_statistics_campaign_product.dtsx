    #region Шаблон

    public class Response
    {
        public Response_Row[] rows { get; set; }
    }

    public class Response_Row
    {
        public long id { get; set; }
        public string title { get; set; }
        public string objectType { get; set; }
        public string status { get; set; }
        public string placement { get; set; }
        public string weeklyBudget { get; set; }
        public string budget { get; set; }
        public string moneySpent { get; set; }
        public string views { get; set; }
        public string clicks { get; set; }
        public string ctr { get; set; }
        public string clickPrice { get; set; }
        public string orders { get; set; }
        public string ordersMoney { get; set; }
        public string drr { get; set; }
        public string toCart { get; set; }
        public string strategy { get; set; }
    }
    #endregion

    JavaScriptSerializer _JSS = null;
    CultureInfo _CultureInfo = null;

    string _access_token = null;
    string _token_type = null;

    public void GET_ACCESS()
    {
        OleDbConnection oSqlConnection = new OleDbConnection(Connections.DWHSTAGECOMMON.ConnectionString);
        oSqlConnection.Open();

        OleDbCommand oSqlCommand = new OleDbCommand(string.Format("UPDATE [Ozon_Perf].[Account] SET [SYSMOMENT_LAST_QUERY_API] = GETDATE() WHERE id_account = {0}", Variables.vIDAccount), oSqlConnection);
        oSqlCommand.ExecuteNonQuery();

        oSqlCommand = new OleDbCommand(string.Format("SELECT [access_token], [token_type] FROM [Ozon_Perf].[Account] WHERE id_account = {0}", Variables.vIDAccount), oSqlConnection);

        OleDbDataReader oReader = oSqlCommand.ExecuteReader();

        while (oReader.Read())
        {
            _access_token = (string)oReader["access_token"];
            _token_type = (string)oReader["token_type"];
        }

        oSqlConnection.Close();
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = int.MaxValue;

        _CultureInfo = new CultureInfo("ru-RU");
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {

        string vFieldError = "";

        try
        {
            GET_ACCESS();

            OzonPerfWebClient oOPWC = new OzonPerfWebClient(30000, 6, 26000);
            byte[] vDATA = oOPWC.SendRequestWithRateLimit(String.Format("https://api-performance.ozon.ru:443/api/client/statistics/campaign/product/json?dateFrom={0:yyyy-MM-dd}&dateTo={1:yyyy-MM-dd}{2}", Variables.vDate, Variables.vDate, Variables.vCampaigns), _access_token, _token_type);

            Response oResponse = _JSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

            if (oResponse.rows != null)
