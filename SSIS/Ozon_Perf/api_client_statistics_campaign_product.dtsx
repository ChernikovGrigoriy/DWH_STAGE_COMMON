            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\загрузка\загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{46D0170B-C483-4B39-9D08-59BD20BD6DD8}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="загрузка в стейджинг"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
                  SQLTask:SqlStatementSource="DECLARE @id_account as int, @date as date&#x9;&#xA;&#xA;SELECT @id_account =? , @date = ?&#xA;&#x9;&#xA;DELETE FROM [Ozon_Perf].[api_client_statistics_campaign_product] WHERE id_account = @id_account AND [date] = @date;&#xA;&#xA;INSERT INTO [Ozon_Perf].[api_client_statistics_campaign_product]&#xA;(&#xA;&#x9;[id_Account]&#xA;    ,[date]&#xA;    ,[id]&#xA;    ,[title]&#xA;    ,[objectType]&#xA;    ,[status]&#xA;    ,[placement]&#xA;    ,[weeklyBudget]&#xA;    ,[budget]&#xA;    ,[moneySpent]&#xA;    ,[views]&#xA;    ,[clicks]&#xA;    ,[ctr]&#xA;    ,[clickPrice]&#xA;    ,[orders]&#xA;    ,[ordersMoney]&#xA;    ,[drr]&#xA;    ,[toCart]&#xA;    ,[strategy]&#xA;    ,[SYSMOMENT]&#xA;)&#xA;SELECT&#xA;&#x9;[id_Account]&#xA;    ,[date]&#xA;    ,[id]&#xA;    ,[title]&#xA;    ,[objectType]&#xA;    ,[status]&#xA;    ,[placement]&#xA;    ,[weeklyBudget]&#xA;    ,[budget]&#xA;    ,[moneySpent]&#xA;    ,[views]&#xA;    ,[clicks]&#xA;    ,[ctr]&#xA;    ,[clickPrice]&#xA;    ,[orders]&#xA;    ,[ordersMoney]&#xA;    ,[drr]&#xA;    ,[toCart]&#xA;    ,[strategy]&#xA;    ,GETDATE()&#xA;FROM&#xA;&#x9;[BUFFER].[Ozon_Perf_api_client_statistics_campaign_product]&#xA;&#xA;&#xA;MERGE Ozon_Perf.api_client_statistics_campaign_product_dates TGT&#xA;USING (SELECT @id_account id_account, @date [date] ) SRC ON TGT.id_account = SRC.id_account AND TGT.[date] = SRC.[date]&#xA;WHEN MATCHED THEN&#xA;UPDATE SET&#xA;&#x9;SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;INSERT ([id_Account], [date], [SYSMOMENT])&#xA;VALUES (SRC.id_account, SRC.[date], GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::vID_Account"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="20"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="1"
                    SQLTask:DtsVariableName="User::vDate"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="7"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
