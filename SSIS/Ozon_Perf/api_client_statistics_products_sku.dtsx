          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{561D7E72-038B-4793-9AC4-DF1EF13BB6EE}"
              SQLTask:SqlStatementSource="DECLARE @table as TABLE&#xA;(&#xA;&#x9;id_account int,&#xA;&#x9;[date] date&#xA;)&#xA;&#xA;INSERT INTO @table&#xA;(&#xA;&#x9;id_account,&#xA;&#x9;[date]&#xA;)&#xA;SELECT&#xA;&#x9;DISTINCT&#xA;&#x9;[id_Account],&#xA;&#x9;[date]&#xA;FROM&#xA;&#x9;[BUFFER].[Ozon_Perf_api_client_statistics_products_sku]&#xA;&#xA;DECLARE @id_account int, @date date&#xA;&#xA;DECLARE cur1 CURSOR FOR&#xA;SELECT id_account, [date] FROM @table&#xA;&#xA;OPEN cur1&#xA;&#xA;FETCH NEXT FROM cur1 INTO @id_account, @date&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;&#x9;DELETE FROM [Ozon_Perf].[api_client_statistics_products_sku] WHERE id_account = @id_account AND [date] = @date;&#xA;&#xA;&#x9;INSERT INTO [Ozon_Perf].[api_client_statistics_products_sku]&#xA;&#x9;(&#xA;&#x9;  [id_Account]&#xA;      ,[date]&#xA;      ,[avgCpc]&#xA;      ,[campaignId]&#xA;      ,[clicks]&#xA;      ,[ctr]&#xA;      ,[dateAdded]&#xA;      ,[drr]&#xA;      ,[expense]&#xA;      ,[modelOrders]&#xA;      ,[modelSales]&#xA;      ,[orders]&#xA;      ,[price]&#xA;      ,[sales]&#xA;      ,[sku]&#xA;      ,[toCart]&#xA;      ,[views]&#xA;      ,[SYSMOMENT]&#xA;&#x9;)&#xA;&#x9;SELECT&#xA;&#x9;  [id_Account]&#xA;      ,[date]&#xA;      ,[avgCpc]&#xA;      ,[campaignId]&#xA;      ,[clicks]&#xA;      ,[ctr]&#xA;      ,[dateAdded]&#xA;      ,[drr]&#xA;      ,[expense]&#xA;      ,[modelOrders]&#xA;      ,[modelSales]&#xA;      ,[orders]&#xA;      ,[price]&#xA;      ,[sales]&#xA;      ,[sku]&#xA;      ,[toCart]&#xA;      ,[views]&#xA;      ,GETDATE()&#xA;&#x9;FROM&#xA;&#x9;&#x9;[BUFFER].[Ozon_Perf_api_client_statistics_products_sku]&#xA;&#x9;WHERE&#xA;&#x9;&#x9;id_account = @id_account AND [date] = @date;&#xA;&#xA;    FETCH NEXT FROM cur1 INTO @id_account, @date&#xA;END&#xA;&#xA;CLOSE cur1&#xA;DEALLOCATE cur1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
