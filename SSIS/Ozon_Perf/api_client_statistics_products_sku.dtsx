     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Шаблон
    public class Request
    {
        public string[] campaignIds { get; set; }
        public string dateFrom { get; set; }
        public string dateTo { get; set; }
    }

    public class Response
    {
        public Response_Row[] rows { get; set; }
    }

    public class Response_Row
    {
        public long? campaignId { get; set; }
        public DateTime date { get; set; }
        public string sku { get; set; }
        public decimal? price { get; set; }
        public decimal? views { get; set; }
        public decimal? clicks { get; set; }
        public decimal? ctr { get; set; }
        public decimal? toCart { get; set; }
        public decimal? avgCpc { get; set; }
        public decimal? expense { get; set; }
        public decimal? orders { get; set; }
        public decimal? sales { get; set; }
        public decimal? modelOrders { get; set; }
        public decimal? modelSales { get; set; }
        public decimal? drr { get; set; }
        public DateTime? dateAdded { get; set; }
    }
    #endregion

    JavaScriptSerializer _JSS = null;

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = int.MaxValue;
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {

        string vFieldError = "";

        Request oRequest = new Request
        {
            campaignIds = Variables.vCampaigns.Split(','),
            dateFrom = string.Format("{0:yyyy-MM-dd}", DateTime.Now.Date.AddDays(-1)),
            dateTo = string.Format("{0:yyyy-MM-dd}", DateTime.Now.Date)
        };

        try
        {
            

            OzonPerfWebClient oOPWC = new OzonPerfWebClient(30000, 6, 26000);
            byte[] vDATA = oOPWC.SendRequestWithRateLimit(String.Format("https://api-performance.ozon.ru:443/api/client/statistics/products/sku"), Variables.vAccessToken, Variables.vTokenType, Encoding.UTF8.GetBytes(_JSS.Serialize(oRequest)));

            Response oResponse = _JSS.Deserialize<Response>(Encoding.UTF8.GetString(vDATA));

            foreach(Response_Row oItem in oResponse.rows)
            {
                OutputBuffer.AddRow();

                OutputBuffer.date = oItem.date;
                vFieldError = "Поле avgCpc";
                if (oItem.avgCpc != null) OutputBuffer.avgCpc = (decimal) oItem.avgCpc;
                vFieldError = "Поле campaignId";
                if (oItem.campaignId != null) OutputBuffer.campaignId = (long)oItem.campaignId;
                vFieldError = "Поле clicks";
                if (oItem.clicks != null) OutputBuffer.clicks = (decimal)oItem.clicks;
                vFieldError = "Поле ctr";
                if (oItem.ctr != null) OutputBuffer.ctr = (decimal)oItem.ctr;
                vFieldError = "Поле dateAdded";
                if (oItem.dateAdded != null) OutputBuffer.dateAdded = (DateTime)oItem.dateAdded;
                vFieldError = "Поле drr";
                if (oItem.drr != null) OutputBuffer.drr = (decimal)oItem.drr;
                vFieldError = "Поле expense";
                if (oItem.expense != null) OutputBuffer.expense = (decimal)oItem.expense;
                vFieldError = "Поле modelOrders";
                if (oItem.modelOrders != null) OutputBuffer.modelOrders = (decimal)oItem.modelOrders;
                vFieldError = "Поле modelSales";
                if (oItem.modelSales != null) OutputBuffer.modelSales = (decimal)oItem.modelSales;
                vFieldError = "Поле orders";
                if (oItem.orders != null) OutputBuffer.orders = (decimal)oItem.orders;
                vFieldError = "Поле price";
                if (oItem.price != null) OutputBuffer.price = (decimal)oItem.price;
                vFieldError = "Поле sales";
                if (oItem.sales != null) OutputBuffer.sales = (decimal)oItem.sales;
                vFieldError = "Поле sku";
                if (oItem.sku != null && oItem.sku.Length > 0) OutputBuffer.sku = oItem.sku.Length > 100 ? oItem.sku.Substring(0,100) : oItem.sku;
