                vFieldError = "Поле views";
                if (oItem.views != null) OutputBuffer.views = (decimal)oItem.views;
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("api_client_campaign {0}", vFieldError), e.Message, "", 0, out cancel);
        }
