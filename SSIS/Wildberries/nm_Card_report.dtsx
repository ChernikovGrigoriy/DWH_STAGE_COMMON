    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        Request oRequest = new Request
        {
            period = new Request_Period
            {
                begin = null,
                end = null
            },
            page = 1
        };

        Response oResponse = null;

        try
        {
            do
            {
                byte[] oDATA = null;

                JavaScriptSerializer oJSS = new JavaScriptSerializer();
                oJSS.MaxJsonLength = int.MaxValue;

                vErrorStr = "Запрос к WB ";
                int i = 1;
                while (i <= 8)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                        string vURL = String.Format("https://seller-analytics-api.wildberries.ru/api/v2/nm-report/detail");
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyPrice));
                        oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");

                        oRequest.period.begin = String.Format("{0:yyyy-MM-dd} 00:00:00", Variables.vDate);
                        oRequest.period.end = String.Format("{0:yyyy-MM-dd} 23:59:00", Variables.vDate); //"2024-05-30 23:59:00"

                        vErrorStr += oJSS.Serialize(oRequest);
                        byte[] vPostData = Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest));

                        oDATA = oTWC.UploadData(vURL, "post", vPostData);
                        oTWC.Dispose();

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests") || e.Message.Contains("(502) Недопустимый шлюз") 
                            || e.Message.Contains("(504) Истекло время ожидания шлюза") 
                            || e.Message.Contains("(408) Время ожидания запроса истекло") 
                            || e.Message.Contains("(500) Внутренняя ошибка сервера")
                            || e.Message.Contains("Время ожидания операции истекло"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 8)
                    throw new ApplicationException("Метод https://seller-analytics-api.wildberries.ru/api/v2/nm-report/detail на сервере WB не доступен");

                vErrorStr = string.Format("Парсинг. Страница {0}", oRequest.page);
                oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA).Replace("\",\"object\":{\"", "\",\"objects\":{\""));

                vErrorStr = "Цыкл";
                foreach (Response_data_card oItem in oResponse.data.cards)
                {
                    OutputBuffer.AddRow();
                    OutputBuffer.nmID = oItem.nmID;
                    vErrorStr = "поле vendorCode";
                    if (oItem.vendorCode != null && oItem.vendorCode.Length > 0) OutputBuffer.vendorCode = oItem.vendorCode.Length > 200 ? oItem.vendorCode.Substring(0, 200) : oItem.vendorCode;
                    vErrorStr = "поле objects.name";
                    if (oItem.objects.name != null && oItem.objects.name.Length > 0) OutputBuffer.objectname = oItem.objects.name.Length > 200 ? oItem.objects.name.Substring(0, 200) : oItem.objects.name;
                    if (oItem.statistics.selectedPeriod.openCardCount != null) OutputBuffer.openCardCount = (int)oItem.statistics.selectedPeriod.openCardCount;
                    if (oItem.statistics.selectedPeriod.addToCartCount != null) OutputBuffer.addToCartCount = (int)oItem.statistics.selectedPeriod.addToCartCount;
                    if (oItem.statistics.selectedPeriod.ordersCount != null) OutputBuffer.ordersCount = (int)oItem.statistics.selectedPeriod.ordersCount;
                    if (oItem.statistics.selectedPeriod.ordersSumRub != null) OutputBuffer.ordersSumRub = (int)oItem.statistics.selectedPeriod.ordersSumRub;
                    if (oItem.statistics.selectedPeriod.buyoutsCount != null) OutputBuffer.buyoutsCount = (int)oItem.statistics.selectedPeriod.buyoutsCount;
                    if (oItem.statistics.selectedPeriod.buyoutsSumRub != null) OutputBuffer.buyoutsSumRub = (int)oItem.statistics.selectedPeriod.buyoutsSumRub;
                    if (oItem.statistics.selectedPeriod.cancelCount != null) OutputBuffer.ReturnsCount = (int)oItem.statistics.selectedPeriod.cancelCount;
                    if (oItem.statistics.selectedPeriod.cancelSumRub != null) OutputBuffer.ReturnsSumRub = (int)oItem.statistics.selectedPeriod.cancelSumRub;
                    if (oItem.statistics.selectedPeriod.avgPriceRub != null) OutputBuffer.avgPriceRub = (int)oItem.statistics.selectedPeriod.avgPriceRub;
                }

                oRequest.page++;
            } while (oResponse.data.isNextPage);
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("nm_Card_report {0}", Variables.vDate), string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }

}
]]></arrayElement>
