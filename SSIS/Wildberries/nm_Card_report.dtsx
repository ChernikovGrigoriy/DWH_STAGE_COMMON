                      SQLTask:SqlStatementSource=" DECLARE @Data date, @id_account int&#xA;&#xA; SELECT @Data = MAX([date]), @id_account = MAX(id_account) FROM [BUFFER].[Wildberies_nm_Card_report]&#xA; &#xA; DELETE [Wildberies].[nm_Card_report] WHERE [Date] = @Data AND id_account = @id_account&#xA; &#xA; INSERT INTO [Wildberies].[nm_Card_report]&#xA; (&#xA; [id_Account]&#xA;    ,[nmID]&#xA;    ,[date]&#xA;    ,[vendorCode]&#xA;    ,[object_name]&#xA;    ,[openCardCount]&#xA;    ,[addToCartCount]&#xA;    ,[ordersCount]&#xA;    ,[ordersSumRub]&#xA;    ,[buyoutsCount]&#xA;    ,[buyoutsSumRub]&#xA;    ,[ReturnsCount]&#xA;    ,[ReturnsSumRub]&#xA;    ,[avgPriceRub]&#xA;    ,[SYSMOMENT]&#xA; )&#xA; SELECT&#xA; &#x9;[id_Account]&#xA;&#x9;,[nmID]&#xA;&#x9;,[date]&#xA;&#x9;,[vendorCode]&#xA;&#x9;,[object_name]&#xA;&#x9;,[openCardCount]&#xA;&#x9;,[addToCartCount]&#xA;&#x9;,[ordersCount]&#xA;&#x9;,[ordersSumRub]&#xA;&#x9;,[buyoutsCount]&#xA;&#x9;,[buyoutsSumRub]&#xA;&#x9;,[ReturnsCount]&#xA;&#x9;,[ReturnsSumRub]&#xA;&#x9;,[avgPriceRub]&#xA;&#x9;,GETDATE()&#xA; FROM&#xA;&#x9;(&#xA;&#x9;&#x9; SELECT&#xA;&#x9;&#x9; [id_Account]&#xA;&#x9;&#x9;&#x9;,[nmID]&#xA;&#x9;&#x9;&#x9;,[date]&#xA;&#x9;&#x9;&#x9;,[vendorCode]&#xA;&#x9;&#x9;&#x9;,[object_name]&#xA;&#x9;&#x9;&#x9;,[openCardCount]&#xA;&#x9;&#x9;&#x9;,[addToCartCount]&#xA;&#x9;&#x9;&#x9;,[ordersCount]&#xA;&#x9;&#x9;&#x9;,[ordersSumRub]&#xA;&#x9;&#x9;&#x9;,[buyoutsCount]&#xA;&#x9;&#x9;&#x9;,[buyoutsSumRub]&#xA;&#x9;&#x9;&#x9;,[ReturnsCount]&#xA;&#x9;&#x9;&#x9;,[ReturnsSumRub]&#xA;&#x9;&#x9;&#x9;,[avgPriceRub]&#xA;&#x9;&#x9;&#x9;,ROW_NUMBER() OVER(PARTITION BY [id_Account], [nmID], [date] ORDER BY CURRENT_TIMESTAMP) RN&#xA;&#x9;&#x9; FROM&#xA;&#x9;&#x9; [BUFFER].[Wildberies_nm_Card_report]&#xA; ) TMP&#xA; WHERE&#xA;&#x9;RN = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
