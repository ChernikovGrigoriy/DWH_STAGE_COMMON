    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        try
        {
            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            vErrorStr = "Запрос к WB ";

            WildberriesWebClient oWWC = new WildberriesWebClient(60000, 15, 26000);

            byte[] oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://advert-api.wildberries.ru/adv/v1/upd?" + string.Format("&from={0:yyyy-MM-dd}", Variables.vDATESTART) + string.Format("&to={0:yyyy-MM-dd}", Variables.vDATEFINISH)), string.Format("Bearer {0}", Variables.vKeyAdvert));            

            Response[] oResponses = oJSS.Deserialize<Response[]>(Encoding.UTF8.GetString(oDATA));


            vErrorStr = "Начало цикла";
            if (oResponses != null)
            {
                foreach (Response oItem in oResponses)
                {
                    OutputBuffer.AddRow();
                    if (oItem.updNum != null) OutputBuffer.updNum = (int)oItem.updNum;
                    if (oItem.updTime != null) OutputBuffer.updTime = (DateTime)oItem.updTime;
                    if (oItem.updSum != null) OutputBuffer.updSum = (decimal)oItem.updSum;
                    if (oItem.advertId != null) OutputBuffer.advertId = (int)oItem.advertId;
                    if (oItem.campName != null && oItem.campName.Length > 0) OutputBuffer.campName = oItem.campName.Length > 200 ? oItem.campName.Substring(0, 200) : oItem.campName;
                    if (oItem.advertType != null) OutputBuffer.advertType = (int)oItem.advertType;
                    if (oItem.paymentType != null && oItem.paymentType.Length > 0) OutputBuffer.paymentType = oItem.paymentType.Length > 50 ? oItem.paymentType.Substring(0, 50) : oItem.paymentType;
                    if (oItem.advertStatus != null) OutputBuffer.advertStatus = (int)oItem.advertStatus;
                }
            }
        }
        catch (Exception e)
        {
            bool cancel;
            if (!e.Message.Contains("Для компаний задан не корректный интервал"))
                ComponentMetaData.FireError(10, "adv_v1_upd", string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }

}
]]></arrayElement>
