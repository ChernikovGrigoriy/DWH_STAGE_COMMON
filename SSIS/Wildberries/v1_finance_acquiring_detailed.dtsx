            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Foreach Loop Container\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{20E2F1CE-E803-49D5-BB1D-BE225694FE04}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка в стейджинг"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="DECLARE @id_Account int&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA;MERGE [Wildberies].[v1_finance_acquiring_list] TGT&#xA;USING [BUFFER].[v1_finance_acquiring_list] SRC ON TGT.[id_Account] = SRC.[id_Account]&#xA;AND TGT.[reportId] = SRC.[reportId]&#xA;WHEN MATCHED AND&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;      SRC.[reportId]&#xA;      ,SRC.[dateFrom]&#xA;      ,SRC.[dateTo]&#xA;      ,SRC.[sellerFinanceName]&#xA;      ,SRC.[createDate]&#xA;      ,SRC.[currency]&#xA;      ,SRC.[acquiringFeeSum]&#xA;      ,SRC.[acquiringFeeVatSum]&#xA;&#x9;) &lt;&gt; &#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;      TGT.[reportId]&#xA;      ,TGT.[dateFrom]&#xA;      ,TGT.[dateTo]&#xA;      ,TGT.[sellerFinanceName]&#xA;      ,TGT.[createDate]&#xA;      ,TGT.[currency]&#xA;      ,TGT.[acquiringFeeSum]&#xA;      ,TGT.[acquiringFeeVatSum]&#xA;&#x9;) THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;   [reportId] = SRC.[reportId]&#xA;      ,[dateFrom] = SRC.[dateFrom]&#xA;      ,[dateTo] = SRC.[dateTo]&#xA;      ,[sellerFinanceName] = SRC.[sellerFinanceName]&#xA;      ,[createDate] = SRC.[createDate]&#xA;      ,[currency] = SRC.[currency]&#xA;      ,[acquiringFeeSum] = SRC.[acquiringFeeSum]&#xA;      ,[acquiringFeeVatSum] = SRC.[acquiringFeeVatSum]&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;  [id_Account]&#xA;      ,[DATE_START]&#xA;      ,[DATE_FINISH]&#xA;      ,[reportId]&#xA;      ,[dateFrom]&#xA;      ,[dateTo]&#xA;      ,[sellerFinanceName]&#xA;      ,[createDate]&#xA;      ,[currency]&#xA;      ,[acquiringFeeSum]&#xA;      ,[acquiringFeeVatSum]&#xA;      ,[SYSMOMENT]&#xA;&#x9;)&#xA;&#x9;VALUES (&#xA;      SRC.[id_Account]&#xA;      ,SRC.[DATE_START]&#xA;      ,SRC.[DATE_FINISH]&#xA;      ,SRC.[reportId]&#xA;      ,SRC.[dateFrom]&#xA;      ,SRC.[dateTo]&#xA;      ,SRC.[sellerFinanceName]&#xA;      ,SRC.[createDate]&#xA;      ,SRC.[currency]&#xA;      ,SRC.[acquiringFeeSum]&#xA;      ,SRC.[acquiringFeeVatSum]&#xA;      ,GETDATE()&#xA;&#x9;);&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
