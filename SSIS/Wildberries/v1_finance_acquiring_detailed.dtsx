                  SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[v1_finance_acquiring_list]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[v1_finance_acquiring_list]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[v1_finance_acquiring_list] FROM [Wildberies].[v1_finance_acquiring_list]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
