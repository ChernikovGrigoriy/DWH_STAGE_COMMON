        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Диапазон дат"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{856572A3-5628-4F93-84CC-211A42452092}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Диапазон дат"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @id_account int&#xA;DECLARE @TEMP TABLE  ([DATE_START] date, DATE_FINISH date)&#xA;&#xA;SET @id_account = ?&#xA;&#xA;INSERT INTO @TEMP  ([DATE_START], DATE_FINISH)&#xA;SELECT&#xA;&#x9;distinct [DATE_START], DATE_FINISH&#xA;FROM&#xA;&#x9;[Wildberies].[v1_finance_acquiring_list]&#xA;WHERE&#xA;&#x9;id_account = @id_account &#xA;&#xA;SELECT&#xA;&#x9;[DATA] DATE_START,&#xA;&#x9;EOMONTH([DATA]) DATE_FINISH&#xA;FROM&#xA;&#x9;[dbo].[fnDATA]('20260101', GETDATE(), 1)&#xA;EXCEPT&#xA;SELECT&#xA;&#x9;[DATE_START], DATE_FINISH&#xA;FROM&#xA;&#x9;@TEMP&#xA;UNION&#xA;SELECT&#xA;&#x9;[DATA] DATE_START,&#xA;&#x9;EOMONTH([DATA]) DATE_FINISH&#xA;FROM&#xA;&#x9;[dbo].[fnDATA](DATEADD(month,-2,GETDATE()), GETDATE(), 1)&#xA;&#xA;"
