            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            List<Response> oResponse = null;

            Request oRequest = new Request
            {
                dateFrom = string.Format("{0:yyyy-MM-dd}", Variables.vDATESTART),
                dateTo = string.Format("{0:yyyy-MM-dd}", Variables.vDATEFINISH),
                limit = 1000,
                offset = 0
            };


            do
            {
                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                        string vURL = String.Format("https://finance-api.wildberries.ru/api/finance/v1/acquiring/list");
                        byte[] vDataSend = Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest));
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, Variables.vKeyStatistic);
                        oDATA = oTWC.UploadData(vURL, vDataSend);
                        oTWC = null;
                       
                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests 54564"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else if (e.Message.Contains("Too Many Requests"))
                        {
                            WebException oWExp = e as WebException;
                            HttpWebResponse response = (HttpWebResponse)oWExp.Response;
                            int vXRR = int.Parse(response.GetResponseHeader("X-Ratelimit-Retry"));
                            Thread.Sleep((vXRR + 1) * 1000);

                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Слишком большое количество обращений к серверу WB");

                oResponse = oJSS.Deserialize<List<Response>>(Encoding.UTF8.GetString(oDATA));

                if (oResponse != null)
                {
                    foreach (Response oItem in oResponse)
                    {
                        OutputBuffer.AddRow();
                        if (oItem.reportId != null) OutputBuffer.reportId = oItem.reportId;
                        if (oItem.dateFrom != null) OutputBuffer.dateFrom = (DateTime)oItem.dateFrom;
                        if (oItem.dateTo != null) OutputBuffer.dateTo = (DateTime)oItem.dateTo;
                        if (oItem.sellerFinanceName != null && oItem.sellerFinanceName.Length > 0) OutputBuffer.sellerFinanceName = oItem.sellerFinanceName.Length > 200 ? oItem.sellerFinanceName.Substring(0, 200) : oItem.sellerFinanceName;
                        if (oItem.createDate != null) OutputBuffer.createDate = (DateTime)oItem.createDate;
                        if (oItem.currency != null && oItem.currency.Length > 0) OutputBuffer.currency = oItem.currency.Length > 100 ? oItem.currency.Substring(0, 100) : oItem.currency;
                        if (oItem.acquiringFeeSum != null) OutputBuffer.acquiringFeeSum = (decimal)oItem.acquiringFeeSum;
                        if (oItem.acquiringFeeVatSum != null) OutputBuffer.acquiringFeeVatSum = (decimal)oItem.acquiringFeeVatSum;
                    }

                    oRequest.offset += oResponse.Count;
                }
                
            } while (oResponse != null && oResponse.Count == 1000);
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("v1/acquiring/list"), e.Message, "", 0, out cancel);
        }
    }

}
]]></arrayElement>
