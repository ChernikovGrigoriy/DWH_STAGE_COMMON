                    if (oItem.stocks.stocksWb != null) analCardBuffer.stocksstocksWb = (int)oItem.stocks.stocksWb;
                }

                oRequest.page++;
            } while (oResponse.data.isNextPage);
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("v2 nm-report detail {0}", Variables.vDateFrom), string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }

}
