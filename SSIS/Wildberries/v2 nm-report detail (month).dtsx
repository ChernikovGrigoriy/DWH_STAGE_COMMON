              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="DECLARE @id_Account int, @DATE_START date, @DATE_FINISH date, @type int&#xA;&#xA;SELECT TOP 1 @id_Account = id_ACCOUNT, @type = [type], @DATE_START = DATE_START, @DATE_FINISH = DATE_FINISH FROM [BUFFER].[Wildberies_v2 nm-report detail (month)]&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;  DELETE [Wildberies].[v2 nm-report detail] WITH(TABLOCK) WHERE @id_Account = id_ACCOUNT AND [type] = @Type AND @DATE_START = DATE_START AND @DATE_FINISH = DATE_FINISH&#xA;&#xA;  INSERT INTO [Wildberies].[v2 nm-report detail] WITH(TABLOCK)&#xA;  (&#xA;   [id_Account]&#xA;      ,[nmID]&#xA;      ,[DATE_START]&#xA;   ,[DATE_FINISH]&#xA;      ,[vendorCode]&#xA;      ,[brandName]&#xA;      ,[object_id]&#xA;      ,[object_name]&#xA;      ,[selectedPeriod_begin]&#xA;      ,[selectedPeriod_end]&#xA;      ,[selectedPeriod_openCardCount]&#xA;      ,[selectedPeriod_addToCartCount]&#xA;      ,[selectedPeriod_ordersCount]&#xA;      ,[selectedPeriod_ordersSumRub]&#xA;      ,[selectedPeriod_buyoutsCount]&#xA;      ,[selectedPeriod_buyoutsSumRub]&#xA;      ,[selectedPeriod_cancelCount]&#xA;      ,[selectedPeriod_cancelSumRub]&#xA;      ,[selectedPeriod_avgPriceRub]&#xA;      ,[selectedPeriod_avgOrdersCountPerDay]&#xA;      ,[selectedPeriod_conversion_addToCartPercent]&#xA;      ,[selectedPeriod_conversion_cartToOrderPercent]&#xA;      ,[selectedPeriod_conversion_buyoutsPercent]&#xA;      ,[previousPeriod_begin]&#xA;      ,[previousPeriod_end]&#xA;      ,[previousPeriod_openCardCount]&#xA;      ,[previousPeriod_addToCartCount]&#xA;      ,[previousPeriod_ordersCount]&#xA;      ,[previousPeriod_ordersSumRub]&#xA;      ,[previousPeriod_buyoutsCount]&#xA;      ,[previousPeriod_buyoutsSumRub]&#xA;      ,[previousPeriod_cancelCount]&#xA;      ,[previousPeriod_cancelSumRub]&#xA;      ,[previousPeriod_avgPriceRub]&#xA;      ,[previousPeriod_avgOrdersCountPerDay]&#xA;      ,[previousPeriod_conversion_addToCartPercent]&#xA;      ,[previousPeriod_conversion_cartToOrderPercent]&#xA;      ,[previousPeriod_conversion_buyoutsPercent]&#xA;      ,[periodComparison_openCardDynamics]&#xA;      ,[periodComparison_addToCartDynamics]&#xA;      ,[periodComparison_ordersSumRubDynamics]&#xA;      ,[periodComparison_buyoutsCountDynamics]&#xA;      ,[periodComparison_buyoutsSumRubDynamics]&#xA;      ,[periodComparison_cancelCountDynamics]&#xA;      ,[periodComparison_avgOrdersCountPerDayDynamics]&#xA;      ,[periodComparison_avgPriceRubDynamics]&#xA;      ,[periodComparison_conversion_addToCartPercent]&#xA;      ,[periodComparison_conversion_cartToOrderPercent]&#xA;      ,[periodComparison_conversion_buyoutsPercent]&#xA;      ,[stocks_stocksMp]&#xA;      ,[stocks_stocksWb]&#xA;&#x9;  ,[type]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  SELECT&#xA;      [id_Account]&#xA;      ,[nmID]&#xA;      ,[DATE_START]&#xA;   ,[DATE_FINISH]&#xA;      ,[vendorCode]&#xA;      ,[brandName]&#xA;      ,[object_id]&#xA;      ,[object_name]&#xA;      ,[selectedPeriod_begin]&#xA;      ,[selectedPeriod_end]&#xA;      ,[selectedPeriod_openCardCount]&#xA;      ,[selectedPeriod_addToCartCount]&#xA;      ,[selectedPeriod_ordersCount]&#xA;      ,[selectedPeriod_ordersSumRub]&#xA;      ,[selectedPeriod_buyoutsCount]&#xA;      ,[selectedPeriod_buyoutsSumRub]&#xA;      ,[selectedPeriod_cancelCount]&#xA;      ,[selectedPeriod_cancelSumRub]&#xA;      ,[selectedPeriod_avgPriceRub]&#xA;      ,[selectedPeriod_avgOrdersCountPerDay]&#xA;      ,[selectedPeriod_conversion_addToCartPercent]&#xA;      ,[selectedPeriod_conversion_cartToOrderPercent]&#xA;      ,[selectedPeriod_conversion_buyoutsPercent]&#xA;      ,[previousPeriod_begin]&#xA;      ,[previousPeriod_end]&#xA;      ,[previousPeriod_openCardCount]&#xA;      ,[previousPeriod_addToCartCount]&#xA;      ,[previousPeriod_ordersCount]&#xA;      ,[previousPeriod_ordersSumRub]&#xA;      ,[previousPeriod_buyoutsCount]&#xA;      ,[previousPeriod_buyoutsSumRub]&#xA;      ,[previousPeriod_cancelCount]&#xA;      ,[previousPeriod_cancelSumRub]&#xA;      ,[previousPeriod_avgPriceRub]&#xA;      ,[previousPeriod_avgOrdersCountPerDay]&#xA;      ,[previousPeriod_conversion_addToCartPercent]&#xA;      ,[previousPeriod_conversion_cartToOrderPercent]&#xA;      ,[previousPeriod_conversion_buyoutsPercent]&#xA;      ,[periodComparison_openCardDynamics]&#xA;      ,[periodComparison_addToCartDynamics]&#xA;      ,[periodComparison_ordersSumRubDynamics]&#xA;      ,[periodComparison_buyoutsCountDynamics]&#xA;      ,[periodComparison_buyoutsSumRubDynamics]&#xA;      ,[periodComparison_cancelCountDynamics]&#xA;      ,[periodComparison_avgOrdersCountPerDayDynamics]&#xA;      ,[periodComparison_avgPriceRubDynamics]&#xA;      ,[periodComparison_conversion_addToCartPercent]&#xA;      ,[periodComparison_conversion_cartToOrderPercent]&#xA;      ,[periodComparison_conversion_buyoutsPercent]&#xA;      ,[stocks_stocksMp]&#xA;      ,[stocks_stocksWb]&#xA;&#x9;  ,[type]&#xA;      ,GETDATE() SYSMOMENT&#xA; FROM&#xA;  (&#xA;    SELECT&#xA;    *&#xA;    ,ROW_NUMBER() OVER (PARTITION BY [id_Account],[type], [nmID], [DATE_START], [DATE_FINISH] ORDER BY selectedPeriod_end DESC) RN&#xA;  FROM&#xA;    [BUFFER].[Wildberies_v2 nm-report detail (month)]&#xA;   ) TMP&#xA; WHERE&#xA;  RN = 1&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
