    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        Request oRequest = new Request
        {
            period = new Request_Period
            {
                begin = null,
                end = null
            },
            page = 1
        };

        Response oResponse = null;

        try
        {
            do
            {
                byte[] oDATA = null;

                JavaScriptSerializer oJSS = new JavaScriptSerializer();
                oJSS.MaxJsonLength = int.MaxValue;

                vErrorStr = "Запрос к WB ";
                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(60000);
                        string vURL = String.Format("https://seller-analytics-api.wildberries.ru/api/v2/nm-report/detail");
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyPrice));
                        oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");

                        DateTime vFirstDateMonth = new DateTime(Variables.vDateFrom.Year, Variables.vDateFrom.Month, 1); //Variables.vDateFrom.AddDays(1 - Variables.vDateFrom.Day);
                        DateTime vLastDateMonth = vFirstDateMonth.AddMonths(1).AddSeconds(-1);

                        if (vLastDateMonth >= DateTime.Now)
                        {
                            vLastDateMonth = DateTime.Now.AddMinutes(-90);
                        }

                        oRequest.period.begin = String.Format("{0:yyyy-MM-dd} 00:00:00", vFirstDateMonth);
                        oRequest.period.end = String.Format("{0:yyyy-MM-dd HH:mm:ss}", vLastDateMonth); //"2024-05-30 23:59:00"

                        vErrorStr += oJSS.Serialize(oRequest);
                        byte[] vPostData = Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest));

                        oDATA = oTWC.UploadData(vURL, "post", vPostData);
                        oTWC.Dispose();

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests") 
                            || e.Message.Contains("(502) Недопустимый шлюз")
                            || e.Message.Contains("(503) Сервер не доступен")
                            || e.Message.Contains("(504) Истекло время ожидания шлюза") 
                            || e.Message.Contains("(408) Время ожидания запроса истекло") 
                            || e.Message.Contains("(500) Внутренняя ошибка сервера")
                            || e.Message.Contains("Время ожидания операции истекло")
                            || e.Message.Contains("Невозможно соединиться с удаленным сервером"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Метод https://seller-analytics-api.wildberries.ru/api/v2/nm-report/detail сервера WB не отвечает");

                oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA).Replace("\",\"object\":{\"", "\",\"objects\":{\""));

                vErrorStr = "Цикл";
                foreach (Response_data_card oItem in oResponse.data.cards)
                {
                    analCardBuffer.AddRow();
                    analCardBuffer.nmID = oItem.nmID;
                    analCardBuffer.DATESTART = Variables.vDateFrom.AddDays(1 - Variables.vDateFrom.Day);
                    analCardBuffer.DATEFINISH = Variables.vDateFrom.AddDays(1 - Variables.vDateFrom.Day).AddMonths(1).AddDays(-1);
                    vErrorStr = "поле vendorCode";
                    if (oItem.vendorCode != null && oItem.vendorCode.Length > 0) analCardBuffer.vendorCode = oItem.vendorCode.Length > 200 ? oItem.vendorCode.Substring(0,200) : oItem.vendorCode;
                    vErrorStr = "поле brandName";
                    if (oItem.brandName != null && oItem.brandName.Length > 0) analCardBuffer.brandName = oItem.brandName.Length > 200 ? oItem.brandName.Substring(0, 200) : oItem.brandName;
                    vErrorStr = "поле objects.id";
                    if (oItem.objects.id != null) analCardBuffer.objectid = (int)oItem.objects.id;
                    vErrorStr = "поле objects.name";
                    if (oItem.objects.name != null && oItem.objects.name.Length > 0) analCardBuffer.objectname = oItem.objects.name.Length > 200 ? oItem.objects.name.Substring(0, 200) : oItem.objects.name;
                    if (oItem.statistics.selectedPeriod.begin != null) analCardBuffer.selectedPeriodbegin = (DateTime)oItem.statistics.selectedPeriod.begin;
                    if (oItem.statistics.selectedPeriod.end != null) analCardBuffer.selectedPeriodend = (DateTime)oItem.statistics.selectedPeriod.end;
                    if (oItem.statistics.selectedPeriod.openCardCount != null) analCardBuffer.selectedPeriodopenCardCount = (int)oItem.statistics.selectedPeriod.openCardCount;
                    if (oItem.statistics.selectedPeriod.addToCartCount != null) analCardBuffer.selectedPeriodaddToCartCount = (int)oItem.statistics.selectedPeriod.addToCartCount;
                    if (oItem.statistics.selectedPeriod.ordersCount != null) analCardBuffer.selectedPeriodordersCount = (int)oItem.statistics.selectedPeriod.ordersCount;
                    if (oItem.statistics.selectedPeriod.ordersSumRub != null) analCardBuffer.selectedPeriodordersSumRub = (int)oItem.statistics.selectedPeriod.ordersSumRub;
                    if (oItem.statistics.selectedPeriod.buyoutsCount != null) analCardBuffer.selectedPeriodbuyoutsCount = (int)oItem.statistics.selectedPeriod.buyoutsCount;
                    if (oItem.statistics.selectedPeriod.buyoutsSumRub != null) analCardBuffer.selectedPeriodbuyoutsSumRub = (int)oItem.statistics.selectedPeriod.buyoutsSumRub;
                    if (oItem.statistics.selectedPeriod.cancelCount != null) analCardBuffer.selectedPeriodcancelCount = (int)oItem.statistics.selectedPeriod.cancelCount;
                    if (oItem.statistics.selectedPeriod.cancelSumRub != null) analCardBuffer.selectedPeriodcancelSumRub = (int)oItem.statistics.selectedPeriod.cancelSumRub;
                    if (oItem.statistics.selectedPeriod.avgPriceRub != null) analCardBuffer.selectedPeriodavgPriceRub = (int)oItem.statistics.selectedPeriod.avgPriceRub;
                    if (oItem.statistics.selectedPeriod.avgOrdersCountPerDay != null) analCardBuffer.selectedPeriodavgOrdersCountPerDay = (decimal)oItem.statistics.selectedPeriod.avgOrdersCountPerDay;
                    if (oItem.statistics.selectedPeriod.conversions.addToCartPercent != null) analCardBuffer.selectedPeriodconversionaddToCartPercent = (int)oItem.statistics.selectedPeriod.conversions.addToCartPercent;
                    if (oItem.statistics.selectedPeriod.conversions.cartToOrderPercent != null) analCardBuffer.selectedPeriodconversioncartToOrderPercent = (int)oItem.statistics.selectedPeriod.conversions.cartToOrderPercent;
                    if (oItem.statistics.selectedPeriod.conversions.buyoutsPercent != null) analCardBuffer.selectedPeriodconversionbuyoutsPercent = (int)oItem.statistics.selectedPeriod.conversions.buyoutsPercent;
                    if (oItem.statistics.previousPeriod.begin != null) analCardBuffer.previousPeriodbegin = (DateTime)oItem.statistics.previousPeriod.begin;
                    if (oItem.statistics.previousPeriod.end != null) analCardBuffer.previousPeriodend = (DateTime)oItem.statistics.previousPeriod.end;
                    if (oItem.statistics.previousPeriod.openCardCount != null) analCardBuffer.previousPeriodopenCardCount = (int)oItem.statistics.previousPeriod.openCardCount;
                    if (oItem.statistics.previousPeriod.addToCartCount != null) analCardBuffer.previousPeriodaddToCartCount = (int)oItem.statistics.previousPeriod.addToCartCount;
                    if (oItem.statistics.previousPeriod.ordersCount != null) analCardBuffer.previousPeriodordersCount = (int)oItem.statistics.previousPeriod.ordersCount;
                    if (oItem.statistics.previousPeriod.ordersSumRub != null) analCardBuffer.previousPeriodordersSumRub = (int)oItem.statistics.previousPeriod.ordersSumRub;
                    if (oItem.statistics.previousPeriod.buyoutsCount != null) analCardBuffer.previousPeriodbuyoutsCount = (int)oItem.statistics.previousPeriod.buyoutsCount;
                    if (oItem.statistics.previousPeriod.buyoutsSumRub != null) analCardBuffer.previousPeriodbuyoutsSumRub = (int)oItem.statistics.previousPeriod.buyoutsSumRub;
                    if (oItem.statistics.previousPeriod.cancelCount != null) analCardBuffer.previousPeriodcancelCount = (int)oItem.statistics.previousPeriod.cancelCount;
                    if (oItem.statistics.previousPeriod.cancelSumRub != null) analCardBuffer.previousPeriodcancelSumRub = (int)oItem.statistics.previousPeriod.cancelSumRub;
                    if (oItem.statistics.previousPeriod.avgPriceRub != null) analCardBuffer.previousPeriodavgPriceRub = (int)oItem.statistics.previousPeriod.avgPriceRub;
                    if (oItem.statistics.previousPeriod.avgOrdersCountPerDay != null) analCardBuffer.previousPeriodavgOrdersCountPerDay = (decimal)oItem.statistics.previousPeriod.avgOrdersCountPerDay;
                    if (oItem.statistics.previousPeriod.conversions.addToCartPercent != null) analCardBuffer.previousPeriodconversionaddToCartPercent = (int)oItem.statistics.previousPeriod.conversions.addToCartPercent;
                    if (oItem.statistics.previousPeriod.conversions.cartToOrderPercent != null) analCardBuffer.previousPeriodconversioncartToOrderPercent = (int)oItem.statistics.previousPeriod.conversions.cartToOrderPercent;
                    if (oItem.statistics.previousPeriod.conversions.buyoutsPercent != null) analCardBuffer.previousPeriodconversionbuyoutsPercent = (int)oItem.statistics.previousPeriod.conversions.buyoutsPercent;
                    if (oItem.statistics.periodComparison.openCardDynamics != null) analCardBuffer.periodComparisonopenCardDynamics = (int)oItem.statistics.periodComparison.openCardDynamics;
                    if (oItem.statistics.periodComparison.addToCartDynamics != null) analCardBuffer.periodComparisonaddToCartDynamics = (int)oItem.statistics.periodComparison.addToCartDynamics;
                    if (oItem.statistics.periodComparison.ordersSumRubDynamics != null) analCardBuffer.periodComparisonordersSumRubDynamics = (int)oItem.statistics.periodComparison.ordersSumRubDynamics;
                    if (oItem.statistics.periodComparison.buyoutsCountDynamics != null) analCardBuffer.periodComparisonbuyoutsCountDynamics = (int)oItem.statistics.periodComparison.buyoutsCountDynamics;
                    if (oItem.statistics.periodComparison.buyoutsSumRubDynamics != null) analCardBuffer.periodComparisonbuyoutsSumRubDynamics = (int)oItem.statistics.periodComparison.buyoutsSumRubDynamics;
                    if (oItem.statistics.periodComparison.cancelCountDynamics != null) analCardBuffer.periodComparisoncancelCountDynamics = (int)oItem.statistics.periodComparison.cancelCountDynamics;
                    if (oItem.statistics.periodComparison.avgOrdersCountPerDayDynamics != null) analCardBuffer.periodComparisonavgOrdersCountPerDayDynamics = (int)oItem.statistics.periodComparison.avgOrdersCountPerDayDynamics;
                    if (oItem.statistics.periodComparison.avgPriceRubDynamics != null) analCardBuffer.periodComparisonavgPriceRubDynamics = (int)oItem.statistics.periodComparison.avgPriceRubDynamics;
                    if (oItem.statistics.periodComparison.conversions.addToCartPercent != null) analCardBuffer.periodComparisonconversionaddToCartPercent = (int)oItem.statistics.periodComparison.conversions.addToCartPercent;
                    if (oItem.statistics.periodComparison.conversions.cartToOrderPercent != null) analCardBuffer.periodComparisonconversioncartToOrderPercent = (int)oItem.statistics.periodComparison.conversions.cartToOrderPercent;
                    if (oItem.statistics.periodComparison.conversions.buyoutsPercent != null) analCardBuffer.periodComparisonconversionbuyoutsPercent = (int)oItem.statistics.periodComparison.conversions.buyoutsPercent;
