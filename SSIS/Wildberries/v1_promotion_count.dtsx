              SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; UPDATE [Wildberies].[advert_promotion] SET isActive = 0&#xA;&#xA; MERGE [Wildberies].[advert_promotion] WITH(TABLOCK) TGT&#xA; USING (&#xA; SELECT &#xA;   [id_account]&#xA;      ,[advertId]&#xA;      ,[type]&#xA;      ,[status]&#xA;      ,[changeTime]&#xA;      ,1 isActive&#xA;  FROM [BUFFER].[Wildberies_advert_promotion]&#xA; ) SRC ON (TGT.[id_account]  = SRC.[id_account] AND TGT.[advertId] = SRC.[advertId])&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;   SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[type]&#xA;      ,SRC.[status]&#xA;      ,SRC.[changeTime] &#xA;      ,SRC.isActive&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;   TGT.[id_account]&#xA;      ,TGT.[advertId]&#xA;      ,TGT.[type]&#xA;      ,TGT.[status]&#xA;      ,TGT.[changeTime]&#xA;      ,TGT.isActive&#xA; ) THEN&#xA;   UPDATE SET &#xA;   [type] = SRC.[type]&#xA;   ,[status] = SRC.[status]&#xA;   ,[changeTime] = SRC.[changeTime]&#xA;   ,isActive = SRC.isActive&#xA;   ,SYSMOMENT = SRC.[changeTime]&#xA;  WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;   [id_account]&#xA;      ,[advertId]&#xA;      ,[type]&#xA;      ,[status]&#xA;      ,[changeTime]&#xA;&#x9;  ,isActive&#xA;   ,SYSMOMENT&#xA; )&#xA; VALUES&#xA; (&#xA;   SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[type]&#xA;      ,SRC.[status]&#xA;      ,SRC.[changeTime]&#xA;&#x9;  ,SRC.isActive&#xA;   ,GETDATE()&#xA; );&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
