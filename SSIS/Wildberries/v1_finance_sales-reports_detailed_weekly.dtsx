              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @id_account int&#xA;DECLARE @TEMP_1 TABLE  ([DATE_START] date,[DATE_FINISH] date)&#xA;DECLARE @TEMP_2 TABLE  ([DATE_START] date,[DATE_FINISH] date)&#xA;&#xA;SET @id_account = ?&#xA;&#xA;INSERT INTO @TEMP_1  ([DATE_START], [DATE_FINISH])&#xA;SELECT&#xA;&#x9;distinct [DATE_START], [DATE_FINISH]&#xA;FROM&#xA;&#x9;[Wildberies].[v1_finance_sales-reports_detailed]&#xA;WHERE&#xA;&#x9;id_account = @id_account &#xA;&#x9;AND [period] = 'weekly'&#xA;&#xA;INSERT INTO @TEMP_2  ([DATE_START], [DATE_FINISH])&#xA;SELECT&#xA;&#x9;[DATE_START], [DATE_FINISH]&#xA;FROM&#xA;&#x9;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[DATA] DATE_START,&#xA;&#x9;&#x9;LEAD([DATA]) OVER (ORDER BY [DATA]) DATE_FINISH&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;[DATA]&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;[dbo].[fnDATA]('20241215', GETDATE(), 0)&#xA;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;&#x9;DATEPART(weekday, [DATA]) in (1,7)&#xA;&#x9;&#x9;) TMP&#xA;&#x9;) TMP&#xA;WHERE&#xA;&#x9;DATEDIFF(day,[DATE_START], [DATE_FINISH]) = 6&#xA;&#xA;SELECT [DATE_START], [DATE_FINISH] FROM @TEMP_2&#xA;EXCEPT&#xA;SELECT [DATE_START], [DATE_FINISH] FROM&#x9;@TEMP_1&#xA;UNION&#xA;SELECT TOP 2 [DATE_START], [DATE_FINISH] FROM @TEMP_2 ORDER BY [DATE_START] desc&#xA;&#xA;"
