            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\загрузка отчета за неделю\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{54698E76-5F47-4486-96DA-EF5FAFE3A0B9}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
