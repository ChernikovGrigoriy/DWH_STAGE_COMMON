                  SQLTask:SqlStatementSource="DECLARE @id_Account int, @DATE_START date, @DATE_FINISH date, @type int&#xA;&#xA;SELECT TOP 1 @id_Account = id_ACCOUNT, @type = [type], @DATE_START = DATE_START, @DATE_FINISH = DATE_FINISH FROM [BUFFER].[Wildberies_v3 sales-funnel (month)]&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;  DELETE [Wildberies].[v3 sales-funnel] WITH(TABLOCK) WHERE @id_Account = id_ACCOUNT AND [type] = @Type AND @DATE_START = DATE_START AND @DATE_FINISH = DATE_FINISH&#xA;&#xA;  INSERT INTO [Wildberies].[v3 sales-funnel] WITH(TABLOCK)&#xA;  (&#xA;&#x9; [id_Account]&#xA;      ,[type]&#xA;      ,[nmID]&#xA;      ,[DATE_START]&#xA;      ,[DATE_FINISH]&#xA;      ,[title]&#xA;      ,[vendorCode]&#xA;      ,[brandName]&#xA;      ,[subjectId]&#xA;      ,[subjectName]&#xA;      ,[productRating]&#xA;      ,[feedbackRating]&#xA;      ,[stocks_wb]&#xA;      ,[stocks_mp]&#xA;      ,[stocks_balanceSum]&#xA;      ,[statistic_selected_period_start]&#xA;      ,[statistic_selected_period_end]&#xA;      ,[statistic_selected_openCount]&#xA;      ,[statistic_selected_cartCount]&#xA;      ,[statistic_selected_orderCount]&#xA;      ,[statistic_selected_orderSum]&#xA;      ,[statistic_selected_buyoutCount]&#xA;      ,[statistic_selected_buyoutSum]&#xA;      ,[statistic_selected_cancelCount]&#xA;      ,[statistic_selected_cancelSum]&#xA;      ,[statistic_selected_avgPrice]&#xA;      ,[statistic_selected_avgOrdersCountPerDay]&#xA;      ,[statistic_selected_shareOrderPercent]&#xA;      ,[statistic_selected_addToWishlist]&#xA;      ,[statistic_selected_timeToReady_days]&#xA;      ,[statistic_selected_timeToReady_hours]&#xA;      ,[statistic_selected_timeToReady_mins]&#xA;      ,[statistic_selected_localizationPercent]&#xA;      ,[statistic_selected_wbClub_orderCount]&#xA;      ,[statistic_selected_wbClub_orderSum]&#xA;      ,[statistic_selected_wbClub_buyoutSum]&#xA;      ,[statistic_selected_wbClub_buyoutCount]&#xA;      ,[statistic_selected_wbClub_cancelSum