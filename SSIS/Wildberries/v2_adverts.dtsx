          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v2_adverts]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v2_adverts]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v2_adverts] FROM [Wildberies].[v2_adverts]&#xA;&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v2_adverts_nm_settings]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v2_adverts_nm_settings]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v2_adverts_nm_settings] FROM [Wildberies].[v2_adverts_nm_settings]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
