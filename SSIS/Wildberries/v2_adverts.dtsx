        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{690AFD18-EB8B-471D-A514-662D27B3D0DF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; MERGE  [Wildberies].[v2_adverts] WITH(TABLOCK) TGT&#xA; USING  [BUFFER].[Wildberies_v2_adverts ]SRC ON (TGT.[id_account]  = SRC.[id_account] AND TGT.[Id] = SRC.[Id])&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA;&#x9;SRC.[id_account]&#xA;    ,SRC.[id]&#xA;    ,SRC.[bid_type]&#xA;    ,SRC.[status]&#xA;    ,SRC.[timestamp_created]&#xA;    ,SRC.[timestamp_updated]&#xA;    ,SRC.[timestamp_started]&#xA;    ,SRC.[timestamp_deleted]&#xA;    ,SRC.[settings_payment_type]&#xA;    ,SRC.[settings_name]&#xA;    ,SRC.[settings_plasements_search]&#xA;    ,SRC.[settings_plasements_recommendations]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;&#x9;TGT.[id_account]&#xA;    ,TGT.[id]&#xA;    ,TGT.[bid_type]&#xA;    ,TGT.[status]&#xA;    ,TGT.[timestamp_created]&#xA;    ,TGT.[timestamp_updated]&#xA;    ,TGT.[timestamp_started]&#xA;    ,TGT.[timestamp_deleted]&#xA;    ,TGT.[settings_payment_type]&#xA;    ,TGT.[settings_name]&#xA;    ,TGT.[settings_plasements_search]&#xA;    ,TGT.[settings_plasements_recommendations]&#xA; ) THEN&#xA;   UPDATE SET &#xA;&#x9;[id_account] = SRC.[id_account]&#xA;    ,[id] = SRC.[id]&#xA;    ,[bid_type] = SRC.[bid_type]&#xA;    ,[status] = SRC.[status]&#xA;    ,[timestamp_created] = SRC.[timestamp_created]&#xA;    ,[timestamp_updated] = SRC.[timestamp_updated]&#xA;    ,[timestamp_started] = SRC.[timestamp_started]&#xA;    ,[timestamp_deleted] = SRC.[timestamp_deleted]&#xA;    ,[settings_payment_type] = SRC.[settings_payment_type]&#xA;    ,[settings_name] = SRC.[settings_name]&#xA;    ,[settings_plasements_search] = SRC.[settings_plasements_search]&#xA;    ,[settings_plasements_recommendations] = SRC.[settings_plasements_recommendations]&#xA;    ,SYSMOMENT = GETDATE()&#xA;  WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;&#x9;[id_account]&#xA;    ,[id]&#xA;    ,[bid_type]&#xA;    ,[status]&#xA;    ,[timestamp_created]&#xA;    ,[timestamp_updated]&#xA;    ,[timestamp_started]&#xA;    ,[timestamp_deleted]&#xA;    ,[settings_payment_type]&#xA;    ,[settings_name]&#xA;    ,[settings_plasements_search]&#xA;    ,[settings_plasements_recommendations]&#xA;&#x9;,[SYSMOMENT]&#xA; )&#xA; VALUES&#xA; (&#xA;&#x9;SRC.[id_account]&#xA;    ,SRC.[id]&#xA;    ,SRC.[bid_type]&#xA;    ,SRC.[status]&#xA;    ,SRC.[timestamp_created]&#xA;    ,SRC.[timestamp_updated]&#xA;    ,SRC.[timestamp_started]&#xA;    ,SRC.[timestamp_deleted]&#xA;    ,SRC.[settings_payment_type]&#xA;    ,SRC.[settings_name]&#xA;    ,SRC.[settings_plasements_search]&#xA;    ,SRC.[settings_plasements_recommendations]&#xA;    ,GETDATE()&#xA; );&#xA;&#xA; MERGE [Wildberies].[v2_adverts_nm_settings] TGT&#xA; USING [BUFFER].[Wildberies_v2_adverts_nm_settings] SRC ON (TGT.[id_account] = SRC.[id_account]&#xA; AND TGT.[id] = SRC.[id]&#xA; AND TGT.[nm_id] = SRC.[nm_id])&#xA; WHEN MATCHED AND &#xA; CHECKSUM&#xA; (&#xA;&#x9;SRC.[id_account]&#xA;    ,SRC.[id]&#xA;    ,SRC.[nm_id]&#xA;    ,SRC.[subject_id]&#xA;    ,SRC.[subject_name]&#xA;    ,SRC.[bids_kopecs_search]&#xA;    ,SRC.[bids_kopecs_recommendations]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA; &#x9;TGT.[id_account]&#xA;    ,TGT.[id]&#xA;    ,TGT.[nm_id]&#xA;    ,TGT.[subject_id]&#xA;    ,TGT.[subject_name]&#xA;    ,TGT.[bids_kopecs_search]&#xA;    ,TGT.[bids_kopecs_recommendations]&#xA; ) THEN&#xA;&#x9;UPDATE SET&#xA;&#x9;&#x9;[id_account] = SRC.[id_account]&#xA;&#x9;&#x9;,[id] = SRC.[id]&#xA;&#x9;&#x9;,[nm_id] = SRC.[nm_id]&#xA;&#x9;&#x9;,[subject_id] = SRC.[subject_id]&#xA;&#x9;&#x9;,[subject_name]= SRC.[subject_name]&#xA;&#x9;&#x9;,[bids_kopecs_search] = SRC.[bids_kopecs_search]&#xA;&#x9;&#x9;,[bids_kopecs_recommendations] = SRC.[bids_kopecs_recommendations]&#xA;&#x9;&#x9;,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT &#xA;&#x9;(&#xA;&#x9;[id_account]&#xA;    ,[id]&#xA;    ,[nm_id]&#xA;    ,[subject_id]&#xA;    ,[subject_name]&#xA;    ,[bids_kopecs_search]&#xA;    ,[bids_kopecs_recommendations]&#xA;&#x9;,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES&#xA;&#x9;(&#xA;&#x9;SRC.[id_account]&#xA;    ,SRC.[id]&#xA;    ,SRC.[nm_id]&#xA;    ,SRC.[subject_id]&#xA;    ,SRC.[subject_name]&#xA;    ,SRC.[bids_kopecs_search]&#xA;    ,SRC.[bids_kopecs_recommendations]&#xA;&#x9;,GETDATE()&#xA;&#x9;);&#xA;&#xA;&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Создание буферной таблицы"
