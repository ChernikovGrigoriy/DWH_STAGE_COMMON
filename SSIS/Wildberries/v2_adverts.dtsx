    #region Response

    public class Response
    {
        public advert[] adverts { get; set; }
    }

    public class advert
    {
        public string bid_type { get; set; }
        public long id { get; set; }
        public int status { get; set; }
        public advert_timestamp timestamps { get; set; }
        public advert_setting settings { get; set; }
        public advert_nm_setting[] nm_settings { get; set; }
    }

    public class advert_timestamp
    {
        public DateTime? created { get; set; }
        public DateTime? updated { get; set; }
        public DateTime? started { get; set; }
        public DateTime? deleted { get; set; }
    }

    public class advert_setting
    {
        public string payment_type { get; set; }
        public string name { get; set; }
        public advert_setting_placements placements { get; set; }
    }

    public class advert_setting_placements
    {
        public bool? search { get; set; }
        public bool? recommendations { get; set; }
    }

    public class advert_nm_setting
    {
        public long nm_id { get; set; }
        public advert_nm_settings_subject subject { get; set; }
        public advert_nm_settings_bids_kopecks bids_kopecks { get; set; }
    }

    public class advert_nm_settings_subject
    {
        public long id { get; set; }
        public string name { get; set; }
    }

    public class advert_nm_settings_bids_kopecks
    {
        public long? search { get; set; }
        public long? recommendations { get; set; }
    }
