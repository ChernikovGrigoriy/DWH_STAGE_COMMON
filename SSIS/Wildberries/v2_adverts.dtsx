          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="SELECT&#xA;   STRING_AGG([advertId], ',') ad_list&#xA;FROM&#xA; (&#xA;  SELECT&#xA;   [advertId],&#xA;   ROW_NUMBER() OVER (ORDER BY CURRENT_TIMESTAMP) / 50 [block]&#xA;  FROM&#xA;   [Wildberies].[advert_promotion]&#xA;  WHERE&#xA;   id_account = ?&#xA; ) TMP&#xA;GROUP BY&#xA; [block]"
              SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::vAdObj" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::vID_Account"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="20"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
