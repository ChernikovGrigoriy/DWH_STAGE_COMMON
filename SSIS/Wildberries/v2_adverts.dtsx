    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        try
        {
            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            WildberriesWebClient oWWC = new WildberriesWebClient(60000, 15, 26000);
            string vURL = String.Format("https://advert-api.wildberries.ru/api/advert/v2/adverts?ids=" + Variables.vAdList);
            byte[] oDATA = oWWC.SendRequestWithRateLimit(vURL, string.Format("Bearer {0}", Variables.vKeyAdvert));

            Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

            vErrorStr = "Старт цикла загрузки";
            if (oResponse != null && oResponse.adverts != null) { 
                foreach (advert oItem in oResponse.adverts)
                {
                    advertsBuffer.AddRow();
                    advertsBuffer.id = oItem.id;
                    if (oItem.bid_type != null && oItem.bid_type.Length > 0) advertsBuffer.bidtype = oItem.bid_type.Length > 100 ? oItem.bid_type.Substring(0,100) : oItem.bid_type;
                    vErrorStr = "Поле status";
                    if (oItem.status != null) advertsBuffer.status = (int)oItem.status;
                    if (oItem.timestamps != null)
                    {
                        vErrorStr = "Поле timestamp screated";
                        if (oItem.timestamps.created != null) advertsBuffer.timestampscreated = (DateTime)oItem.timestamps.created;
                        vErrorStr = "Поле timestamp started";
                        if (oItem.timestamps.started != null) advertsBuffer.timestampsstarted = (DateTime)oItem.timestamps.started;
                        vErrorStr = "Поле timestamp updated";
                        if (oItem.timestamps.updated != null) advertsBuffer.timestampsupdated = (DateTime)oItem.timestamps.updated;
                        vErrorStr = "Поле timestamp deleted";
                        if (oItem.timestamps.deleted!= null) advertsBuffer.timestampsdeleted = (DateTime)oItem.timestamps.deleted;
                    }
                    if (oItem.settings != null)
                    {
                        vErrorStr = "Поле settings.name";
                        if (oItem.settings.name != null && oItem.settings.name.Length > 0) advertsBuffer.settingsname = oItem.settings.name.Length > 50 ? oItem.settings.name.Substring(0,50) : oItem.settings.name;
                        vErrorStr = "Поле settings.payment_type";
                        if (oItem.settings.payment_type != null && oItem.settings.payment_type.Length > 0) advertsBuffer.settingspaymenttype = oItem.settings.payment_type.Length > 50 ? oItem.settings.payment_type.Substring(0, 50) : oItem.settings.payment_type;
                        
                        if (oItem.settings.placements != null)
                        {
                            if (oItem.settings.placements.search != null) advertsBuffer.placementssearch = (bool)oItem.settings.placements.search;
