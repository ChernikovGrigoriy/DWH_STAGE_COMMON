    private JavaScriptSerializer _JSS { get; set; }

    #region Первый шаг
    private string Step_First(DateTime DateStart, DateTime DateFinish)
    {
        byte[] oDATA = null;

        int i = 1;
        while (i <= 6)
        {
            try
            {

                TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                string vURL = String.Format("https://seller-analytics-api.wildberries.ru/api/v1/paid_storage?dateFrom={0:yyyy-MM-dd}&dateTo={1:yyyy-MM-dd}", DateStart, DateFinish);
                oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyAnalytics));
                oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");
                oDATA = oTWC.DownloadData(vURL);
                oTWC = null;

                break;
            }
            catch (WebException e)
            {
                if (e.Message.Contains("Too Many Requests"))
                {
                    Thread.Sleep(26000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Сервер WB не отвечает");

        Response_CreateReport oResponse = _JSS.Deserialize<Response_CreateReport>(Encoding.UTF8.GetString(oDATA));

        return oResponse.data.taskId;
    }
    #endregion

    #region Второй шаг
    public void Step_Two(string TaskId)
    {
        byte[] oDATA = null;

        Response_ReportStatus oResponse = null;

        int j = 1;
        do
        {
            if (j != 1) { Thread.Sleep(60000); }

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                    string vURL = String.Format("https://seller-analytics-api.wildberries.ru/api/v1/paid_storage/tasks/{0}/status", TaskId);
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyAnalytics));
                    oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (WebException e)
                {
                    if (e.Message.Contains("Too Many Requests"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Сервер WB не отвечает");

            oResponse = _JSS.Deserialize<Response_ReportStatus>(Encoding.UTF8.GetString(oDATA));

            j++;
        } while (oResponse.data.status != "done" && j < 10);

        if (j >= 10)
            throw new ApplicationException("Отчет не сформирован");
    }
    #endregion

    public override void CreateNewOutputRows()
    {
        try
        {
            DateTime vWorkDate = Variables.pSYSMOMENT;

            while (vWorkDate <= DateTime.Now)
            {
                DateTime vDateStart = vWorkDate;
                DateTime vDateFinish = vWorkDate.AddDays(7);

                if (vDateStart.AddDays(-7).Year != vDateStart.Year)
                {
                    vDateStart = new DateTime(vDateStart.Year, 1, 1);
                    vDateFinish = vDateStart.AddDays(7);
                }

                if (vDateFinish.Year != vDateStart.Year)
                {
                    vDateFinish = new DateTime(vDateStart.Year, 12, 31);
                }

                string vTaskId = Step_First(vDateStart, vDateFinish);

                Step_Two(vTaskId);

                byte[] oDATA = null;

                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                        string vURL = String.Format("https://seller-analytics-api.wildberries.ru/api/v1/paid_storage/tasks/{0}/download", vTaskId);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyAnalytics));
                        oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (WebException e)
                    {
                        if (e.Message.Contains("Too Many Requests")
                            || e.Message.Contains("Время ожидания операции истекло")
                            || e.Message.Contains("Невозможно соединиться с удаленным сервером"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Метод https://seller-analytics-api.wildberries.ru/api/v1/paid_storage/tasks/{0}/download сервера WB не отвечает");

                Response_Download[] oResponses = _JSS.Deserialize<Response_Download[]>(Encoding.UTF8.GetString(oDATA));

                foreach (Response_Download oItem in oResponses)
                {
                    OutputBuffer.AddRow();
                    OutputBuffer.date = oItem.date;
                    if (oItem.logWarehouseCoef != null) OutputBuffer.logWarehouseCoef = (decimal) oItem.logWarehouseCoef;
                    if (oItem.officeId != null) OutputBuffer.officeId = (int)oItem.officeId;
                    if (oItem.warehouse != null && oItem.warehouse.Length > 0) OutputBuffer.warehouse = oItem.warehouse.Length > 200 ? oItem.warehouse.Substring(0, 200) : oItem.warehouse;
                    if (oItem.warehouseCoef != null) OutputBuffer.warehouseCoef = (decimal)oItem.warehouseCoef;
                    if (oItem.giId != null) OutputBuffer.giId = (int)oItem.giId;
                    if (oItem.chrtId != null) OutputBuffer.chrtId = (int)oItem.chrtId;
                    if (oItem.size != null && oItem.size.Length > 0) OutputBuffer.size = oItem.size.Length > 50 ? oItem.size.Substring(0, 50) : oItem.size;
                    if (oItem.barcode != null && oItem.barcode.Length > 0) OutputBuffer.barcode = oItem.barcode.Length > 50 ? oItem.barcode.Substring(0, 50) : oItem.barcode;
                    if (oItem.subject != null && oItem.subject.Length > 0) OutputBuffer.subject = oItem.subject.Length > 200 ? oItem.subject.Substring(0, 200) : oItem.subject;
                    if (oItem.barcode != null && oItem.barcode.Length > 0) OutputBuffer.barcode = oItem.barcode.Length > 50 ? oItem.barcode.Substring(0, 50) : oItem.barcode;
                    if (oItem.brand != null && oItem.brand.Length > 0) OutputBuffer.brand = oItem.brand.Length > 200 ? oItem.brand.Substring(0, 200) : oItem.brand;
                    if (oItem.vendorCode != null && oItem.vendorCode.Length > 0) OutputBuffer.vendorCode = oItem.vendorCode.Length > 200 ? oItem.vendorCode.Substring(0, 100) : oItem.vendorCode;
                    if (oItem.nmId != null) OutputBuffer.nmId = (int)oItem.nmId;
                    if (oItem.volume != null) OutputBuffer.volume = (decimal)oItem.volume;
                    if (oItem.calcType != null && oItem.calcType.Length > 0) OutputBuffer.calcType = oItem.calcType.Length > 200 ? oItem.calcType.Substring(0, 200) : oItem.calcType;
                    if (oItem.warehousePrice != null) OutputBuffer.warehousePrice = (decimal)oItem.warehousePrice;
                    if (oItem.barcodesCount != null) OutputBuffer.barcodesCount = (int)oItem.barcodesCount;
                    if (oItem.palletPlaceCode != null) OutputBuffer.palletPlaceCode = (int)oItem.palletPlaceCode;
                    if (oItem.palletCount != null) OutputBuffer.palletCount = (decimal)oItem.palletCount;
                    if (oItem.originalDate != null) OutputBuffer.originalDate = (DateTime)oItem.originalDate;
                    if (oItem.loyaltyDiscount != null) OutputBuffer.loyaltyDiscount = (decimal)oItem.loyaltyDiscount;
                    if (oItem.tariffFixDate != null) OutputBuffer.tariffFixDate = (DateTime)oItem.tariffFixDate;
                    if (oItem.tariffLowerDate != null) OutputBuffer.tariffLowerDate = (DateTime)oItem.tariffLowerDate;
                }               

                vWorkDate = vWorkDate.AddDays(7);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "WB", e.Message, "", 0, out cancel);
        }
    }

}
