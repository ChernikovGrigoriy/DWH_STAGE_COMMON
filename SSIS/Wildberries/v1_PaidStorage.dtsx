          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @id_account int, @date date&#xA;&#xA;DECLARE CUR1 CURSOR LOCAL FOR&#xA;SELECT DISTINCT [id_Account], [date] FROM [BUFFER].[Wildberries_anal_PaidStorage]&#xA;OPEN CUR1&#xA;&#xA;FETCH NEXT FROM CUR1 INTO @id_account, @date&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA; BEGIN TRY  &#xA;  DELETE FROM [Wildberies].[anal_PaidStorage] WHERE id_account = @id_account AND [date] = @date&#xA;&#xA;  INSERT INTO [Wildberies].[anal_PaidStorage]&#xA;  (&#xA;   [id_Account]&#xA;    ,[date]&#xA;    ,[logWarehouseCoef]&#xA;    ,[officeId]&#xA;    ,[warehouse]&#xA;    ,[warehouseCoef]&#xA;    ,[giId]&#xA;    ,[chrtId]&#xA;    ,[size]&#xA;    ,[barcode]&#xA;    ,[subject]&#xA;    ,[brand]&#xA;    ,[vendorCode]&#xA;    ,[nmId]&#xA;    ,[volume]&#xA;    ,[calcType]&#xA;    ,[warehousePrice]&#xA;    ,[barcodesCount]&#xA;    ,[palletPlaceCode]&#xA;    ,[palletCount]&#xA;    ,[originalDate]&#xA;    ,[loyaltyDiscount]&#xA;    ,[tariffFixDate]&#xA;    ,[tariffLowerDate]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  SELECT&#xA;   [id_Account]&#xA;    ,[date]&#xA;    ,[logWarehouseCoef]&#xA;    ,[officeId]&#xA;    ,[warehouse]&#xA;    ,[warehouseCoef]&#xA;    ,[giId]&#xA;    ,[chrtId]&#xA;    ,[size]&#xA;    ,[barcode]&#xA;    ,[subject]&#xA;    ,[brand]&#xA;    ,[vendorCode]&#xA;    ,[nmId]&#xA;    ,[volume]&#xA;    ,[calcType]&#xA;    ,[warehousePrice]&#xA;    ,[barcodesCount]&#xA;    ,[palletPlaceCode]&#xA;    ,[palletCount]&#xA;    ,[originalDate]&#xA;    ,[loyaltyDiscount]&#xA;    ,[tariffFixDate]&#xA;    ,[tariffLowerDate]&#xA;    ,GETDATE()&#xA;  FROM&#xA;   [BUFFER].[Wildberries_anal_PaidStorage]&#xA;  WHERE id_account = @id_account AND [date] = @date &#xA;&#xA; END TRY  &#xA; BEGIN CATCH  &#xA;  DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;  DECLARE @ErrorSeverity INT;  &#xA;  DECLARE @ErrorState INT;  &#xA;  &#xA;  SELECT   &#xA;   @ErrorMessage = ERROR_MESSAGE(),  &#xA;   @ErrorSeverity = ERROR_SEVERITY(),  &#xA;   @ErrorState = ERROR_STATE();  &#xA;  &#xA;  IF @@TRANCOUNT &gt; 0  &#xA;   ROLLBACK TRANSACTION;  &#xA;&#xA;  RAISERROR (@ErrorMessage, -- Message text.  &#xA;       @ErrorSeverity, -- Severity.  &#xA;       @ErrorState -- State.  &#xA;       ); &#xA; &#xA; END CATCH;  &#xA;&#xA;    FETCH NEXT FROM CUR1 INTO @id_account, @date&#xA;END&#xA;CLOSE CUR1;&#xA;DEALLOCATE CUR1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
