    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        try
        {

            byte[] oDATA = null;

            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            vErrorStr = "Запрос к WB ";
            int i = 1;
            while (i <= 6)
            {
                try
                {
                    string[] ads = Variables.vAdList.Split(',');

                    TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                    string vURL = String.Format("https://advert-api.wildberries.ru/adv/v1/promotion/adverts");
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyAdvert));
                    oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");
                    oDATA = oTWC.UploadData(vURL, Encoding.UTF8.GetBytes(string.Format("[{0}]",Variables.vAdList)));
                    oTWC.Dispose();

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("(502) Недопустимый шлюз") 
                        || e.Message.Contains("(504) Истекло время ожидания шлюза"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("При обращении к методу https://advert-api.wildberries.ru/adv/v1/promotion/adverts cервера WB произошла ошибка");

            List<Response> oResponses = oJSS.Deserialize<List<Response>>(Encoding.UTF8.GetString(oDATA));

            vErrorStr = "Старт цикла загрузки";
            if (oResponses != null) { 
                foreach (Response oItem in oResponses)
                {
                    ResponseInfoAdvertBuffer.AddRow();
                    ResponseInfoAdvertBuffer.advertId = oItem.advertId;
                    vErrorStr = "Поле name";
                    if (oItem.name != null && oItem.name.Length > 0) ResponseInfoAdvertBuffer.name = oItem.name.Length > 200 ? oItem.name.Substring(0, 200) : oItem.name;
                    vErrorStr = "Поле endTime";
                    if (oItem.endTime != null) ResponseInfoAdvertBuffer.endTime = (DateTime)oItem.endTime;
                    vErrorStr = "Поле createTime";
                    if (oItem.createTime != null) ResponseInfoAdvertBuffer.createTime = (DateTime)oItem.createTime;
                    vErrorStr = "Поле changeTime";
                    if (oItem.changeTime != null) ResponseInfoAdvertBuffer.changeTime = (DateTime)oItem.changeTime;
                    vErrorStr = "Поле startTime";
                    if (oItem.startTime != null) ResponseInfoAdvertBuffer.startTime = (DateTime)oItem.startTime;
                    vErrorStr = "Поле dailyBudget";
