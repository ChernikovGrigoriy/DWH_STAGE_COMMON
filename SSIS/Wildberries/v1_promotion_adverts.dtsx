        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4e6e0b70-d0a3-4cc9-84bb-cc444255f554}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; MERGE [Wildberies].[advert_promotion] WITH(TABLOCK) TGT&#xA; USING (&#xA; SELECT [id_account]&#xA;    ,[advertId]&#xA;    ,[type]&#xA;    ,[status]&#xA;    ,[createTime]&#xA;    ,[startTime]&#xA;    ,[changeTime]&#xA;    ,[endTime]&#xA;    ,[name]&#xA;    ,[dailyBudget]&#xA;    ,[paymentType]&#xA;&#x9;,searchPluseState&#xA;   FROM [BUFFER].[Wildberies_advert_promotion]&#xA; ) SRC ON (TGT.[id_account]  = SRC.[id_account] AND TGT.[advertId] = SRC.[advertId])&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA; SRC.[type]&#xA; ,SRC.[status]&#xA; ,SRC.[createTime]&#xA; ,SRC.[startTime]&#xA; ,SRC.[changeTime]&#xA; ,SRC.[endTime]&#xA; ,SRC.[name]&#xA; ,SRC.[dailyBudget]&#xA; ,SRC.[paymentType]&#xA; ,SRC.searchPluseState&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA; TGT.[type]&#xA; ,TGT.[status]&#xA; ,TGT.[createTime]&#xA; ,TGT.[startTime]&#xA; ,TGT.[changeTime]&#xA; ,TGT.[endTime]&#xA; ,TGT.[name]&#xA; ,TGT.[dailyBudget]&#xA; ,TGT.[paymentType]&#xA; ,TGT.searchPluseState&#xA; ) THEN&#xA;   UPDATE SET &#xA;  [type] = SRC.[type]&#xA; ,[status] = SRC.[status]&#xA; ,[createTime] = SRC.[createTime]&#xA; ,[startTime] = SRC.[startTime]&#xA; ,[changeTime] = SRC.[changeTime]&#xA; ,[endTime] = SRC.[endTime]&#xA; ,[name] = SRC.[name]&#xA; ,[dailyBudget] = SRC.[dailyBudget]&#xA; ,[paymentType] = SRC.[paymentType]&#xA; ,searchPluseState = SRC.searchPluseState&#xA;    ,SYSMOMENT = GETDATE()&#xA;  WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA;    [id_account]&#xA; ,[advertId]&#xA; ,[type]&#xA; ,[status]&#xA; ,[createTime]&#xA; ,[startTime]&#xA; ,[changeTime]&#xA; ,[endTime]&#xA; ,[name]&#xA; ,[dailyBudget]&#xA; ,[paymentType]&#xA; ,searchPluseState&#xA; ,[SYSMOMENT]&#xA; )&#xA; VALUES&#xA; (&#xA;    SRC.[id_account]&#xA; ,SRC.[advertId]&#xA; ,SRC.[type]&#xA; ,SRC.[status]&#xA; ,SRC.[createTime]&#xA; ,SRC.[startTime]&#xA; ,SRC.[changeTime]&#xA; ,SRC.[endTime]&#xA; ,SRC.[name]&#xA; ,SRC.[dailyBudget]&#xA; ,SRC.[paymentType]&#xA; ,SRC.searchPluseState&#xA;    ,GETDATE()&#xA; );&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
