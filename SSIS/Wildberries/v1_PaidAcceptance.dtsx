              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_anal_PaidAcceptance]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_anal_PaidAcceptance]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_anal_PaidAcceptance] FROM [Wildberies].[anal_PaidAcceptance]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
