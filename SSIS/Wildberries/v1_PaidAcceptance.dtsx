    }

    private JavaScriptSerializer _JSS { get; set; }

    public override void CreateNewOutputRows()
    {
        try
        {
            DateTime vWorkDate = Variables.pSYSMOMENT;

            while (vWorkDate <= DateTime.Now)
            {
                DateTime vDateStart = vWorkDate;
                DateTime vDateFinish = vWorkDate.AddDays(30);

                byte[] oDATA = null;

                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                        string vURL = String.Format("https://seller-analytics-api.wildberries.ru/api/v1/analytics/acceptance-report?dateFrom={0:yyyy-MM-dd}&dateTo={1:yyyy-MM-dd}", vDateStart, vDateFinish);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyAnalytics));
                        oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (WebException e)
                    {
                        if (e.Message.Contains("Too Many Requests"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Метод https://seller-analytics-api.wildberries.ru/api/v1/analytics/acceptance-report сервера WB не отвечает");

                Response oResponse = _JSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                foreach (Response_Report oItem in oResponse.Report)
                {
                    OutputBuffer.AddRow();
                    OutputBuffer.shkСreateDate = oItem.shkСreateDate;
                    if (oItem.count != null) OutputBuffer.count = (int)oItem.count;
                    if (oItem.giCreateDate != null) OutputBuffer.giCreateDate = (DateTime)oItem.giCreateDate;
                    if (oItem.incomeId != null) OutputBuffer.incomeId = (int)oItem.incomeId;
                    if (oItem.nmID != null) OutputBuffer.nmID  = (int)oItem.nmID;
                    if (oItem.subjectName != null && oItem.subjectName.Length > 0) OutputBuffer.subjectName = oItem.subjectName.Length > 200 ? oItem.subjectName.Substring(0, 200) : oItem.subjectName;
                    if (oItem.sum != null) OutputBuffer.sum = (int)oItem.sum;
                    if (oItem.total != null) OutputBuffer.total = (decimal)oItem.total;
                }

                vWorkDate = vWorkDate.AddDays(30);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "WB", e.Message, "", 0, out cancel);
        }
    }

}
]]></arrayElement>
