    #region Response
    public class Response
    {
        public Response_Report[] Report { get; set; }
    }
    public class Response_Report
    {
        public int? count { get; set; }
        public DateTime? giCreateDate { get; set; }
        public int? incomeId { get; set; }
        public int? nmID { get; set; }
        public DateTime shkСreateDate { get; set; }
        public string subjectName { get; set; }
        public int? sum { get; set; }
        public decimal? total { get; set; }
    }


    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
