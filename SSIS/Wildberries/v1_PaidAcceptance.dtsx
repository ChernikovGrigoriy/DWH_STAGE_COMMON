          DTS:DTSID="{43841a81-3825-4f5e-8d3a-9937dd48b4bb}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Загрузка в стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @id_account int, @shkСreateDate date&#xA;&#xA;DECLARE CUR1 CURSOR LOCAL FOR&#xA;SELECT DISTINCT [id_Account], [shkСreateDate] FROM [BUFFER].[Wildberies_anal_PaidAcceptance]&#xA;OPEN CUR1&#xA;&#xA;FETCH NEXT FROM CUR1 INTO @id_account, @shkСreateDate&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA; BEGIN TRY  &#xA;  DELETE FROM [Wildberies].[anal_PaidAcceptance] WHERE id_account = @id_account AND [shkСreateDate] = @shkСreateDate&#xA;&#xA;  INSERT INTO [Wildberies].[anal_PaidAcceptance]&#xA;  (&#xA;   [id_Account]&#xA;      ,[count]&#xA;      ,[giCreateDate]&#xA;      ,[incomeId]&#xA;      ,[nmID]&#xA;      ,[shkСreateDate]&#xA;      ,[subjectName]&#xA;      ,[sum]&#xA;      ,[total]&#xA;      ,[SYSMOMENT]&#xA;  )&#xA;  SELECT&#xA;   [id_Account]&#xA;      ,[count]&#xA;      ,[giCreateDate]&#xA;      ,[incomeId]&#xA;      ,[nmID]&#xA;      ,[shkСreateDate]&#xA;      ,[subjectName]&#xA;      ,[sum]&#xA;      ,[total]&#xA;    ,GETDATE()&#xA;  FROM&#xA;   [BUFFER].[Wildberies_anal_PaidAcceptance]&#xA;  WHERE id_account = @id_account AND [shkСreateDate] = @shkСreateDate&#xA;&#xA; END TRY  &#xA; BEGIN CATCH  &#xA;  DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;  DECLARE @ErrorSeverity INT;  &#xA;  DECLARE @ErrorState INT;  &#xA;  &#xA;  SELECT   &#xA;   @ErrorMessage = ERROR_MESSAGE(),  &#xA;   @ErrorSeverity = ERROR_SEVERITY(),  &#xA;   @ErrorState = ERROR_STATE();  &#xA;  &#xA;  IF @@TRANCOUNT &gt; 0  &#xA;   ROLLBACK TRANSACTION;  &#xA;&#xA;  RAISERROR (@ErrorMessage, -- Message text.  &#xA;       @ErrorSeverity, -- Severity.  &#xA;       @ErrorState -- State.  &#xA;       ); &#xA; &#xA; END CATCH;  &#xA;&#xA;    FETCH NEXT FROM CUR1 INTO @id_account, @shkСreateDate&#xA;END&#xA;CLOSE CUR1;&#xA;DEALLOCATE CUR1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
