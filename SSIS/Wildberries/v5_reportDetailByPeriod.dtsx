    private DateTime GetFirstDateOfWeek(int  Year , int Week)
    {
        DateTime firstDay = new DateTime(Year, 1, 1); //1 января сего года
        while (firstDay.DayOfWeek != DayOfWeek.Monday) firstDay = firstDay.AddDays(-1); //ближайший предыдущий понедельник
        return firstDay.AddDays(7 * Week); //добавляем количество недель * 7 дней
    }

    private DateTime GetLastDateOfWeek(int Year, int Week)
    {
        DateTime firstDay = new DateTime(Year, 1, 1); //1 января сего года
        while (firstDay.DayOfWeek != DayOfWeek.Sunday) firstDay = firstDay.AddDays(1); //ближайший предыдущий понедельник
        return firstDay.AddDays(7 * Week); //добавляем количество недель * 7 дней
    }

    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        //получение начальной и конечной даны
        DateTime vDateStart = GetFirstDateOfWeek(Variables.vYEAR, Variables.vWEEK);
        DateTime vDateFinish = GetLastDateOfWeek(Variables.vYEAR, Variables.vWEEK);

        string vError = "";

        try
        {
            bool vIsLastReport = false;
            long vrrdid = 0;

            while (!vIsLastReport)
            {
                byte[] oDATA = null;

                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                        string vURL = String.Format("https://statistics-api.wildberries.ru/api/v5/supplier/reportDetailByPeriod?dateFrom={0:yyyy-MM-dd}&limit=20000&rrdid={2}&dateTo={1:yyyy-MM-dd}", vDateStart, vDateFinish, vrrdid);
                        oTWC.Headers.Add(HttpRequestHeader.Authorization, Variables.vKeyStatistic);
                        oDATA = oTWC.DownloadData(vURL);
                        oTWC = null;

                        break;
                    }
                    catch (Exception e)
                    {
                        if (
                            e.Message.Contains("(503) Сервер не доступен")
                            || e.Message.Contains("(502) Недопустимый шлюз")
                            )
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else if (e.Message.Contains("Too Many Requests"))
                        {
                            WebException oWExp = e as WebException;
                            HttpWebResponse response = (HttpWebResponse)oWExp.Response;
                            int vXRR = int.Parse(response.GetResponseHeader("X-Ratelimit-Retry"));
                            Thread.Sleep((vXRR + 1) * 1000);

                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Метод https://statistics-api.wildberries.ru/api/v5/supplier/reportDetailByPeriod не доступен на сервере WB");

                JavaScriptSerializer oJSS = new JavaScriptSerializer();
                oJSS.MaxJsonLength = int.MaxValue;

                List<reportDetailByPeriod> oreportDetailByPeriods = oJSS.Deserialize<List<reportDetailByPeriod>>(Encoding.UTF8.GetString(oDATA));

                if (oreportDetailByPeriods == null || oreportDetailByPeriods.Count == 0)
                {
                    vIsLastReport = true;
                    continue;
                }
                
                foreach (reportDetailByPeriod oItem in oreportDetailByPeriods)
                {
                    vError = "Начало строки";
                    OutputBuffer.AddRow();
                    OutputBuffer.idAccount = Variables.vIDAccount;
                    OutputBuffer.WEEKDATESTART = vDateStart;
                    OutputBuffer.WEEKDATEFINISH = vDateFinish;
                    vError = "Field realizationreport_id";
                    if (oItem.realizationreport_id != null) OutputBuffer.realizationreportid = (long)oItem.realizationreport_id;
                    vError = "Field suppliercontract_code";
                    if (oItem.suppliercontract_code != null && oItem.suppliercontract_code.Length > 0) OutputBuffer.suppliercontractcode = oItem.suppliercontract_code.Length > 50 ? oItem.suppliercontract_code.Substring(0, 50) : oItem.suppliercontract_code;
                    vError = "Field rid";
                    if (oItem.rid != null) OutputBuffer.rid = (long)oItem.rid;
                    vError = "Field rr_dt";
                    if (oItem.rr_dt != null) OutputBuffer.rrdt = (DateTime)oItem.rr_dt;
                    vError = "Field rrd_id";
                    if (oItem.rrd_id != null) OutputBuffer.rrdid = (long)oItem.rrd_id;
                    vError = "Field gi_id";
                    if (oItem.gi_id != null) OutputBuffer.giid = (int)oItem.gi_id;
                    vError = "Field subject_name";
                    if (oItem.subject_name != null && oItem.subject_name.Length > 0) OutputBuffer.subjectname = oItem.subject_name.Length > 200 ? oItem.subject_name.Substring(0, 200) : oItem.subject_name;
                    vError = "Field NM_id";
                    if (oItem.NM_id != null && oItem.NM_id != 0) OutputBuffer.NMid = (int)oItem.NM_id;
                    vError = "Field brand_name";
                    if (oItem.brand_name != null && oItem.brand_name.Length > 0) OutputBuffer.brandname = oItem.brand_name.Length > 200 ? oItem.brand_name.Substring(0, 200) : oItem.brand_name;
                    vError = "Field sa_name";
