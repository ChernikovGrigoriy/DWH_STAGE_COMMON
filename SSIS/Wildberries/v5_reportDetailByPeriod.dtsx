              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="SELECT&#xA; COUNT(*)&#xA;FROM&#xA; [Wildberies].[v5_stat_reportDetailByPeriod] R&#xA;WHERE&#xA; R.[YEAR] = ?&#xA; AND R.[WEEK] = ?&#xA; AND DATEDIFF(day, R.SYSMOMENT, GETDATE()) &lt;= 2&#xA; AND R.id_Account = ?"
                  SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ResultBinding
                    SQLTask:ResultName="0"
                    SQLTask:DtsVariableName="User::vCount" />
