                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                      SQLTask:SqlStatementSource="MERGE [Wildberies].[v3_fullstats_boosterStats] TGT&#xA;USING [BUFFER].[Wildberies_v3_fullstats_boosterStats] SRC ON SRC.[id_account] = TGT.[id_account]&#xA;AND SRC.[advertId] = TGT.[advertId]&#xA;AND SRC.[nmId] = TGT.[nmId]&#xA;AND SRC.[date] = TGT.[date]&#xA;WHEN MATCHED AND&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;  SRC.[avg_position]&#xA;&#x9;) &lt;&gt; &#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;  TGT.[avg_position]&#xA;&#x9;) THEN&#xA;UPDATE SET&#xA;&#x9;  [avg_position] = SRC.[avg_position]&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT (&#xA;&#x9;  [id_account]&#xA;      ,[advertId]&#xA;      ,[nmId]&#xA;&#x9;  ,[date]&#xA;&#x9;  ,[avg_position]&#xA;&#x9;  ,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES (&#xA;&#x9;  SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[nmId]&#xA;&#x9;  ,SRC.[date]&#xA;&#x9;  ,SRC.[avg_position]&#xA;&#x9;  ,GETDATE()&#xA;&#x9;);&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                  </DTS:ObjectData>
