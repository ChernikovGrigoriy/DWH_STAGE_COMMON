                  DTS:ObjectName="v3_fullstats"
                  DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
                  DTS:ThreadHint="1">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                      SQLTask:SqlStatementSource="MERGE [Wildberies].[v3_fullstats] TGT&#xA;USING [BUFFER].[Wildberies_v3_fullstats] SRC ON SRC.[id_account] = TGT.[id_account]&#xA;AND SRC.[advertId] = TGT.[advertId]&#xA;AND SRC.[DATE_START] = TGT.[DATE_START]&#xA;AND SRC.[DATE_FINISH] = TGT.[DATE_FINISH]&#xA;WHEN MATCHED AND&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;  SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[DATE_START]&#xA;      ,SRC.[DATE_FINISH]&#xA;      ,SRC.[atbs]&#xA;      ,SRC.[canceled]&#xA;      ,SRC.[clicks]&#xA;      ,SRC.[cpc]&#xA;      ,SRC.[cr]&#xA;      ,SRC.[ctr]&#xA;      ,SRC.[orders]&#xA;      ,SRC.[shks]&#xA;      ,SRC.[sum]&#xA;      ,SRC.[sum_price]&#xA;      ,SRC.[views]&#xA;&#x9;) &lt;&gt; &#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;  TGT.[id_account]&#xA;      ,TGT.[advertId]&#xA;      ,TGT.[DATE_START]&#xA;      ,TGT.[DATE_FINISH]&#xA;      ,TGT.[atbs]&#xA;      ,TGT.[canceled]&#xA;      ,TGT.[clicks]&#xA;      ,TGT.[cpc]&#xA;      ,TGT.[cr]&#xA;      ,TGT.[ctr]&#xA;      ,TGT.[orders]&#xA;      ,TGT.[shks]&#xA;      ,TGT.[sum]&#xA;      ,TGT.[sum_price]&#xA;      ,TGT.[views]&#xA;&#x9;) THEN&#xA;UPDATE SET&#xA;&#x9;  [id_account] = SRC.[id_account]&#xA;      ,[advertId] = SRC.[advertId]&#xA;      ,[DATE_START] = SRC.[DATE_START]&#xA;      ,[DATE_FINISH] = SRC.[DATE_FINISH]&#xA;      ,[atbs] = SRC.[atbs]&#xA;      ,[canceled] = SRC.[canceled]&#xA;      ,[clicks] = SRC.[clicks]&#xA;      ,[cpc] = SRC.[cpc]&#xA;      ,[cr]= SRC.[cr]&#xA;      ,[ctr] = SRC.[ctr]&#xA;      ,[orders] = SRC.[orders]&#xA;      ,[shks] = SRC.[shks]&#xA;      ,[sum] = SRC.[sum]&#xA;      ,[sum_price] = SRC.[sum_price]&#xA;      ,[views] = SRC.[views]&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT (&#xA;&#x9;  [id_account]&#xA;      ,[advertId]&#xA;      ,[DATE_START]&#xA;      ,[DATE_FINISH]&#xA;      ,[atbs]&#xA;      ,[canceled]&#xA;      ,[clicks]&#xA;      ,[cpc]&#xA;      ,[cr]&#xA;      ,[ctr]&#xA;      ,[orders]&#xA;      ,[shks]&#xA;      ,[sum]&#xA;      ,[sum_price]&#xA;      ,[views]&#xA;&#x9;  ,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES (&#xA;&#x9;SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[DATE_START]&#xA;      ,SRC.[DATE_FINISH]&#xA;      ,SRC.[atbs]&#xA;      ,SRC.[canceled]&#xA;      ,SRC.[clicks]&#xA;      ,SRC.[cpc]&#xA;      ,SRC.[cr]&#xA;      ,SRC.[ctr]&#xA;      ,SRC.[orders]&#xA;      ,SRC.[shks]&#xA;      ,SRC.[sum]&#xA;      ,SRC.[sum_price]&#xA;      ,SRC.[views]&#xA;&#x9;  ,GETDATE()&#xA;&#x9;);&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                  </DTS:ObjectData>
                </DTS:Executable>
                <DTS:Executable
                  DTS:refId="Package\fullstats\даты\стейджинг\v3_fullstats_boosterStats"
