    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        try
        {           
            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            vErrorStr = "Запрос к WB ";

            WildberriesWebClient oWWC = new WildberriesWebClient(90000, 20, 30000);
            string vURL = String.Format("https://advert-api.wildberries.ru/adv/v3/fullstats?ids=" + Variables.vAdList + string.Format("&beginDate={0:yyyy-MM-dd}", Variables.vDATESTART) + string.Format("&endDate={0:yyyy-MM-dd}", Variables.vDATEFINISH));
            byte[] oDATA = oWWC.SendRequestWithRateLimit(vURL, string.Format("Bearer {0}", Variables.vKeyAdvert));

            Response[] oResponses = oJSS.Deserialize<Response[]>(Encoding.UTF8.GetString(oDATA));

            
            vErrorStr = "Начало цикла";
            if (oResponses != null)
            {

                foreach(Response oItem in oResponses)
                {
                    v3fullstatsBuffer.AddRow();
                    v3fullstatsBuffer.advertId = (int)oItem.advertId;
                    if (oItem.atbs != null) v3fullstatsBuffer.atbs = (int)oItem.atbs;
                    if (oItem.canceled != null) v3fullstatsBuffer.canceled = (int)oItem.canceled;
                    if (oItem.clicks != null) v3fullstatsBuffer.clicks = (int)oItem.clicks;
                    if (oItem.cpc != null) v3fullstatsBuffer.cpc = (decimal)oItem.cpc;
                    if (oItem.cr != null) v3fullstatsBuffer.cr = (decimal)oItem.cr;
                    if (oItem.ctr != null) v3fullstatsBuffer.ctr = (decimal)oItem.ctr;
                    if (oItem.orders != null) v3fullstatsBuffer.orders = (int)oItem.orders;
                    if (oItem.shks != null) v3fullstatsBuffer.shks = (int)oItem.shks;
                    if (oItem.sum != null) v3fullstatsBuffer.sum = (decimal)oItem.sum;
                    if (oItem.sum_price != null) v3fullstatsBuffer.sumprice = (decimal)oItem.sum_price;
                    if (oItem.views != null) v3fullstatsBuffer.views = (int)oItem.views;    
                    
                    if (oItem.boosterStats != null && oItem.boosterStats.Length > 0)
                    {
                        foreach (Response_boosterStat oBS in oItem.boosterStats)
                        {
                            v3fullstatsboosterStatsBuffer.AddRow();
                            v3fullstatsboosterStatsBuffer.advertId = (int)oItem.advertId;
                            v3fullstatsboosterStatsBuffer.nmId = oBS.nm;
                            v3fullstatsboosterStatsBuffer.date = oBS.date;
                            v3fullstatsboosterStatsBuffer.avgposition = oBS.avg_position;
                        }

                    }

                    if (oItem.Days != null)
                    {
                        foreach (Response_Day oDay in oItem.Days)
                        {
                            v3fullstatsdayBuffer.AddRow();
                            v3fullstatsdayBuffer.advertId = (int)oItem.advertId;
                            v3fullstatsdayBuffer.date = oDay.date;
                            if (oDay.atbs != null) v3fullstatsdayBuffer.atbs = (int)oDay.atbs;
                            if (oDay.canceled != null) v3fullstatsdayBuffer.cancelled = (int)oDay.canceled;
                            if (oDay.clicks != null) v3fullstatsdayBuffer.clicks = (int)oDay.clicks;
                            if (oDay.cpc != null) v3fullstatsdayBuffer.cpc = (decimal)oDay.cpc;
                            if (oDay.cr != null) v3fullstatsdayBuffer.cr = (decimal)oDay.cr;
                            if (oDay.ctr != null) v3fullstatsdayBuffer.ctr = (decimal)oDay.ctr;
                            if (oDay.orders != null) v3fullstatsdayBuffer.orders = (int)oDay.orders;
                            if (oDay.shks != null) v3fullstatsdayBuffer.shks = (int)oDay.shks;
                            if (oDay.sum != null) v3fullstatsdayBuffer.sum = (decimal)oDay.sum;
                            if (oDay.sum_price != null) v3fullstatsdayBuffer.sumprice = (decimal)oDay.sum_price;
                            if (oDay.views != null) v3fullstatsdayBuffer.views = (int)oDay.views;

                            if (oDay.apps != null)
                            {
                                foreach(Response_Day_App oApp in oDay.apps)
                                {
                                    v3fullstatsdayappBuffer.AddRow();
                                    v3fullstatsdayappBuffer.advertId = (int)oItem.advertId;
                                    v3fullstatsdayappBuffer.date = oDay.date;
                                    v3fullstatsdayappBuffer.appType = oApp.appType;
                                    if (oApp.atbs != null) v3fullstatsdayappBuffer.atbs = (int)oApp.atbs;
                                    if (oApp.canceled != null) v3fullstatsdayappBuffer.canceled = (int)oApp.canceled;
                                    if (oApp.clicks != null) v3fullstatsdayappBuffer.clicks = (int)oApp.clicks;
                                    if (oApp.cpc != null) v3fullstatsdayappBuffer.cpc = (decimal)oApp.cpc;
                                    if (oApp.cr != null) v3fullstatsdayappBuffer.cr = (decimal)oApp.cr;
                                    if (oApp.ctr != null) v3fullstatsdayappBuffer.ctr = (decimal)oApp.ctr;
                                    if (oApp.orders != null) v3fullstatsdayappBuffer.orders = (int)oApp.orders;
                                    if (oApp.shks != null) v3fullstatsdayappBuffer.shks = (int)oApp.shks;
                                    if (oApp.sum != null) v3fullstatsdayappBuffer.sum = (decimal)oApp.sum;
                                    if (oApp.sum_price != null) v3fullstatsdayappBuffer.sumprice = (decimal)oApp.sum_price;
                                    if (oApp.views != null) v3fullstatsdayappBuffer.views = (int)oApp.views;

                                    if (oApp != null)
                                    {
                                        foreach(Response_Day_NM oNM in oApp.nms)
                                        {
                                            v3fullstatsdayappnmBuffer.AddRow();
                                            v3fullstatsdayappnmBuffer.advertId = (int)oItem.advertId;
                                            v3fullstatsdayappnmBuffer.date = oDay.date;
                                            v3fullstatsdayappnmBuffer.appType = oApp.appType;
                                            v3fullstatsdayappnmBuffer.nmId = oNM.nmId;
                                            v3fullstatsdayappnmBuffer.name = oNM.name;
                                            if (oNM.atbs != null) v3fullstatsdayappnmBuffer.atbs = (int)oNM.atbs;
                                            if (oNM.canceled != null) v3fullstatsdayappnmBuffer.canceled = (int)oNM.canceled;
                                            if (oNM.clicks != null) v3fullstatsdayappnmBuffer.clicks = (int)oNM.clicks;
                                            if (oNM.cpc != null) v3fullstatsdayappnmBuffer.cpc = (decimal)oNM.cpc;
                                            if (oNM.cr != null) v3fullstatsdayappnmBuffer.cr = (decimal)oNM.cr;
                                            if (oNM.ctr != null) v3fullstatsdayappnmBuffer.ctr = (decimal)oNM.ctr;
                                            if (oNM.orders != null) v3fullstatsdayappnmBuffer.orders = (int)oNM.orders;
                                            if (oNM.shks != null) v3fullstatsdayappnmBuffer.shks = (int)oNM.shks;
                                            if (oNM.sum != null) v3fullstatsdayappnmBuffer.sum = (decimal)oNM.sum;
                                            if (oNM.sum_price != null) v3fullstatsdayappnmBuffer.sumprice = (decimal)oNM.sum_price;
                                            if (oNM.views != null) v3fullstatsdayappnmBuffer.views = (int)oNM.views;
                                        }
                                    }
                                }                                
                            }
                        }
                    }
                }
            }
        }
        catch (Exception e)
        {
            bool cancel;
            if (! e.Message.Contains("Для компаний задан не корректный интервал"))
                ComponentMetaData.FireError(10, "advert_v1_promotion", string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }
