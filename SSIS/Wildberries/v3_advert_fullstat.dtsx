                      SQLTask:SqlStatementSource="MERGE [Wildberies].[v3_fullstats_day_app] TGT&#xA;USING [BUFFER].[Wildberies_v3_fullstats_day_app] SRC ON SRC.[id_account] = TGT.[id_account]&#xA;AND SRC.[advertId] = TGT.[advertId]&#xA;AND SRC.date = TGT.date&#xA;AND SRC.[appType] = TGT.[appType]&#xA;WHEN MATCHED AND&#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;  SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[date]&#xA;      ,SRC.[atbs]&#xA;      ,SRC.[canceled]&#xA;      ,SRC.[clicks]&#xA;      ,SRC.[cpc]&#xA;      ,SRC.[cr]&#xA;      ,SRC.[ctr]&#xA;      ,SRC.[orders]&#xA;      ,SRC.[shks]&#xA;      ,SRC.[sum]&#xA;      ,SRC.[sum_price]&#xA;      ,SRC.[views]&#xA;&#x9;  ,SRC.[appType]&#xA;&#x9;) &lt;&gt; &#xA;&#x9;CHECKSUM&#xA;&#x9;(&#xA;&#x9;  TGT.[id_account]&#xA;      ,TGT.[advertId]&#xA;      ,TGT.[date]&#xA;      ,TGT.[atbs]&#xA;      ,TGT.[canceled]&#xA;      ,TGT.[clicks]&#xA;      ,TGT.[cpc]&#xA;      ,TGT.[cr]&#xA;      ,TGT.[ctr]&#xA;      ,TGT.[orders]&#xA;      ,TGT.[shks]&#xA;      ,TGT.[sum]&#xA;      ,TGT.[sum_price]&#xA;      ,TGT.[views]&#xA;&#x9;  ,TGT.[appType]&#xA;&#x9;) THEN&#xA;UPDATE SET&#xA;&#x9;  [id_account] = SRC.[id_account]&#xA;      ,[advertId] = SRC.[advertId]&#xA;      ,[date] = SRC.[date]&#xA;      ,[atbs] = SRC.[atbs]&#xA;      ,[canceled] = SRC.[canceled]&#xA;      ,[clicks] = SRC.[clicks]&#xA;      ,[cpc] = SRC.[cpc]&#xA;      ,[cr]= SRC.[cr]&#xA;      ,[ctr] = SRC.[ctr]&#xA;      ,[orders] = SRC.[orders]&#xA;      ,[shks] = SRC.[shks]&#xA;      ,[sum] = SRC.[sum]&#xA;      ,[sum_price] = SRC.[sum_price]&#xA;      ,[views] = SRC.[views]&#xA;&#x9;  ,[appType] = SRC.[appType]&#xA;&#x9;  ,SYSMOMENT = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;&#x9;INSERT (&#xA;&#x9;  [id_account]&#xA;      ,[advertId]&#xA;      ,[date]&#xA;&#x9;  ,[appType]&#xA;      ,[atbs]&#xA;      ,[canceled]&#xA;      ,[clicks]&#xA;      ,[cpc]&#xA;      ,[cr]&#xA;      ,[ctr]&#xA;      ,[orders]&#xA;      ,[shks]&#xA;      ,[sum]&#xA;      ,[sum_price]&#xA;      ,[views]&#xA;&#x9;  ,SYSMOMENT&#xA;&#x9;)&#xA;&#x9;VALUES (&#xA;&#x9;SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[date]&#xA;&#x9;  ,SRC.[appType]&#xA;      ,SRC.[atbs]&#xA;      ,SRC.[canceled]&#xA;      ,SRC.[clicks]&#xA;      ,SRC.[cpc]&#xA;      ,SRC.[cr]&#xA;      ,SRC.[ctr]&#xA;      ,SRC.[orders]&#xA;      ,SRC.[shks]&#xA;      ,SRC.[sum]&#xA;      ,SRC.[sum_price]&#xA;      ,SRC.[views]&#xA;&#x9;  ,GETDATE()&#xA;&#x9;);&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
