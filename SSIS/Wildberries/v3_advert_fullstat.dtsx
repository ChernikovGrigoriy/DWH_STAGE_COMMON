              <DTS:Variables />
              <DTS:Executables>
                <DTS:Executable
                  DTS:refId="Package\fullstats\даты\стейджинг\v3_fullstats"
                  DTS:CreationName="Microsoft.ExecuteSQLTask"
                  DTS:Description="Execute SQL Task"
                  DTS:DTSID="{A76F2D7C-63E0-4F00-9007-5DBA3932B6FB}"
