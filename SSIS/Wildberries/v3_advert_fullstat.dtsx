              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v3_fullstats]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v3_fullstats]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v3_fullstats] FROM [Wildberies].[v3_fullstats]&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v3_fullstats_day]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v3_fullstats_day]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v3_fullstats_day] FROM [Wildberies].[v3_fullstats_day]&#xA;&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v3_fullstats_day_app]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v3_fullstats_day_app]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v3_fullstats_day_app] FROM [Wildberies].[v3_fullstats_day_app]&#xA;&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v3_fullstats_day_app_nm]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v3_fullstats_day_app_nm]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v3_fullstats_day_app_nm] FROM [Wildberies].[v3_fullstats_day_app_nm]&#xA;&#xA;if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_v3_fullstats_boosterStats]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_v3_fullstats_boosterStats]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_v3_fullstats_boosterStats] FROM [Wildberies].[v3_fullstats_boosterStats]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\fullstats\даты\список рекламных кампаний"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{2c701acf-5909-4d53-bf34-dca0053dc03c}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="список рекламных кампаний"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="SELECT&#xA;   STRING_AGG([Id], ',') ad_list&#xA;FROM&#xA; (&#xA;  SELECT&#xA;   [Id],&#xA;   ROW_NUMBER() OVER (ORDER BY CURRENT_TIMESTAMP) / 50 [block]&#xA;  FROM&#xA;   [Wildberies].[v2_adverts]&#xA;  WHERE&#xA;   id_account = ?&#xA;   AND ? &gt;= COALESCE([timestamp_created], [timestamp_started],'19000101')&#xA;   AND ? &lt;= ISNULL([timestamp_deleted], '22000101')&#xA; ) TMP&#xA;GROUP BY&#xA; [block]"
                  SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ResultBinding
                    SQLTask:ResultName="0"
                    SQLTask:DtsVariableName="User::vAdObj" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::vID_Account"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="20"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="2"
                    SQLTask:DtsVariableName="User::vDATE_START"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="7"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="1"
                    SQLTask:DtsVariableName="User::vDATE_FINISH"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="7"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\fullstats\даты\стейджинг"
