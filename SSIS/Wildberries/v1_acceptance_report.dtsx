     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    #region Response_CreateReport
    public class Response_CreateReport
    {
        public Response_CreateReport_data data { get; set; }
    }

    public class Response_CreateReport_data
    {
        public string taskId { get; set; }
    }
    #endregion

    #region Response_ReportStatus
    public class Response_ReportStatus
    {
        public Response_ReportStatus_data data { get; set; }
    }
    public class Response_ReportStatus_data
    {
        public string id { get; set; }
        public string status { get; set; }
    }
    #endregion

    #region Response_Download
    public class Response_Download
    {
        public int? count { get; set; }
        public DateTime? giCreateDate { get; set; }
        public int? incomeId { get; set; }
        public int? nmID { get; set; }
        public DateTime shkСreateDate { get; set; }
        public string subjectName { get; set; }
        public int? sum { get; set; }
        public decimal? total { get; set; }
    }
    #endregion


    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;
        _JSS = new JavaScriptSerializer();
        _JSS.MaxJsonLength = 2147483647;
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    private JavaScriptSerializer _JSS { get; set; }

    #region Первый шаг
    private string Step_First(DateTime DateStart, DateTime DateFinish)
    {
        WildberriesWebClient oWWC = new WildberriesWebClient(30000, 6, 26000);

        byte[] oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://seller-analytics-api.wildberries.ru/api/v1/acceptance_report?dateFrom={0:yyyy-MM-dd}&dateTo={1:yyyy-MM-dd}", DateStart, DateFinish), string.Format("Bearer {0}", Variables.vKeyAnalytics));

        Response_CreateReport oResponse = _JSS.Deserialize<Response_CreateReport>(Encoding.UTF8.GetString(oDATA));

        return oResponse.data.taskId;
    }
    #endregion

    #region Второй шаг
    public void Step_Two(string TaskId)
    {
        Response_ReportStatus oResponse = null;


        int j = 1;
        do
        {
            if (j != 1) { Thread.Sleep(60000); }

            WildberriesWebClient oWWC = new WildberriesWebClient(30000, 6, 26000);

            byte[] oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://seller-analytics-api.wildberries.ru/api/v1/acceptance_report/tasks/{0}/status", TaskId), string.Format("Bearer {0}", Variables.vKeyAnalytics));

            oResponse = _JSS.Deserialize<Response_ReportStatus>(Encoding.UTF8.GetString(oDATA));

            j++;
        } while (oResponse.data.status != "done" && j < 10);

        if (j >= 10)
            throw new ApplicationException("Отчет не сформирован");
    }
    #endregion

    public override void CreateNewOutputRows()
    {
        try
        {
            DateTime vWorkDate = Variables.pSYSMOMENT;

            while (vWorkDate <= DateTime.Now)
            {
                DateTime vDateStart = vWorkDate;
                DateTime vDateFinish = vWorkDate.AddDays(30);

                if (vDateFinish > DateTime.Now)
                {
                    vDateFinish = DateTime.Now;
                }

                string vTaskId = Step_First(vDateStart, vDateFinish);

                Step_Two(vTaskId);

                WildberriesWebClient oWWC = new WildberriesWebClient(30000, 6, 26000);

                byte[] oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://seller-analytics-api.wildberries.ru/api/v1/acceptance_report/tasks/{0}/download", vTaskId), string.Format("Bearer {0}", Variables.vKeyAnalytics));


                Response_Download[] oResponses = _JSS.Deserialize<Response_Download[]>(Encoding.UTF8.GetString(oDATA));

                if (oResponses != null)
                {
                    foreach (Response_Download oItem in oResponses)
                    {
                        OutputBuffer.AddRow();
                        OutputBuffer.shkСreateDate = oItem.shkСreateDate;
                        if (oItem.count != null) OutputBuffer.count = (int)oItem.count;
                        if (oItem.giCreateDate != null) OutputBuffer.giCreateDate = (DateTime)oItem.giCreateDate;
                        if (oItem.incomeId != null) OutputBuffer.incomeId = (int)oItem.incomeId;
                        if (oItem.nmID != null) OutputBuffer.nmID = (int)oItem.nmID;
                        if (oItem.subjectName != null && oItem.subjectName.Length > 0) OutputBuffer.subjectName = oItem.subjectName.Length > 200 ? oItem.subjectName.Substring(0, 200) : oItem.subjectName;
                        if (oItem.sum != null) OutputBuffer.sum = (int)oItem.sum;
                        if (oItem.total != null) OutputBuffer.total = (decimal)oItem.total;
                    }
                }

                vWorkDate = vWorkDate.AddDays(30);
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, "v1_acceptance_report", e.Message, "", 0, out cancel);
        }
