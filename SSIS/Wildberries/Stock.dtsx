              SQLTask:SqlStatementSource="DECLARE @Date date, @id_Account int&#xA;&#xA;SELECT TOP 1 @Date = [Date], @id_Account = id_Account FROM [BUFFER].[Wildberies_stat_Stocks]&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; DELETE [Wildberies].[stat_Stocks] WHERE [Date] = @Date AND id_Account = @id_Account&#xA;&#xA; INSERT INTO [Wildberies].[stat_Stocks]&#xA; (&#xA; [id_Account]&#xA; ,[Date]&#xA;    ,[lastChangeDate]&#xA;    ,[supplierArticle]&#xA;    ,[techSize]&#xA;    ,[barcode]&#xA;    ,[quantity]&#xA;    ,[isSupply]&#xA;    ,[isRealization]&#xA;    ,[quantityFull]&#xA;    ,[quantityNotInOrders]&#xA;    ,[warehouseName]&#xA;    ,[inWayToClient]&#xA;    ,[inWayFromClient]&#xA;    ,[nmId]&#xA;    ,[subject]&#xA;    ,[category]&#xA;    ,[daysOnSite]&#xA;    ,[brand]&#xA;    ,[SCCode]&#xA;    ,[Price]&#xA;    ,[Discount]&#xA; ,SYSMOMENT&#xA; )&#xA; SELECT&#xA;    @id_Account&#xA; ,[Date]&#xA;    ,[lastChangeDate]&#xA;    ,[supplierArticle]&#xA;    ,[techSize]&#xA;    ,[barcode]&#xA;    ,[quantity]&#xA;    ,[isSupply]&#xA;    ,[isRealization]&#xA;    ,[quantityFull]&#xA;    ,[quantityNotInOrders]&#xA;    ,[warehouseName]&#xA;    ,[inWayToClient]&#xA;    ,[inWayFromClient]&#xA;    ,[nmId]&#xA;    ,[subject]&#xA;    ,[category]&#xA;    ,[daysOnSite]&#xA;    ,[brand]&#xA;    ,[SCCode]&#xA;    ,[Price]&#xA;    ,[Discount]&#xA; ,GETDATE()&#xA; FROM&#xA; [BUFFER].[Wildberies_stat_Stocks]&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
