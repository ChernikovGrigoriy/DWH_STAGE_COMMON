    #region  Шаблон
    [Serializable]
    private class Stock
    {
        public DateTime? lastChangeDate { get; set; }
        public string supplierArticle { get; set; }
        public string techSize { get; set; }
        public string barcode { get; set; }
        public int? quantity { get; set; }
        public bool? isSupply { get; set; }
        public bool? isRealization { get; set; }
        public int? quantityFull { get; set; }
        public int? quantityNotInOrders { get; set; }
        public string warehouseName { get; set; }
        public int? inWayToClient { get; set; }
        public int? inWayFromClient { get; set; }
        public long? nmId { get; set; }
        public string subject { get; set; }
        public string category { get; set; }
        public int? daysOnSite { get; set; }
        public string brand { get; set; }
        public string SCCode { get; set; }
        public decimal? Price { get; set; }
        public decimal? Discount { get; set; }
    }
    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        try
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                    string vURL = String.Format("https://statistics-api.wildberries.ru/api/v1/supplier/stocks?dateFrom={0:yyyy-MM-dd}", new DateTime(2020,01,01));
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, Variables.vKeyStatistic);
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Слишком большое количество обращений к серверу WB");

            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            List<Stock> oStocks = oJSS.Deserialize<List<Stock>>(Encoding.UTF8.GetString(oDATA));

            foreach (Stock oItem in oStocks)
            {
                OutputBuffer.AddRow();
                OutputBuffer.idAccount = Variables.vIDAccount;
                if (oItem.lastChangeDate != null) OutputBuffer.lastChangeDate = (DateTime)oItem.lastChangeDate;
                if (oItem.supplierArticle != null && oItem.supplierArticle.Length > 0) OutputBuffer.supplierArticle = oItem.supplierArticle;
                if (oItem.techSize != null && oItem.techSize.Length > 0) OutputBuffer.techSize = oItem.techSize;
                if (oItem.barcode != null && oItem.barcode.Length > 0) OutputBuffer.barcode = oItem.barcode;
                if (oItem.quantity != null) OutputBuffer.quantity = (int) oItem.quantity;
                if (oItem.isSupply != null) OutputBuffer.isSupply = (bool)oItem.isSupply;
                if (oItem.isRealization != null) OutputBuffer.isRealization = (bool)oItem.isRealization;
                if (oItem.quantityFull != null) OutputBuffer.quantityFull = (int) oItem.quantityFull;
                if (oItem.quantityNotInOrders != null) OutputBuffer.quantityNotInOrders = (int)oItem.quantityNotInOrders;
                if (oItem.warehouseName != null && oItem.warehouseName.Length > 0) OutputBuffer.warehouseName = oItem.warehouseName;
                if (oItem.inWayToClient != null) OutputBuffer.inWayToClient = (int) oItem.inWayToClient;
                if (oItem.inWayFromClient != null) OutputBuffer.inWayFromClient = (int)oItem.inWayFromClient;
                if (oItem.nmId != null) OutputBuffer.nmId = (long)oItem.nmId;
                if (oItem.subject != null && oItem.subject.Length > 0) OutputBuffer.subject = oItem.subject;
                if (oItem.category != null && oItem.category.Length > 0) OutputBuffer.category = oItem.category;
                if (oItem.daysOnSite != null) OutputBuffer.daysOnSite = (int)oItem.daysOnSite;
                if (oItem.brand != null && oItem.brand.Length > 0) OutputBuffer.brand = oItem.brand;
