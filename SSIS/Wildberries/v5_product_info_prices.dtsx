    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";
        Request oRequest = new Request
        {
            cursor = "",
            filter = new Request_Filter
            {
                visibility = "ALL"
            },
            limit = 1000
        };
        Response oResponse = null;

        try
        {
            do
            {
                byte[] oDATA = null;

                vErrorStr = "Запрос к WB";
                int i = 1;
                while (i <= 6)
                {
                    try
                    {
                        TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                        string vURL = String.Format("https://discounts-prices-api.wildberries.ru/api/v5/product/info/prices");
                        byte[] vDataSend = Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest));
                        oTWC.Headers.Add("Client-Id", string.Format("{0}", Variables.vClientID));
                        oTWC.Headers.Add("Api-Key", Variables.vApiKey);
                        oDATA = oTWC.UploadData(vURL, vDataSend);
                        oTWC = null;

                        break;
                    }
                    catch (Exception e)
                    {
                        if (e.Message.Contains("Too Many Requests"))
                        {
                            Thread.Sleep(26000 * i);
                            i++;
                        }
                        else
                        {
                            throw;
                        }
                    }
                }

                if (i > 6)
                    throw new ApplicationException("Метод https://discounts-prices-api.wildberries.ru/api/v2/list/goods/filter на сервере WB не доступен");

                vErrorStr = "Парсинг";
                JavaScriptSerializer oJSS = new JavaScriptSerializer();
                oJSS.MaxJsonLength = int.MaxValue;

                oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                if (oResponse.data != null)
                {
                    foreach (Response_listGoods oItem in oResponse.data.listGoods)
                    {
                        if (oItem.sizes != null)
                        {
                            foreach (Response_listGoods_sizes oSize in oItem.sizes)
                            {
                                OutputBuffer.AddRow();
                                vErrorStr = "Поле nmID";
                                OutputBuffer.nmID = (int)oItem.nmID;
                                vErrorStr = "Поле vendorCode";
                                if (oItem.vendorCode != null) OutputBuffer.vendorCode = oItem.vendorCode;
                                vErrorStr = "Поле sizeID";
                                OutputBuffer.sizeID = (long)oSize.sizeID;
                                vErrorStr = "Поле price";
                                if (oSize.price != null) OutputBuffer.price = (decimal)oSize.price;
                                vErrorStr = "Поле discountedPrice";
                                if (oSize.discountedPrice != null) OutputBuffer.discountedPrice = (decimal)oSize.discountedPrice;
                                vErrorStr = "Поле techSizeName";
                                if (oSize.techSizeName != null && oSize.techSizeName.Length > 0) OutputBuffer.techSizeName = Substr(oSize.techSizeName, 200);
                                vErrorStr = "Поле currencyIsoCode4217";
                                if (oItem.currencyIsoCode4217 != null && oItem.currencyIsoCode4217.Length > 0) OutputBuffer.currencyIsoCode4217 = Substr(oItem.currencyIsoCode4217, 50);
                                vErrorStr = "Поле discount";
                                if (oItem.discount != null) OutputBuffer.discount = (decimal)oItem.discount;
                                vErrorStr = "Поле editableSizePrice";
                                if (oItem.editableSizePrice != null) OutputBuffer.editableSizePrice = (bool)oItem.editableSizePrice;
                            }
                        }
                        else
                        {
                            OutputBuffer.AddRow();
                            vErrorStr = "Поле nmID";
                            OutputBuffer.nmID = (int)oItem.nmID;
                            vErrorStr = "Поле vendorCode";
                            if (oItem.vendorCode != null) OutputBuffer.vendorCode = oItem.vendorCode;
                            vErrorStr = "Поле currencyIsoCode4217";
                            if (oItem.currencyIsoCode4217 != null && oItem.currencyIsoCode4217.Length > 0) OutputBuffer.currencyIsoCode4217 = Substr(oItem.currencyIsoCode4217, 50);
                            vErrorStr = "Поле discount";
