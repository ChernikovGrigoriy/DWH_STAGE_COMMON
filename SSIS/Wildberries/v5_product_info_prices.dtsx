                            vErrorStr = "Поле editableSizePrice";
                            if (oItem.editableSizePrice != null) OutputBuffer.editableSizePrice = (bool)oItem.editableSizePrice;
                        }
                    }

                    vOffset += oResponse.data.listGoods.Length;
                }

            } while (oResponse != null && oResponse.data != null && oResponse.data.listGoods.Length == 1000);
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("price_Goods"), string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }

}
