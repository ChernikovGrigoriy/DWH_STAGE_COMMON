     */
    #endregion

    #region Шаблон
    public class Request
    {
        public string cursor { get; set; }
        public Request_Filter filter { get; set; }
        public int limit { get; set; }
    }

    public class Request_Filter
    {
        public string[] offer_id { get; set; }
        public long[] product_id { get; set; }
        public string visibility { get; set; }
    }

    private class Response
    {
        public Response_data data { get; set; }
        public bool error { get; set; }
        public string errorText { get; set; }
    }

    public class Response_data
{
        public Response_listGoods[] listGoods { get; set; }
    }

    [Serializable]
    public class Response_listGoods 
    {
        public long nmID { get; set; }
        public string vendorCode { get; set; }
        public Response_listGoods_sizes[] sizes { get; set; }
        public string currencyIsoCode4217  { get; set; }
        public decimal? discount { get; set; }
        public bool? editableSizePrice { get; set; }
    }

    public class Response_listGoods_sizes
    {
        public long sizeID { get; set; }
        public int? price { get; set; }
        public decimal? discountedPrice { get; set; }
        public string techSizeName { get; set; }
    }
    #endregion

    public class TimeoutWebClient : WebClient
    {
        /// <summary>
        /// Default constructor (30000 ms timeout)
        /// NOTE: timeout can be changed later on using the [Timeout] property.
        /// </summary>
        public TimeoutWebClient() : this(30000) { }

        /// <summary>
        /// Constructor with customizable timeout
        /// </summary>
        /// <param name="timeout">
        /// Web request timeout (in milliseconds)
        /// </param>
        public TimeoutWebClient(int timeout)
        {
            Timeout = timeout;
        }

        #region Methods
        protected override WebRequest GetWebRequest(Uri uri)
        {
            WebRequest w = base.GetWebRequest(uri);
            w.Timeout = Timeout;
            ((HttpWebRequest)w).ReadWriteTimeout = Timeout;
            return w;
        }
        #endregion

        /// <summary>
        /// Web request timeout (in milliseconds)
        /// </summary>
        public int Timeout { get; set; }
    }

    private string Substr(string Value, int length)
    {
        return Value.Length > length ? Value.Substring(1, length) : Value;
    }
    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
