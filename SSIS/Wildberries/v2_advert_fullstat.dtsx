         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";
        byte[] oDATA = null;

        try
        {           
            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            vErrorStr = "Запрос к WB ";
            int i = 1;
            while (i <= 6)
            {
                try
                {
                    BODY[] oBodys = oJSS.Deserialize<BODY[]>(Variables.vBody);
                    
                    List<Request> oRequests = new List<Request>();
                    foreach (BODY oItem in oBodys) {
                        oRequests.Add(
                            new Request
                            {
                                id = oItem.id,
                                dates = oItem.dates.Split(',')
                            }
                        );
                     }

                    TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                    string vURL = String.Format("https://advert-api.wildberries.ru/adv/v2/fullstats");
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("Bearer {0}", Variables.vKeyAdvert));
                    oTWC.Headers.Add(HttpRequestHeader.ContentType, "application/json");
                    //vErrorStr = oJSS.Serialize(oRequests);
                    oDATA = oTWC.UploadData(vURL, Encoding.UTF8.GetBytes(oJSS.Serialize(oRequests)));
                    oTWC.Dispose();

                    break;
                }
                catch (WebException e)
                {
                    if (e.Message.Contains("Too Many Requests") 
                        || e.Message.Contains("(502) Недопустимый шлюз") 
                        || e.Message.Contains("(504) Истекло время ожидания шлюза") 
                        || e.Message.Contains("(503) Сервер не доступен") 
                        || e.Message.Contains("Запрос был прерван: Не удалось создать защищенный канал SSL/TLS")
                        || e.Message.Contains("Время ожидания операции истекло"))
                    {
                        Thread.Sleep(26000 * i);
                        i++;
                    }
                    else if (e.Message.Contains("(400) Недопустимый запрос"))
                    {
                        string oError = new StreamReader(e.Response.GetResponseStream()).ReadToEnd();
                        if (oError.Contains("Invalid Params: there are no companies with correct intervals"))
                            throw new ApplicationException("Для компаний задан не корректный интервал");
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Ошибка метода https://advert-api.wildberries.ru/adv/v2/fullstats на сервере WB");

            Response[] oResponses = oJSS.Deserialize<Response[]>(Encoding.UTF8.GetString(oDATA));

            
            vErrorStr = "Начало цикла";
            if (oResponses != null)
            {
                foreach (Response oItem in oResponses)
                {
                    if (oItem.days != null)
                    {
                        foreach (Response_Days oDay in oItem.days)
                        {
                            if (oDay.apps != null)
                            {
                                foreach (Response_Apps oApp in oDay.apps)
                                {
                                    if (oApp.nm != null)
                                    {
                                        foreach (Response_Nm oNm in oApp.nm)
                                        {
                                            OutputBuffer.AddRow();
                                            //OutputBuffer.date = DateTime.ParseExact(oDay.date, "yyyy-MM-dd", CultureInfo.InvariantCulture);
                                            OutputBuffer.advertId = (int)oItem.advertId;
                                            OutputBuffer.date = oDay.date;
                                            if (oApp.appType != null) OutputBuffer.appType = (int)oApp.appType;
                                            if (oNm.nmId != null) OutputBuffer.nmId = (int)oNm.nmId;
                                            if (oNm.name != null && oNm.name.Length > 0) OutputBuffer.name = oNm.name;
                                            if (oNm.views != null) OutputBuffer.views = (int)oNm.views;
                                            if (oNm.clicks != null) OutputBuffer.clicks = (int)oNm.clicks;
                                            if (oNm.ctr != null) OutputBuffer.ctr = (decimal)oNm.ctr;
                                            if (oNm.cpc != null) OutputBuffer.cpc = (decimal)oNm.cpc;
                                            if (oNm.sum != null) OutputBuffer.sum = (decimal)oNm.sum;
                                            if (oNm.atbs != null) OutputBuffer.atbs = (int)oNm.atbs;
                                            if (oNm.orders != null) OutputBuffer.orders = (int)oNm.orders;
                                            if (oNm.shks != null) OutputBuffer.shks = (int)oNm.shks;
                                            if (oNm.sum_price != null) OutputBuffer.sumprice = (decimal)oNm.sum_price;
                                            if (oNm.cr != null) OutputBuffer.cr = (decimal)oNm.cr;
                                        }
                                    }
                                }
                            }
                        }
                    }

                }
            }

            Thread.Sleep(20000);
        }
        catch (Exception e)
        {
            bool cancel;
            if (! e.Message.Contains("Для компаний задан не корректный интервал"))
                ComponentMetaData.FireError(10, "advert_v1_promotion", string.Format("Место в коде {1}. Ошибка {0}", e.Message, vErrorStr), "", 0, out cancel);
        }
    }
}
]]></arrayElement>
