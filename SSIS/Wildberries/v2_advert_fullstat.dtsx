        <DTS:Executable
          DTS:refId="Package\fullstats\загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7C21B425-AC49-480E-9F10-0FF9709DA43C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; MERGE [Wildberies].[advert_fullstats] WITH(TABLOCK) TGT&#xA; USING (&#xA; SELECT [id_account]&#xA;      ,[advertId]&#xA;      ,[date]&#xA;      ,[appType]&#xA;      ,[nmId]&#xA;      ,[name]&#xA;      ,[views]&#xA;      ,[clicks]&#xA;      ,[ctr]&#xA;      ,[cpc]&#xA;      ,[sum]&#xA;      ,[atbs]&#xA;      ,[orders]&#xA;      ,[shks]&#xA;      ,[sum_price]&#xA;      ,[cr]&#xA;   FROM [BUFFER].[Wildberies_advert_fullstats]&#xA; ) SRC ON (TGT.[id_account]  = SRC.[id_account] AND TGT.[advertId] = SRC.[advertId] AND TGT.[date] = SRC.[date] AND TGT.[appType] = SRC.[appType] AND TGT.[nmId] = SRC.[nmId])&#xA; WHEN MATCHED AND&#xA; CHECKSUM&#xA; (&#xA; SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[date]&#xA;      ,SRC.[appType]&#xA;      ,SRC.[nmId]&#xA;      ,SRC.[name]&#xA;      ,SRC.[views]&#xA;      ,SRC.[clicks]&#xA;      ,SRC.[ctr]&#xA;      ,SRC.[cpc]&#xA;      ,SRC.[sum]&#xA;      ,SRC.[atbs]&#xA;      ,SRC.[orders]&#xA;      ,SRC.[shks]&#xA;      ,SRC.[sum_price]&#xA;      ,SRC.[cr]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;TGT.[id_account]&#xA;      ,TGT.[advertId]&#xA;      ,TGT.[date]&#xA;      ,TGT.[appType]&#xA;      ,TGT.[nmId]&#xA;      ,TGT.[name]&#xA;      ,TGT.[views]&#xA;      ,TGT.[clicks]&#xA;      ,TGT.[ctr]&#xA;      ,TGT.[cpc]&#xA;      ,TGT.[sum]&#xA;      ,TGT.[atbs]&#xA;      ,TGT.[orders]&#xA;      ,TGT.[shks]&#xA;      ,TGT.[sum_price]&#xA;      ,TGT.[cr]&#xA; ) THEN&#xA;   UPDATE SET &#xA; [id_account] = SRC.[id_account]&#xA;      ,[advertId] = SRC.[advertId]&#xA;      ,[date] = SRC.[date]&#xA;      ,[appType] = SRC.[appType]&#xA;      ,[nmId] = SRC.[nmId]&#xA;      ,[name] = SRC.[name]&#xA;      ,[views] = SRC.[views]&#xA;      ,[clicks] = SRC.[clicks]&#xA;      ,[ctr] = SRC.[ctr]&#xA;      ,[cpc] = SRC.[cpc]&#xA;      ,[sum] = SRC.[sum]&#xA;      ,[atbs] = SRC.[atbs]&#xA;      ,[orders] = SRC.[orders]&#xA;      ,[shks] = SRC.[shks]&#xA;      ,[sum_price] = SRC.[sum_price]&#xA;      ,[cr] = SRC.[cr]&#xA;      ,SYSMOMENT = GETDATE()&#xA;  WHEN NOT MATCHED THEN&#xA; INSERT &#xA; (&#xA; [id_account]&#xA;      ,[advertId]&#xA;      ,[date]&#xA;      ,[appType]&#xA;      ,[nmId]&#xA;      ,[name]&#xA;      ,[views]&#xA;      ,[clicks]&#xA;      ,[ctr]&#xA;      ,[cpc]&#xA;      ,[sum]&#xA;      ,[atbs]&#xA;      ,[orders]&#xA;      ,[shks]&#xA;      ,[sum_price]&#xA;      ,[cr]&#xA; ,[SYSMOMENT]&#xA; )&#xA; VALUES&#xA; (&#xA; SRC.[id_account]&#xA;      ,SRC.[advertId]&#xA;      ,SRC.[date]&#xA;      ,SRC.[appType]&#xA;      ,SRC.[nmId]&#xA;      ,SRC.[name]&#xA;      ,SRC.[views]&#xA;      ,SRC.[clicks]&#xA;      ,SRC.[ctr]&#xA;      ,SRC.[cpc]&#xA;      ,SRC.[sum]&#xA;      ,SRC.[atbs]&#xA;      ,SRC.[orders]&#xA;      ,SRC.[shks]&#xA;      ,SRC.[sum_price]&#xA;      ,SRC.[cr]&#xA;    ,GETDATE()&#xA; );&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\fullstats\Создание буферной таблицы"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
