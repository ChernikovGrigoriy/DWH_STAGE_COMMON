          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_advert_fullstats]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_advert_fullstats]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_advert_fullstats] FROM [Wildberies].[advert_fullstats]&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\fullstats\список рекламных кампаний"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E6BAD3DB-4D36-4B27-91C0-787434ED3BB0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="список рекламных кампаний"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @DATE_START date, @DATE_FINISH date = GETDATE(), @SYSMOMENT date, @id_account int&#xA;&#xA;SELECT @SYSMOMENT = ?, @id_account = ?&#xA;&#xA;SELECT&#xA; @DATE_START = ISNULL(CAST(MIN(createTime) as date),'22000101')&#xA;FROM&#xA; [Wildberies].[advert_promotion]&#xA;WHERE&#xA; [id_account] = @id_account&#xA; AND endTime &gt;= @SYSMOMENT&#xA;&#xA;DECLARE  @TMP TABLE&#xA;(&#xA;&#x9;advertid int,&#xA;&#x9;dates nvarchar(max),&#xA;&#x9;RN int,&#xA;&#x9;ID int IDENTITY(1, 1),&#xA;&#x9;PRIMARY KEY(RN, advertid, ID)&#xA;)&#xA;&#xA;INSERT INTO @TMP&#xA;(&#xA;  advertid,&#xA;  dates,&#xA;  RN&#xA;)&#xA;SELECT&#xA;&#x9;TMP.advertid,&#xA;&#x9;STRING_AGG(DATA,',') dates,&#xA;&#x9;ROW_NUMBER() OVER (ORDER BY CURRENT_TIMESTAMP) / 100 RN&#xA;FROM&#xA;(&#xA;    SELECT&#xA;    CONVERT(char(10), DT.[DATA],126) [DATA],&#xA;    P.advertid,&#xA;    ROW_NUMBER() OVER (PARTITION BY P.advertid ORDER BY DT.[DATA])/ 10 grp &#xA;    FROM&#xA;    [Wildberies].[advert_promotion] P&#xA;    INNER JOIN [dbo].[fnDATA] (@DATE_START, @DATE_FINISH, NULL) DT ON DT.[DATA] BETWEEN P.[createTime] AND P.[endTime]&#xA;    WHERE&#xA;    [id_account] = @id_account&#xA;    AND [createTime] &lt;= @DATE_FINISH&#xA;    AND [endTime] &gt;= @DATE_START&#xA;&#x9;AND NOT EXISTS(SELECT TOP 1 1 FROM [Wildberies].[advert_fullstats] FS WHERE FS.id_account = @id_account AND FS.advertid = P.advertid AND FS.[date] = DT.[DATA] AND FS.[SYSMOMENT] &lt; DATEADD(day, -30, GETDATE()))&#xA;) TMP&#xA;GROUP BY&#xA;&#x9;TMP.advertid, grp&#xA;&#xA;IF @DATE_START &lt;= @DATE_FINISH &#xA;BEGIN&#xA; SELECT&#xA;  BODY = (SELECT advertid id, dates FROM @TMP CTE WHERE CTE.RN = TMP.RN  FOR JSON PATH) &#xA; FROM&#xA;  (SELECT DISTINCT RN FROM @TMP) TMP&#xA;&#xA;END&#xA;ELSE&#xA;BEGIN&#xA; SELECT TOP 0 '' BODY&#xA;END"
              SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
