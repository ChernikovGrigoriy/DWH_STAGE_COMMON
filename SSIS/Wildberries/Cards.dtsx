              SQLTask:SqlStatementSource="DECLARE @id_Account as int&#xA;&#xA;SELECT  @id_Account = id_Account FROM [BUFFER].[Wildberies_cont_Card_Sizes]&#xA;&#xA;CREATE TABLE #temp&#xA;(&#xA; nmID int&#xA;)&#xA;&#xA;INSERT INTO #temp(nmID)&#xA;SELECT&#xA; [BUF].nmID&#xA;FROM&#xA; (&#xA;  SELECT&#xA;   [nmID],&#xA;   CHECKSUM_AGG(BINARY_CHECKSUM(&#xA;     [nmID]&#xA;     ,[skus]&#xA;     ,[chrtID]&#xA;     ,[techSize]&#xA;     ,[wbSize]&#xA;     )) [CHECKSUM],&#xA;   COUNT(*) [CNT] &#xA;  FROM&#xA;   [BUFFER].[Wildberies_cont_Card_Sizes]&#xA;  GROUP BY&#xA;   [nmID]&#xA; ) [BUF]&#xA; LEFT OUTER JOIN (&#xA;  SELECT&#xA;   [nmID],&#xA;   CHECKSUM_AGG(BINARY_CHECKSUM(&#xA;     [nmID]&#xA;     ,[skus]&#xA;     ,[chrtID]&#xA;     ,[techSize]&#xA;     ,[wbSize]&#xA;     )) [CHECKSUM],&#xA;   COUNT(*) [CNT] &#xA;  FROM&#xA;   [Wildberies].[cont_Card_Sizes]&#xA;  WHERE&#xA;   id_Account = @id_Account&#xA;  GROUP BY&#xA;   [nmID]&#xA; ) [TGT] ON [BUF].nmID = [TGT].nmID&#xA;WHERE&#xA; ISNULL([BUF].[CHECKSUM],0) &lt;&gt; ISNULL([TGT].[CHECKSUM],0) OR ISNULL([BUF].[CNT],0) &lt;&gt; ISNULL([TGT].[CNT],0)&#xA; &#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; DELETE TGT&#xA; FROM &#xA;  [Wildberies].[cont_Card_Sizes] [TGT]&#xA; WHERE&#xA;  [TGT].nmID in (SELECT [nmID] FROM #temp)&#xA;  AND [TGT].id_Account = @id_Account&#xA;&#xA; INSERT INTO [Wildberies].[cont_Card_Sizes]&#xA; (&#xA;    [id_Account]&#xA;    ,[nmID]&#xA;       ,[skus]&#xA;       ,[chrtID]&#xA;       ,[techSize]&#xA;       ,[wbSize]&#xA;  ,SYSMOMENT&#xA; )&#xA; SELECT&#xA;    @id_Account&#xA;    ,[nmID]&#xA;       ,[skus]&#xA;       ,[chrtID]&#xA;       ,[techSize]&#xA;       ,[wbSize]&#xA;    ,GETDATE()&#xA; FROM&#xA;  [BUFFER].[Wildberies_cont_Card_Sizes] [SRC]&#xA; WHERE&#xA;  [SRC].nmID in (SELECT [nmID] FROM #temp)&#xA;  AND EXISTS(SELECT TOP 1 1 FROM [Wildberies].[cont_Card] C WHERE SRC.nmID = C.nmID)&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE