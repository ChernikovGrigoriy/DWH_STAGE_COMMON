    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        long? vnmID = null;
        string vupdateAT = null;
        int vTotal = 100;
        int vLimit = vTotal;

        string vError ="";

        try
        {
            while (vTotal == vLimit)
            {
                Request oRequest = new Request
                {
                    settings = new Request_Settings
                    {
                        cursor = new Request_Settings_Cursor
                        {
                            updatedAt = vupdateAT,
                            nmID = vnmID,
                            limit = vLimit
                        },
                        filter = new Request_Settings_Filter
                        {
                            withPhoto = -1
                        },
                        sort = new Request_Settings_Sort
                        {
                            ascending = false
                        }
                    }
                };

                WildberriesWebClient oWWC = new WildberriesWebClient(30000, 6, 26000);

                byte[] oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://content-api.wildberries.ru/content/v2/get/cards/list"), string.Format("Bearer {0}", Variables.vKeyContent), Encoding.UTF8.GetBytes(oJSS.Serialize(oRequest)));

                vError = "Deserialize";
                Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

                vError = "oResponse.cards";
                foreach (Response_Card oCard in oResponse.cards)
                {
                    vError = "oCard";
                    contCardBuffer.AddRow();
                    contCardBuffer.idAccount = Variables.vIDAccount;
                    vError = "oCard.nmID";
                    contCardBuffer.nmID = oCard.nmID;
                    vError = "oCard.imtID";
                    if (oCard.imtID != null) contCardBuffer.imtID = (int) oCard.imtID;
                    vError = "oCard.nmUUID";
                    if (oCard.nmUUID != null && oCard.nmUUID.Length > 0) contCardBuffer.nmUUID = oCard.nmUUID.Length > 50 ? oCard.nmUUID.Substring(0, 50) : oCard.nmUUID;
                    vError = "oCard.subjectID";
                    if (oCard.subjectID != null) contCardBuffer.subjectID = (int)oCard.subjectID;
                    vError = "oCard.vendorCode";
                    if (oCard.vendorCode != null && oCard.vendorCode.Length > 0) contCardBuffer.vendorCode = oCard.vendorCode.Length > 50 ? oCard.vendorCode.Substring(0, 50) : oCard.vendorCode;
                    vError = "oCard.subjectName";
                    if (oCard.subjectName != null && oCard.subjectName.Length > 0) contCardBuffer.subjectName = oCard.subjectName.Length > 200 ? oCard.subjectName.Substring(0, 200) : oCard.subjectName;
                    vError = "oCard.brand";
                    if (oCard.brand != null && oCard.brand.Length > 0) contCardBuffer.brand = oCard.brand.Length > 200 ? oCard.brand.Substring(0, 200) : oCard.brand;
                    vError = "oCard.title";
                    if (oCard.title != null && oCard.title.Length > 0) contCardBuffer.title = oCard.title.Length > 200 ? oCard.title.Substring(0, 200) : oCard.title;
                    vError = "oCard.video";
                    if (oCard.video != null && oCard.video.Length > 0) contCardBuffer.video = oCard.title.Length > 1000 ? oCard.video.Substring(0, 1000) : oCard.video;
                    vError = "oCard.dimensions";
                    if (oCard.dimensions != null) 
                    {
                        if (oCard.dimensions.width != null) contCardBuffer.dimensionwidth = (int)oCard.dimensions.width;
                        if (oCard.dimensions.height != null) contCardBuffer.dimensionheight = (int)oCard.dimensions.height;
                        if (oCard.dimensions.length != null) contCardBuffer.dimansionlength = (int)oCard.dimensions.length;
                    }
                    vError = "oCard.createdAt";
                    if (oCard.createdAt != null) contCardBuffer.createdAt = (DateTime)oCard.createdAt;
                    vError = "oCard.updatedAt";
                    if (oCard.updatedAt != null) contCardBuffer.updatedAt = (DateTime)oCard.updatedAt;

                    vError = "oCard.photos";
                    if (oCard.photos != null)
                    {
                        int vNpp = 1;
                        foreach (Response_Card_Photo oPhoto in oCard.photos)
                        {
                            contCardPhotoBuffer.AddRow();
                            contCardPhotoBuffer.idAccount = Variables.vIDAccount;
                            contCardPhotoBuffer.nmID = oCard.nmID;
                            contCardPhotoBuffer.npp = vNpp;
                            if (oPhoto.big != null && oPhoto.big.Length > 0) contCardPhotoBuffer.big = oPhoto.big.Length > 1000 ? oPhoto.big.Substring(0, 1000) : oPhoto.big;
                            if (oPhoto.c246x328 != null && oPhoto.c246x328.Length > 0) contCardPhotoBuffer.c246x328 = oPhoto.c246x328.Length > 1000 ? oPhoto.c246x328.Substring(0, 1000) : oPhoto.c246x328;
                            if (oPhoto.c516x688 != null && oPhoto.c516x688.Length > 0) contCardPhotoBuffer.c516x688 = oPhoto.c516x688.Length > 1000 ? oPhoto.c516x688.Substring(0, 1000) : oPhoto.c516x688;
                            if (oPhoto.square != null && oPhoto.square.Length > 0) contCardPhotoBuffer.square = oPhoto.square.Length > 1000 ? oPhoto.square.Substring(0, 1000) : oPhoto.square;
                            if (oPhoto.tm != null && oPhoto.tm.Length > 0) contCardPhotoBuffer.tm = oPhoto.tm.Length > 1000 ? oPhoto.tm.Substring(0, 1000) : oPhoto.tm;
                            vNpp++;
                        }
                    }

                    vError = "oCard.characteristics";
                    if (oCard.characteristics != null)
                    {
                        foreach(Response_Card_Characteristic oCharacteristic in oCard.characteristics)
                        {
                            contCardCharacteristicBuffer.AddRow();
                            contCardCharacteristicBuffer.idAccount = Variables.vIDAccount;
                            contCardCharacteristicBuffer.nmID = oCard.nmID;
                            if (oCharacteristic.id != null) contCardCharacteristicBuffer.id = (int)oCharacteristic.id;
                            if (oCharacteristic.name != null && oCharacteristic.name.Length > 0) contCardCharacteristicBuffer.name = oCharacteristic.name.Length > 200 ? oCharacteristic.name.Substring(0, 200) : oCharacteristic.name;
                            if (oCharacteristic.value != null)
                            {
                                if (oCharacteristic.value.GetType().IsArray)
                                    contCardCharacteristicBuffer.value = string.Join(";", ((IEnumerable<object>)oCharacteristic.value).Select(x => x.ToString()));
                                else
                                {
                                    contCardCharacteristicBuffer.value = string.Format("{0}", oCharacteristic.value);
                                }
                            }
                        }
                    }

                    vError = "oCard.sizes";
                    if (oCard.sizes != null)
                    {
                        foreach(Response_Card_Size oSize in oCard.sizes)
                        {
                            if (oSize.skus != null)
                            {
                                foreach (string vSku in oSize.skus)
                                {
                                    contCardSizesBuffer.AddRow();
                                    contCardSizesBuffer.idAccount = Variables.vIDAccount;
                                    contCardSizesBuffer.nmID = oCard.nmID;
                                    contCardSizesBuffer.skus = vSku;
                                    if (oSize.chrtID != null) contCardSizesBuffer.chrtID = (int)oSize.chrtID;
                                    if (oSize.techSize != null && oSize.techSize.Length > 0) contCardSizesBuffer.techSize = oSize.techSize.Length > 50 ? oSize.techSize.Substring(0, 50) : oSize.techSize;
                                    if (oSize.wbSize != null && oSize.wbSize.Length > 0) contCardSizesBuffer.wbSize = oSize.wbSize.Length > 50 ? oSize.wbSize.Substring(0, 50) : oSize.wbSize;
                                }
                            }
                        }
                    }

                    vError = "oCard.tags";
                    if (oCard.tags != null)
                    {
                        foreach(Response_Card_Tag oTag in oCard.tags)
                        {
                            contCardTagBuffer.AddRow();
                            contCardTagBuffer.idAccount = Variables.vIDAccount;
                            contCardTagBuffer.nmID  = oCard.nmID;
                            if (oTag.id != null) contCardTagBuffer.id = (int)oTag.id;
                            if (oTag.name != null && oTag.name.Length > 0) contCardTagBuffer.name = oTag.name.Length > 200 ? oTag.name.Substring(0, 200) : oTag.name;
                            if (oTag.color != null && oTag.color.Length > 0) contCardTagBuffer.color = oTag.color.Length > 50 ? oTag.color.Substring(0, 50) : oTag.color;
                        }
                    }
                }
                
                vnmID = oResponse.cursor.nmID;
                vupdateAT = oResponse.cursor.updatedAt;
                vTotal = oResponse.cursor.total;                
            }
        }
        catch (Exception e)
        {
            bool cancel;
            ComponentMetaData.FireError(10, string.Format("card {0}  Error = {1}", DateTime.Now, vError), e.Message, "", 0, out cancel);
        }
    }
}
