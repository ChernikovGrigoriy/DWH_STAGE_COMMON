        <DTS:Executable
          DTS:refId="Package\Загрузка\Загрузка в cont_Card"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{b1926838-1c60-4015-a773-8ed7fe85aed2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Загрузка в cont_Card"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; MERGE [Wildberies].[cont_Card] TGT &#xA; USING [BUFFER].[Wildberies_cont_Card] SRC ON TGT.nmID = SRC.nmID&#xA; WHEN MATCHED AND &#xA;  CHECKSUM(&#xA;    SRC.[id_Account]&#xA;    ,SRC.[imtID]&#xA;    ,SRC.[nmUUID]&#xA;    ,SRC.[subjectID]&#xA;    ,SRC.[vendorCode]&#xA;    ,SRC.[subjectName]&#xA;    ,SRC.[brand]&#xA;    ,SRC.[title]&#xA;    ,SRC.[video]&#xA;    ,SRC.[dimansion_length]&#xA;    ,SRC.[dimension_width]&#xA;    ,SRC.[dimension_height]&#xA;    ,SRC.[createdAt]&#xA;    ,SRC.[updatedAt]&#xA;  ) &lt;&gt; &#xA;  CHECKSUM(&#xA;    TGT.[id_Account]&#xA;    ,TGT.[imtID]&#xA;    ,TGT.[nmUUID]&#xA;    ,TGT.[subjectID]&#xA;    ,TGT.[vendorCode]&#xA;    ,TGT.[subjectName]&#xA;    ,TGT.[brand]&#xA;    ,TGT.[title]&#xA;    ,TGT.[video]&#xA;    ,TGT.[dimansion_length]&#xA;    ,TGT.[dimension_width]&#xA;    ,TGT.[dimension_height]&#xA;    ,TGT.[createdAt]&#xA;    ,TGT.[updatedAt]&#xA;  ) THEN&#xA;  UPDATE SET&#xA;    [id_Account] = SRC.[id_Account]&#xA;    ,[nmID] = SRC.[nmID]&#xA;    ,[imtID] = SRC.[imtID]&#xA;    ,[nmUUID] = SRC.[nmUUID]&#xA;    ,[subjectID] = SRC.[subjectID]&#xA;    ,[vendorCode] = SRC.[vendorCode]&#xA;    ,[subjectName] = SRC.[subjectName]&#xA;    ,[brand] = SRC.[brand]&#xA;    ,[title] = SRC.[title]&#xA;    ,[video] = SRC.[video]&#xA;    ,[dimansion_length] = SRC.[dimansion_length]&#xA;    ,[dimension_width] = SRC.[dimension_width]&#xA;    ,[dimension_height] = SRC.[dimension_height]&#xA;    ,[createdAt] = SRC.[createdAt]&#xA;    ,[updatedAt] = SRC.[updatedAt]&#xA;    ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA;    [id_Account]&#xA;    ,[nmID]&#xA;    ,[imtID]&#xA;    ,[nmUUID]&#xA;    ,[subjectID]&#xA;    ,[vendorCode]&#xA;    ,[subjectName]&#xA;    ,[brand]&#xA;    ,[title]&#xA;    ,[video]&#xA;    ,[dimansion_length]&#xA;    ,[dimension_width]&#xA;    ,[dimension_height]&#xA;    ,[createdAt]&#xA;    ,[updatedAt]&#xA;    ,SYSMOMENT&#xA;  )&#xA;  VALUES&#xA;  (&#xA;    SRC.[id_Account]&#xA;    ,SRC.[nmID]&#xA;    ,SRC.[imtID]&#xA;    ,SRC.[nmUUID]&#xA;    ,SRC.[subjectID]&#xA;    ,SRC.[vendorCode]&#xA;    ,SRC.[subjectName]&#xA;    ,SRC.[brand]&#xA;    ,SRC.[title]&#xA;    ,SRC.[video]&#xA;    ,SRC.[dimansion_length]&#xA;    ,SRC.[dimension_width]&#xA;    ,SRC.[dimension_height]&#xA;    ,SRC.[createdAt]&#xA;    ,SRC.[updatedAt]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Загрузка\загрузка в cont_Card_Characteristic"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3310d429-675c-4425-b058-d1613c79d95e}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в cont_Card_Characteristic"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @id_Account as int&#xA;&#xA;SELECT  @id_Account = id_Account FROM [BUFFER].[Wildberies_cont_Card_Characteristic]&#xA;&#xA;CREATE TABLE #temp&#xA;(&#xA; nmID int&#xA;)&#xA;&#xA;INSERT INTO #temp(nmID)&#xA;SELECT&#xA; [BUF].nmID&#xA;FROM&#xA; (&#xA;  SELECT&#xA;   [nmID],&#xA;   CHECKSUM_AGG(BINARY_CHECKSUM(&#xA;     [nmID]&#xA;     ,[id]&#xA;     ,[name]&#xA;     ,[value]&#xA;     )) [CHECKSUM],&#xA;   COUNT(*) [CNT] &#xA;  FROM&#xA;   [BUFFER].[Wildberies_cont_Card_Characteristic]&#xA;  GROUP BY&#xA;   [nmID]&#xA; ) [BUF]&#xA; LEFT OUTER JOIN (&#xA;  SELECT&#xA;   [nmID],&#xA;   CHECKSUM_AGG(BINARY_CHECKSUM(&#xA;     [nmID]&#xA;     ,[id]&#xA;     ,[name]&#xA;     ,[value]&#xA;     )) [CHECKSUM],&#xA;   COUNT(*) [CNT] &#xA;  FROM&#xA;   [Wildberies].[cont_Card_Characteristic]&#xA;  WHERE&#xA;   id_Account = @id_Account&#xA;  GROUP BY&#xA;   [nmID]&#xA; ) [TGT] ON [BUF].nmID = [TGT].nmID&#xA;WHERE&#xA; ISNULL([BUF].[CHECKSUM],0) &lt;&gt; ISNULL([TGT].[CHECKSUM],0) OR ISNULL([BUF].[CNT],0) &lt;&gt; ISNULL([TGT].[CNT],0)&#xA; &#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; DELETE TGT&#xA; FROM &#xA;  [Wildberies].[cont_Card_Characteristic] [TGT]&#xA; WHERE&#xA;  [TGT].nmID in (SELECT [nmID] FROM #temp)&#xA;  AND [TGT].id_Account = @id_Account&#xA;&#xA; INSERT INTO [Wildberies].[cont_Card_Characteristic]&#xA; (&#xA;  [id_Account]&#xA;  ,[nmID]&#xA;  ,[id]&#xA;  ,[name]&#xA;  ,[value]&#xA;  ,SYSMOMENT&#xA; )&#xA; SELECT&#xA;  @id_Account&#xA;  ,[nmID]&#xA;  ,[id]&#xA;  ,[name]&#xA;  ,[value]&#xA;  ,GETDATE()&#xA; FROM&#xA;  [BUFFER].[Wildberies_cont_Card_Characteristic] [SRC]&#xA; WHERE&#xA;  [SRC].nmID in (SELECT [nmID] FROM #temp)&#xA;  AND EXISTS(SELECT TOP 1 1 FROM [Wildberies].[cont_Card] C WHERE SRC.nmID = C.nmID)&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
