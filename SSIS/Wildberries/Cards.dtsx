    #region  Request
    [Serializable]
    public class Request
    {
        public Request_Settings settings { get; set; }
    }

    public class Request_Settings
    {
        public Request_Settings_Cursor cursor { get; set; }
        public Request_Settings_Filter filter { get; set; }
        public Request_Settings_Sort sort { get; set; }
    }
    public class Request_Settings_Cursor
    {
        public long? nmID { get; set; }
        public string updatedAt { get; set; }
        public int? limit { get; set; }
    }

    public class Request_Settings_Filter
    {
        public string textSearch { get; set; }
        public bool? allowedCategoriesOnly { get; set; }
        string[] tagIDs { get; set; }
        string[] objectIDs { get; set; }
        string[] brands { get; set; }
        int? imtID { get; set; }
        public int? withPhoto { get; set; }
    }

    public class Request_Settings_Sort
    {
        public bool? ascending { get; set; }
    }
    #endregion

    #region Response

    public class Response
    {
        public Response_Card[] cards { get; set; }
        public Response_Cursor cursor { get; set; }
        public bool error { get; set; }
        public string errorText { get; set; }
        public string additionalErrors { get; set; }
    }

    public class Response_Card
    {
        public long nmID { get; set; }
        public long? imtID { get; set; }
        public string nmUUID { get; set; }
        public long? subjectID { get; set; }
        public string vendorCode { get; set; }
        public string subjectName { get; set; }
        public string brand { get; set; }
        public string title { get; set; }
        public Response_Card_Photo[] photos { get; set; }
        public string video { get; set; }
        public Response_Card_Dimension dimensions { get; set; }
        public Response_Card_Characteristic[] characteristics { get; set; }
        public Response_Card_Size[] sizes { get; set; }
        public Response_Card_Tag[] tags { get; set; }
        public DateTime? createdAt { get; set; }
        public DateTime? updatedAt { get; set; }
    }

    public class Response_Card_Photo
    {
        public string big { get; set; }
        public string c246x328 { get; set; }
        public string c516x688 { get; set; }
        public string square { get; set; }
        public string tm { get; set; }
    }

    public class Response_Card_Dimension
    {
        public long? length { get; set; }
        public long? width { get; set; }
        public long? height { get; set; }
    }

