          DTS:DTSID="{1ed9b0fa-ea44-4376-ae64-d5e467f3f05f}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="загрузка в cont_Card_Tag"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @id_Account as int&#xA;&#xA;SELECT  @id_Account = id_Account FROM [BUFFER].[Wildberies_cont_Card_Tag]&#xA;&#xA;CREATE TABLE #temp&#xA;(&#xA; nmID int&#xA;)&#xA;&#xA;INSERT INTO #temp(nmID)&#xA;SELECT&#xA; [BUF].nmID&#xA;FROM&#xA; (&#xA;  SELECT&#xA;   [nmID],&#xA;   CHECKSUM_AGG(BINARY_CHECKSUM(&#xA;     [nmID]&#xA;      ,[id]&#xA;      ,[name]&#xA;      ,[color]&#xA;     )) [CHECKSUM],&#xA;   COUNT(*) [CNT] &#xA;  FROM&#xA;   [BUFFER].[Wildberies_cont_Card_Tag]&#xA;  GROUP BY&#xA;   [nmID]&#xA; ) [BUF]&#xA; LEFT OUTER JOIN (&#xA;  SELECT&#xA;   [nmID],&#xA;   CHECKSUM_AGG(BINARY_CHECKSUM(&#xA;     [nmID]&#xA;      ,[id]&#xA;      ,[name]&#xA;      ,[color]&#xA;     )) [CHECKSUM],&#xA;   COUNT(*) [CNT] &#xA;  FROM&#xA;   [Wildberies].[cont_Card_Tag]&#xA;  WHERE&#xA;   id_Account = @id_Account&#xA;  GROUP BY&#xA;   [nmID]&#xA; ) [TGT] ON [BUF].nmID = [TGT].nmID&#xA;WHERE&#xA; ISNULL([BUF].[CHECKSUM],0) &lt;&gt; ISNULL([TGT].[CHECKSUM],0) OR ISNULL([BUF].[CNT],0) &lt;&gt; ISNULL([TGT].[CNT],0)&#xA; &#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; DELETE TGT&#xA; FROM &#xA;  [Wildberies].[cont_Card_Tag] [TGT]&#xA; WHERE&#xA;  [TGT].nmID in (SELECT [nmID] FROM #temp)&#xA;  AND [TGT].id_Account = @id_Account&#xA;&#xA; INSERT INTO [Wildberies].[cont_Card_Tag]&#xA; (&#xA; [id_Account]&#xA;   ,[nmID]&#xA;      ,[id]&#xA;      ,[name]&#xA;      ,[color]&#xA;  ,SYSMOMENT&#xA; )&#xA; SELECT&#xA; @id_Account&#xA;   ,[nmID]&#xA;      ,[id]&#xA;      ,[name]&#xA;      ,[color]&#xA;    ,GETDATE()&#xA; FROM&#xA; [BUFFER].[Wildberies_cont_Card_Tag] [SRC]&#xA; WHERE&#xA;  [SRC].nmID in (SELECT [nmID] FROM #temp)&#xA;  AND EXISTS(SELECT TOP 1 1 FROM [Wildberies].[cont_Card] C WHERE SRC.nmID = C.nmID)&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
