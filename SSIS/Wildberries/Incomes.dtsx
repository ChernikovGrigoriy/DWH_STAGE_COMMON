          DTS:DTSID="{edad1784-dde0-48cb-b719-9517d90b8001}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Загрузка в стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; MERGE [Wildberies].[stat_Incomes] WITH(TABLOCK) TGT&#xA; USING (&#xA; SELECT&#xA;   HASHBYTES('SHA2_256', &#xA;  ISNULL(CAST([id_Account] as nvarchar(20)),'') + &#xA;  ISNULL(CAST([incomeId] as nvarchar(20)),'') + &#xA;  ISNULL([number],'') + &#xA;  ISNULL(CAST([date] as nvarchar(20)),'') + &#xA;  ISNULL(CAST([lastChangeDate] as nvarchar(20)),'') + &#xA;  ISNULL([supplierArticle],'') + &#xA;  ISNULL([techSize],'') + &#xA;  ISNULL([barcode],'') + &#xA;  ISNULL(CAST([quantity] as nvarchar(20)),'') + &#xA;  ISNULL(CAST([totalPrice] as nvarchar(20)),'') + &#xA;  ISNULL(CAST([dateClose] as nvarchar(20)),'') + &#xA;  ISNULL([warehouseName],'') + &#xA;  ISNULL(CAST([nmId] as nvarchar(20)),'') + &#xA;  ISNULL([status],'') &#xA;  ) [KEY]&#xA;   ,id_Account&#xA;   ,[incomeId]&#xA;      ,[number]&#xA;      ,[date]&#xA;      ,[lastChangeDate]&#xA;      ,[supplierArticle]&#xA;      ,[techSize]&#xA;      ,[barcode]&#xA;      ,[quantity]&#xA;      ,[totalPrice]&#xA;      ,[dateClose]&#xA;      ,[warehouseName]&#xA;      ,[nmId]&#xA;      ,[status]&#xA; FROM&#xA;  [BUFFER].[Wildberies_stat_Incomes]&#xA; ) SRC ON (TGT.[KEY]  = SRC.[KEY])&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA; id_Account&#xA; ,[KEY]&#xA;    ,[incomeId]&#xA;    ,[number]&#xA;    ,[date]&#xA;    ,[lastChangeDate]&#xA;    ,[supplierArticle]&#xA;    ,[techSize]&#xA;    ,[barcode]&#xA;    ,[quantity]&#xA;    ,[totalPrice]&#xA;    ,[dateClose]&#xA;    ,[warehouseName]&#xA;    ,[nmId]&#xA;    ,[status]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA; SRC.id_Account&#xA; ,SRC.[KEY]&#xA;    ,SRC.[incomeId]&#xA;    ,SRC.[number]&#xA;    ,SRC.[date]&#xA;    ,SRC.[lastChangeDate]&#xA;    ,SRC.[supplierArticle]&#xA;    ,SRC.[techSize]&#xA;    ,SRC.[barcode]&#xA;    ,SRC.[quantity]&#xA;    ,SRC.[totalPrice]&#xA;    ,SRC.[dateClose]&#xA;    ,SRC.[warehouseName]&#xA;    ,SRC.[nmId]&#xA;    ,SRC.[status]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
