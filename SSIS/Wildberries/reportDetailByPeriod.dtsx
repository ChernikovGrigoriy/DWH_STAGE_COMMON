            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\загрузка отчета за неделю\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{d362457c-c51a-49df-baad-336efb1bd404}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка в стейджинг"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="DECLARE @YEAR int, @WEEK int, @id_Account int&#xA;&#xA;SELECT @YEAR = ?, @WEEK = ?, @id_Account= ?&#xA;&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; DELETE [Wildberies].[stat_reportDetailByPeriod] WITH(TABLOCKX, HOLDLOCK) WHERE [YEAR] = @YEAR AND [WEEK] = @WEEK AND id_Account = @id_Account&#xA; &#xA; INSERT INTO [Wildberies].[stat_reportDetailByPeriod]&#xA; (&#xA;  id_Account&#xA;   ,[YEAR]&#xA;      ,[WEEK]&#xA;   ,WEEK_DATE_START&#xA;   ,WEEK_DATE_FINISH &#xA;      ,[realizationreport_id]&#xA;      ,[suppliercontract_code]&#xA;      ,[rid]&#xA;      ,[rr_dt]&#xA;      ,[rrd_id]&#xA;      ,[gi_id]&#xA;      ,[subject_name]&#xA;      ,[NM_id]&#xA;      ,[brand_name]&#xA;      ,[sa_name]&#xA;      ,[ts_name]&#xA;      ,[barcode]&#xA;      ,[doc_type_name]&#xA;      ,[quantity]&#xA;      ,[retail_price]&#xA;      ,[retail_amount]&#xA;      ,[sale_percent]&#xA;      ,[commission_percent]&#xA;      ,[office_name]&#xA;      ,[supplier_oper_name]&#xA;      ,[order_dt]&#xA;      ,[sale_dt]&#xA;      ,[shk_id]&#xA;      ,[retail_price_withdisc_rub]&#xA;      ,[delivery_amount]&#xA;      ,[return_amount]&#xA;      ,[delivery_rub]&#xA;      ,[gi_box_type_name]&#xA;      ,[product_discount_for_report]&#xA;      ,[supplier_promo]&#xA;      ,[ppvz_spp_prc]&#xA;      ,[ppvz_kvw_prc_base]&#xA;      ,[ppvz_kvw_prc]&#xA;      ,[ppvz_sales_commission]&#xA;      ,[ppvz_for_pay]&#xA;      ,[ppvz_reward]&#xA;      ,[ppvz_vw]&#xA;      ,[ppvz_vw_nds]&#xA;      ,[ppvz_office_id]&#xA;      ,[ppvz_office_name]&#xA;      ,[ppvz_supplier_id]&#xA;      ,[ppvz_supplier_name]&#xA;      ,[ppvz_inn]&#xA;      ,[declaration_number]&#xA;      ,[bonus_type_name]&#xA;      ,[sticker_id]&#xA;      ,[site_country]&#xA;   ,penalty&#xA;   ,additional_payment&#xA;   ,srid&#xA;   ,create_dt&#xA;      ,[rebill_logistic_cost]&#xA;      ,[rebill_logistic_org]&#xA;      ,[kiz]&#xA;      ,[date_from]&#xA;      ,[date_to]&#xA;      ,[currency_name]&#xA;      ,[sup_rating_prc_up]&#xA;      ,[is_kgvp_v2]&#xA;      ,[acquiring_fee]&#xA;      ,[acquiring_bank]&#xA;   ,storage_fee&#xA;      ,deduction&#xA;      ,acceptance&#xA;      ,report_type&#xA;      ,[SYSMOMENT]&#xA; )&#xA; SELECT&#xA;   @id_Account&#xA;   ,@YEAR&#xA;      ,@WEEK&#xA;   ,WEEK_DATE_START&#xA;   ,WEEK_DATE_FINISH &#xA;      ,[realizationreport_id]&#xA;      ,[suppliercontract_code]&#xA;      ,[rid]&#xA;      ,[rr_dt]&#xA;      ,[rrd_id]&#xA;      ,[gi_id]&#xA;      ,[subject_name]&#xA;      ,[NM_id]&#xA;      ,[brand_name]&#xA;      ,[sa_name]&#xA;      ,[ts_name]&#xA;      ,[barcode]&#xA;      ,[doc_type_name]&#xA;      ,[quantity]&#xA;      ,[retail_price]&#xA;      ,[retail_amount]&#xA;      ,[sale_percent]&#xA;      ,[commission_percent]&#xA;      ,[office_name]&#xA;      ,[supplier_oper_name]&#xA;      ,[order_dt]&#xA;      ,[sale_dt]&#xA;      ,[shk_id]&#xA;      ,[retail_price_withdisc_rub]&#xA;      ,[delivery_amount]&#xA;      ,[return_amount]&#xA;      ,[delivery_rub]&#xA;      ,[gi_box_type_name]&#xA;      ,[product_discount_for_report]&#xA;      ,[supplier_promo]&#xA;      ,[ppvz_spp_prc]&#xA;      ,[ppvz_kvw_prc_base]&#xA;      ,[ppvz_kvw_prc]&#xA;      ,[ppvz_sales_commission]&#xA;      ,[ppvz_for_pay]&#xA;      ,[ppvz_reward]&#xA;      ,[ppvz_vw]&#xA;      ,[ppvz_vw_nds]&#xA;      ,[ppvz_office_id]&#xA;      ,[ppvz_office_name]&#xA;      ,[ppvz_supplier_id]&#xA;      ,[ppvz_supplier_name]&#xA;      ,[ppvz_inn]&#xA;      ,[declaration_number]&#xA;      ,[bonus_type_name]&#xA;      ,[sticker_id]&#xA;      ,[site_country]&#xA;   ,penalty&#xA;   ,additional_payment&#xA;   ,srid&#xA;   ,create_dt&#xA;      ,[rebill_logistic_cost]&#xA;      ,[rebill_logistic_org]&#xA;      ,[kiz]&#xA;   ,[date_from]&#xA;      ,[date_to]&#xA;      ,[currency_name]&#xA;      ,[sup_rating_prc_up]&#xA;      ,[is_kgvp_v2]&#xA;      ,[acquiring_fee]&#xA;      ,[acquiring_bank]&#xA;   ,storage_fee&#xA;      ,deduction&#xA;      ,acceptance&#xA;      ,report_type&#xA;      ,GETDATE()&#xA; FROM&#xA;  [BUFFER].[Wildberies_stat_reportDetailByPeriod]&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
