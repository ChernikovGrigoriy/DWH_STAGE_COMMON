                  SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_stat_reportDetailByPeriod]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_stat_reportDetailByPeriod]&#xA;&#xA;create table [BUFFER].[Wildberies_stat_reportDetailByPeriod] (&#xA; id_account int,&#xA;   WEEK_DATE_START      date                 null,&#xA;   WEEK_DATE_FINISH     date                 null,&#xA;   realizationreport_id bigint               null,&#xA;   suppliercontract_code nvarchar(50)         null,&#xA;   rid                  bigint               null,&#xA;   rr_dt                datetime             null,&#xA;   rrd_id               bigint               null,&#xA;   gi_id                int                  null,&#xA;   subject_name         nvarchar(200)        null,&#xA;   NM_id                int                  null,&#xA;   brand_name           nvarchar(200)        null,&#xA;   sa_name              nvarchar(200)        null,&#xA;   ts_name              nvarchar(200)        null,&#xA;   barcode              nvarchar(50)         null,&#xA;   doc_type_name        nvarchar(200)        null,&#xA;   quantity             int                  null,&#xA;   retail_price         decimal(20,10)       null,&#xA;   retail_amount        decimal(20,10)       null,&#xA;   sale_percent         decimal(20,10)       null,&#xA;   commission_percent   decimal(20,10)       null,&#xA;   office_name          nvarchar(200)        null,&#xA;   supplier_oper_name   nvarchar(200)        null,&#xA;   order_dt             datetime             null,&#xA;   sale_dt              datetime             null,&#xA;   shk_id               bigint               null,&#xA;   retail_price_withdisc_rub decimal(20,10)       null,&#xA;   delivery_amount      decimal(20,10)       null,&#xA;   return_amount        decimal(20,10)       null,&#xA;   delivery_rub         decimal(20,10)       null,&#xA;   gi_box_type_