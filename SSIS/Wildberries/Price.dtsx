        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Загрузка в стейджинг"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{80e6e7ab-8ca8-49fc-93c1-7e29d7d237e1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Загрузка в стейджинг"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
              SQLTask:SqlStatementSource="DECLARE @i int = 1&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA;&#xA; WHILE (@i &lt;= 2)&#xA; BEGIN&#xA;  MERGE [Wildberies].[price_Goods] AS TGT&#xA;  USING [BUFFER].[price_Goods] SRC&#xA;  ON (&#xA;   SRC.[id_Account] = TGT.[id_Account]&#xA;   AND SRC.[nmID] = TGT.[nmID]&#xA;   AND SRC.[sizeID] = TGT.[sizeID]&#xA;   AND TGT.[DATE_FINISH] = '22000101'&#xA;   )&#xA;  WHEN MATCHED AND&#xA;   CHECKSUM(&#xA;    SRC.[vendorCode],&#xA;    SRC.[price],&#xA;    SRC.[discountedPrice],&#xA;    SRC.[techSizeName],&#xA;    SRC.[currencyIsoCode4217],&#xA;    SRC.[discount],&#xA;    SRC.[editableSizePrice]&#xA;   ) &lt;&gt; &#xA;   CHECKSUM(&#xA;    TGT.[vendorCode],&#xA;    TGT.[price],&#xA;    TGT.[discountedPrice],&#xA;    TGT.[techSizeName],&#xA;    TGT.[currencyIsoCode4217],&#xA;    TGT.[discount],&#xA;    TGT.[editableSizePrice]&#xA;   )&#xA;   AND TGT.DATE_START &lt;&gt; CAST( GETDATE() as date )&#xA;  THEN&#xA;    UPDATE SET &#xA;     [DATE_FINISH]  = DATEADD(day, -1, CAST( GETDATE() as date)),&#xA;     SYSMOMENT = GETDATE()&#xA;  WHEN NOT MATCHED&#xA;   THEN&#xA;    INSERT &#xA;    (&#xA;      [id_Account]&#xA;      ,[nmID]&#xA;      ,[sizeID]&#xA;      ,[DATE_START]&#xA;      ,[DATE_FINISH]&#xA;      ,[vendorCode]&#xA;      ,[price]&#xA;      ,[discountedPrice]&#xA;      ,[techSizeName]&#xA;      ,[currencyIsoCode4217]&#xA;      ,[discount]&#xA;      ,[editableSizePrice]&#xA;      ,[SYSMOMENT]&#xA;    )&#xA;    VALUES &#xA;    (&#xA;      SRC.[id_Account]&#xA;      ,SRC.[nmID]&#xA;      ,SRC.[sizeID]&#xA;      ,CAST(GETDATE() as date)&#xA;      ,'22000101'&#xA;      ,SRC.[vendorCode]&#xA;      ,SRC.[price]&#xA;      ,SRC.[discountedPrice]&#xA;      ,SRC.[techSizeName]&#xA;      ,SRC.[currencyIsoCode4217]&#xA;      ,SRC.[discount]&#xA;      ,SRC.[editableSizePrice]&#xA;      ,GETDATE()&#xA;    );&#xA;&#xA;   SET @i = @i +1&#xA;  END&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
