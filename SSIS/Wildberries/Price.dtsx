              SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[price_Goods]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[price_Goods]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[price_Goods] FROM [Wildberies].[price_Goods]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
