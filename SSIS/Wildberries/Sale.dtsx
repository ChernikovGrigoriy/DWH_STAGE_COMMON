                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].Wildberies_stat_Sales')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].Wildberies_stat_Sales&#xA;&#xA;create table [BUFFER].Wildberies_stat_Sales (&#xA; id_account int,&#xA; [Date] datetime,&#xA; lastChangeDate datetime,&#xA; supplierArticle nvarchar(100),&#xA; techSize nvarchar(50),&#xA; barcode nvarchar(50),&#xA; quantity int,&#xA; totalPrice decimal(20,10),&#xA; discountPercent decimal(20,10),&#xA; isSupply bit,&#xA; isRealization bit,&#xA; orderId bigint,&#xA; promoCodeDiscount int,&#xA; warehouseName nvarchar(100),&#xA; countryName nvarchar(100),&#xA; oblastOkrugName nvarchar(100),&#xA; regionName nvarchar(100),&#xA; incomeID int,&#xA; saleID nvarchar(50),&#xA; odid bigint,&#xA; spp decimal(20,10),&#xA; forpay decimal(20,10),&#xA; finished_price decimal(20,10),&#xA; pricewithdisc decimal(20,10),&#xA; nmId bigint,&#xA; subject nvarchar(100),&#xA; category nvarchar(100),&#xA; brand nvarchar(100),&#xA; IsStorno bit,&#xA; gNumber nvarchar(50),&#xA; srid                 nvarchar(200),&#xA; paymentSaleAmount decimal(20,10),&#xA; sticker nvarchar(50),&#xA;[orderType] nvarchar(50)&#xA;)&#xA;on [BUFFER]&#xA;with (data_compression = page)&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
