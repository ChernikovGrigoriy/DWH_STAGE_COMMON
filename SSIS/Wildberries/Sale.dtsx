                if (oSale.gNumber != null && oSale.gNumber.Length > 0) OutputBuffer.gNumber = oSale.gNumber;
                if (oSale.srid != null && oSale.srid.Length > 0) OutputBuffer.srid = oSale.srid.Length > 200 ? oSale.srid.Substring(0,200) : oSale.srid;
                if (oSale.sticker != null && oSale.sticker.Length > 0) OutputBuffer.sticker = oSale.sticker;
