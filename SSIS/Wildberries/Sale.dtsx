            <DTS:Executable
              DTS:refId="Package\Foreach Loop Container\Sale\Загрузка в стейджинг"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{70a21d20-3a54-486b-bec7-3e7af87037d9}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка в стейджинг"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="DECLARE @Date as date, @id_Account int&#xA;&#xA;SELECT @Date = ?, @id_Account = ?&#xA;&#xA;BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; DELETE [Wildberies].[stat_Sales] WHERE [Date] &gt;= @Date AND [Date] &lt; DATEADD(day, 1, @Date) AND id_Account = @id_Account&#xA;&#xA; INSERT INTO [Wildberies].[stat_Sales]&#xA; (&#xA;      [id_Account]&#xA;   ,[Date]&#xA;      ,[lastChangeDate]&#xA;      ,[supplierArticle]&#xA;      ,[techSize]&#xA;      ,[barcode]&#xA;      ,[quantity]&#xA;      ,[totalPrice]&#xA;      ,[discountPercent]&#xA;      ,[isSupply]&#xA;      ,[isRealization]&#xA;      ,[orderId]&#xA;      ,[promoCodeDiscount]&#xA;      ,[warehouseName]&#xA;      ,[countryName]&#xA;      ,[oblastOkrugName]&#xA;      ,[regionName]&#xA;      ,[incomeID]&#xA;      ,[saleID]&#xA;      ,[odid]&#xA;      ,[spp]&#xA;      ,[forpay]&#xA;      ,[finished_price]&#xA;      ,[pricewithdisc]&#xA;      ,[nmId]&#xA;      ,[subject]&#xA;      ,[category]&#xA;      ,[brand]&#xA;      ,[IsStorno]&#xA;      ,[gNumber]&#xA;      ,[SYSMOMENT]&#xA;      ,[srid]&#xA;   ,[paymentSaleAmount]&#xA;   ,[sticker]&#xA;   ,[orderType]&#xA; )&#xA; SELECT &#xA;   @id_Account&#xA;   ,[Date]&#xA;      ,[lastChangeDate]&#xA;      ,[supplierArticle]&#xA;      ,[techSize]&#xA;      ,[barcode]&#xA;      ,[quantity]&#xA;      ,[totalPrice]&#xA;      ,[discountPercent]&#xA;      ,[isSupply]&#xA;      ,[isRealization]&#xA;      ,[orderId]&#xA;      ,[promoCodeDiscount]&#xA;      ,[warehouseName]&#xA;      ,[countryName]&#xA;      ,[oblastOkrugName]&#xA;      ,[regionName]&#xA;      ,[incomeID]&#xA;      ,[saleID]&#xA;      ,[odid]&#xA;      ,[spp]&#xA;      ,[forpay]&#xA;      ,[finished_price]&#xA;      ,[pricewithdisc]&#xA;      ,[nmId]&#xA;      ,[subject]&#xA;      ,[category]&#xA;      ,[brand]&#xA;      ,[IsStorno]&#xA;      ,[gNumber]&#xA;      ,GETDATE()&#xA;      ,[srid]&#xA;   ,[paymentSaleAmount]&#xA;   ,[sticker]&#xA;   ,[orderType]&#xA;  FROM [BUFFER].[Wildberies_stat_Sales]&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::vDateSale"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="7"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="1"
                    SQLTask:DtsVariableName="User::vID_Account"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="20"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
