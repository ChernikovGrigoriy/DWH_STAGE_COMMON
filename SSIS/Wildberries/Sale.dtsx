                if (oSale.finishedPrice != null) OutputBuffer.finishedprice = (decimal)oSale.finishedPrice;
                if (oSale.pricewithdisc != null) OutputBuffer.pricewithdisc = (decimal)oSale.pricewithdisc;
                if (oSale.nmId != null) OutputBuffer.nmId = (int)oSale.nmId;
