                if (oSale.promoCodeDiscount != null) OutputBuffer.promoCodeDiscount = (int)oSale.promoCodeDiscount;
                if (oSale.warehouseName != null && oSale.warehouseName.Length > 0) OutputBuffer.warehouseName = oSale.warehouseName;
                if (oSale.countryName != null && oSale.countryName.Length > 0) OutputBuffer.countryName = oSale.countryName;
                if (oSale.oblastOkrugName != null && oSale.oblastOkrugName.Length > 0) OutputBuffer.oblastOkrugName = oSale.oblastOkrugName;
                if (oSale.regionName != null && oSale.regionName.Length > 0) OutputBuffer.regionName = oSale.regionName;
                if (oSale.incomeID != null) OutputBuffer.incomeID = (int)oSale.incomeID;
                if (oSale.saleID != null && oSale.saleID.Length > 0) OutputBuffer.saleID = oSale.saleID;
                if (oSale.odid != null) OutputBuffer.odid = (int)oSale.odid;
                if (oSale.spp != null) OutputBuffer.spp = (decimal)oSale.spp;
