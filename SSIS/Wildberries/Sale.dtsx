    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        try
        {
            byte[] oDATA = null;


            WildberriesWebClient oWWC = new WildberriesWebClient(60000, 15, 26000);

            oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://statistics-api.wildberries.ru/api/v1/supplier/sales?dateFrom={0:yyyy-MM-dd}&flag=1", Variables.vDateSale), string.Format("Bearer {0}", Variables.vKeyStatistic));

            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            List<Sale> oSales = oJSS.Deserialize<List<Sale>>(Encoding.UTF8.GetString(oDATA));

