              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CE8F9A80-A998-4424-9C87-6C5E058DD44D}"
                  SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[Wildberies_stat_Orders]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[Wildberies_stat_Orders]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[Wildberies_stat_Orders] FROM [Wildberies].[stat_Orders]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
