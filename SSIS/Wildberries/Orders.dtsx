    #region Шаблон
    [Serializable]
    private class Order
    {
        public DateTime? date { get; set; }
        public DateTime lastChangeDate { get; set; }
        public string supplierArticle { get; set; }
        public string techSize { get; set; }
        public string barcode { get; set; }
        public int? quantity { get; set; }
        public decimal? totalPrice { get; set; }
        public decimal? discountPercent { get; set; }
        public string warehouseName { get; set; }
        public string warehouseType { get; set; }
        public string oblast { get; set; }
        public long? incomeID { get; set; }
        public long? odid { get; set; }
        public long? nmId { get; set; }
        public string subject { get; set; }
        public string category { get; set; }
        public string brand { get; set; }
        public bool? isCancel { get; set; }
        public DateTime? cancel_dt { get; set; }
        public string gNumber { get; set; }
        public string sticker { get; set; }
        public string srid { get; set; }
        public string countryName { get; set; }
        public string oblastOkrugName { get; set; }
        public string regionName { get; set; }
        public bool? isSupply { get; set; }
        public bool? isRealization { get; set; }
        public int? spp { get; set; }
        public decimal? finishedPrice { get; set; }
        public decimal? priceWithDisc { get; set; }
        public DateTime? cancelDate { get; set; }
        public string orderType { get; set; }
    }
    #endregion


    private string Substr(string Value, int length)
    {
        return Value.Length > length ? Value.Substring(1, length) : Value;
    }
    /// <summary>
