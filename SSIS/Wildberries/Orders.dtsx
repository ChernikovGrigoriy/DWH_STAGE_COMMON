    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

        string vErrorStr = "";

        try
        {
            byte[] oDATA = null;

            WildberriesWebClient oWWC = new WildberriesWebClient(60000, 7, 26000);

            oDATA = oWWC.SendRequestWithRateLimit(String.Format("https://statistics-api.wildberries.ru/api/v1/supplier/orders?dateFrom={0:yyyy-MM-dd}&flag=1", Variables.vDateFrom), string.Format("Bearer {0}", Variables.vKeyStatistic));

            vErrorStr = string.Format("Парсинг за дату {0}",Variables.vDateFrom);
            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            List<Order> oOrders = oJSS.Deserialize<List<Order>>(Encoding.UTF8.GetString(oDATA));

            foreach (Order oItem in oOrders)
            {
                OutputBuffer.AddRow();
                OutputBuffer.idAccount = Variables.vIDAccount;
                vErrorStr = "Поле date";
                if (oItem.date != null) OutputBuffer.date = (DateTime)oItem.date;
                vErrorStr = "Поле lastChangeDate";
                if (oItem.lastChangeDate != null) OutputBuffer.lastChangeDate = (DateTime)oItem.lastChangeDate;
                vErrorStr = "Поле supplierArticle";
                if (oItem.supplierArticle != null && oItem.supplierArticle.Length > 0) OutputBuffer.supplierArticle = Substr(oItem.supplierArticle, 50);
                vErrorStr = "Поле techSize";
                if (oItem.techSize != null && oItem.techSize.Length > 0) OutputBuffer.techSize = Substr(oItem.techSize, 50);
                vErrorStr = "Поле barcode";
                if (oItem.barcode != null && oItem.barcode.Length > 0) OutputBuffer.barcode = Substr(oItem.barcode, 50);
                vErrorStr = "Поле quantity";
                if (oItem.quantity != null) OutputBuffer.quantity = (int)oItem.quantity;
                vErrorStr = "Поле totalPrice";
                if (oItem.totalPrice != null) OutputBuffer.totalPrice = (decimal)oItem.totalPrice;
                vErrorStr = "Поле discountPercent";
                if (oItem.discountPercent != null) OutputBuffer.discountPercent = (decimal)oItem.discountPercent;
                vErrorStr = "Поле warehouseName";
                if (oItem.warehouseName != null && oItem.warehouseName.Length > 0) OutputBuffer.warehouseName = Substr(oItem.warehouseName, 100);
                vErrorStr = "Поле warehouseType";
                if (oItem.warehouseType != null && oItem.warehouseType.Length > 0) OutputBuffer.warehouseType = Substr(oItem.warehouseType, 200);
                vErrorStr = "Поле oblast";
                if (oItem.oblast != null && oItem.oblast.Length > 0) OutputBuffer.oblast = Substr(oItem.oblast, 100);
                vErrorStr = "Поле incomeID";
                if (oItem.incomeID != null) OutputBuffer.incomeID = (long)oItem.incomeID;
                vErrorStr = "Поле odid ";
                if (oItem.odid != null) OutputBuffer.odid = (long)oItem.odid;
                vErrorStr = "Поле nmId";
                if (oItem.nmId != null) OutputBuffer.nmId = (long)oItem.nmId;
                vErrorStr = "Поле subject";
                if (oItem.subject != null && oItem.subject.Length > 0) OutputBuffer.subject = Substr(oItem.subject, 100);
                vErrorStr = "Поле category";
                if (oItem.category != null && oItem.category.Length > 0) OutputBuffer.category = Substr(oItem.category, 100);
                vErrorStr = "Поле brand";
                if (oItem.brand != null && oItem.brand.Length > 0) OutputBuffer.brand = Substr(oItem.brand, 100);
                vErrorStr = "Поле isCancel";
                if (oItem.isCancel != null) OutputBuffer.isCancel = (bool)oItem.isCancel;
                vErrorStr = "Поле canceldt";
                if (oItem.cancel_dt != null) OutputBuffer.canceldt = (DateTime)oItem.cancel_dt;
                vErrorStr = "Поле gNumber";
                if (oItem.gNumber != null && oItem.gNumber.Length > 0) OutputBuffer.gNumber = Substr(oItem.gNumber, 50);
                vErrorStr = "Поле sticker";
                if (oItem.sticker != null && oItem.sticker.Length > 0) OutputBuffer.sticker = Substr(oItem.sticker, 200);
                vErrorStr = "Поле srid";
                if (oItem.srid != null && oItem.srid.Length > 0) OutputBuffer.srid = Substr(oItem.srid, 200);
                vErrorStr = "Поле countryName";
                if (oItem.countryName != null && oItem.countryName.Length > 0) OutputBuffer.countryName = Substr(oItem.countryName, 100);
                vErrorStr = "Поле oblastOkrugName";
