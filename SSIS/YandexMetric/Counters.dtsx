    public override void CreateNewOutputRows()
    {
        byte[] oDATA = null;

        string vError = null;

        try
        {
            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                    string vURL = String.Format("https://api-metrika.yandex.net/management/v1/counters");
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("OAuth {0}", Variables.pToken));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests"))
                    {
                        Thread.Sleep(20000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Слишком большое количество обращений к серверу YandexMetrica");

            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

            foreach(Response_Counter item in oResponse.counters)
            {
                OutputBuffer.AddRow();
                OutputBuffer.id = item.id;
                if (item.status != null && item.status.Length > 0) OutputBuffer.status = item.status.Length > 100 ? item.status.Substring(0, 100) : item.status;
                if (item.owner_login != null && item.owner_login.Length > 0) OutputBuffer.ownerlogin = item.owner_login.Length > 100 ? item.owner_login.Substring(0, 100) : item.owner_login;
                if (item.code_status != null && item.code_status.Length > 0) OutputBuffer.codestatus = item.code_status.Length > 100 ? item.code_status.Substring(0, 100) : item.code_status;
                if (item.activity_status != null && item.activity_status.Length > 0) OutputBuffer.activitystatus = item.activity_status.Length > 100 ? item.activity_status.Substring(0, 100) : item.activity_status;
                if (item.name != null && item.name.Length > 0) OutputBuffer.name = item.name.Length > 100 ? item.name.Substring(0, 100) : item.name;
                if (item.type != null && item.type.Length > 0) OutputBuffer.type = item.type.Length > 100 ? item.type.Substring(0, 100) : item.type;
                if (item.favorite != null) OutputBuffer.favorite = (int) item.favorite;
                if (item.hide_address != null) OutputBuffer.hideaddress = (int)item.hide_address;
                if (item.pro != null) OutputBuffer.pro = (int)item.pro;
                if (item.permission != null && item.permission.Length > 0) OutputBuffer.permission = item.permission.Length > 100 ? item.permission.Substring(0, 100) : item.permission;
                if (item.webvisor != null)
                {
                    if (item.webvisor.urls != null && item.webvisor.urls.Length > 0) OutputBuffer.webvisorurls = item.webvisor.urls.Length > 100 ? item.webvisor.urls.Substring(0, 100) : item.webvisor.urls;
                    if (item.webvisor.arch_enabled != null) OutputBuffer.webvisorarchenabled = (int)item.webvisor.arch_enabled;
                    if (item.webvisor.arch_type != null && item.webvisor.arch_type.Length > 0) OutputBuffer.webvisorarchtype = item.webvisor.arch_type.Length > 100 ? item.webvisor.arch_type.Substring(0, 100) : item.webvisor.arch_type;
                    if (item.webvisor.load_player_type != null && item.webvisor.load_player_type.Length > 0) OutputBuffer.webvisorloadplayertype = item.webvisor.load_player_type.Length > 100 ? item.webvisor.load_player_type.Substring(0, 100) : item.webvisor.load_player_type;
                    if (item.webvisor.wv_version != null) OutputBuffer.webvisorwvversion = (int)item.webvisor.wv_version;
                    if (item.webvisor.allow_wv2 != null) OutputBuffer.webvisorallowwv2 = (bool)item.webvisor.allow_wv2;
                    if (item.webvisor.wv_forms != null) OutputBuffer.webvisorwvforms = (int)item.webvisor.wv_forms;
                }
                if (item.code_options != null)
                {
                    if (item.code_options.async != null) OutputBuffer.codeoptionsasync = (int)item.code_options.async;
                    if (item.code_options.informer != null)
                    {
                        if (item.code_options.informer.enabled != null) OutputBuffer.codeoptionsinformerenabled = (int)item.code_options.informer.enabled;
                        if (item.code_options.informer.type != null && item.code_options.informer.type.Length > 0) OutputBuffer.codeoptionsinformertype = item.code_options.informer.type.Length > 100 ? item.code_options.informer.type.Substring(0, 100) : item.code_options.informer.type;
                        if (item.code_options.informer.size != null) OutputBuffer.codeoptionsinformersize = (int)item.code_options.informer.size;
                        if (item.code_options.informer.indicator != null && item.code_options.informer.indicator.Length > 0) OutputBuffer.codeoptionsinformerindicator = item.code_options.informer.indicator.Length > 100 ? item.code_options.informer.indicator.Substring(0, 100) : item.code_options.informer.indicator;
