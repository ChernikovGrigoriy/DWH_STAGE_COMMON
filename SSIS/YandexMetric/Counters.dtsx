                    if (item.code_options.alternative_cdn != null) OutputBuffer.codeoptionsalternativecdn = (int)item.code_options.alternative_cdn;
                    if (item.code_options.ecommerce_object != null && item.code_options.ecommerce_object.Length > 0) OutputBuffer.codeoptionsecommerceobject = item.code_options.ecommerce_object.Length > 100 ? item.code_options.ecommerce_object.Substring(0, 100) : item.code_options.ecommerce_object;
