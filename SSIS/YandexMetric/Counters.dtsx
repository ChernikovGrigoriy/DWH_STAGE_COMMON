    <DTS:Executable
      DTS:refId="Package\Создание буфера"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{dead0e96-3489-42ae-87cd-44c264b58ca9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Создание буфера"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA4A1DC9-22A3-4932-A092-D2CDF0854EFF}"
          SQLTask:SqlStatementSource="if exists (select 1&#xA;            from  sysobjects&#xA;           where  id = object_id('[BUFFER].[YandexMetric_Counters]')&#xA;            and   type = 'U')&#xA;   drop table [BUFFER].[YandexMetric_Counters]&#xA;&#xA;SELECT TOP 0 * INTO [BUFFER].[YandexMetric_Counters] FROM [YandexMetric].[Counters]&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Стейджинг"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3715d6a8-faf7-4e5e-80e1-96f24ef8a555}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Стейджинг"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA4A1DC9-22A3-4932-A092-D2CDF0854EFF}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;  &#xA;  &#xA;BEGIN TRY  &#xA; MERGE [YandexMetric].[Counters] WITH(TABLOCK) TGT&#xA; USING [BUFFER].[YandexMetric_Counters] SRC ON (TGT.[id] = SRC.[id])&#xA; WHEN MATCHED AND &#xA; CHECKSUM&#xA; (&#xA;   SRC.[status]&#xA;      ,SRC.[owner_login]&#xA;      ,SRC.[code_status]&#xA;      ,SRC.[activity_status]&#xA;      ,SRC.[name]&#xA;      ,SRC.[type]&#xA;      ,SRC.[favorite]&#xA;      ,SRC.[hide_address]&#xA;      ,SRC.[pro]&#xA;      ,SRC.[permission]&#xA;      ,SRC.[webvisor_urls]&#xA;      ,SRC.[webvisor_arch_enabled]&#xA;      ,SRC.[webvisor_arch_type]&#xA;      ,SRC.[webvisor_load_player_type]&#xA;      ,SRC.[webvisor_wv_version]&#xA;      ,SRC.[webvisor_allow_wv2]&#xA;      ,SRC.[webvisor_wv_forms]&#xA;      ,SRC.[code_options_async]&#xA;      ,SRC.[code_options_informer_enabled]&#xA;      ,SRC.[code_options_informer_type]&#xA;      ,SRC.[code_options_informer_size]&#xA;      ,SRC.[code_options_informer_indicator]&#xA;      ,SRC.[code_options_informer_color_start]&#xA;      ,SRC.[code_options_informer_color_end]&#xA;      ,SRC.[code_options_informer_color_text]&#xA;      ,SRC.[code_options_informer_color_arrow]&#xA;      ,SRC.[code_options_visor]&#xA;      ,SRC.[code_options_track_hash]&#xA;      ,SRC.[code_options_xml_site]&#xA;      ,SRC.[code_options_clickmap]&#xA;      ,SRC.[code_options_in_one_line]&#xA;      ,SRC.[code_options_ecommerce]&#xA;      ,SRC.[code_options_alternative_cdn]&#xA;      ,SRC.[code_options_ecommerce_object]&#xA;      ,SRC.[code_options_ytm]&#xA;      ,SRC.[create_time]&#xA;      ,SRC.[time_zone_name]&#xA;      ,SRC.[time_zone_offset]&#xA;      ,SRC.[partner_id]&#xA;      ,SRC.[site]&#xA;      ,SRC.[site2_site]&#xA;      ,SRC.[site2_domain]&#xA;      ,SRC.[gdpr_agreement_accepted]&#xA; ) &lt;&gt;&#xA; CHECKSUM&#xA; (&#xA;   TGT.[status]&#xA;      ,TGT.[owner_login]&#xA;      ,TGT.[code_status]&#xA;      ,TGT.[activity_status]&#xA;      ,TGT.[name]&#xA;      ,TGT.[type]&#xA;      ,TGT.[favorite]&#xA;      ,TGT.[hide_address]&#xA;      ,TGT.[pro]&#xA;      ,TGT.[permission]&#xA;      ,TGT.[webvisor_urls]&#xA;      ,TGT.[webvisor_arch_enabled]&#xA;      ,TGT.[webvisor_arch_type]&#xA;      ,TGT.[webvisor_load_player_type]&#xA;      ,TGT.[webvisor_wv_version]&#xA;      ,TGT.[webvisor_allow_wv2]&#xA;      ,TGT.[webvisor_wv_forms]&#xA;      ,TGT.[code_options_async]&#xA;      ,TGT.[code_options_informer_enabled]&#xA;      ,TGT.[code_options_informer_type]&#xA;      ,TGT.[code_options_informer_size]&#xA;      ,TGT.[code_options_informer_indicator]&#xA;      ,TGT.[code_options_informer_color_start]&#xA;      ,TGT.[code_options_informer_color_end]&#xA;      ,TGT.[code_options_informer_color_text]&#xA;      ,TGT.[code_options_informer_color_arrow]&#xA;      ,TGT.[code_options_visor]&#xA;      ,TGT.[code_options_track_hash]&#xA;      ,TGT.[code_options_xml_site]&#xA;      ,TGT.[code_options_clickmap]&#xA;      ,TGT.[code_options_in_one_line]&#xA;      ,TGT.[code_options_ecommerce]&#xA;      ,TGT.[code_options_alternative_cdn]&#xA;      ,TGT.[code_options_ecommerce_object]&#xA;      ,TGT.[code_options_ytm]&#xA;      ,TGT.[create_time]&#xA;      ,TGT.[time_zone_name]&#xA;      ,TGT.[time_zone_offset]&#xA;      ,TGT.[partner_id]&#xA;      ,TGT.[site]&#xA;      ,TGT.[site2_site]&#xA;      ,TGT.[site2_domain]&#xA;      ,TGT.[gdpr_agreement_accepted]&#xA; ) THEN&#xA; UPDATE SET&#xA;   [status] = SRC.[status]&#xA;      ,[owner_login] = SRC.[owner_login]&#xA;      ,[code_status] = SRC.[code_status]&#xA;      ,[activity_status] = SRC.[activity_status]&#xA;      ,[name] = SRC.[name]&#xA;      ,[type] = SRC.[type]&#xA;      ,[favorite] = SRC.[favorite]&#xA;      ,[hide_address] = SRC.[hide_address]&#xA;      ,[pro] = SRC.[pro]&#xA;      ,[permission] = SRC.[permission]&#xA;      ,[webvisor_urls] = SRC.[webvisor_urls]&#xA;      ,[webvisor_arch_enabled] = SRC.[webvisor_arch_enabled]&#xA;      ,[webvisor_arch_type] = SRC.[webvisor_arch_type]&#xA;      ,[webvisor_load_player_type] = SRC.[webvisor_load_player_type]&#xA;      ,[webvisor_wv_version] = SRC.[webvisor_wv_version]&#xA;      ,[webvisor_allow_wv2] = SRC.[webvisor_allow_wv2]&#xA;      ,[webvisor_wv_forms] = SRC.[webvisor_wv_forms]&#xA;      ,[code_options_async] = SRC.[code_options_async]&#xA;      ,[code_options_informer_enabled] = SRC.[code_options_informer_enabled]&#xA;      ,[code_options_informer_type] = SRC.[code_options_informer_type]&#xA;      ,[code_options_informer_size] = SRC.[code_options_informer_size]&#xA;      ,[code_options_informer_indicator] = SRC.[code_options_informer_indicator]&#xA;      ,[code_options_informer_color_start] = SRC.[code_options_informer_color_start]&#xA;      ,[code_options_informer_color_end] = SRC.[code_options_informer_color_end]&#xA;      ,[code_options_informer_color_text] = SRC.[code_options_informer_color_text]&#xA;      ,[code_options_informer_color_arrow] = SRC.[code_options_informer_color_arrow]&#xA;      ,[code_options_visor] = SRC.[code_options_visor]&#xA;      ,[code_options_track_hash] = SRC.[code_options_track_hash]&#xA;      ,[code_options_xml_site] = SRC.[code_options_xml_site]&#xA;      ,[code_options_clickmap] = SRC.[code_options_clickmap]&#xA;      ,[code_options_in_one_line] = SRC.[code_options_in_one_line]&#xA;      ,[code_options_ecommerce] = SRC.[code_options_ecommerce]&#xA;      ,[code_options_alternative_cdn] = SRC.[code_options_alternative_cdn]&#xA;      ,[code_options_ecommerce_object] = SRC.[code_options_ecommerce_object]&#xA;      ,[code_options_ytm] = SRC.[code_options_ytm]&#xA;      ,[create_time] = SRC.[create_time]&#xA;      ,[time_zone_name] = SRC.[time_zone_name]&#xA;      ,[time_zone_offset] = SRC.[time_zone_offset]&#xA;      ,[partner_id] = SRC.[partner_id]&#xA;      ,[site] = SRC.[site]&#xA;      ,[site2_site] = SRC.[site2_site]&#xA;      ,[site2_domain] = SRC.[site2_domain]&#xA;      ,[gdpr_agreement_accepted] = SRC.[gdpr_agreement_accepted]&#xA;   ,SYSMOMENT = GETDATE()&#xA; WHEN NOT MATCHED THEN&#xA;  INSERT (&#xA; [id]&#xA;    ,[status]&#xA;    ,[owner_login]&#xA;    ,[code_status]&#xA;    ,[activity_status]&#xA;    ,[name]&#xA;    ,[type]&#xA;    ,[favorite]&#xA;    ,[hide_address]&#xA;    ,[pro]&#xA;    ,[permission]&#xA;    ,[webvisor_urls]&#xA;    ,[webvisor_arch_enabled]&#xA;    ,[webvisor_arch_type]&#xA;    ,[webvisor_load_player_type]&#xA;    ,[webvisor_wv_version]&#xA;    ,[webvisor_allow_wv2]&#xA;    ,[webvisor_wv_forms]&#xA;    ,[code_options_async]&#xA;    ,[code_options_informer_enabled]&#xA;    ,[code_options_informer_type]&#xA;    ,[code_options_informer_size]&#xA;    ,[code_options_informer_indicator]&#xA;    ,[code_options_informer_color_start]&#xA;    ,[code_options_informer_color_end]&#xA;    ,[code_options_informer_color_text]&#xA;    ,[code_options_informer_color_arrow]&#xA;    ,[code_options_visor]&#xA;    ,[code_options_track_hash]&#xA;    ,[code_options_xml_site]&#xA;    ,[code_options_clickmap]&#xA;    ,[code_options_in_one_line]&#xA;    ,[code_options_ecommerce]&#xA;    ,[code_options_alternative_cdn]&#xA;    ,[code_options_ecommerce_object]&#xA;    ,[code_options_ytm]&#xA;    ,[create_time]&#xA;    ,[time_zone_name]&#xA;    ,[time_zone_offset]&#xA;    ,[partner_id]&#xA;    ,[site]&#xA;    ,[site2_site]&#xA;    ,[site2_domain]&#xA;    ,[gdpr_agreement_accepted]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  VALUES (&#xA; SRC.[id]&#xA;    ,SRC.[status]&#xA;    ,SRC.[owner_login]&#xA;    ,SRC.[code_status]&#xA;    ,SRC.[activity_status]&#xA;    ,SRC.[name]&#xA;    ,SRC.[type]&#xA;    ,SRC.[favorite]&#xA;    ,SRC.[hide_address]&#xA;    ,SRC.[pro]&#xA;    ,SRC.[permission]&#xA;    ,SRC.[webvisor_urls]&#xA;    ,SRC.[webvisor_arch_enabled]&#xA;    ,SRC.[webvisor_arch_type]&#xA;    ,SRC.[webvisor_load_player_type]&#xA;    ,SRC.[webvisor_wv_version]&#xA;    ,SRC.[webvisor_allow_wv2]&#xA;    ,SRC.[webvisor_wv_forms]&#xA;    ,SRC.[code_options_async]&#xA;    ,SRC.[code_options_informer_enabled]&#xA;    ,SRC.[code_options_informer_type]&#xA;    ,SRC.[code_options_informer_size]&#xA;    ,SRC.[code_options_informer_indicator]&#xA;    ,SRC.[code_options_informer_color_start]&#xA;    ,SRC.[code_options_informer_color_end]&#xA;    ,SRC.[code_options_informer_color_text]&#xA;    ,SRC.[code_options_informer_color_arrow]&#xA;    ,SRC.[code_options_visor]&#xA;    ,SRC.[code_options_track_hash]&#xA;    ,SRC.[code_options_xml_site]&#xA;    ,SRC.[code_options_clickmap]&#xA;    ,SRC.[code_options_in_one_line]&#xA;    ,SRC.[code_options_ecommerce]&#xA;    ,SRC.[code_options_alternative_cdn]&#xA;    ,SRC.[code_options_ecommerce_object]&#xA;    ,SRC.[code_options_ytm]&#xA;    ,SRC.[create_time]&#xA;    ,SRC.[time_zone_name]&#xA;    ,SRC.[time_zone_offset]&#xA;    ,SRC.[partner_id]&#xA;    ,SRC.[site]&#xA;    ,SRC.[site2_site]&#xA;    ,SRC.[site2_domain]&#xA;    ,SRC.[gdpr_agreement_accepted]&#xA;    ,GETDATE()&#xA;  );&#xA;&#xA;END TRY  &#xA;BEGIN CATCH  &#xA;    DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;    DECLARE @ErrorSeverity INT;  &#xA;    DECLARE @ErrorState INT;  &#xA;  &#xA;    SELECT   &#xA;        @ErrorMessage = ERROR_MESSAGE(),  &#xA;        @ErrorSeverity = ERROR_SEVERITY(),  &#xA;        @ErrorState = ERROR_STATE();  &#xA;  &#xA;    IF @@TRANCOUNT &gt; 0  &#xA;        ROLLBACK TRANSACTION;  &#xA;&#xA;    RAISERROR (@ErrorMessage, -- Message text.  &#xA;               @ErrorSeverity, -- Severity.  &#xA;               @ErrorState -- State.  &#xA;               ); &#xA; &#xA;END CATCH;  &#xA;  &#xA;IF @@TRANCOUNT &gt; 0  &#xA;    COMMIT TRANSACTION;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
