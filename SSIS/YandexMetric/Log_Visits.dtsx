                  SQLTask:SqlStatementSource="CREATE TABLE #Change&#xA;(&#xA; [id] bigint,&#xA; [Date] date&#xA;)&#xA;&#xA;SELECT &#xA; LV0.[id]&#xA;    ,LV0.[ym:s:visitID]&#xA;    ,LV0.[Date]&#xA;    ,LV0.[ym:s:watchIDs]&#xA;    ,LV0.[ym:s:dateTimeUTC]&#xA;    ,LV0.[ym:s:isNewUser]&#xA;    ,LV0.[ym:s:startURL]&#xA;    ,LV0.[ym:s:endURL]&#xA;    ,LV0.[ym:s:pageViews]&#xA;    ,LV0.[ym:s:visitDuration]&#xA;    ,LV0.[ym:s:bounce]&#xA;    ,LV0.[ym:s:ipAddress]&#xA;    ,LV0.[ym:s:regionCountry]&#xA;    ,LV0.[ym:s:regionCity]&#xA;    ,LV0.[ym:s:regionCountryID]&#xA;    ,LV0.[ym:s:regionCityID]&#xA;    ,LV0.[ym:s:clientID]&#xA;    ,LV0.[ym:s:counterUserIDHash]&#xA;    ,LV0.[ym:s:networkType]&#xA;    ,LV0.[ym:s:goalsID]&#xA;    ,LV0.[ym:s:goalsSerialNumber]&#xA;    ,LV0.[ym:s:goalsDateTime]&#xA;    ,LV0.[ym:s:goalsPrice]&#xA;    ,LV0.[ym:s:goalsOrder]&#xA;    ,LV0.[ym:s:goalsCurrency]&#xA;    ,LV0.[ym:s:lastsignTrafficSource]&#xA;    ,LV0.[ym:s:lastsignAdvEngine]&#xA;    ,LV0.[ym:s:lastsignReferalSource]&#xA;    ,LV0.[ym:s:lastsignSearchEngineRoot]&#xA;    ,LV0.[ym:s:lastsignSearchEngine]&#xA;    ,LV0.[ym:s:lastsignSocialNetwork]&#xA;    ,LV0.[ym:s:lastsignSocialNetworkProfile]&#xA;    ,LV0.[ym:s:referer]&#xA;    ,LV0.[ym:s:lastsignDirectClickOrder]&#xA;    ,LV0.[ym:s:lastsignDirectBannerGroup]&#xA;    ,LV0.[ym:s:lastsignDirectClickBanner]&#xA;    ,LV0.[ym:s:lastsignDirectClickOrderName]&#xA;    ,LV0.[ym:s:lastsignClickBannerGroupName]&#xA;    ,LV0.[ym:s:lastsignDirectClickBannerName]&#xA;    ,LV0.[ym:s:lastsignDirectPhraseOrCond]&#xA;    ,LV0.[ym:s:lastsignDirectPlatformType]&#xA;    ,LV0.[ym:s:lastsignDirectPlatform]&#xA;    ,LV0.[ym:s:lastsignDirectConditionType]&#xA;    ,LV0.[ym:s:lastsignCurrencyID]&#xA;    ,LV0.[ym:s:from]&#xA;    ,LV0.[ym:s:lastsignUTMCampaign]&#xA;    ,LV0.[ym:s:lastsignUTMContent]&#xA;    ,LV0.[ym:s:lastsignUTMMedium]&#xA;    ,LV0.[ym:s:lastsignUTMSource]&#xA;    ,LV0.[ym:s:lastsignUTMTerm]&#xA;    ,LV0.[ym:s:lastsignopenstatAd]&#xA;    ,LV0.[ym:s:lastsignopenstatCampaign]&#xA;    ,LV0.[ym:s:lastsignopenstatService]&#xA;    ,LV0.[ym:s:lastsignopenstatSource]&#xA;    ,LV0.[ym:s:lastsignhasGCLID]&#xA;    ,LV0.[ym:s:lastsignGCLID]&#xA;    ,LV0.[ym:s:browserLanguage]&#xA;    ,LV0.[ym:s:browserCountry]&#xA;    ,LV0.[ym:s:clientTimeZone]&#xA;    ,LV0.[ym:s:deviceCategory]&#xA;    ,LV0.[ym:s:mobilePhone]&#xA;    ,LV0.[ym:s:mobilePhoneModel]&#xA;    ,LV0.[ym:s:operatingSystemRoot]&#xA;    ,LV0.[ym:s:operatingSystem]&#xA;    ,LV0.[ym:s:browser]&#xA;    ,LV0.[ym:s:browserMajorVersion]&#xA;    ,LV0.[ym:s:browserMinorVersion]&#xA;    ,LV0.[ym:s:browserEngine]&#xA;    ,LV0.[ym:s:browserEngineVersion1]&#xA;    ,LV0.[ym:s:browserEngineVersion2]&#xA;    ,LV0.[ym:s:browserEngineVersion3]&#xA;    ,LV0.[ym:s:browserEngineVersion4]&#xA;    ,LV0.[ym:s:cookieEnabled]&#xA;    ,LV0.[ym:s:javascriptEnabled]&#xA;    ,LV0.[ym:s:screenFormat]&#xA;    ,LV0.[ym:s:screenColors]&#xA;    ,LV0.[ym:s:screenOrientation]&#xA;    ,LV0.[ym:s:screenWidth]&#xA;    ,LV0.[ym:s:screenHeight]&#xA;    ,LV0.[ym:s:physicalScreenWidth]&#xA;    ,LV0.[ym:s:physicalScreenHeight]&#xA;    ,LV0.[ym:s:windowClientWidth]&#xA;    ,LV0.[ym:s:windowClientHeight]&#xA;    ,LV0.[ym:s:purchaseID]&#xA;    ,LV0.[ym:s:purchaseDateTime]&#xA;    ,LV0.[ym:s:purchaseAffiliation]&#xA;    ,LV0.[ym:s:purchaseRevenue]&#xA;    ,LV0.[ym:s:purchaseTax]&#xA;    ,LV0.[ym:s:purchaseShipping]&#xA;    ,LV0.[ym:s:purchaseCoupon]&#xA;    ,LV0.[ym:s:purchaseCurrency]&#xA;    ,LV0.[ym:s:purchaseProductQuantity]&#xA;    ,LV0.[ym:s:eventsProductID]&#xA;    ,LV0.[ym:s:eventsProductList]&#xA;    ,LV0.[ym:s:eventsProductBrand]&#xA;    ,LV0.[ym:s:eventsProductCategory]&#xA;    ,LV0.[ym:s:eventsProductCategory1]&#xA;    ,LV0.[ym:s:eventsProductCategory2]&#xA;    ,LV0.[ym:s:eventsProductCategory3]&#xA;    ,LV0.[ym:s:eventsProductCategory4]&#xA;    ,LV0.[ym:s:eventsProductCategory5]&#xA;    ,LV0.[ym:s:eventsProductVariant]&#xA;    ,LV0.[ym:s:eventsProductPosition]&#xA;    ,LV0.[ym:s:eventsProductPrice]&#xA;    ,LV0.[ym:s:eventsProductCurrency]&#xA;    ,LV0.[ym:s:eventsProductCoupon]&#xA;    ,LV0.[ym:s:eventsProductQuantity]&#xA;    ,LV0.[ym:s:eventsProductEventTime]&#xA;    ,LV0.[ym:s:eventsProductType]&#xA;    ,LV0.[ym:s:eventsProductDiscount]&#xA;    ,LV0.[ym:s:eventsProductName]&#xA;    ,LV0.[ym:s:productsPurchaseID]&#xA;    ,LV0.[ym:s:productsID]&#xA;    ,LV0.[ym:s:productsName]&#xA;    ,LV0.[ym:s:productsBrand]&#xA;    ,LV0.[ym:s:productsCategory]&#xA;    ,LV0.[ym:s:productsCategory1]&#xA;    ,LV0.[ym:s:productsCategory2]&#xA;    ,LV0.[ym:s:productsCategory3]&#xA;    ,LV0.[ym:s:productsCategory4]&#xA;    ,LV0.[ym:s:productsCategory5]&#xA;    ,LV0.[ym:s:productsVariant]&#xA;    ,LV0.[ym:s:productsPosition]&#xA;    ,LV0.[ym:s:productsPrice]&#xA;    ,LV0.[ym:s:productsCurrency]&#xA;    ,LV0.[ym:s:productsCoupon]&#xA;    ,LV0.[ym:s:productsQuantity]&#xA;    ,LV0.[ym:s:productsList]&#xA;    ,LV0.[ym:s:productsEventTime]&#xA;    ,LV0.[ym:s:productsDiscount]&#xA;    ,LV0.[ym:s:impressionsURL]&#xA;    ,LV0.[ym:s:impressionsDateTime]&#xA;    ,LV0.[ym:s:impressionsProductID]&#xA;    ,LV0.[ym:s:impressionsProductName]&#xA;    ,LV1.[ym:s:impressionsProductBrand]&#xA;    ,LV1.[ym:s:impressionsProductCategory]&#xA;    ,LV1.[ym:s:impressionsProductCategory1]&#xA;    ,LV1.[ym:s:impressionsProductCategory2]&#xA;    ,LV1.[ym:s:impressionsProductCategory3]&#xA;    ,LV1.[ym:s:impressionsProductCategory4]&#xA;    ,LV1.[ym:s:impressionsProductCategory5]&#xA;    ,LV1.[ym:s:impressionsProductVariant]&#xA;    ,LV1.[ym:s:impressionsProductPrice]&#xA;    ,LV1.[ym:s:impressionsProductCurrency]&#xA;    ,LV1.[ym:s:impressionsProductCoupon]&#xA;    ,LV1.[ym:s:impressionsProductList]&#xA;    ,LV1.[ym:s:impressionsProductQuantity]&#xA;    ,LV1.[ym:s:impressionsProductEventTime]&#xA;    ,LV1.[ym:s:impressionsProductDiscount]&#xA;    ,LV1.[ym:s:promotionID]&#xA;    ,LV1.[ym:s:promotionName]&#xA;    ,LV1.[ym:s:promotionCreative]&#xA;    ,LV1.[ym:s:promotionPosition]&#xA;    ,LV1.[ym:s:promotion