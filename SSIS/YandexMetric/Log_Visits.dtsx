                                    vError = "Field=ym:s:goalsCurrency";
                                    LogVisitsBuffer.ymsgoalsCurrency = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:lastsignTrafficSource":
                                    vError = "Field=ym:s:lastsignTrafficSource";
                                    LogVisitsBuffer.ymslastsignTrafficSource = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                    break;

                                case "ym:s:lastsignAdvEngine":
                                    vError = "Field=ym:s:lastsignAdvEngine";
                                    LogVisitsBuffer.ymslastsignAdvEngine = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                    break;

                                case "ym:s:lastsignReferalSource":
                                    vError = "Field=ym:s:lastsignReferalSource";
                                    LogVisitsBuffer.ymslastsignReferalSource = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                    break;

                                case "ym:s:lastsignSearchEngineRoot":
                                    vError = "Field=ym:s:lastsignSearchEngineRoot";
                                    LogVisitsBuffer.ymslastsignSearchEngineRoot = vValues[j].Length > 1000 ? vValues[j].Substring(0, 1000) : vValues[j];
                                    break;

