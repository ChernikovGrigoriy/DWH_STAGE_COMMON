          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CA4A1DC9-22A3-4932-A092-D2CDF0854EFF}"
              SQLTask:SqlStatementSource="DECLARE @SYSMOMENT date, @id bigint&#xA;&#xA;SELECT @SYSMOMENT = ?, @id = ?&#xA;&#xA;SELECT&#xA;&#x9; [DATA] &#xA;FROM&#xA;&#x9;(&#xA;&#x9;&#x9;select &#xA;&#x9;&#x9;&#x9;[DATA] &#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[dbo].[fnDATA]( @SYSMOMENT, DATEADD(day,-1,GETDATE()), 0)&#xA;&#x9;&#x9;EXCEPT&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;DISTINCT [Date]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[YandexMetric].[Log_Visits]&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;id = @id&#xA;&#x9;) TMP&#xA;ORDER BY&#xA;&#x9;[DATA] desc"
