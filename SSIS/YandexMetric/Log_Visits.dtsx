            <DTS:Executable
              DTS:refId="Package\Foreach Loop Counters\Foreach Loop Dates\Log_Visits_Events"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{fd0deb87-b6a6-4e17-810f-e71a88c48060}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Log_Visits_Events"
              DTS:ThreadHint="1">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CA4A1DC9-22A3-4932-A092-D2CDF0854EFF}"
                  SQLTask:SqlStatementSource="CREATE TABLE #Change&#xA;(&#xA; [id] bigint,&#xA; [Date] date&#xA;)&#xA;&#xA;SELECT &#xA; [id]&#xA;,[ym:s:visitID]&#xA;,[Date]&#xA;,[NPP]&#xA;,[ym:s:eventsProductID]&#xA;,[ym:s:eventsProductList]&#xA;,[ym:s:eventsProductBrand]&#xA;,[ym:s:eventsProductCategory]&#xA;,[ym:s:eventsProductCategory1]&#xA;,[ym:s:eventsProductCategory2]&#xA;,[ym:s:eventsProductCategory3]&#xA;,[ym:s:eventsProductCategory4]&#xA;,[ym:s:eventsProductCategory5]&#xA;,[ym:s:eventsProductVariant]&#xA;,[ym:s:eventsProductPosition]&#xA;,[ym:s:eventsProductPrice]&#xA;,[ym:s:eventsProductCurrency]&#xA;,[ym:s:eventsProductCoupon]&#xA;,[ym:s:eventsProductQuantity]&#xA;,[ym:s:eventsProductEventTime]&#xA;,[ym:s:eventsProductType]&#xA;,[ym:s:eventsProductDiscount]&#xA;,[ym:s:eventsProductName]&#xA;INTO &#xA; #temp&#xA;FROM &#xA; [BUFFER].[YandexMetric_Log_Visits_Events] LV0&#xA;&#xA;&#xA;INSERT #Change &#xA;(&#xA; [id],&#xA; [Date]&#xA;)&#xA;SELECT&#xA; id,&#xA; [Date]&#xA;FROM&#xA; (&#xA;  SELECT &#xA;   [id],&#xA;   [Date],&#xA;   CAST(&#xA;    CHECKSUM_AGG(&#xA;    CHECKSUM&#xA;    (&#xA;&#x9;&#x9;[ym:s:visitID]&#xA;&#x9;&#x9;,[NPP]&#xA;&#x9;&#x9;,[ym:s:eventsProductID]&#xA;&#x9;&#x9;,[ym:s:eventsProductList]&#xA;&#x9;&#x9;,[ym:s:eventsProductBrand]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory1]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory2]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory3]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory4]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory5]&#xA;&#x9;&#x9;,[ym:s:eventsProductVariant]&#xA;&#x9;&#x9;,[ym:s:eventsProductPosition]&#xA;&#x9;&#x9;,[ym:s:eventsProductPrice]&#xA;&#x9;&#x9;,[ym:s:eventsProductCurrency]&#xA;&#x9;&#x9;,[ym:s:eventsProductCoupon]&#xA;&#x9;&#x9;,[ym:s:eventsProductQuantity]&#xA;&#x9;&#x9;,[ym:s:eventsProductEventTime]&#xA;&#x9;&#x9;,[ym:s:eventsProductType]&#xA;&#x9;&#x9;,[ym:s:eventsProductDiscount]&#xA;&#x9;&#x9;,[ym:s:eventsProductName]&#xA;    )&#xA;       )&#xA;   as bigint) [CHECKSUM],&#xA;   COUNT(*) [CNT]&#xA;  FROM &#xA;   #temp&#xA;  GROUP BY&#xA;   [id],&#xA;   [Date]&#xA;  UNION&#xA;  SELECT &#xA;   V.[id],&#xA;   V.[Date],&#xA;   -CAST(&#xA;       CHECKSUM_AGG(&#xA;    CHECKSUM&#xA;    (&#xA;&#x9;&#x9;[ym:s:visitID]&#xA;&#x9;&#x9;,[NPP]&#xA;&#x9;&#x9;,[ym:s:eventsProductID]&#xA;&#x9;&#x9;,[ym:s:eventsProductList]&#xA;&#x9;&#x9;,[ym:s:eventsProductBrand]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory1]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory2]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory3]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory4]&#xA;&#x9;&#x9;,[ym:s:eventsProductCategory5]&#xA;&#x9;&#x9;,[ym:s:eventsProductVariant]&#xA;&#x9;&#x9;,[ym:s:eventsProductPosition]&#xA;&#x9;&#x9;,[ym:s:eventsProductPrice]&#xA;&#x9;&#x9;,[ym:s:eventsProductCurrency]&#xA;&#x9;&#x9;,[ym:s:eventsProductCoupon]&#xA;&#x9;&#x9;,[ym:s:eventsProductQuantity]&#xA;&#x9;&#x9;,[ym:s:eventsProductEventTime]&#xA;&#x9;&#x9;,[ym:s:eventsProductType]&#xA;&#x9;&#x9;,[ym:s:eventsProductDiscount]&#xA;&#x9;&#x9;,[ym:s:eventsProductName] &#xA;    )&#xA;    )&#xA;   as bigint) [CHECKSUM],&#xA;   -COUNT(*) [CNT]&#xA;  FROM &#xA;   [YandexMetric].[Log_Visits_Events] V&#xA;   INNER JOIN (SELECT DISTINCT id, [Date] FROM #temp) T ON V.id= T.id AND V.[Date] = T.[Date] &#xA;  GROUP BY&#xA;   V.[id],&#xA;   V.[Date]&#xA; ) TMP&#xA;GROUP BY&#xA; [id],&#xA; [Date]&#xA;HAVING&#xA; SUM([CHECKSUM]) &lt;&gt; 0 OR SUM([CNT]) &lt;&gt; 0&#xA;&#xA;DECLARE @id bigint, @Date date&#xA;&#xA;DECLARE CUR1 CURSOR FOR&#xA;SELECT id, Date FROM #Change&#xA;&#xA;OPEN CUR1&#xA;&#xA;FETCH NEXT FROM CUR1 INTO @id, @Date&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA; BEGIN TRANSACTION;  &#xA;  &#xA; BEGIN TRY  &#xA;  DELETE [YandexMetric].[Log_Visits_Events] WITH(TABLOCKX, HOLDLOCK) WHERE [id] = @id AND [Date] = @Date&#xA; &#xA;  INSERT INTO [YandexMetric].[Log_Visits_Events]&#xA;  (&#xA;&#x9;[id]&#xA;    ,[ym:s:visitID]&#xA;    ,[Date]&#xA;    ,[NPP]&#xA;    ,[ym:s:eventsProductID]&#xA;    ,[ym:s:eventsProductList]&#xA;    ,[ym:s:eventsProductBrand]&#xA;    ,[ym:s:eventsProductCategory]&#xA;    ,[ym:s:eventsProductCategory1]&#xA;    ,[ym:s:eventsProductCategory2]&#xA;    ,[ym:s:eventsProductCategory3]&#xA;    ,[ym:s:eventsProductCategory4]&#xA;    ,[ym:s:eventsProductCategory5]&#xA;    ,[ym:s:eventsProductVariant]&#xA;    ,[ym:s:eventsProductPosition]&#xA;    ,[ym:s:eventsProductPrice]&#xA;    ,[ym:s:eventsProductCurrency]&#xA;    ,[ym:s:eventsProductCoupon]&#xA;    ,[ym:s:eventsProductQuantity]&#xA;    ,[ym:s:eventsProductEventTime]&#xA;    ,[ym:s:eventsProductType]&#xA;    ,[ym:s:eventsProductDiscount]&#xA;    ,[ym:s:eventsProductName]&#xA;    ,[SYSMOMENT]&#xA;  )&#xA;  SELECT&#xA;&#x9;[id]&#xA;    ,[ym:s:visitID]&#xA;    ,[Date]&#xA;    ,[NPP]&#xA;    ,[ym:s:eventsProductID]&#xA;    ,[ym:s:eventsProductList]&#xA;    ,[ym:s:eventsProductBrand]&#xA;    ,[ym:s:eventsProductCategory]&#xA;    ,[ym:s:eventsProductCategory1]&#xA;    ,[ym:s:eventsProductCategory2]&#xA;    ,[ym:s:eventsProductCategory3]&#xA;    ,[ym:s:eventsProductCategory4]&#xA;    ,[ym:s:eventsProductCategory5]&#xA;    ,[ym:s:eventsProductVariant]&#xA;    ,[ym:s:eventsProductPosition]&#xA;    ,[ym:s:eventsProductPrice]&#xA;    ,[ym:s:eventsProductCurrency]&#xA;    ,[ym:s:eventsProductCoupon]&#xA;    ,[ym:s:eventsProductQuantity]&#xA;    ,[ym:s:eventsProductEventTime]&#xA;    ,[ym:s:eventsProductType]&#xA;    ,[ym:s:eventsProductDiscount]&#xA;    ,[ym:s:eventsProductName]&#xA;    ,GETDATE()&#xA;  FROM&#xA;    #temp&#xA;  WHERE&#xA;    [id] = @id &#xA;    AND [Date] = @Date&#xA;&#xA; END TRY  &#xA; BEGIN CATCH  &#xA;  DECLARE @ErrorMessage NVARCHAR(4000);  &#xA;  DECLARE @ErrorSeverity INT;  &#xA;  DECLARE @ErrorState INT;  &#xA;  &#xA;  SELECT   &#xA;   @ErrorMessage = ERROR_MESSAGE(),  &#xA;   @ErrorSeverity = ERROR_SEVERITY(),  &#xA;   @ErrorState = ERROR_STATE();  &#xA;  &#xA;  IF @@TRANCOUNT &gt; 0  &#xA;   ROLLBACK TRANSACTION;  &#xA;&#xA;  RAISERROR (@ErrorMessage, -- Message text.  &#xA;       @ErrorSeverity, -- Severity.  &#xA;       @ErrorState -- State.  &#xA;       ); &#xA; &#xA; END CATCH;  &#xA;  &#xA; IF @@TRANCOUNT &gt; 0  &#xA;  COMMIT TRANSACTION;  &#xA;&#xA;&#xA;    FETCH NEXT FROM CUR1 INTO @id, @Date&#xA;END&#xA;&#xA;CLOSE CUR1&#xA;DEALLOCATE CUR1&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
