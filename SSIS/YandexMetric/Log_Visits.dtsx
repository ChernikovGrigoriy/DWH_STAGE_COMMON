    string vError = "";

    private bool IsValue(string Value)
    {
        return Value != "''";
    }

    private string GetValue(string Value)
    {
        if (Value.IndexOf("'") != -1 && Value.IndexOf("'") != Value.LastIndexOf("'")) {
            string vValue = Value.Substring(1, Value.Length - 1);
            vValue = vValue.Substring(0, Value.Length - 2);
            return vValue.Length > 200 ? vValue.Substring(0, 200) : vValue;
        }
        return Value;
    }

    private long Step1(DateTime Date, string Fields)
    {
        byte[] oDATA = null;

        int i = 1;
        while (i <= 6)
        {
            try
            {
                TimeoutWebClient oTWC = new TimeoutWebClient(90000);
                string vURL = String.Format("https://api-metrika.yandex.net/management/v1/counter/{0}/logrequests?date1={1:yyyy-MM-dd}&date2={1:yyyy-MM-dd}&source=visits&fields={2}&attribution=AUTOMATIC", Variables.vCounterID, Date, Fields);                
                oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("OAuth {0}", Variables.pToken));
                oDATA = oTWC.UploadData(vURL, Encoding.UTF8.GetBytes(""));
                oTWC = null;

                break;
            }
            catch (Exception e)
            {
                if (
                    e.Message.Contains("Too Many Requests") 
                    || e.Message.Contains("(503) Сервер не доступен")
                    )
                {
                    Thread.Sleep(20000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Метод https://api-metrika.yandex.net/management/v1/counter/{0}/logrequests?date1={1:yyyy-MM-dd}&date2={1:yyyy-MM-dd}&source=visits&fields={2}&attribution=AUTOMATIC (Step 1) срвера YandexMetrica не доступен");

        JavaScriptSerializer oJSS = new JavaScriptSerializer();
        oJSS.MaxJsonLength = int.MaxValue;

        Response oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

        return oResponse.log_request.request_id;
    }

    private int[] Step2(long Request_ID)
    {
        Response oResponse = null;
        int vCnt = 0;
        do
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                    string vURL = String.Format("https://api-metrika.yandex.net/management/v1/counter/{0}/logrequest/{1}", Variables.vCounterID, Request_ID);
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("OAuth {0}", Variables.pToken));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests"))
                    {
                        Thread.Sleep(20000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Метод https://api-metrika.yandex.net/management/v1/counter/{0}/logrequests?date1={1:yyyy-MM-dd}&date2={1:yyyy-MM-dd}&source=visits&fields={2}&attribution=AUTOMATIC (Step2) срвера YandexMetrica не доступен");

            JavaScriptSerializer oJSS = new JavaScriptSerializer();
            oJSS.MaxJsonLength = int.MaxValue;

            oResponse = oJSS.Deserialize<Response>(Encoding.UTF8.GetString(oDATA));

            if (oResponse.log_request.status != "processed" && vCnt < 10)
            {
                vCnt++;
                Thread.Sleep(30000);
            }

        } while (oResponse.log_request.status != "processed" && vCnt < 10);

        if (oResponse.log_request.status != "processed" && vCnt >= 10)
        {
            throw new ApplicationException("Не получен отчет");
        }

        return oResponse.log_request.parts.Select(x => x.part_number).ToArray();
    }

    private void Step3(DateTime Date, long Request_ID, int[] Parts, int Num)
    {
        CultureInfo provider = CultureInfo.InvariantCulture;

        foreach (int vPart in Parts)
        {
            byte[] oDATA = null;

            int i = 1;
            while (i <= 6)
            {
                try
                {
                    TimeoutWebClient oTWC = new TimeoutWebClient(30000);
                    string vURL = String.Format("https://api-metrika.yandex.net/management/v1/counter/{0}/logrequest/{1}/part/{2}/download", Variables.vCounterID, Request_ID, vPart);
                    oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("OAuth {0}", Variables.pToken));
                    oDATA = oTWC.DownloadData(vURL);
                    oTWC = null;

                    break;
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Too Many Requests"))
                    {
                        Thread.Sleep(20000 * i);
                        i++;
                    }
                    else
                    {
                        throw;
                    }
                }
            }

            if (i > 6)
                throw new ApplicationException("Метод https://api-metrika.yandex.net/management/v1/counter/{0}/logrequests?date1={1:yyyy-MM-dd}&date2={1:yyyy-MM-dd}&source=visits&fields={2}&attribution=AUTOMATIC (Step 3) срвера YandexMetrica не доступен");

            string vBufferStr = Encoding.UTF8.GetString(oDATA);

            string[] vLines = vBufferStr.Split(new string[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);

            string[] vFields = vLines[0].Split(new string[] { "\t" }, StringSplitOptions.None);

            vError = "vFields";
            for (int vLnNum = 1; vLnNum < vLines.Length; vLnNum++)
            {
                string[] vValues = vLines[vLnNum].Split(new string[] { "\t" }, StringSplitOptions.None);

                vError = "Добавление новой записи";
                if (vValues.Length == vFields.Length)
                {
                    LogVisitsBuffer.AddRow();
                    LogVisitsBuffer.Num = Num;
                    LogVisitsBuffer.Date = Date;

                    
                    /* Log_Visits_Events */
                    string vVisitID = null;
                    Dictionary<string, List<string>> oEventsLst = new Dictionary<string, List<string>>();
                    vError = "Цикл oEventsLst";
                    for (int j = 0; j < vFields.Length; j++)
                    {
                        if (vValues[j] != null && vValues[j].Length > 0)
                        {
                            switch (vFields[j])
                            {
                                case "ym:s:visitID":
                                    vError = "Field=ym:s:visitID";
                                    LogVisitsBuffer.ymsvisitID = vValues[j];
                                    vVisitID = vValues[j];
                                    break;

                                case "ym:s:watchIDs":
                                    vError = "Field=ym:s:watchIDs";
                                    LogVisitsBuffer.ymswatchIDs = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:dateTimeUTC":
                                    vError = "Field=ym:s:dateTimeUTC";
                                    LogVisitsBuffer.ymsdateTimeUTC = DateTime.ParseExact(vValues[j], "yyyy-MM-dd HH:mm:ss", provider);
                                    break;

                                case "ym:s:isNewUser":
                                    vError = "Field=ym:s:isNewUser";
                                    LogVisitsBuffer.ymsisNewUser = int.Parse(vValues[j]);
                                    break;

                                case "ym:s:startURL":
                                    vError = "Field=ym:s:startURL";
                                    LogVisitsBuffer.ymsstartURL = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:endURL":
                                    vError = "Field=ym:s:endURL";
                                    LogVisitsBuffer.ymsendURL = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:pageViews":
                                    vError = "Field=ym:s:pageViews";
                                    LogVisitsBuffer.ymspageViews = int.Parse(vValues[j]);
                                    break;

                                case "ym:s:visitDuration":
                                    vError = "Field=ym:s:visitDuration";
                                    LogVisitsBuffer.ymsvisitDuration = int.Parse(vValues[j]);
                                    break;

                                case "ym:s:bounce":
                                    vError = "Field=ym:s:bounce";
                                    LogVisitsBuffer.ymsbounce = int.Parse(vValues[j]);
                                    break;

                                case "ym:s:ipAddress":
                                    vError = "Field=ym:s:ipAddress";
                                    LogVisitsBuffer.ymsipAddress = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                    break;

                                case "ym:s:regionCountry":
                                    vError = "Field=ym:s:regionCountry";
                                    LogVisitsBuffer.ymsregionCountry = vValues[j].Length > 200 ? vValues[j].Substring(0, 200) : vValues[j];
                                    break;

                                case "ym:s:regionCity":
                                    vError = "Field=ym:s:regionCity";
                                    LogVisitsBuffer.ymsregionCity = vValues[j].Length > 200 ? vValues[j].Substring(0, 200) : vValues[j];
                                    break;

                                case "ym:s:regionCountryID":
                                    vError = "Field=ym:s:regionCountryID";
                                    LogVisitsBuffer.ymsregionCountryID = int.Parse(vValues[j]);
                                    break;

                                case "ym:s:regionCityID":
                                    vError = "Field=ym:s:regionCityID";
                                    LogVisitsBuffer.ymsregionCityID = int.Parse(vValues[j]);
                                    break;

                                case "ym:s:clientID":
                                    vError = "Field=ym:s:clientID";
                                    LogVisitsBuffer.ymsclientID = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                    break;

                                case "ym:s:counterUserIDHash":
                                    vError = "Field=ym:s:counterUserIDHash";
                                    LogVisitsBuffer.ymscounterUserIDHash = vValues[j].Length > 50 ? vValues[j].Substring(0, 50) : vValues[j];
                                    break;

                                case "ym:s:networkType":
                                    vError = "Field=ym:s:networkType";
                                    LogVisitsBuffer.ymsnetworkType = vValues[j].Length > 200 ? vValues[j].Substring(0, 200) : vValues[j];
                                    break;

                                case "ym:s:goalsID":
                                    vError = "Field=ym:s:goalsID";
                                    LogVisitsBuffer.ymsgoalsID = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:goalsSerialNumber":
                                    vError = "Field=ym:s:goalsSerialNumber";
                                    LogVisitsBuffer.ymsgoalsSerialNumber = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:goalsDateTime":
                                    vError = "Field=ym:s:goalsDateTime";
                                    LogVisitsBuffer.ymsgoalsDateTime = vValues[j].Length > 4000 ? vValues[j].Substring(0, 4000) : vValues[j];
                                    break;

                                case "ym:s:goalsPrice":
                                    vError = "Field=ym:s:goalsPrice";
