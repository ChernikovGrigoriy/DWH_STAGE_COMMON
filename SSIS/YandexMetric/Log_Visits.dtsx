    private void Step4(long Request_ID)
    {
        byte[] oDATA = null;

        int i = 1;
        while (i <= 6)
        {
            try
            {
                TimeoutWebClient oTWC = new TimeoutWebClient(600000);
                string vURL = String.Format("https://api-metrika.yandex.net/management/v1/counter/{0}/logrequest/{1}/clean", Variables.vCounterID, Request_ID);
                oTWC.Headers.Add(HttpRequestHeader.Authorization, string.Format("OAuth {0}", Variables.pToken));
                oDATA = oTWC.UploadData(vURL, Encoding.UTF8.GetBytes(""));
                oTWC = null;

                break;
            }
            catch (Exception e)
            {
                if (e.Message.Contains("Too Many Requests"))
                {
                    Thread.Sleep(20000 * i);
                    i++;
                }
                else
                {
                    throw;
                }
            }
        }

        if (i > 6)
            throw new ApplicationException("Слишком большое количество обращений к серверу YandexMetrica");
    }
